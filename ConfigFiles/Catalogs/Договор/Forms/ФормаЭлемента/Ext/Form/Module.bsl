&НаКлиенте
Процедура Добавить(Команда)
	Если  ПустаяСтрока(Объект.ДатаСоставления) = ЛОжь тогда
	Объект.СрокДействия=Объект.ДатаСоставления+(86400*Объект.Срок);
	Иначе
	Предупреждение("Дата составления договора пуста", 60, "Дата договора");
	КонецЕсли;
КонецПроцедуры

