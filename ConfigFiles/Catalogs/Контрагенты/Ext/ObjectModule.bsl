Процедура ПередЗаписью(Отказ, РежимЗаписи)
	// Проверка на уникальность ИНН перед записью
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.Ссылка <> &ТекущийОбъект";

	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("ТекущийОбъект", Ссылка);

	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Отказ = Истина;
		Сообщить("Бундай ИНН билан контрагент мавжуд " + ИНН);
	КонецЕсли;
КонецПроцедуры


