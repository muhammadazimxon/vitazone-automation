&НаСервере
Процедура ЗаполнятьДокументы()
	
    // Очищаем табличную часть перед заполнением
    Объект.Табдок.Очистить();
    
    // Параметры для запроса
    Дата = ТекущаяДата();
    Контрагенты = ПолучимСсылкуНа(Объект.Код); // Ссылка на конкретный договор

		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Дебиторка.Активность КАК Активность,
		|	Дебиторка.ДокНомер КАК ДокНомер,
		|	Дебиторка.Регистратор.Ссылка КАК ДокументПродажи,
		|	ВЫБОР
		|		КОГДА Дебиторка.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА Дебиторка.ЗадолженностьСум
		|	КОНЕЦ КАК Приход,
		|	ВЫБОР
		|		КОГДА Дебиторка.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА Дебиторка.ЗадолженностьСум
		|	КОНЕЦ КАК Расход,
		|	Дебиторка.Контрагенты КАК Контрагенты,
		|	Дебиторка.Период КАК Период
		|ИЗ
		|	РегистрНакопления.Дебиторка КАК Дебиторка
		|ГДЕ
		|	Дебиторка.Контрагенты = &Контрагенты";
	
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);

   РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();

    // Заполнение табличной части
    Пока Выборка.Следующий() Цикл
        НоваяСтрока = Объект.Табдок.Добавить();
        НоваяСтрока.Документ = Выборка.ДокументПродажи;
		НоваяСтрока.договор=Выборка.ДокНомер;
        НоваяСтрока.ТабПриход = Выборка.Приход;
		НоваяСтрока.ТабРасход = Выборка.Расход;
		НоваяСтрока.Дата=Выборка.Период;
	КонецЦикла;
	ОстатокПоДокументу=Объект.Табдок.Итог("ТабРасход")-Объект.Табдок.Итог("ТабПриход");
	//Если ОстатокПоДокументу<0 Тогда
	//	Элементы.ОстатокПоДокументу.ЦветТекста.Красный=истина;
	//	Элементы.ОстатокПоДокументу.Шрифт.Полужирный=Истина;
	//КонецЕсли;
КонецПроцедуры


&НаСервере
Функция ПолучимСсылкуНа (Контрагенты)
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Код КАК Код
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Код = &Контрагенты";
	
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;// Вставить обработку выборки ВыборкаДетальныеЗаписи
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоИНН(Команда)
    Если Не ЗначениеЗаполнено(Объект.ИНН) Тогда
        Предупреждение("Заполните ИНН перед выполнением команды!");
        Возврат;
    КонецЕсли;
    
    // Преобразуем ИНН в строку без разделителей
    ИННСтрокой = Формат(Объект.ИНН, "ЧГ=0");
    ДлинаИНН = СтрДлина(ИННСтрокой);
    
    // Отладочный вывод
    Сообщить("ИНН как строка: " + ИННСтрокой);
    Сообщить("Длина ИНН: " + Строка(ДлинаИНН));
    
    // Проверка длины ИНН
    Если ДлинаИНН <> 9 И ДлинаИНН <> 14 Тогда
        Предупреждение("ИНН должен содержать либо 9, либо 14 цифр!");
        Возврат;
    КонецЕсли;
    
    Результат = ЗаполнитьПоИНННаСервере(ИННСтрокой);
    
    Если Результат <> Неопределено Тогда
        Объект.Наименование = Результат.Наименование;
        Объект.ДатаРегистрации = Результат.ДатаРегистрации;
        Объект.ОКЭД = Результат.ОКЭД;
        Объект.ИННДиректора = Результат.ИННДиректора;
        Объект.ПинфлДиректора = Результат.ПинфлДиректора;
        Объект.Директор = Результат.Директор;
        Объект.Бухгалтер = Результат.Бухгалтер;
        Объект.МФО = Результат.МФО;
        Объект.Счет = Результат.Счет;
        Объект.НДС = Результат.НДС;
        Объект.АктивностьНДС = Результат.АктивностьНДС;
        Объект.Адрес = Результат.Адрес; // Добавляем заполнение адреса
        Модифицированность = Истина;
    Иначе
        Предупреждение("Не удалось получить данные по ИНН!");
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоИНННаСервере(ИНН)
    // Объявляем переменные в начале функции
    Перем ЧастиДаты, День, Месяц, Год;
    
    Тело = "{""password"":""307792054"",""ПортПодключения"":443}";
    
    HTTPСоединение = Новый HTTPСоединение("api.goodsign.biz", 443,,,,, Новый ЗащищенноеСоединениеOpenSSL);
    HTTPЗапрос = Новый HTTPЗапрос("waltz/goodsign/0.0.1/user/307792054/token");
    HTTPЗапрос.Заголовки.Вставить("accept", "application/json");
    HTTPЗапрос.Заголовки.Вставить("content-type", "application/json");
    HTTPЗапрос.Заголовки.Вставить("api-key", "67ae7302-42a1-40d6-b9be-778b0285b99a");
    HTTPЗапрос.УстановитьТелоИзСтроки(Тело, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
    
    HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
    Токен = HTTPОтвет.ПолучитьТелоКакСтроку();
    
    HTTPСоединение = Новый HTTPСоединение("api.goodsign.biz", 443,,,,, Новый ЗащищенноеСоединениеOpenSSL);	
    HTTPЗапрос = Новый HTTPЗапрос("/waltz/goodsign/0.0.1/info/" + ИНН);
    HTTPЗапрос.Заголовки.Вставить("user-key", Токен);
    HTTPЗапрос.Заголовки.Вставить("api-key", "67ae7302-42a1-40d6-b9be-778b0285b99a");
    
    HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
    ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
    
    Сообщить("Текст ответа от API: " + ТекстОтвета);
    
    Ответ = ЧтениеЖС(ТекстОтвета);
    
    Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("error") И Ответ.error <> Неопределено Тогда
        Сообщить("Ошибка API: " + Ответ.error.message);
        Возврат Неопределено;
    КонецЕсли;
    
    // Проверяем наличие shortName
    Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("shortName") Тогда
        Структура = Новый Структура();
        Структура.Вставить("Наименование", Ответ.shortName);
        Структура.Вставить("ИНН", Ответ.inn);
        
        // ДатаРегистрации из regDate
        ДатаРегистрации = Дата(1,1,1); // Значение по умолчанию
        Если Ответ.Свойство("regDate") И ЗначениеЗаполнено(Ответ.regDate) Тогда
            Попытка
                // Разбираем строку "03.05.2019" на части
                ЧастиДаты = СтрРазделить(Ответ.regDate, ".", Ложь);
                Если ЧастиДаты.Количество() = 3 Тогда
                    День = Число(ЧастиДаты[0]);
                    Месяц = Число(ЧастиДаты[1]);
                    Год = Число(ЧастиДаты[2]);
                    ДатаРегистрации = Дата(Год, Месяц, День); // Передаём как отдельные параметры
                    Сообщить("Дата разобрана: День=" + День + ", Месяц=" + Месяц + ", Год=" + Год);
                Иначе
                    Сообщить("Неверный формат даты регистрации: " + Ответ.regDate);
                КонецЕсли;
            Исключение
                Сообщить("Ошибка преобразования даты регистрации: " + Ответ.regDate + ". Описание: " + ОписаниеОшибки());
            КонецПопытки;
        КонецЕсли;
        Структура.Вставить("ДатаРегистрации", ДатаРегистрации);
        
        // Остальные поля
        Структура.Вставить("ОКЭД", ?(Ответ.Свойство("oked"), Ответ.oked, ""));
        Структура.Вставить("ИННДиректора", ?(Ответ.Свойство("directorTin"), Ответ.directorTin, ""));
        Структура.Вставить("ПинфлДиректора", ?(Ответ.Свойство("directorPinfl"), Ответ.directorPinfl, ""));
        Структура.Вставить("Директор", ?(Ответ.Свойство("director"), Ответ.director, ""));
        Структура.Вставить("Бухгалтер", ?(Ответ.Свойство("accountant"), Ответ.accountant, ""));
        Структура.Вставить("МФО", ?(Ответ.Свойство("bankCode"), Ответ.bankCode, ""));
        Структура.Вставить("Счет", ?(Ответ.Свойство("bankAccount"), Ответ.bankAccount, ""));
        Структура.Вставить("НДС", ?(Ответ.Свойство("vatRegCode"), Ответ.vatRegCode, ""));
        Структура.Вставить("АктивностьНДС", ?(Ответ.Свойство("vat"), Ответ.vat, Ложь));
        Структура.Вставить("Адрес", ?(Ответ.Свойство("address"), Ответ.address, "")); // Добавляем адрес
        
        Возврат Структура;
    Иначе
        Сообщить("Ошибка: в ответе API отсутствует поле 'shortName'");
        Возврат Неопределено;
    КонецЕсли;
КонецФункции

&НаСервере
Функция ЧтениеЖС(СтрокаJSON)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();
    Возврат Результат;
КонецФункции