&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Все файлы (*.*)|*.*";
    Диалог.МножественныйВыбор = Ложь;
    Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
    Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    // Помещаем файл во временное хранилище
    ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
    НачатьПомещениеФайла(ОписаниеОповещения, , ВыбранныеФайлы[0], Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
    Если Не Результат Тогда
        Предупреждение("Не удалось поместить файл во временное хранилище!");
        Возврат;
    КонецЕсли;
    ИмяФайла = ПолучитьИмяФайлаИзПолногоПути(ВыбранноеИмяФайла);
    СохранитьФайлНаСервере(Адрес, ИмяФайла);
    Предупреждение("Файл успешно загружен!");
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяФайлаИзПолногоПути(ПолныйПуть)
    МассивЧастей = СтрРазделить(ПолныйПуть, "\", Ложь);
    Если МассивЧастей.Количество() = 1 Тогда
        МассивЧастей = СтрРазделить(ПолныйПуть, "/", Ложь);
    КонецЕсли;
    Если МассивЧастей.Количество() > 0 Тогда
        Возврат МассивЧастей[МассивЧастей.Количество() - 1];
    Иначе
        Возврат "";
    КонецЕсли;
КонецФункции

&НаСервере
Процедура СохранитьФайлНаСервере(Адрес, ИмяФайла)
    // Получаем двоичные данные из временного хранилища
    ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
    // Преобразуем в Base64
    Объект.ФайлBase64 = Base64Строка(ДвоичныеДанные);
    // Обрезаем имя файла, если оно слишком длинное
    Объект.Наименование = Лев(ИмяФайла, 150);
    Объект.ДатаЗагрузки = ТекущаяДатаСеанса();
    Записать();
    // Удаляем данные из временного хранилища
    УдалитьИзВременногоХранилища(Адрес);
КонецПроцедуры

&НаКлиенте
Процедура СкачатьФайл(Команда)
    Если Не ЗначениеЗаполнено(Объект.ФайлBase64) Тогда
        Предупреждение("Файл не загружен!");
        Возврат;
    КонецЕсли;
    ДвоичныеДанные = ПолучитьДвоичныеДанныеФайла();
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Фильтр = "Все файлы (*.*)|*.*";
    Диалог.ПолноеИмяФайла = Объект.Наименование;
    Диалог.Показать(Новый ОписаниеОповещения("ПослеУказанияИмениФайла", ЭтотОбъект, ДвоичныеДанные));
КонецПроцедуры

&НаКлиенте
Процедура ПослеУказанияИмениФайла(ВыбранныеФайлы, ДвоичныеДанные) Экспорт
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ДвоичныеДанные.Записать(ВыбранныеФайлы[0]);
    Предупреждение("Файл успешно сохранен!");
КонецПроцедуры

&НаСервере
Функция ПолучитьДвоичныеДанныеФайла()
    Возврат Base64Значение(Объект.ФайлBase64);
КонецФункции