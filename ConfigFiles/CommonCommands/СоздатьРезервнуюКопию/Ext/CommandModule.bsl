&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
    // Вызываем серверную процедуру для запуска .bat-файла
    СоздатьРезервнуюКопиюНаСервере();
    
    // Небольшая задержка перед завершением работы
    //Приостановить(1000); // Задержка 1 секунда (1000 миллисекунд)
    
    // Завершаем работу системы на клиенте
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

Процедура СоздатьРезервнуюКопиюНаСервере() Экспорт
    ИмяФайла = "C:\Backup\Backup_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".dt";
    Каталог = "C:\Backup";
    СоздатьКаталог(Каталог);

    ПутьКBatФайлу = "D:\DaantecBase\backup.bat"; // Укажите путь к вашему .bat-файлу

    Попытка
        ЗапуститьПриложение(ПутьКBatФайлу,, Ложь); // Не ждём завершения
        Сообщить("Команда для создания резервной копии запущена: " + ИмяФайла);
    Исключение
        Сообщить("Ошибка при запуске команды: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры