&НаКлиенте
Процедура ОбновитьТокен(Команда)
	
	// Вызываем серверную функцию и выводим результат пользователю
	ТекстСообщения = ОбновитьТокенНаСервере();
	Сообщить(ТекстСообщения);
	
КонецПроцедуры

&НаСервере
Функция ОбновитьТокенНаСервере()
	
	// Тот самый длинный ключ интеграции, который вы скидывали ранее
	СекретныйКлюч = "68a011e658f3b72184b61d2b0fc0b6d964cd6fec3a92caf2211f61994641796d0c6f78bd4caefbbb034a3f477e5c69c895c8b1c9673d1b3ac38e5073c3253de4e077a965f13233f8ddd4e55e6256c75eef4b756e363ea2c5e0b02f49afd16bc62c28a00abda39b128f91129aa115c98e3196d38bef79edca"; 
	
	Сервер = "api-admin.billz.ai";
	АдресРесурса = "/v1/auth/login";
	
	// Настраиваем защищенное HTTPS-соединение
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	HTTPСоединение = Новый HTTPСоединение(Сервер, 443, , , , 15, ЗащищенноеСоединение);
	
	// Подготавливаем заголовки
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
	
	// Формируем тело запроса
	ТелоЗапроса = "{""secret_token"": """ + СекретныйКлюч + """}";
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
	
	Попытка
		// Отправляем POST-запрос
		HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		СтрокаОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
		
		Если HTTPОтвет.КодСостояния = 200 Тогда
			
			// Ответ успешный, парсим JSON
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
			ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			// Проверяем, есть ли нужные поля в ответе
			Если ДанныеОтвета.Свойство("data") И ДанныеОтвета.data.Свойство("access_token") Тогда
				
				НовыйТокен = ДанныеОтвета.data.access_token;
				
				// Записываем токен в константу
				КонстантаМенеджер = Константы.ТокенБиллз.СоздатьМенеджерЗначения();
				КонстантаМенеджер.Значение = НовыйТокен;
				КонстантаМенеджер.Записать();
				
				Возврат "Токен BILLZ успешно обновлен и сохранен!";
				
			Иначе
				Возврат "Ошибка: Сервер ответил 200, но поле access_token не найдено. Ответ: " + СтрокаОтвета;
			КонецЕсли;
			
		Иначе
			// Если сервер вернул 400, 401, 500 и т.д.
			Возврат "Ошибка сервера BILLZ. Код состояния: " + HTTPОтвет.КодСостояния + Символы.ПС + СтрокаОтвета;
		КонецЕсли;
		
	Исключение
		// Ловим ошибки связи (нет интернета, блокировка портов)
		Возврат "Ошибка при соединении с сервером: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции