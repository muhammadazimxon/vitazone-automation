&НаКлиенте
Перем ПредыдущийВерх, ПредыдущийНиз, ПредыдущийЛево, ПредыдущийПраво;

&НаКлиенте
Процедура РассчитатьСуммуВыделенногоДиапазона()

    ВыделеннаяОбласть = Элементы.Результат.ТекущаяОбласть;

    Если ВыделеннаяОбласть = Неопределено Тогда
        Элементы.СуммаВыделенногоДиапазона.Заголовок = "Сумма: 0";
        ПредыдущийВерх  = Неопределено;
        ПредыдущийНиз   = Неопределено;
        ПредыдущийЛево  = Неопределено;
        ПредыдущийПраво = Неопределено;
        Возврат;
    КонецЕсли;

    Верх  = ВыделеннаяОбласть.Верх;
    Низ   = ВыделеннаяОбласть.Низ;
    Лево  = ВыделеннаяОбласть.Лево;
    Право = ВыделеннаяОбласть.Право;

    Если ПредыдущийВерх = Верх
        И ПредыдущийНиз  = Низ
        И ПредыдущийЛево = Лево
        И ПредыдущийПраво = Право Тогда
        Возврат;
    КонецЕсли;

    ПредыдущийВерх  = Верх;
    ПредыдущийНиз   = Низ;
    ПредыдущийЛево  = Лево;
    ПредыдущийПраво = Право;

    Сумма = 0;
    ОбработанныеЯчейки = Новый Соответствие; // для учета объединенных ячеек

    // Проходим по всем строкам и столбцам в выделенном диапазоне
    Для НомерСтроки = Верх По Низ Цикл
        Для НомерСтолбца = Лево По Право Цикл

            // Формируем ключ, чтобы не обрабатывать ячейку повторно
            КлючЯчейки = Формат(НомерСтроки, "ЧГ=0") + "_" + Формат(НомерСтолбца, "ЧГ=0");
            Если ОбработанныеЯчейки[КлючЯчейки] <> Неопределено Тогда
                Продолжить;
            КонецЕсли;

            Область = Результат.Область(НомерСтроки, НомерСтолбца);
            ЗначениеЯчейки = Область.Текст;

            Если ПустаяСтрока(ЗначениеЯчейки) Тогда
                Продолжить;
            КонецЕсли;

            Попытка
                ОчищенноеЗначение = СтрЗаменить(СтрЗаменить(ЗначениеЯчейки, Символ(160), ""), " ", "");
                ОчищенноеЗначение = СтрЗаменить(ОчищенноеЗначение, ",", ".");
                ЧисловоеЗначение  = Число(ОчищенноеЗначение);
                Сумма = Сумма + ЧисловоеЗначение;

                // Обрабатываем объединенные ячейки
                Если Область.ВерхняяГраницаОбъединения <> Неопределено Тогда
                    Для СчСтрока = Область.ВерхняяГраницаОбъединения По Область.НижняяГраницаОбъединения Цикл
                        Для СчСтолбец = Область.ЛеваяГраницаОбъединения По Область.ПраваяГраницаОбъединения Цикл
                            Ключ = Формат(СчСтрока, "ЧГ=0") + "_" + Формат(СчСтолбец, "ЧГ=0");
                            ОбработанныеЯчейки.Вставить(Ключ, Истина);
                        КонецЦикла;
                    КонецЦикла;
                Иначе
                    ОбработанныеЯчейки.Вставить(КлючЯчейки, Истина);
                КонецЕсли;

            Исключение
                // Сообщить("Ошибка преобразования в число: " + ЗначениеЯчейки + ", Очищенное: " + ОчищенноеЗначение);
                Продолжить;
            КонецПопытки;

        КонецЦикла;
    КонецЦикла;

    Элементы.СуммаВыделенногоДиапазона.Заголовок =
        "Сумма: " + Формат(Сумма, "ЧДЦ=2; ЧРД=','; ЧРГ=' '");

КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизации(Элемент)
    РассчитатьСуммуВыделенногоДиапазона();
КонецПроцедуры
