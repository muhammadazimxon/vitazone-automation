// Общий модуль АвтоматическоеУдаление

Процедура ПометитьНаУдалениеФин3(ДатаДедлайна) Экспорт
	// Логируем начало выполнения
	ЗаписьЖурналаРегистрации(
		"ПометкаУдаленияФин3.Отладка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Начало выполнения процедуры ПометитьНаУдалениеФин3, ДатаДедлайна: " 
			+ Формат(ДатаДедлайна, "ДФ=dd.MM.yyyy HH:mm:ss")
	);
	
	// Проверяем существование документа Фин3
	Попытка
		МетаданныеДокумента = Метаданные.Документы.Фин3;
		ЗаписьЖурналаРегистрации(
			"ПометкаУдаленияФин3.Отладка",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Документ Фин3 найден в метаданных. Имя: " + МетаданныеДокумента.Имя 
				+ ", Полное имя: " + МетаданныеДокумента.ПолноеИмя()
		);
		
		// Вывод стандартных реквизитов
		СтрокаРеквизитов = "Стандартные реквизиты документа Фин3: ";
		Для Каждого Реквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
			СтрокаРеквизитов = СтрокаРеквизитов + Реквизит.Имя + ", ";
		КонецЦикла;
		ЗаписьЖурналаРегистрации(
			"ПометкаУдаленияФин3.Отладка",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрокаРеквизитов
		);
		
		// Вывод обычных реквизитов
		СтрокаРеквизитов = "Обычные реквизиты документа Фин3: ";
		Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
			СтрокаРеквизитов = СтрокаРеквизитов + Реквизит.Имя + ", ";
		КонецЦикла;
		ЗаписьЖурналаРегистрации(
			"ПометкаУдаленияФин3.Отладка",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрокаРеквизитов
		);
		
		// Проверка на конфликты имён
		СтрокаКонфликтов = "Объекты метаданных с именем 'Фин3': ";
		Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
			Если НРег(ОбъектМетаданных.Имя) = НРег("Фин3") Тогда
				СтрокаКонфликтов = СтрокаКонфликтов + "Документ: " + ОбъектМетаданных.ПолноеИмя() + "; ";
			КонецЕсли;
		КонецЦикла;
		Для Каждого ОбъектМетаданных Из Метаданные.Справочники Цикл
			Если НРег(ОбъектМетаданных.Имя) = НРег("Фин3") Тогда
				СтрокаКонфликтов = СтрокаКонфликтов + "Справочник: " + ОбъектМетаданных.ПолноеИмя() + "; ";
			КонецЕсли;
		КонецЦикла;
		Для Каждого ОбъектМетаданных Из Метаданные.РегистрыСведений Цикл
			Если НРег(ОбъектМетаданных.Имя) = НРег("Фин3") Тогда
				СтрокаКонфликтов = СтрокаКонфликтов + "Регистр сведений: " + ОбъектМетаданных.ПолноеИмя() + "; ";
			КонецЕсли;
		КонецЦикла;
		ЗаписьЖурналаРегистрации(
			"ПометкаУдаленияФин3.Отладка",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрокаКонфликтов
		);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ПометкаУдаленияФин3.Отладка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка при обращении к метаданным документа Фин3: " + ОписаниеОшибки()
		);
		ВызватьИсключение;
	КонецПопытки;
	
	// Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Фин3.Ссылка КАК Ссылка,
	|	Фин3.Дата КАК Дата,
	|	Фин3.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.Фин3 КАК Фин3
	|ГДЕ
	|	Фин3.Дата <= &ДатаДедлайна
	|	И НЕ Фин3.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДатаДедлайна", ДатаДедлайна);
	
	// Логирование запроса
	ЗаписьЖурналаРегистрации(
		"ПометкаУдаленияФин3.Отладка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Текст запроса: " + Запрос.Текст + "; Параметр ДатаДедлайна: " + Формат(ДатаДедлайна, "ДФ=dd.MM.yyyy HH:mm:ss")
	);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		КоличествоНайденных = Выборка.Количество();
		
		ЗаписьЖурналаРегистрации(
			"ПометкаУдаленияФин3.Отладка",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.Фин3,
			,
			"Найдено документов для пометки: " + КоличествоНайденных
		);
		
		Пока Выборка.Следующий() Цикл
			ЗаписьЖурналаРегистрации(
				"ПометкаУдаленияФин3.Отладка",
				УровеньЖурналаРегистрации.Информация,
				Метаданные.Документы.Фин3,
				Выборка.Ссылка,
				"Обработка документа: Ссылка = " + Строка(Выборка.Ссылка) 
					+ ", Дата = " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy HH:mm:ss")
					+ ", ПометкаУдаления = " + Выборка.ПометкаУдаления
			);
			
			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект = Неопределено Тогда
					ЗаписьЖурналаРегистрации(
						"ПометкаУдаленияФин3.Отладка",
						УровеньЖурналаРегистрации.Предупреждение,
						Метаданные.Документы.Фин3,
						Выборка.Ссылка,
						"Объект не найден для ссылки: " + Строка(Выборка.Ссылка)
					);
					Продолжить;
				КонецЕсли;
				
				Объект.УстановитьПометкуУдаления(Истина);
				
				ЗаписьЖурналаРегистрации(
					"ПометкаУдаленияФин3",
					УровеньЖурналаРегистрации.Информация,
					Метаданные.Документы.Фин3,
					Выборка.Ссылка,
					"Помечен на удаление документ: " 
						+ Строка(Выборка.Ссылка) 
						+ ", Дата: " 
						+ Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")
				);
			Исключение
				ЗаписьЖурналаРегистрации(
					"ПометкаУдаленияФин3",
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Документы.Фин3,
					Выборка.Ссылка,
					"Ошибка при пометке: " + ОписаниеОшибки()
				);
			КонецПопытки;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации(
			"ПометкаУдаленияФин3",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.Фин3,
			,
			"Ошибка выполнения запроса: " + ОписаниеОшибки()
		);
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура УдалитьПомеченныеФин3() Экспорт
	// Логируем начало выполнения
	ЗаписьЖурналаРегистрации(
		"УдалениеПомеченныхФин3.Отладка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Начало выполнения процедуры УдалитьПомеченныеФин3"
	);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Фин3.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Фин3 КАК Фин3
	|ГДЕ
	|	Фин3.ПометкаУдаления = ИСТИНА";
	
	// Логируем текст запроса
	ЗаписьЖурналаРегистрации(
		"УдалениеПомеченныхФин3.Отладка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Текст запроса: " + Запрос.Текст
	);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		КоличествоНайденных = Выборка.Количество();
		
		ЗаписьЖурналаРегистрации(
			"УдалениеПомеченныхФин3.Отладка",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.Фин3,
			,
			"Найдено помеченных документов для удаления: " + КоличествоНайденных
		);
		
		Пока Выборка.Следующий() Цикл
			ЗаписьЖурналаРегистрации(
				"УдалениеПомеченныхФин3.Отладка",
				УровеньЖурналаРегистрации.Информация,
				Метаданные.Документы.Фин3,
				Выборка.Ссылка,
				"Обработка документа: Ссылка = " + Строка(Выборка.Ссылка)
			);
			
			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект = Неопределено Тогда
					ЗаписьЖурналаРегистрации(
						"УдалениеПомеченныхФин3.Отладка",
						УровеньЖурналаРегистрации.Предупреждение,
						Метаданные.Документы.Фин3,
						Выборка.Ссылка,
						"Объект не найден для ссылки: " + Строка(Выборка.Ссылка)
					);
					Продолжить;
				КонецЕсли;
				
				Объект.Удалить();
				
				ЗаписьЖурналаРегистрации(
					"УдалениеПомеченныхФин3",
					УровеньЖурналаРегистрации.Информация,
					Метаданные.Документы.Фин3,
					Выборка.Ссылка,
					"Удален документ: " + Строка(Выборка.Ссылка)
				);
			Исключение
				ЗаписьЖурналаРегистрации(
					"УдалениеПомеченныхФин3",
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Документы.Фин3,
					Выборка.Ссылка,
					"Ошибка при удалении: " + ОписаниеОшибки()
				);
			КонецПопытки;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации(
			"УдалениеПомеченныхФин3",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.Фин3,
			,
			"Ошибка выполнения запроса: " + ОписаниеОшибки()
		);
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ВыполнитьУдалениеФин3ПоДедлайну(ДатаДедлайна = Неопределено) Экспорт
	// Устанавливаем значение по умолчанию, если параметр не передан
	Если ДатаДедлайна = Неопределено Тогда
		ДатаДедлайна = КонецДня(Дата(2025, 12, 01));
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		"УдалениеФин3ПоДедлайну.Отладка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Начало выполнения процедуры ВыполнитьУдалениеФин3ПоДедлайну, ДатаДедлайна: " 
			+ Формат(ДатаДедлайна, "ДФ=dd.MM.yyyy HH:mm:ss")
	);
	
	Попытка
		ПометитьНаУдалениеФин3(ДатаДедлайна);
		УдалитьПомеченныеФин3();
		
		ЗаписьЖурналаРегистрации(
			"УдалениеФин3ПоДедлайну",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Завершение выполнения"
		);
	Исключение
		ЗаписьЖурналаРегистрации(
			"УдалениеФин3ПоДедлайну",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка выполнения: " + ОписаниеОшибки()
		);
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ВыполнитьУдалениеНаСервере(ДатаДедлайна, ТекстСообщения) Экспорт
	// Логируем начало выполнения
	ЗаписьЖурналаРегистрации(
		"УдалениеФин3.Отладка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Начало выполнения удаления, Простодата: " 
			+ Формат(ДатаДедлайна, "ДФ=dd.MM.yyyy")
	);
	
	Попытка
		ЗаписьЖурналаРегистрации(
			"УдалениеФин3.Отладка",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Вызов процедуры АвтоматическоеУдаление.ВыполнитьУдалениеФин3ПоДедлайну с датой: " 
				+ Формат(ДатаДедлайна, "ДФ=dd.MM.yyyy")
		);
		ВыполнитьУдалениеФин3ПоДедлайну(ДатаДедлайна);
		ЗаписьЖурналаРегистрации(
			"УдалениеФин3.Отладка",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения
		);
		Сообщить(ТекстСообщения);
	Исключение
		ЗаписьЖурналаРегистрации(
			"УдалениеФин3.Отладка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка при выполнении удаления: " + ОписаниеОшибки()
		);
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры