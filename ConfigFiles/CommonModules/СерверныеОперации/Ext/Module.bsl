  // Общий модуль СерверныеОперации

Процедура ВыполнитьУдалениеНаСервере(ДатаДедлайна, ТекстСообщения) Экспорт
	// Логируем начало выполнения
	ЗаписьЖурналаРегистрации(
		"УдалениеПродаж.Отладка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Начало выполнения удаления, Простодата: " 
			+ Формат(ДатаДедлайна, "ДФ=dd.MM.yyyy")
	);
	
	Попытка
		ЗаписьЖурналаРегистрации(
			"УдалениеПродаж.Отладка",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Вызов процедуры АвтоматическоеУдаление.ВыполнитьУдалениеПродажиПоДедлайну с датой: " 
				+ Формат(ДатаДедлайна, "ДФ=dd.MM.yyyy")
		);
		АвтоматическоеУдаление.ВыполнитьУдалениеПродажиПоДедлайну(ДатаДедлайна);
		ЗаписьЖурналаРегистрации(
			"УдалениеПродаж.Отладка",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения
		);
		Сообщить(ТекстСообщения);
	Исключение
		ЗаписьЖурналаРегистрации(
			"УдалениеПродаж.Отладка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка при выполнении удаления: " + ОписаниеОшибки()
		);
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры