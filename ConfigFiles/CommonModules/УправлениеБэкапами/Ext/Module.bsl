Процедура СделатьБэкап() Экспорт

    // Каталог базы данных (для файловой версии)
    КаталогИБ = Константы.КаталогИБ.Получить(); // Нужно создать константу с путем

    // Проверяем, указана ли директория базы
    Если ПустаяСтрока(КаталогИБ) Тогда
        ЗаписьЖурналаРегистрации("Ошибка: не указан каталог ИБ!", "Создание резервной копии");
        Сообщить("Ошибка: не указан каталог ИБ!");
        Возврат;
    КонецЕсли;

    ПутьККаталогу = ПолучитьКаталогВременныхФайлов() + "Backups\"; // Или константа
    ИмяФайла = Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".zip";
    ПутьКФайлу = ПутьККаталогу + ИмяФайла;

    // Проверяем существование каталога и создаем его при необходимости
    Если НЕ КаталогСуществует(ПутьККаталогу) Тогда  // Исправлено!
        СоздатьКаталог(ПутьККаталогу);
    КонецЕсли;

    Попытка
        ЗаписьЖурналаРегистрации("Начало создания резервной копии", "Создание резервной копии");

        Архив = Новый ЗаписьZipФайла;
        Архив.Открыть(ПутьКФайлу);
        Архив.ДобавитьФайлыИзКаталога(КаталогИБ, "*.*", Истина);
        Архив.Закрыть();

        РазмерАрхива = РазмерФайла(ПутьКФайлу);
        ЗаписьЖурналаРегистрации("Резервная копия успешно создана", "Создание резервной копии", "",  "", "", РазмерАрхива);
        Сообщить("Резервная копия успешно создана: " + ПутьКФайлу + " (Размер: " + Формат(РазмерАрхива / 1024, "ЧД=15;ДФ=0") + " Кб)");
    Исключение
        ЗаписьЖурналаРегистрации("Ошибка создания резервной копии", "Создание резервной копии", "",  "", "", ОписаниеОшибки());
        Сообщить("Ошибка при создании резервной копии: " + ОписаниеОшибки() + " (Код ошибки: " + ПолучитьКодОшибки() + ")");
    КонецПопытки;

КонецПроцедуры