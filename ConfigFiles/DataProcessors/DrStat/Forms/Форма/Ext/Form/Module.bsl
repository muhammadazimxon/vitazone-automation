// Объявляем переменную в начале модуля формы
Перем ТокенAPI Экспорт;

// Клиентская процедура
&НаКлиенте
Процедура Сформировать(Команда)
    ДанныеОбъекта = Новый Структура;
    ДанныеОбъекта.Вставить("Дата1", Объект.Дата1);
    ДанныеОбъекта.Вставить("Дата2", КонецДня(Объект.Дата2));
    ДанныеОбъекта.Вставить("Номенклатура", ПолучимНаименованиюНоменклатуры(Объект.Номенклатура));
    ДанныеОбъекта.Вставить("ЮзерАйди", ПолучимЮзерАйди(Объект.МП));
    
    ПолучитьДанныеПоAPI(ДанныеОбъекта);
    Элементы.Результаты.Обновить();
КонецПроцедуры

// При изменении поля МП
&НаКлиенте
Процедура МППриИзменении(Элемент)
    Если НЕ ПустаяСтрока(Объект.МП) Тогда
        Объект.ЮзерАйди = ПолучимЮзерАйди(Объект.МП);
    Иначе
        Объект.ЮзерАйди = 0;
    КонецЕсли;
КонецПроцедуры

// Серверная процедура
&НаСервере
Процедура ПолучитьДанныеПоAPI(ДанныеОбъекта)
    Если ТокенAPI = Неопределено Или Не ЗначениеЗаполнено(ТокенAPI) Тогда
        ТокенAPI = ПолучитьТокенАвторизации();
    КонецЕсли;
    
    ДанныеЗапроса = Новый Структура;
    ДанныеЗапроса.Вставить("fromDate", Формат(ДанныеОбъекта.Дата1, "ДФ='yyyy-MM-ddTHH:mm:ss'"));
    ДанныеЗапроса.Вставить("toDate", Формат(ДанныеОбъекта.Дата2, "ДФ='yyyy-MM-ddTHH:mm:ss'"));
    
    Если ЗначениеЗаполнено(ДанныеОбъекта.Номенклатура) Тогда
        ДанныеЗапроса.Вставить("medicineName", ДанныеОбъекта.Номенклатура); // Уже строка
    КонецЕсли;
    Если ЗначениеЗаполнено(ДанныеОбъекта.ЮзерАйди) Тогда
        ДанныеЗапроса.Вставить("userId", ДанныеОбъекта.ЮзерАйди); // Числовое значение
    КонецЕсли;
    
    // Отладочный вывод для проверки
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеЗапроса);
	Сообщить("Отправляемый запрос: " + ЗаписьJSON.Закрыть());
    
    Результат = ВыполнитьЗапросКAPI(ТокенAPI, ДанныеЗапроса);
    
    Если Результат.Успех Тогда
        ОбработатьПолученныеДанные(Результат.Данные);
    Иначе
        Сообщить("Ошибка при выполнении запроса: " + Результат.ТекстОшибки);
    КонецЕсли;
КонецПроцедуры

// Функция для получения токена авторизации
&НаСервере
Функция ПолучитьТокенАвторизации()
    HTTPСоединение = Новый HTTPСоединение("84.54.116.154", 8080,,,,,);
    
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    
    ТелоЗапроса = "{
    |""username"": ""998977716381"",
    |""password"": ""051093""
    |}";
    
    Запрос = Новый HTTPЗапрос("/authenticate", Заголовки);
    Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
    
    Ответ = HTTPСоединение.ОтправитьДляОбработки(Запрос);
    
    Если Ответ.КодСостояния = 200 Тогда
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
        Возврат Данные.token;
    Иначе
        ВызватьИсключение "Ошибка получения токена: " + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;
КонецФункции

// Функция для выполнения запроса к API
&НаСервере
Функция ВыполнитьЗапросКAPI(Токен, ДанныеЗапроса)
    Результат = Новый Структура("Успех, Данные, ТекстОшибки", Ложь, Неопределено, "");
    
    HTTPСоединение = Новый HTTPСоединение("213.230.69.180", 8080,,,,,);
    
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Заголовки.Вставить("Authorization", "Bearer " + Токен);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеЗапроса);
    ТелоЗапроса = ЗаписьJSON.Закрыть();
    
    Запрос = Новый HTTPЗапрос("/api/v1/summary", Заголовки);
    Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
    
    Попытка
        Ответ = HTTPСоединение.ОтправитьДляОбработки(Запрос);
        
        Если Ответ.КодСостояния = 200 Тогда
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
            Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
            ЧтениеJSON.Закрыть();
            
            Результат.Успех = Истина;
            Результат.Данные = Данные;
        ИначеЕсли Ответ.КодСостояния = 401 Тогда
            ТокенAPI = ПолучитьТокенАвторизации();
            Заголовки["Authorization"] = "Bearer " + ТокенAPI;
            Запрос = Новый HTTPЗапрос("/api/v1/summary", Заголовки);
            Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
            Ответ = HTTPСоединение.ОтправитьДляОбработки(Запрос);
            
            Если Ответ.КодСостояния = 200 Тогда
                ЧтениеJSON = Новый ЧтениеJSON;
                ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
                Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
                ЧтениеJSON.Закрыть();
                
                Результат.Успех = Истина;
                Результат.Данные = Данные;
            Иначе
                Результат.ТекстОшибки = "Код состояния: " + Ответ.КодСостояния + ". " + Ответ.ПолучитьТелоКакСтроку();
            КонецЕсли;
        Иначе
            Результат.ТекстОшибки = "Код состояния: " + Ответ.КодСостояния + ". " + Ответ.ПолучитьТелоКакСтроку();
        КонецЕсли;
    Исключение
        Результат.ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;
    
    Возврат Результат;
КонецФункции

// Процедура обработки полученных данных
// Процедура обработки полученных данных с фильтрацией
&НаСервере
Процедура ОбработатьПолученныеДанные(Данные)
    Объект.Результаты.Очистить();
    
    НоменклатураФильтр = ПолучимНаименованиюНоменклатуры(Объект.Номенклатура);
    ЮзерАйдиФильтр = ПолучимЮзерАйди(Объект.МП);
    
    Для Каждого Элемент Из Данные Цикл
        // Проверяем фильтры
        Если (ЗначениеЗаполнено(НоменклатураФильтр) И Элемент["medicineName"] <> НоменклатураФильтр)
            Или (ЗначениеЗаполнено(ЮзерАйдиФильтр) И Элемент["userId"] <> ЮзерАйдиФильтр) Тогда
            Продолжить; // Пропускаем строки, не соответствующие фильтру
        КонецЕсли;
        
        НоваяСтрока = Объект.Результаты.Добавить();
        НоваяСтрока.Пользователь = ПолучимМП(Элемент["userId"]);
        НоваяСтрока.ВСервере = Элемент["userName"];
        НоваяСтрока.Идентификатор = Элемент["userId"];
        
        НоменклатураСсылка = ПолучимНоменклатуру(Элемент["medicineName"]);
        Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
            НоваяСтрока.Номенклатура = НоменклатураСсылка;
        Иначе
            НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
        КонецЕсли;
        
        НоваяСтрока.Количество = Элемент["count"];
        НоваяСтрока.ИтоговыеЦели = Элемент["totalGoals"];
    КонецЦикла;
КонецПроцедуры

// Функция получения ЮзерАйди по менеджеру
&НаСервере
Функция ПолучимЮзерАйди(МП)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.ЮзерАйди КАК ЮзерАйди
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.Ссылка = &МП";
    
    Запрос.УстановитьПараметр("МП", МП);
    РезультатЗапроса = Запрос.Выполнить();
    
    Выборка = РезультатЗапроса.Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.ЮзерАйди;
    Иначе
        Возврат 0;
    КонецЕсли;
КонецФункции

// Функция получения менеджера по ЮзерАйди
&НаСервере
Функция ПолучимМП(ЮзерАйди)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.ЮзерАйди = &ЮзерАйди";
    
    Запрос.УстановитьПараметр("ЮзерАйди", ЮзерАйди);
    РезультатЗапроса = Запрос.Выполнить();
    
    Выборка = РезультатЗапроса.Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    Иначе
        Возврат Справочники.Менеджер.ПустаяСсылка();
    КонецЕсли;
КонецФункции

// Функция получения номенклатуры
&НаСервере
Функция ПолучимНоменклатуру(Номенклатура)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Номенклатура.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |	Номенклатура.Наименование = &Номенклатура";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    РезультатЗапроса = Запрос.Выполнить();
    
    Выборка = РезультатЗапроса.Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    Иначе
        Возврат Справочники.Номенклатура.ПустаяСсылка();
    КонецЕсли;
КонецФункции

// Функция получения наименования номенклатуры
&НаСервере
Функция ПолучимНаименованиюНоменклатуры(Номенклатура)
    Если Не ЗначениеЗаполнено(Номенклатура) Тогда
        Возврат "";
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Номенклатура.Наименование КАК Наименование
        |ИЗ
        |	Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |	Номенклатура.Ссылка = &Номенклатура";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    РезультатЗапроса = Запрос.Выполнить();
    
    Выборка = РезультатЗапроса.Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Наименование;
    Иначе
        Возврат "";
    КонецЕсли;
КонецФункции


