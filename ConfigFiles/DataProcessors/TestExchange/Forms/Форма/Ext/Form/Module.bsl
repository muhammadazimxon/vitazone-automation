



#Область ПрограммныйИнтерфейс

// Процедура для выгрузки данных (используется в рабочей базе)
Процедура ВыгрузитьДанные() Экспорт
    УзелОбмена = ПланыОбмена.ОбменДокументами.НайтиПоКоду("ПБ"); // Код узла пустой базы
    Если УзелОбмена.Пустая() Тогда
        Сообщить("Узел обмена не найден!");
        Возврат;
    КонецЕсли;

	
	 	
	
	
    // Пример: выгрузка справочника "Номенклатура"
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
	 |	Номенклатура.Ссылка КАК Ссылка,
	 |	Номенклатура.ВерсияДанных КАК ВерсияДанных,
	 |	Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
	 |	Номенклатура.Код КАК Код,
	 |	Номенклатура.Наименование КАК Наименование,
	 |	Номенклатура.Производитель КАК Производитель,
	 |	Номенклатура.Бонус КАК Бонус,
	 |	Номенклатура.ЕдИзм КАК ЕдИзм,
	 |	Номенклатура.АктуальнаяПартия КАК АктуальнаяПартия,
	 |	Номенклатура.Рефлет КАК Рефлет,
	 |	Номенклатура.Сертификаты КАК Сертификаты,
	 |	Номенклатура.Предопределенный КАК Предопределенный,
	 |	Номенклатура.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	 |ИЗ
	 |	Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   НЕ Номенклатура.ПометкаУдаления
    |   И Номенклатура.ЭтоГруппа = ЛОЖЬ";
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    // Путь для файлового обмена (замените на свой, если используете сетевую папку)
    ПутьКФайлу = "\\192.168.1.240\52024052 — копия\ExchangeData.xml";

    // Выгрузка данных
    ПланыОбмена.ВыгрузитьИзменения(УзелОбмена, ПутьКФайлу);
    Сообщить("Данные выгружены в " + ПутьКФайлу);
КонецПроцедуры

// Процедура для загрузки данных (используется в пустой базе)
Процедура ЗагрузитьДанные() Экспорт
    УзелОбмена = ПланыОбмена.ПустаяБаза.НайтиПоКоду("РБ"); // Код узла рабочей базы
    Если УзелОбмена.Пустая() Тогда
        Сообщить("Узел обмена не найден!");
        Возврат;
    КонецЕсли;

    // Путь для файлового обмена (замените на свой, если используете сетевую папку)
    ПутьКФайлу = "\\192.168.1.240\52024052 — копия\ExchangeData.xml";

    // Проверка наличия файла
    Если НайтиФайлы(ПутьКФайлу).Количество() = 0 Тогда
        Сообщить("Файл данных не найден: " + ПутьКФайлу);
        Возврат;
    КонецЕсли;

    // Загрузка данных
    ПланыОбмена.ЗагрузитьСообщениеОбмена(ПутьКФайлу, УзелОбмена);
    Сообщить("Данные загружены из " + ПутьКФайлу);
КонецПроцедуры

&НаКлиенте
Процедура ВыгурзитьДанные(Команда)
	ВыгрузитьДанные();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанные1(Команда)
	ЗагрузитьДанные();
КонецПроцедуры

#КонецОбласти