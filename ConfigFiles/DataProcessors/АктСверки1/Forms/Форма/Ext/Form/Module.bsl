	МассивСтрок = СтрРазделить(СтрокаСЧислом, "0123456789", Ложь);
	Для Каждого ТекСтрока из МассивСтрок Цикл 
		СтрокаСЧислом = СтрЗаменить(СтрокаСЧислом, ТекСтрока, "");
	КонецЦикла;
	
	Возврат Строка(СтрокаСЧислом);
КонецФункции

