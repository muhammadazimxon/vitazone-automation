&НаСервере
Функция НайтиКонтрагентаПоИНН(ИНН)
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Контрагенты.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |   Контрагенты.ИНН = &ИНН";
    
    Запрос.УстановитьПараметр("ИНН", ИНН);
    Результат = Запрос.Выполнить();
    
    Выборка = Результат.Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    Иначе
        Возврат Справочники.Контрагенты.ПустаяСсылка();
    КонецЕсли;
КонецФункции



&НаСервере
Функция ПолучитьДанныеИзРегистраДебиторка(Контрагент, ДатаНачала, ДатаОкончания)
    // 1. Проверяем наличие движений в регистре
    ЗапросПроверка = Новый Запрос;
    ЗапросПроверка.Текст = 
    "ВЫБРАТЬ
    |   Дебиторка.Период КАК Период,
    |   Дебиторка.ДокНомер КАК Документ,
    |   Дебиторка.ЗадолженностьСум КАК Сумма,
    |   Дебиторка.ВидДвижения КАК ВидДвижения
    |ИЗ
    |   РегистрНакопления.Дебиторка КАК Дебиторка
    |ГДЕ
    |   Дебиторка.Контрагенты = &Контрагент
    |   И Дебиторка.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Дебиторка.ЗадолженностьСум <> &ПустоеЗначение
    |УПОРЯДОЧИТЬ ПО
    |   Дебиторка.Период";
    
    ЗапросПроверка.УстановитьПараметр("Контрагент", Контрагент);
    ЗапросПроверка.УстановитьПараметр("ДатаНачала", ДатаНачала);
    ЗапросПроверка.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	ЗапросПроверка.УстановитьПараметр("ПустоеЗначение", 0);
    
    РезультатПроверка = ЗапросПроверка.Выполнить();
    Если РезультатПроверка.Пустой() Тогда
       // Сообщить("В регистре Дебиторка нет движений за период с " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));
    Иначе
       // Сообщить("Найдены движения в регистре Дебиторка:");
        ВыборкаПроверка = РезультатПроверка.Выбрать();
        Пока ВыборкаПроверка.Следующий() Цикл
         //   Сообщить("Дата: " + Формат(ВыборкаПроверка.Период, "ДФ=dd.MM.yyyy") + ", Документ: " + ВыборкаПроверка.Документ + ", Сумма: " + ВыборкаПроверка.Сумма + ", ВидДвижения: " + ВыборкаПроверка.ВидДвижения);
        КонецЦикла;
    КонецЕсли;
    
    // 2. Получаем начальный остаток на начало периода
    ЗапросОстатки = Новый Запрос;
    ЗапросОстатки.Текст = 
    "ВЫБРАТЬ
    |   ЕСТЬNULL(СУММА(ДебиторкаОстатки.ЗадолженностьСумОстаток), 0) КАК Остаток
    |ИЗ
    |   РегистрНакопления.Дебиторка.Остатки(&ДатаНачала, Контрагенты = &Контрагент) КАК ДебиторкаОстатки";
    
    ЗапросОстатки.УстановитьПараметр("Контрагент", Контрагент);
    ЗапросОстатки.УстановитьПараметр("ДатаНачала", ДатаНачала);
    
    РезультатОстатки = ЗапросОстатки.Выполнить();
    НачальныйОстаток = 0;
    ВыборкаОстатки = РезультатОстатки.Выбрать();
    Если ВыборкаОстатки.Следующий() Тогда
        НачальныйОстаток = ВыборкаОстатки.Остаток;
    КонецЕсли;
    
    // 3. Получаем обороты за период
    ЗапросОбороты = Новый Запрос;
    ЗапросОбороты.Текст = 
    "ВЫБРАТЬ
    |   Дебиторка.Период КАК Дата,
    |   Дебиторка.ДокНомер КАК Документ,
    |   ВЫБОР
    |       КОГДА Дебиторка.ДокНомер ЕСТЬ NULL
    |           ТОГДА """"
    |       ИНАЧЕ Дебиторка.ДокНомер.Наименование
    |   КОНЕЦ КАК Представление,
    |   ВЫБОР
    |       КОГДА Дебиторка.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
    |           ТОГДА Дебиторка.ЗадолженностьСум
    |       ИНАЧЕ 0
    |   КОНЕЦ КАК Дебет,
    |   ВЫБОР
    |       КОГДА Дебиторка.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
    |           ТОГДА Дебиторка.ЗадолженностьСум
    |       ИНАЧЕ 0
    |   КОНЕЦ КАК Кредит
    |ИЗ
    |   РегистрНакопления.Дебиторка КАК Дебиторка
    |ГДЕ
    |   Дебиторка.Контрагенты = &Контрагент
    |   И Дебиторка.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
    |УПОРЯДОЧИТЬ ПО
    |   Дебиторка.Период ВОЗР // Сортировка по убыванию даты
    |ИТОГИ
    |   СУММА(Дебет),
    |   СУММА(Кредит)
    |ПО
    |   ОБЩИЕ";
    
    ЗапросОбороты.УстановитьПараметр("Контрагент", Контрагент);
    ЗапросОбороты.УстановитьПараметр("ДатаНачала", ДатаНачала);
    ЗапросОбороты.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    
    РезультатОбороты = ЗапросОбороты.Выполнить();
    
    Данные = Новый Структура;
    СписокДокументов = Новый Массив;
    ОборотыДт = 0;
    ОборотыКт = 0;
    
    // Получаем общие итоги (суммарные обороты)
    ВыборкаИтоги = РезультатОбороты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ОБЩИЕ");
    Если ВыборкаИтоги.Следующий() Тогда
        ОборотыДт = ВыборкаИтоги.Дебет;
        ОборотыКт = ВыборкаИтоги.Кредит;
    КонецЕсли;
    
    // Получаем детальные записи
    Выборка = РезультатОбороты.Выбрать();
    Пока Выборка.Следующий() Цикл
        СтруктураЗаписи = Новый Структура;
        СтруктураЗаписи.Вставить("ДатаДокументаКонтр", Выборка.Дата);
        СтруктураЗаписи.Вставить("РегистраторПредставлениеКонтр", Выборка.Представление);
        СтруктураЗаписи.Вставить("СуммаОборотДтКонтр", Выборка.Дебет);
        СтруктураЗаписи.Вставить("СуммаОборотКтКонтр", Выборка.Кредит);
        СтруктураЗаписи.Вставить("СуммаОборотДтКонтрРегл", 0); // Нет валютного учета
        СтруктураЗаписи.Вставить("СуммаОборотКтКонтрРегл", 0);
        СписокДокументов.Добавить(СтруктураЗаписи);
    КонецЦикла;
    
    Данные.Вставить("НачальныйОстаток", НачальныйОстаток);
    Данные.Вставить("СписокДокументов", СписокДокументов);
    Данные.Вставить("ОборотыДт", ОборотыДт);
    Данные.Вставить("ОборотыКт", ОборотыКт);
    
    Возврат Данные;
КонецФункции




&НаКлиенте
Процедура РассчитатьСуммуВыделенногоДиапазона()
    ВыделеннаяОбласть = Элементы.ТабличныйДокумент.ТекущаяОбласть;
    
    Если ВыделеннаяОбласть = Неопределено Тогда
        Элементы.СуммаВыделенногоДиапазона.Заголовок = "Сумма: 0";
        ПредыдущийВерх = Неопределено;
        ПредыдущийНиз = Неопределено;
        ПредыдущийЛево = Неопределено;
        ПредыдущийПраво = Неопределено;
        Возврат;
    КонецЕсли;
    
    Верх  = ВыделеннаяОбласть.Верх;
    Низ   = ВыделеннаяОбласть.Низ;
    Лево  = ВыделеннаяОбласть.Лево;
    Право = ВыделеннаяОбласть.Право;
    
    Если ПредыдущийВерх = Верх И ПредыдущийНиз = Низ И ПредыдущийЛево = Лево И ПредыдущийПраво = Право Тогда
        Возврат;
    КонецЕсли;
    
    ПредыдущийВерх = Верх;
    ПредыдущийНиз = Низ;
    ПредыдущийЛево = Лево;
    ПредыдущийПраво = Право;
    
    Сумма = 0;
    ОбработанныеЯчейки = Новый Соответствие; // Для учета объединенных ячеек
    
    // Проходим по всем строкам и столбцам в выделенном диапазоне
    Для НомерСтроки = Верх По Низ Цикл
        Для НомерСтолбца = Лево По Право Цикл
            // Формируем ключ для проверки, чтобы не обрабатывать ячейку повторно
            КлючЯчейки = Формат(НомерСтроки, "ЧГ=0") + "_" + Формат(НомерСтолбца, "ЧГ=0");
            Если ОбработанныеЯчейки[КлючЯчейки] <> Неопределено Тогда
                Продолжить;
            КонецЕсли;
            
            Область = Элементы.ТабличныйДокумент.Область(НомерСтроки, НомерСтолбца);
            ЗначениеЯчейки = Область.Текст;
            
            Если ПустаяСтрока(ЗначениеЯчейки) Тогда
                Продолжить;
            КонецЕсли;
            
            Попытка
                ОчищенноеЗначение = СтрЗаменить(СтрЗаменить(ЗначениеЯчейки, Символ(160), ""), " ", "");
                ОчищенноеЗначение = СтрЗаменить(ОчищенноеЗначение, ",", ".");
                ЧисловоеЗначение = Число(ОчищенноеЗначение);
                Сумма = Сумма + ЧисловоеЗначение;
                
                // Обрабатываем объединенные ячейки
                Если Область.ВерхняяГраницаОбъединения <> Неопределено Тогда
                    Для СчСтрока = Область.ВерхняяГраницаОбъединения По Область.НижняяГраницаОбъединения Цикл
                        Для СчСтолбец = Область.ЛеваяГраницаОбъединения По Область.ПраваяГраницаОбъединения Цикл
                            Ключ = Формат(СчСтрока, "ЧГ=0") + "_" + Формат(СчСтолбец, "ЧГ=0");
                            ОбработанныеЯчейки.Вставить(Ключ, Истина);
                        КонецЦикла;
                    КонецЦикла;
                Иначе
                    ОбработанныеЯчейки.Вставить(КлючЯчейки, Истина);
                КонецЕсли;
            Исключение
                // Сообщить("Ошибка преобразования в число: " + ЗначениеЯчейки + ", Очищенное: " + ОчищенноеЗначение);
                Продолжить;
            КонецПопытки;
        КонецЦикла;
    КонецЦикла;
    
    Элементы.СуммаВыделенногоДиапазона.Заголовок = "Сумма: " + Формат(Сумма, "ЧДЦ=2; ЧРД=','; ЧРГ=' '");
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизации(Элемент)
    РассчитатьСуммуВыделенногоДиапазона();
КонецПроцедуры
