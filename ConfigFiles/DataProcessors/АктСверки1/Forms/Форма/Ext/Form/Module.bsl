&НаКлиенте
Процедура СформироватьОтчет(Команда)
ИНН = СтрЗаменить(ПолучитьИНН(), Символ(160), "");
ИНН = СтрЗаменить(ИНН, " ", ""); // Удаляем обычные пробелы
КонтрагентКом = ПодключениеКБазе.Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);
	//Сообщить("Ищем этот ИНН: " + ПолучитьИНН(), СтатусСообщения.Важное);
	Если КонтрагентКом.Пустая() Тогда
		Сообщить("Контрагент в бухгалтерской базе не найден");
		Возврат;
	КонецЕсли;
	Если НЕ (Объект.Покупатель ИЛИ Объект.Поставщик) Тогда
		Сообщить("Выберите хотя бы одну галочку (Поставщик|Покупатель");
		Возврат;
	КонецЕсли;
	
	Рандом = Новый ГенераторСлучайныхЧисел;
	Состояние("Формирование акт сверки",Рандом.СлучайноеЧисло(0,20));
	ДокументАктСверка = СоздатьДокументАктСверки(КонтрагентКом);
	Состояние("Формирование акт сверки",Рандом.СлучайноеЧисло(40,60));
	Структура = СобратьДанныедляАктСверки(ПодключениеКБазе,ДокументАктСверка.Ссылка);
	Состояние("Формирование акт сверки",Рандом.СлучайноеЧисло(80,99));
	ПолеТабличногоДокумента = ПечатьАктаСверки(Структура);
	Состояние("Формирование акт сверки",100);
	
	ДокументАктСверка.Удалить();
	
КонецПроцедуры


&НаКлиенте
Функция СоздатьДокументАктСверки(Контрагент)
    
    мВалютаРегламентированногоУчета = ПодключениеКБазе.Константы.ВалютаРегламентированногоУчета.Получить();
    ДокументАктСверка = ПодключениеКБазе.Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();
    ДокументАктСверка.Дата = ТекущаяДата();
    ПодключениеКБазе.ОбщегоНазначения.ЗаполнитьШапкуДокумента(ДокументАктСверка.ThisObject, ПодключениеКБазе.Справочники.Пользователи.НайтиПоНаименованию("Администратор"), мВалютаРегламентированногоУчета);
    //Заполнить таблицу счетов значениями по умолчанию
    ЗаполнитьСписокСчетовЗначениямиПоУмолчанию(ПодключениеКБазе, ДокументАктСверка);
    ДокументАктСверка.СверкаСогласована = Ложь;
    ДокументАктСверка.ДатаОкончания = КонецДня(Объект.КонецПериода);
    // Устанавливаем ДатаНачала строго из параметров
    ДокументАктСверка.ДатаНачала = НачалоДня(Объект.НачалоПериода); // Используем НачалоДня для точности
    
    ДокументАктСверка.Контрагент = Контрагент;
    
    //ПодключениеКБазе.УправлениеВзаиморасчетами.ПриИзмененииЗначенияКонтрагента(ДокументАктСверка.ThisObject);
    ДокументАктСверка.ПредставительКонтрагента = ДокументАктСверка.Контрагент.ОсновноеКонтактноеЛицо;
    
    ФильтрСписокСчетов = ПодключениеКБазе.NewObject("Массив");
    Для каждого СтрокаСчета Из ДокументАктСверка.СписокСчетов Цикл
        Если НЕ ПодключениеКБазе.ЗначениеЗаполнено(СтрокаСчета.Счет) или СтрокаСчета.УчаствуетВРасчетах = Ложь Тогда
            Продолжить;
        Иначе
            ФильтрСписокСчетов.Добавить(СтрокаСчета.Счет);
        КонецЕсли; 
    КонецЦикла;
    
    ДокументАктСверка.ОстаткиПоДоговорам.Очистить();
    
    ДокументАктСверка.ЗаполнитьПоДаннымБухгалтерскогоУчета(ФильтрСписокСчетов);
    ДокументАктСверка.ЗаполнитьПоДаннымОрганизации();
    
    ДокументАктСверка.Записать();
    
    Возврат ДокументАктСверка;
КонецФункции // СоздатьДокументАктСверки()




