Процедура ПолучитьОстаткиЧерезCOM(ДатаОстатков, НоменклатураНаименование = "") Экспорт
    
   // //Сообщить("Начало получения остатков через COM...");
    
    // Строка подключения
    СтрокаПодключения = "Srvr='192.168.1.240';Ref='hed2021';Usr='Sherzod';Pwd='1';";
    //Сообщить("Попытка подключения к основной базе: " + СтрокаПодключения);
    
    // Подключение через COM
    Попытка
        COMОбъект = Новый COMОбъект("V83.COMConnector");
        Соединение = COMОбъект.Connect(СтрокаПодключения);
      //  //Сообщить("Подключение к основной базе успешно установлено!");
    Исключение
        //Сообщить("Ошибка подключения: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    
    // Нормализуем наименование номенклатуры для фильтрации
    НоменклатураНаименованиеПоиск = ВРег(СокрЛП(НоменклатураНаименование));
  //  //Сообщить("Нормализованное наименование для поиска: " + НоменклатураНаименованиеПоиск);
    
    // Запрос к регистру
 //   //Сообщить("Формирование запроса к регистру ТоварыНаСкладах...");
    Запрос = Соединение.NewObject("Запрос");
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ТоварыНаСкладахОстатки.Номенклатура.Наименование КАК НоменклатураНаименование,
        |	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК ВНаличии,
        |	ТоварыНаСкладахОстатки.КОтгрузкеОстаток КАК КОтгрузке
        |ИЗ
        |	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, ) КАК ТоварыНаСкладахОстатки";
    
    // Устанавливаем параметры запроса
    Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
    //Сообщить("Параметры запроса: Дата = " + Формат(ДатаОстатков, "ДЛФ=Д") + ", Номенклатура = " + ?(ПустаяСтрока(НоменклатураНаименование), "не указана", НоменклатураНаименование));
    
    // Выполняем запрос
  //  //Сообщить("Выполнение запроса...");
    Результат = Запрос.Выполнить();
    
    // Проверяем, есть ли данные
 //   //Сообщить("Проверка наличия данных...");
    Если Результат.Пустой() Тогда
        //Сообщить("Нет данных для формирования отчета на дату " + Формат(ДатаОстатков, "ДЛФ=Д") + "!");
        // Дополнительно проверим, какие номенклатуры есть в базе
        //Сообщить("Проверка всех номенклатур в регистре на указанную дату...");
        ЗапросВсеНоменклатуры = Соединение.NewObject("Запрос");
        ЗапросВсеНоменклатуры.Текст = 
            "ВЫБРАТЬ РАЗЛИЧНЫЕ
            |	ТоварыНаСкладахОстатки.Номенклатура.Наименование КАК НоменклатураНаименование
            |ИЗ
            |	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, ) КАК ТоварыНаСкладахОстатки";
        ЗапросВсеНоменклатуры.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
        РезультатВсеНоменклатуры = ЗапросВсеНоменклатуры.Выполнить();
        Если РезультатВсеНоменклатуры.Пустой() Тогда
            //Сообщить("В регистре ТоварыНаСкладах нет данных на дату " + Формат(ДатаОстатков, "ДЛФ=Д") + "!");
        Иначе
            //Сообщить("Список номенклатур в регистре на дату " + Формат(ДатаОстатков, "ДЛФ=Д") + ":");
            ВыборкаВсеНоменклатуры = РезультатВсеНоменклатуры.Выбрать();
            Пока ВыборкаВсеНоменклатуры.Следующий() Цикл
                //Сообщить("- " + ВыборкаВсеНоменклатуры.НоменклатураНаименование);
            КонецЦикла;
        КонецЕсли;
        COMОбъект = Неопределено;
        Соединение = Неопределено;
   //     //Сообщить("Завершение получения остатков через COM.");
        Возврат;
    КонецЕсли;
    
  //  //Сообщить("Данные найдены, обработка выборки...");
    Выборка = Результат.Выбрать();
    
    // Обработка данных
    КоличествоЗаписей = 0;
    КоличествоПодходящихЗаписей = 0;
    Пока Выборка.Следующий() Цикл
        КоличествоЗаписей = КоличествоЗаписей + 1;
     //   //Сообщить("Обработка записи #" + КоличествоЗаписей + ": Номенклатура = " + Выборка.НоменклатураНаименование + ", В наличии = " + Выборка.ВНаличии + ", К отгрузке = " + Выборка.КОтгрузке);
        
        // Нормализуем наименование из выборки
        НоменклатураНаименованиеПоискИзВыборки = ВРег(СокрЛП(Выборка.НоменклатураНаименование));
      //  //Сообщить("Нормализованное наименование из выборки: " + НоменклатураНаименованиеПоискИзВыборки);
        
        // Проверяем, подходит ли запись по наименованию
        Если НЕ ПустаяСтрока(НоменклатураНаименование) Тогда
            Если НоменклатураНаименованиеПоискИзВыборки <> НоменклатураНаименованиеПоиск Тогда
                //Сообщить("Запись не подходит по наименованию: " + НоменклатураНаименованиеПоискИзВыборки + " <> " + НоменклатураНаименованиеПоиск);
                Продолжить;
            КонецЕсли;
        КонецЕсли;
        
        КоличествоПодходящихЗаписей = КоличествоПодходящихЗаписей + 1;
        
        // Ищем номенклатуру по наименованию в текущей базе
        НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(НоменклатураНаименованиеПоискИзВыборки, Истина);
        Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
            //Сообщить("Точное совпадение не найдено, выполняем поиск с нормализацией...");
            НоменклатураСсылка = Неопределено;
            ВыборкаНоменклатуры = Справочники.Номенклатура.Выбрать();
            Пока ВыборкаНоменклатуры.Следующий() Цикл
                Если ВРег(СокрЛП(ВыборкаНоменклатуры.Наименование)) = НоменклатураНаименованиеПоискИзВыборки Тогда
                    НоменклатураСсылка = ВыборкаНоменклатуры.Ссылка;
                  //  //Сообщить("Номенклатура найдена: " + НоменклатураСсылка);
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        Иначе
          //  //Сообщить("Номенклатура найдена: " + НоменклатураСсылка);
        КонецЕсли;
        
        Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
        //    //Сообщить("Номенклатура с наименованием '" + Выборка.НоменклатураНаименование + "' не найдена в текущей базе!");
            Продолжить;
        КонецЕсли;
        
        // Выводим информацию о номенклатуре и остатках
    //    //Сообщить("Номенклатура: " + НоменклатураСсылка + ", В наличии: " + Выборка.ВНаличии + ", К отгрузке: " + Выборка.КОтгрузке);
    КонецЦикла;
    
    // Проверяем, были ли обработаны записи
  //  //Сообщить("Всего записей: " + КоличествоЗаписей + ", Подходящих записей: " + КоличествоПодходящихЗаписей);
    Если КоличествоПодходящихЗаписей = 0 Тогда
        //Сообщить("Ни одной записи не подходит по наименованию!");
        // Выводим список всех номенклатур
        ЗапросВсеНоменклатуры = Соединение.NewObject("Запрос");
        ЗапросВсеНоменклатуры.Текст = 
            "ВЫБРАТЬ РАЗЛИЧНЫЕ
            |	ТоварыНаСкладахОстатки.Номенклатура.Наименование КАК НоменклатураНаименование
            |ИЗ
            |	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, ) КАК ТоварыНаСкладахОстатки";
        ЗапросВсеНоменклатуры.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
        РезультатВсеНоменклатуры = ЗапросВсеНоменклатуры.Выполнить();
        Если НЕ РезультатВсеНоменклатуры.Пустой() Тогда
            //Сообщить("Список номенклатур в регистре на дату " + Формат(ДатаОстатков, "ДЛФ=Д") + ":");
            ВыборкаВсеНоменклатуры = РезультатВсеНоменклатуры.Выбрать();
            Пока ВыборкаВсеНоменклатуры.Следующий() Цикл
                //Сообщить("- " + ВыборкаВсеНоменклатуры.НоменклатураНаименование);
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;
    
    // Закрытие соединения
    COMОбъект = Неопределено;
    Соединение = Неопределено;
   // //Сообщить("Завершение получения остатков через COM.");
    
КонецПроцедуры

Функция СформироватьОтчетЧерезCOM(ДатаОстатков, НоменклатураНаименование = "") Экспорт
    
 //   //Сообщить("Начало формирования отчета через COM...");
    
    // Устанавливаем дату на конец дня
    ДатаОстатковКонецДня = КонецДня(ДатаОстатков);
  //  //Сообщить("Дата остатков: " + Формат(ДатаОстатковКонецДня, "ДЛФ=ДВ"));
    
    // Строка подключения
    СтрокаПодключения = "Srvr='192.168.1.240';Ref='hed2021';Usr='Sherzod';Pwd='1';";
   // //Сообщить("Попытка подключения: " + СтрокаПодключения);
    
    // Подключение
    Попытка
        COMОбъект = Новый COMОбъект("V83.COMConnector");
        Соединение = COMОбъект.Connect(СтрокаПодключения);
   //     //Сообщить("Подключение успешно!");
    Исключение
        //Сообщить("Ошибка подключения: " + ОписаниеОшибки());
        Возврат Новый ТабличныйДокумент;
    КонецПопытки;
    
    // Нормализация наименования
    НоменклатураНаименованиеПоиск = ВРег(СокрЛП(НоменклатураНаименование));
 //   //Сообщить("Поиск по: " + НоменклатураНаименованиеПоиск);
    
    // Запрос к основной базе
    Запрос = Соединение.NewObject("Запрос");
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ТоварыНаСкладахОстатки.Номенклатура.Наименование КАК НоменклатураНаименование,
        |	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК ВНаличии,
        |	ТоварыНаСкладахОстатки.КОтгрузкеОстаток КАК КОтгрузке
        |ИЗ
        |	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, ) КАК ТоварыНаСкладахОстатки";
    
    Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатковКонецДня);
    
    // Локальный запрос
    ЗапросЛокальный = Новый Запрос;
    ЗапросЛокальный.Текст = 
        "ВЫБРАТЬ
        |	СкладыОстатки.Номенклатура КАК Номенклатура,
        |	СкладыОстатки.КолВоОстаток КАК КолВо
        |ИЗ
        |	РегистрНакопления.Склады.Остатки(&ДатаОстатков, ) КАК СкладыОстатки";
    ЗапросЛокальный.УстановитьПараметр("ДатаОстатков", ДатаОстатковКонецДня);
    
    Результат = Запрос.Выполнить();
    РезультатЛокальный = ЗапросЛокальный.Выполнить();
    
    // Создание таблицы отчета
    ТаблицаОтчета = Новый ТаблицаЗначений;
    ТаблицаОтчета.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    ТаблицаОтчета.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(150)));
    ТаблицаОтчета.Колонки.Добавить("ОстаткиУТ", Новый ОписаниеТипов("Число"));
    ТаблицаОтчета.Колонки.Добавить("КОтгрузкеУТ", Новый ОписаниеТипов("Число"));
    ТаблицаОтчета.Колонки.Добавить("Наш1С", Новый ОписаниеТипов("Число"));
    ТаблицаОтчета.Колонки.Добавить("Разница", Новый ОписаниеТипов("Число"));
    
    // Обработка данных основной базы
    Если НЕ Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            НоменклатураНаименованиеПоискИзВыборки = ВРег(СокрЛП(Выборка.НоменклатураНаименование));
            Если НЕ ПустаяСтрока(НоменклатураНаименование) И НоменклатураНаименованиеПоискИзВыборки <> НоменклатураНаименованиеПоиск Тогда
                Продолжить;
            КонецЕсли;
            
            НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(НоменклатураНаименованиеПоискИзВыборки, Истина);
            Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                //Сообщить("Номенклатура '" + Выборка.НоменклатураНаименование + "' не найдена!");
                Продолжить;
            КонецЕсли;
            
            НоваяСтрока = ТаблицаОтчета.Добавить();
            НоваяСтрока.Номенклатура = НоменклатураСсылка;
            НоваяСтрока.Наименование = Выборка.НоменклатураНаименование;
            НоваяСтрока.ОстаткиУТ = Выборка.ВНаличии;
            НоваяСтрока.КОтгрузкеУТ = Выборка.КОтгрузке;
            НоваяСтрока.Разница = НоваяСтрока.ОстаткиУТ - НоваяСтрока.Наш1С;
        КонецЦикла;
    КонецЕсли;
    
    // Обработка локальной базы
    Если НЕ РезультатЛокальный.Пустой() Тогда
        ВыборкаЛокальная = РезультатЛокальный.Выбрать();
        Пока ВыборкаЛокальная.Следующий() Цикл
            НайденныеСтроки = ТаблицаОтчета.НайтиСтроки(Новый Структура("Номенклатура", ВыборкаЛокальная.Номенклатура));
            Если НайденныеСтроки.Количество() > 0 Тогда
                НайденныеСтроки[0].Наш1С = ВыборкаЛокальная.КолВо;
                НайденныеСтроки[0].Разница = НайденныеСтроки[0].ОстаткиУТ - НайденныеСтроки[0].Наш1С;
            Иначе
                НоваяСтрока = ТаблицаОтчета.Добавить();
                НоваяСтрока.Номенклатура = ВыборкаЛокальная.Номенклатура;
                НоваяСтрока.Наименование = Строка(ВыборкаЛокальная.Номенклатура);
                НоваяСтрока.Наш1С = ВыборкаЛокальная.КолВо;
                НоваяСтрока.ОстаткиУТ = 0;
                НоваяСтрока.КОтгрузкеУТ = 0;
                НоваяСтрока.Разница = НоваяСтрока.ОстаткиУТ - НоваяСтрока.Наш1С;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    ТаблицаОтчета.Сортировать("Наименование Возр");
    
    // Формирование красивого отчета
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ИмяПараметровПечати = "Отчет_Остатки_" + Формат(ДатаОстатковКонецДня, "ДФ=ddMMyyyy");
    
    // Заголовок отчета (только в первой колонке)
    ОбластьЗаголовок = ТабДок.ПолучитьОбласть(1, 1, 1, 1); // Уменьшаем область до одной колонки
    ОбластьЗаголовок.Область(1, 1).Текст = "Отчет по остаткам на конец " + Формат(ДатаОстатковКонецДня, "ДЛФ=DD");
    ОбластьЗаголовок.Область(1, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);
    ОбластьЗаголовок.Область(1, 1).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево; // Выравнивание по левому краю
    ТабДок.Вывести(ОбластьЗаголовок);
    
    // Шапка таблицы
    ОбластьШапка = ТабДок.ПолучитьОбласть(3, 1, 3, 5);
    ОбластьШапка.Область(1, 1).Текст = "Номенклатура";
    ОбластьШапка.Область(1, 2).Текст = "Остатки УТ";
    ОбластьШапка.Область(1, 3).Текст = "К отгрузке УТ";
    ОбластьШапка.Область(1, 4).Текст = "Наш 1С";
    ОбластьШапка.Область(1, 5).Текст = "Разница";
    
    // Форматирование шапки
    Для Колонка = 1 По 5 Цикл
        ОбластьШапка.Область(1, Колонка).Шрифт = Новый Шрифт("Arial", 10, Истина);
        ОбластьШапка.Область(1, Колонка).ЦветФона = WebЦвета.СветлоСерый;
        ОбластьШапка.Область(1, Колонка).ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
        ОбластьШапка.Область(1, Колонка).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
    КонецЦикла;
    
    // Установка ширины колонок
    ТабДок.Область(1, 1).ШиринаКолонки = 40;
    ТабДок.Область(1, 2).ШиринаКолонки = 15;
    ТабДок.Область(1, 3).ШиринаКолонки = 15;
    ТабДок.Область(1, 4).ШиринаКолонки = 15;
    ТабДок.Область(1, 5).ШиринаКолонки = 15;
    
    ТабДок.Вывести(ОбластьШапка);
    
    // Заполнение данными
    НомерСтроки = 4;
    Для Каждого СтрокаТаблицы Из ТаблицаОтчета Цикл
        ОбластьСтрока = ТабДок.ПолучитьОбласть(НомерСтроки, 1, НомерСтроки, 5);
        
        ОбластьСтрока.Область(1, 1).Текст = Строка(СтрокаТаблицы.Номенклатура);
        ОбластьСтрока.Область(1, 2).Текст = Формат(СтрокаТаблицы.ОстаткиУТ, "ЧН=0");
        ОбластьСтрока.Область(1, 3).Текст = Формат(СтрокаТаблицы.КОтгрузкеУТ, "ЧН=0");
        ОбластьСтрока.Область(1, 4).Текст = Формат(СтрокаТаблицы.Наш1С, "ЧН=0");
        ОбластьСтрока.Область(1, 5).Текст = Формат(СтрокаТаблицы.Разница, "ЧН=0");
        
        // Форматирование строки
        Для Колонка = 1 По 5 Цикл
            ОбластьСтрока.Область(1, Колонка).Шрифт = Новый Шрифт("Arial", 9);
            ОбластьСтрока.Область(1, Колонка).ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Точечная);
            Если Колонка > 1 Тогда
                ОбластьСтрока.Область(1, Колонка).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
            КонецЕсли;
        КонецЦикла;
        
        // Выделение отрицательной разницы
        Если СтрокаТаблицы.Разница < 0 Тогда
            ОбластьСтрока.Область(1, 5).ЦветТекста = WebЦвета.Красный;
        КонецЕсли;
        
        ТабДок.Вывести(ОбластьСтрока);
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    
    // Итоговая строка
    Если ТаблицаОтчета.Количество() > 0 Тогда
        ОбластьИтог = ТабДок.ПолучитьОбласть(НомерСтроки, 1, НомерСтроки, 5);
        ОбластьИтог.Область(1, 1).Текст = "Итого строк: " + ТаблицаОтчета.Количество();
        ОбластьИтог.Область(1, 1).Шрифт = Новый Шрифт("Arial", 9, Истина);
        ТабДок.Вывести(ОбластьИтог);
    КонецЕсли;
    
    // Настройки страницы
    ТабДок.АвтоМасштаб = Истина;
    ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
    ТабДок.ПолеСверху = 10;
    ТабДок.ПолеСнизу = 10;
    ТабДок.ПолеСлева = 10;
    ТабДок.ПолеСправа = 10;
    
  //  //Сообщить("Строк в отчете: " + ТаблицаОтчета.Количество());
    COMОбъект = Неопределено;
    Соединение = Неопределено;
  //  //Сообщить("Формирование отчета завершено.");
    
    Возврат ТабДок;
    
КонецФункции

&НаКлиенте
Процедура СформироватьОтчетНажатие(Команда)
    ////Сообщить("Нажата кнопка 'Сформировать отчет'...");
    
    // Проверяем, что параметры заполнены
    Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
        //Сообщить("Ошибка: Укажите дату остатков!");
        Возврат;
    КонецЕсли;
    
    // Получаем наименование выбранной номенклатуры
    НоменклатураНаименование = "";
    Если ЗначениеЗаполнено(Номенклатура) Тогда
        НоменклатураНаименование = ПолучитьНаименованиеНоменклатуры(Номенклатура);
       // //Сообщить("Выбрана номенклатура: " + Номенклатура + ", Наименование: " + НоменклатураНаименование);
    Иначе
       // //Сообщить("Номенклатура не выбрана, будут получены остатки по всем номенклатурам.");
    КонецЕсли;
    
   // //Сообщить("Параметры: Дата = " + Формат(ДатаОстатков, "ДЛФ=Д") + ", Номенклатура = " + ?(ПустаяСтрока(НоменклатураНаименование), "не указана", НоменклатураНаименование));
    
    // Вызываем серверную процедуру, передавая параметры
  //  //Сообщить("Вызов серверной процедуры СформироватьОтчетЧерезCOM...");
    ТабДок = СформироватьОтчетЧерезCOM(ДатаОстатков, НоменклатураНаименование);
    
    // Отображаем табличный документ на клиенте
    Если ТабДок.ВысотаТаблицы > 1 Тогда
    //    //Сообщить("Отображение отчета на клиенте...");
        ТабДок.Показать();
    Иначе
    //    //Сообщить("Отчет пуст, отображение не требуется.");
    КонецЕсли;
    
   // //Сообщить("Завершение обработки нажатия кнопки 'Сформировать отчет'.");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНаименованиеНоменклатуры(НоменклатураСсылка)
    Возврат Строка(НоменклатураСсылка);
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ДатаОстатков=ТекущаяДата();
КонецПроцедуры
