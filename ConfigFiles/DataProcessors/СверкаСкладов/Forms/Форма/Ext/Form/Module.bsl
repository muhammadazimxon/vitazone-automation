&НаКлиенте
Процедура СверитьОстатки(Команда)
	Если Не ЗначениеЗаполнено(ДатаОтчета) Тогда
		Сообщить("Укажите дату отчета!");
		Возврат;
	КонецЕсли;
	
	Если Курс = 0 Тогда
		Сообщить("Укажите курс валюты!");
		Возврат;
	КонецЕсли;
	
	СверитьОстаткиНаСервере();
	Сообщить("Сверка успешно завершена!");
КонецПроцедуры

&НаСервере
Процедура СверитьОстаткиНаСервере()
	
	ТаблицаОстатков.Очистить();
	ОстаткиСвод = Новый Соответствие;
	
	Токен = Константы.ТокенБиллз.Получить();
	Если ПустаяСтрока(Токен) Тогда Возврат; КонецЕсли;

	СтрокаДаты = Формат(ДатаОтчета, "ДФ=yyyy-MM-dd"); 
	Сервер = "api-admin.billz.ai";
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	HTTPСоединение = Новый HTTPСоединение(Сервер, 443, , , , 30, ЗащищенноеСоединение);
	
	// =========================================================================================
	// ЭТАП 1: ПОЛУЧЕНИЕ СКЛАДОВ
	// =========================================================================================
	МассивИДМагазинов = Новый Массив;
	АдресПродаж = "/v1/general-report-table?start_date=" + СтрокаДаты + "&end_date=" + СтрокаДаты + "&limit=100&page=1&currency=UZS&detalization=day";
	
	ЗапросПродажи = Новый HTTPЗапрос(АдресПродаж);
	ЗапросПродажи.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	ОтветПродажи = HTTPСоединение.Получить(ЗапросПродажи);
	
	Если ОтветПродажи.КодСостояния = 200 Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ОтветПродажи.ПолучитьТелоКакСтроку());
		ДанныеПродаж = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(ДанныеПродаж) = Тип("Структура") И ДанныеПродаж.Свойство("shop_stats_by_date") Тогда
			Для Каждого СтрокаОтчета Из ДанныеПродаж.shop_stats_by_date Цикл
				ТекИДМагазина = ?(СтрокаОтчета.Свойство("shop_id"), СтрокаОтчета.shop_id, "");
				ИмяМагазина = СокрЛП(?(СтрокаОтчета.Свойство("shop_name"), СтрокаОтчета.shop_name, ""));
				
				Если ЗначениеЗаполнено(ТекИДМагазина) И МассивИДМагазинов.Найти(ТекИДМагазина) = Неопределено Тогда
					МассивИДМагазинов.Добавить(ТекИДМагазина);
					ОстаткиСвод.Вставить(ИмяМагазина, Новый Структура("СуммаБиллз, Сумма1С", 0, 0));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Если МассивИДМагазинов.Количество() = 0 Тогда Возврат; КонецЕсли;
	СтрокаИДМагазинов = СтрСоединить(МассивИДМагазинов, ",");

	// =========================================================================================
	// ЭТАП 2: ЗАГРУЗКА ОСТАТКОВ BILLZ
	// =========================================================================================
	НомерСтраницы = 1;
	Лимит = 1000;
	
	Пока Истина Цикл
		АдресОстатков = "/v1/stock-report-table?report_date=" + СтрокаДаты + "&page=" + Формат(НомерСтраницы, "ЧГ=") + "&limit=" + Формат(Лимит, "ЧГ=") + "&shop_ids=" + СтрокаИДМагазинов + "&currency=UZS";
		
		ЗапросОстатков = Новый HTTPЗапрос(АдресОстатков);
		ЗапросОстатков.Заголовки.Вставить("Accept", "application/json");
		ЗапросОстатков.Заголовки.Вставить("Authorization", "Bearer " + Токен);
		
		ОтветОстатков = HTTPСоединение.Получить(ЗапросОстатков);
		
		Если ОтветОстатков.КодСостояния = 200 Тогда
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветОстатков.ПолучитьТелоКакСтроку());
			ДанныеОстатков = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			МассивОстатков = ДанныеОстатков.rows;
			Если ТипЗнч(МассивОстатков) <> Тип("Массив") ИЛИ МассивОстатков.Количество() = 0 Тогда Прервать; КонецЕсли;
			
			Для Каждого СтрОстаток Из МассивОстатков Цикл
				ИмяМагазина = СокрЛП(?(СтрОстаток.Свойство("shop_name"), СтрОстаток.shop_name, ""));
				ЦенаЗакупкиUZS = ?(СтрОстаток.Свойство("supply_price"), СтрОстаток.supply_price, 0);
				ОстатокТовара = ?(СтрОстаток.Свойство("measurement_value"), СтрОстаток.measurement_value, 0);
				
				ДанныеСклада = ОстаткиСвод.Получить(ИмяМагазина);
				Если ДанныеСклада <> Неопределено Тогда
					ДанныеСклада.СуммаБиллз = ДанныеСклада.СуммаБиллз + (ОстатокТовара * ЦенаЗакупкиUZS);
				КонецЕсли;
			КонецЦикла;
			
			Если МассивОстатков.Количество() < Лимит Тогда Прервать; КонецЕсли;
			НомерСтраницы = НомерСтраницы + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// =========================================================================================
	// ЭТАП 3: ПОЛУЧЕНИЕ ОСТАТКОВ ИЗ 1С (РЕСУРС ВАЛЮТА)
	// =========================================================================================
	//Запрос1С = Новый Запрос;
	//Запрос1С.Текст = 
	//	"ВЫБРАТЬ
	//	|	СпрФинИст.Наименование КАК СкладНаименование,
	//	|	СпрФинИст.БиллзНоми КАК БиллзНоми,
	//	|	ЕСТЬNULL(ФинансыОстатки.ВалютаОстаток, 0) КАК ВалютаОстаток1С
	//	|ИЗ
	//	|	Справочник.ФинИст КАК СпрФинИст
	//	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Финансы.Остатки(&КонецПериода, ) КАК ФинансыОстатки
	//	|		ПО СпрФинИст.Ссылка = ФинансыОстатки.ФинИст
	//	|ГДЕ
	//	|	СпрФинИст.Родитель.Наименование = ""Склад""
	//	|	И НЕ СпрФинИст.ПометкаУдаления";
	//
	//ГраницаОстатков = Новый Граница(КонецДня(ДатаОтчета), ВидГраницы.Включая);
	//Запрос1С.УстановитьПараметр("КонецПериода", ГраницаОстатков);
	//
	//Выборка = Запрос1С.Выполнить().Выбрать();
	//
	//Пока Выборка.Следующий() Цикл
	//	БиллзНоми = СокрЛП(Выборка.БиллзНоми);
	//	Если ПустаяСтрока(БиллзНоми) Тогда Продолжить; КонецЕсли;
	//	
	//	ДанныеСклада = ОстаткиСвод.Получить(БиллзНоми);
	//	Если ДанныеСклада = Неопределено Тогда
	//		ДанныеСклада = Новый Структура("СуммаБиллз, Сумма1С", 0, 0);
	//		ОстаткиСвод.Вставить(БиллзНоми, ДанныеСклада);
	//	КонецЕсли;
	//	
	//	ДанныеСклада.Сумма1С = Выборка.ВалютаОстаток1С;
	//КонецЦикла;
	// =========================================================================================
	// ЭТАП 3: ОСТАТКИ СКЛАДОВ В UZS И USD НА КОНЕЦ ВЫБРАННОЙ ДАТЫ
	// =========================================================================================

	Запрос1С = Новый Запрос;
	Запрос1С.Текст =
	    "ВЫБРАТЬ
	    |   СпрФинИст.БиллзНоми КАК БиллзНоми,
	    |   СУММА(ЕСТЬNULL(ФинансыОстатки.СуммаКонечныйОстаток, 0)) КАК ОстатокСум,
	    |   СУММА(ЕСТЬNULL(ФинансыОстатки.ВалютаКонечныйОстаток, 0)) КАК ОстатокВал
	    |ИЗ
	    |   Справочник.ФинИст КАК СпрФинИст
	    |       ЛЕВОЕ СОЕДИНЕНИЕ
	    |           РегистрНакопления.Финансы.ОстаткиИОбороты(
	    |               &НачалоПериода,
	    |               &КонецПериода,
	    |               ,
	    |               ,
	    |           ) КАК ФинансыОстатки
	    |       ПО СпрФинИст.Ссылка = ФинансыОстатки.ФинИст
	    |ГДЕ
	    |   СпрФинИст.БиллзНоми <> """"
	    |   И НЕ СпрФинИст.ПометкаУдаления
	    |СГРУППИРОВАТЬ ПО
	    |   СпрФинИст.БиллзНоми";

	Запрос1С.УстановитьПараметр(
	    "НачалоПериода",
	    НачалоДня(ДатаОтчета)
	);

	Запрос1С.УстановитьПараметр(
	    "КонецПериода",
	    КонецДня(ДатаОтчета)
	);

	Выборка = Запрос1С.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

	    БиллзНоми = СокрЛП(Выборка.БиллзНоми);

	    Если ПустаяСтрока(БиллзНоми) Тогда
	        Продолжить;
	    КонецЕсли;

	    // Объединяем долларовый финансовый источник
	    // с соответствующим магазином без знака $
	    Если СтрДлина(БиллзНоми) > 0
	        И Прав(БиллзНоми, 1) = "$" Тогда

	        БиллзНоми = Лев(
	            БиллзНоми,
	            СтрДлина(БиллзНоми) - 1
	        );

	        БиллзНоми = СокрЛП(БиллзНоми);

	    КонецЕсли;

	    ДанныеСклада = ОстаткиСвод.Получить(БиллзНоми);

	    Если ДанныеСклада = Неопределено Тогда

	        ДанныеСклада = Новый Структура(
	            "СуммаБиллз, Сумма1С",
	            0,
	            0
	        );

	        ОстаткиСвод.Вставить(
	            БиллзНоми,
	            ДанныеСклада
	        );

	    КонецЕсли;

	    // UZS + USD, пересчитанный в UZS
	    ДанныеСклада.Сумма1С =
	        ДанныеСклада.Сумма1С
	        + Выборка.ОстатокСум
	        + Выборка.ОстатокВал * Курс;

	КонецЦикла;
	// =========================================================================================
	// ЭТАП 4: ЗАПОЛНЕНИЕ ТАБЛИЦЫ И КОНВЕРТАЦИЯ
	// =========================================================================================
	Для Каждого ЭлементСвода Из ОстаткиСвод Цикл
		
		// Отсеиваем склады, по которым нет остатков ни там, ни там
		Если ЭлементСвода.Значение.СуммаБиллз = 0 И ЭлементСвода.Значение.Сумма1С = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтр = ТаблицаОстатков.Добавить();
		НовСтр.Склад      = ЭлементСвода.Ключ; 
		НовСтр.СуммаБиллз = ЭлементСвода.Значение.СуммаБиллз; 
		НовСтр.Сумма1С = ЭлементСвода.Значение.Сумма1С; 
		НовСтр.Разница    = НовСтр.Сумма1С - НовСтр.СуммаБиллз; 
		
	КонецЦикла;
	
	ТаблицаОстатков.Сортировать("Склад ВОЗР");

КонецПроцедуры

&НаКлиенте
Процедура ДатаОтчетаПриИзменении(Элемент) 
	Если Валюта.Пустая()=Истина
		Тогда Валюта=ВалютаДоллар();
	КонецЕсли;
	Курс=КурсОламиз.КурсОламиз(ДатаОтчета,Валюта)
КонецПроцедуры    

&НаСервере
Функция ВалютаДоллар() 
	Возврат Справочники.Валюта.USD
КонецФункции




