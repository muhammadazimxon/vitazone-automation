&НаКлиенте
Процедура ПолучитьСтатусыAslBelgisi(Команда)
	
	//ПеренестиКонстанты();
	// Получаем массив кодов из табличной части
    МассивКодов = ПолучитьМассивКодовМаркировок();

    Если МассивКодов.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Табличная часть 'Маркировки' пуста!");
        Возврат;
    КонецЕсли;

    // Вызываем серверную функцию для получения данных
    ДанныеСервера = ПолучитьСтатусыAslBelgisiНаСервере(МассивКодов);

    Если ДанныеСервера.Успех = Истина Тогда
        // Обновляем статусы и владельцев в табличной части
        Для Каждого Стр Из ДанныеСервера.Ответ Цикл
            СтрокиПоиска = Объект.Табдок.НайтиСтроки(Новый Структура("Маркировки", Стр.Код));
            Если СтрокиПоиска.Количество() = 0 Тогда
                // Ищем код в табличной части для вывода номера строки
                Для Каждого СтрокаТаб Из Объект.Табдок Цикл
                    Если СтрокаТаб.Маркировки = Стр.Код Тогда
                        НомерСтроки = Объект.Табдок.Индекс(СтрокаТаб) + 1;
                        Сообщить("Не найдено совпадений для кода: строка " + НомерСтроки + ", код: " + Стр.Код);
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
                // Если код вообще не найден в таблице
                Если СтрокиПоиска.Количество() = 0 Тогда
                    Сообщить("Не найдено совпадений для кода: " + Стр.Код + " (строка не определена)");
                КонецЕсли;
            Иначе
                Для Каждого СтрПоиска Из СтрокиПоиска Цикл
                    СтрПоиска.Статус = Стр.Статус;
                    СтрПоиска.Владелец = Стр.Владелец;
                    // Проверяем условия для сообщения
                    Если Стр.Владелец <> """DAANTEC"" MCHJ" Или Стр.Статус <> "Введен в оборот" Тогда
                        НомерСтроки = Объект.Табдок.Индекс(СтрПоиска) + 1;
                        Сообщить("Строка " + НомерСтроки + ", код: " + Стр.Код + 
                                 ", статус: " + Стр.Статус + ", владелец: " + Стр.Владелец);
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;
        КонецЦикла;
    Иначе
        ПоказатьПредупреждение(, "Ошибка ASL BELGISI: " + СокрЛП(ДанныеСервера.Ответ));
	КонецЕсли;
	ПолучимПустые();
КонецПроцедуры


&НаКлиенте 
Функция ПолучимПустые ()
	Для Каждого Стр Из Объект.Табдок Цикл
		Если Стр.Владелец<>"""DAANTEC"" MCHJ" Тогда 
			   Сообщить("Строка " + Стр.НомерСтроки + ", код: " + Стр.Маркировки + 
                                 ", статус: " + Стр.Статус + ", владелец: " + Стр.Владелец);
		   КонецЕсли;
		   КонецЦикла;
	   КонецФункции
	   



&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    НастроитьУсловноеОформление();
КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()
    // Создаем элемент условного оформления
    ЭлементОформления = УсловноеОформление.Элементы.Добавить();
    
    // Указываем поле для оформления
    ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
    ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("Табдок");
    
    // Группа условий ИЛИ
    ГруппаОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
    ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
    
    // Условие 1: Владелец <> "DAANTEC" MCHJ
    ЭлементОтбора1 = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементОтбора1.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Табдок.Владелец");
    ЭлементОтбора1.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
    ЭлементОтбора1.ПравоеЗначение = """DAANTEC"" MCHJ";
    ЭлементОтбора1.Использование = Истина;
    
    // Условие 2: Статус <> "Введен в оборот"
    ЭлементОтбора2 = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементОтбора2.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Табдок.Статус");
    ЭлементОтбора2.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
    ЭлементОтбора2.ПравоеЗначение = "Введен в оборот";
    ЭлементОтбора2.Использование = Истина;
    
    // Устанавливаем красный фон
    ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
    ЭлементОформления.Использование = Истина;
КонецПроцедуры









&НаКлиенте
Функция ПолучитьМассивКодовМаркировок()
    МассивКодов = Новый Массив;
    Для Каждого СтрокаТаб Из Объект.Табдок Цикл
        Если ЗначениеЗаполнено(СтрокаТаб.Маркировки) Тогда
            МассивКодов.Добавить(СтрокаТаб.Маркировки);
        КонецЕсли;
    КонецЦикла;
    Возврат МассивКодов;
КонецФункции

&НаСервере
Функция ПолучитьСтатусыAslBelgisiНаСервере(МассивКодов)
    Возврат AslBelgisi_ПолучитьИнформацию(МассивКодов);
КонецФункции
&НаСервере
Функция AslBelgisi_ПолучитьИнформацию(Данные) 
    Ответ_Структура = Новый Структура("Успех, Ответ", Ложь, "");
    МассивКодов = Новый Массив;

    Если ТипЗнч(Данные) = Тип("Строка") Тогда
        Массив = Новый Массив;
        Массив.Добавить(Данные);
        Данные_ = Массив;
    Иначе
        Данные_ = Данные;
    КонецЕсли;

    Если Данные_.Количество() > 500 Тогда
        МассивОтветов = Новый Массив;
        МассивЗапрос = Новый Массив;
        РазмерПакета = 500;
        Счетчик = 0;
        ВсегоЭлементов = Данные_.Количество();

        Для Каждого ЭлементНовый Из Данные_ Цикл
            МассивЗапрос.Добавить(ЭлементНовый);
            Счетчик = Счетчик + 1;

            Если МассивЗапрос.Количество() = РазмерПакета Или Счетчик = ВсегоЭлементов Тогда
                ОтветЧасть = AslBelgisi_ПолучитьИнформациюПакета(МассивЗапрос);
                Если ОтветЧасть.Успех = Истина Тогда
                    Для Каждого ЭлемОтветЧасть Из ОтветЧасть.Ответ Цикл
                        МассивОтветов.Добавить(ЭлемОтветЧасть);
                    КонецЦикла;
                Иначе
                    Сообщить("Ошибка при обработке пакета: " + ОтветЧасть.Ответ);
                    Возврат ОтветЧасть;
                КонецЕсли;
                МассивЗапрос = Новый Массив;
            КонецЕсли;
        КонецЦикла;

        Ответ_Структура.Успех = Истина;
        Ответ_Структура.Ответ = МассивОтветов;
        Возврат Ответ_Структура;
    КонецЕсли;

    Возврат AslBelgisi_ПолучитьИнформациюПакета(Данные_);
КонецФункции


Функция AslBelgisi_ПолучитьИнформациюПакета(Данные_)
    Ответ_Структура = Новый Структура("Успех, Ответ", Ложь, "");
    МассивКодов = Новый Массив;

    ТекстЗапроса = СформироватьJSON(Данные_);

    Попытка
        ssl = Новый ЗащищенноеСоединениеOpenSSL();
        Token_aslbelgisi = Константы.Token_Aslbelgisi.Получить();
        
        СоединениеHTTP = Новый HTTPСоединение("asllikbelgisi.uz", 443,,,,, ssl);
        
        HTTPЗапрос = Новый HTTPЗапрос;
        HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");
        HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Token_aslbelgisi);
        HTTPЗапрос.УстановитьТелоИзСтроки(ТекстЗапроса, КодировкаТекста.ANSI, ИспользованиеByteOrderMark.НеИспользовать);
        HTTPЗапрос.АдресРесурса = "/api/v3/true-api/cises/publicInfo?pg=pharma";
        
        РезультатЗапроса = СоединениеHTTP.ОтправитьДляОбработки(HTTPЗапрос);
        
        Если РезультатЗапроса.КодСостояния = 200 Тогда
            Результат = РезультатЗапроса.ПолучитьТелоКакСтроку();
            Результат_Массив = ЧтениеЖС(Результат, Истина);
            Для Каждого Элем Из Результат_Массив Цикл
                Структура_Кодов = Элем.Получить("cisInfo");
                СтрокаДанных = Новый Структура("Код, Статус, Владелец", 
                    Структура_Кодов["cis"], 
                    Структура_Кодов["status"], 
                    Структура_Кодов["ownerName"]);
                
                Если СтрокаДанных.Статус = "EMITTED" Тогда
                    СтрокаДанных.Статус = "Эмитирован";
                ИначеЕсли СтрокаДанных.Статус = "APPLIED" Тогда
                    СтрокаДанных.Статус = "Нанесён";
                ИначеЕсли СтрокаДанных.Статус = "INTRODUCED" Тогда
                    СтрокаДанных.Статус = "Введен в оборот";
                ИначеЕсли СтрокаДанных.Статус = "WRITTEN_OFF" Тогда
                    СтрокаДанных.Статус = "Утилизирован";
                ИначеЕсли СтрокаДанных.Статус = "WITHDRAWN" Тогда
                    СтрокаДанных.Статус = "Выведен из оборота";
                ИначеЕсли СтрокаДанных.Статус = "INTRODUCED_RETURNED" Тогда
                    СтрокаДанных.Статус = "Возвращён в оборот";
                ИначеЕсли СтрокаДанных.Статус = "DISAGGREGATED" Тогда
                    СтрокаДанных.Статус = "Дезагрегирован";
                ИначеЕсли СтрокаДанных.Статус = "APPLIED_NOT_PAID" Тогда
                    СтрокаДанных.Статус = "Нанесён, не оплачен";
                КонецЕсли;
                
                МассивКодов.Добавить(СтрокаДанных);
            КонецЦикла;
            Ответ_Структура.Успех = Истина;
            Ответ_Структура.Ответ = МассивКодов;
        Иначе
            Ответ_Структура.Ответ = "Ошибка сервера: код " + РезультатЗапроса.КодСостояния;
        КонецЕсли;
        
    Исключение
        Ответ_Структура.Ответ = "Ошибка при запросе: " + ОписаниеОшибки();
    КонецПопытки;

    Возврат Ответ_Структура;
КонецФункции

// Вспомогательные функции
&НаСервере
Функция СформироватьJSON(Данные)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаСервере
Функция ЧтениеЖС(ТекстJSON, КакСоответствие = Ложь)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстJSON);
    Данные = ПрочитатьJSON(ЧтениеJSON, КакСоответствие);
    ЧтениеJSON.Закрыть();
    Возврат Данные;
КонецФункции


&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//Если Исключить=Ложь тогда
	Если Объект.Табдок.Количество() > 0 Тогда
		Текст = "";
		Для Каждого Стр Из Объект.Табдок Цикл
			//Если Стр.Исключить = Ложь Тогда
            Если Стр.Владелец <> """DAANTEC"" MCHJ" Тогда
                Сообщение = "Строка " + Стр.НомерСтроки + ", код: " + Стр.Маркировки + 
                            ", статус: " + Стр.Статус + ", владелец: " + Стр.Владелец;
                Сообщить(Сообщение);
                Текст = Текст + Сообщение + Символы.ПС + Символы.ПС;
			КонецЕсли;
				//КонецЕсли;
        КонецЦикла;
        
        Если Текст <> "" Тогда
            Сообщить(Текст, СтатусСообщения.Важное);
            ПоказатьПредупреждение(, Текст, 60, "Эти позиции не принадлежать к DAANTEC MCHJ");
            Отказ = Истина;
        КонецЕсли;
	
	КонецЕсли
	
КонецПроцедуры



Процедура ПеренестиКонстанты() Экспорт
    Попытка
        // Параметры подключения к исходной ИБ
        СтрокаПодключенияИсходная = "Srvr='192.168.1.240';Ref='hed2021';Usr='Sherzod';Pwd='1';";

        // Параметры подключения к целевой ИБ
        СтрокаПодключенияЦелевая = "Srvr='192.168.1.35';Ref='DaantecBase';Usr='Админ';Pwd='77зфкщд77';";

        // Создание COM-объекта
        COMОбъект = Новый COMОбъект("V83.COMConnector");

        // Подключение к исходной ИБ
        СоединениеИсходное = COMОбъект.Connect(СтрокаПодключенияИсходная);
        
        // Подключение к целевой ИБ
        СоединениеЦелевое = COMОбъект.Connect(СтрокаПодключенияЦелевая);

        // Получение списка констант из исходной ИБ
        МетаданныеКонстант = СоединениеИсходное.Метаданные.Константы;
        
        Для Каждого МетаКонстанта Из МетаданныеКонстант Цикл
            ИмяКонстанты = МетаКонстанта.Имя; // Получаем имя константы
            ЗначениеКонстанты = СоединениеИсходное.Константы[ИмяКонстанты].Получить();
            
            // Проверка наличия константы в целевой ИБ
            Если СоединениеЦелевое.Метаданные.Константы.Найти(ИмяКонстанты) <> Неопределено Тогда
                СоединениеЦелевое.Константы[ИмяКонстанты].Установить(ЗначениеКонстанты);
                Сообщить("Константа " + ИмяКонстанты + " перенесена.");
            Иначе
                Сообщить("Константа " + ИмяКонстанты + " не найдена в целевой ИБ.");
            КонецЕсли;
        КонецЦикла;

        Сообщить("Перенос констант завершен!");
        
    Исключение
        Сообщить("Ошибка: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры