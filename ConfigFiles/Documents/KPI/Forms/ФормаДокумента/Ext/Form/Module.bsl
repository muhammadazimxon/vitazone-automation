&НаСервере 
Функция ДанныеИзРегистра (МП, Начало, Конец)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДебиторкаОстаткиИОбороты.Контрагенты КАК Контрагенты,
		|	ДебиторкаОстаткиИОбороты.Статья КАК Статья,
		|	ДебиторкаОстаткиИОбороты.ДокНомер КАК ДокНомер,
		|	ДебиторкаОстаткиИОбороты.Счет КАК Счет,
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток КАК НачальныйОстаток,
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумПриход КАК РПриход,
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход КАК РРасход,
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток КАК КонечныйОстаток,
		|	ДебиторкаОстаткиИОбороты.ДокНомер.ДатаСоставления КАК ДатаДоговора,
		|	ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия КАК СрокДоговора,
		|	ДебиторкаОстаткиИОбороты.МП КАК МП,
		|	ДебиторкаОстаткиИОбороты.Контрагенты.Регион КАК Регион,
		|	ВЫБОР
		|		КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
		|				И &Начало > ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия
		|			ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаПросрочкиНачало,
		|	ВЫБОР
		|		КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
		|				И &Конец > ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия
		|			ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаПросрочки,
		|	ВЫБОР
		|		КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
		|				И &Конец > ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия
		|			ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Количество,
		|	ВЫБОР
		|		КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
		|							И &Конец > ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия
		|						ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток
		|					ИНАЧЕ 0
		|				КОНЕЦ / ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток * 100
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоэффициентПросрочки,
		|	ВЫБОР
		|		КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток <> 0
		|				И ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток < 0
		|				И &Конец > ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия
		|			ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток / ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток * 100
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоэфПросрочки,
		|	ВЫБОР
		|		КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумПриход <> 0
		|			ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход / ДебиторкаОстаткиИОбороты.ЗадолженностьСумПриход * 100
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоэфОплаты,
		|	ВЫБОР
		|		КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток <> 0
		|			ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход / ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток * 100
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоэфРеализации
		|ИЗ
		|	РегистрНакопления.Дебиторка.ОстаткиИОбороты(&Начало, &Конец, , , ) КАК ДебиторкаОстаткиИОбороты
		|ГДЕ
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток < 0
		|	И ДебиторкаОстаткиИОбороты.МП = &МП";
	
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("МП", МП);
	Запрос.УстановитьПараметр("Начало", Начало);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	// Очистить табличную часть
	//Объект.ОбрТабдок.Очистить();
	
	// Добавить строки в табличную часть
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока =Объект.ОбрТабдок.Добавить();
		Если ВыборкаДетальныеЗаписи.статья=Справочники.Статьи.Продажа Тогда
		НоваяСтрока.Контрагенты = ВыборкаДетальныеЗаписи.Контрагенты;
		НоваяСтрока.ДокНомер = ВыборкаДетальныеЗаписи.ДокНомер;
		НоваяСтрока.ОтсатокНаНачало = -ВыборкаДетальныеЗаписи.НачальныйОстаток;
		НоваяСтрока.КонечныйОстаток = -ВыборкаДетальныеЗаписи.КонечныйОстаток;
		НоваяСтрока.ПросрочкаНаНачало = -ВыборкаДетальныеЗаписи.СуммаПросрочкиНачало;
		НоваяСтрока.ПросрочкаНаКонец = -ВыборкаДетальныеЗаписи.СуммаПросрочки;
		НоваяСтрока.Приход = ВыборкаДетальныеЗаписи.РПриход;
		НоваяСтрока.Реализация = ВыборкаДетальныеЗаписи.РРасход;
		НоваяСтрока.Менеджер = МП;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции


