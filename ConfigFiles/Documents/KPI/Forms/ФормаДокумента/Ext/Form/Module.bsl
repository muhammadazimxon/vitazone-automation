&НаКлиенте
Процедура УдалитьПовторыОбрТабдок(ТабличнаяЧасть)
    // Создаем временное соответствие для агрегирования данных
    ВременныеДанные = Новый Соответствие;

    // Проходим по каждой строке табличной части
    Для Каждого Строка Из ТабличнаяЧасть Цикл
        Менеджер = Строка.Менеджер;

        // Если менеджер уже есть в соответствии, суммируем данные
        Если НЕ ВременныеДанные[Менеджер] = Неопределено Тогда
            ТекущиеДанные = ВременныеДанные[Менеджер];
            ТекущиеДанные.ОтсатокНаНачало = ТекущиеДанные.ОтсатокНаНачало + Строка.ОтсатокНаНачало;
            ТекущиеДанные.КонечныйОстаток = ТекущиеДанные.КонечныйОстаток + Строка.КонечныйОстаток;
            ТекущиеДанные.Приход = ТекущиеДанные.Приход + Строка.Приход;
            ТекущиеДанные.Реализация = ТекущиеДанные.Реализация + Строка.Реализация;
            ТекущиеДанные.ПросрочкаНаНачало = ТекущиеДанные.ПросрочкаНаНачало + Строка.ПросрочкаНаНачало;
            ТекущиеДанные.ПросрочкаНаКонец = ТекущиеДанные.ПросрочкаНаКонец + Строка.ПросрочкаНаКонец;
        Иначе
            // Если менеджера нет, добавляем его в соответствие
            НоваяСтрока = Новый Структура(
                "Менеджер, ОтсатокНаНачало, КонечныйОстаток, Приход, Реализация, ПросрочкаНаНачало, ПросрочкаНаКонец",
                Менеджер,
                Строка.ОтсатокНаНачало,
                Строка.КонечныйОстаток,
                Строка.Приход,
                Строка.Реализация,
                Строка.ПросрочкаНаНачало,
                Строка.ПросрочкаНаКонец
            );
            ВременныеДанные.Вставить(Менеджер, НоваяСтрока);
        КонецЕсли;
    КонецЦикла;

    // Очищаем табличную часть
    ТабличнаяЧасть.Очистить();

    // Переносим агрегированные данные обратно в табличную часть
    Для Каждого Итог Из ВременныеДанные Цикл
        НоваяСтрока = ТабличнаяЧасть.Добавить();
        НоваяСтрока.Менеджер = Итог.Значение.Менеджер;
        НоваяСтрока.ОтсатокНаНачало = Итог.Значение.ОтсатокНаНачало;
        НоваяСтрока.КонечныйОстаток = Итог.Значение.КонечныйОстаток;
        НоваяСтрока.Приход = Итог.Значение.Приход;
        НоваяСтрока.Реализация = Итог.Значение.Реализация;
        НоваяСтрока.ПросрочкаНаНачало = Итог.Значение.ПросрочкаНаНачало;
        НоваяСтрока.ПросрочкаНаКонец = Итог.Значение.ПросрочкаНаКонец;
    КонецЦикла;
КонецПроцедуры

