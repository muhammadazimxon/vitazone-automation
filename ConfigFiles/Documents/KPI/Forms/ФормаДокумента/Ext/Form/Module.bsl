                Строка.Приход,
                Строка.Реализация,
                Строка.ПросрочкаНаНачало,
                Строка.ПросрочкаНаКонец
            );
            ВременныеДанные.Вставить(Регион, НоваяСтрока);
        КонецЕсли;
    КонецЦикла;

    // Очищаем табличную часть
    ТабличнаяЧасть.Очистить();

    // Переносим агрегированные данные обратно в табличную часть
    Для Каждого Итог Из ВременныеДанные Цикл
        НоваяСтрока = ТабличнаяЧасть.Добавить();
        НоваяСтрока.Регион = Итог.Значение.Регион;
        НоваяСтрока.ОтсатокНаНачало = Итог.Значение.ОтсатокНаНачало;
        НоваяСтрока.КонечныйОстаток = Итог.Значение.КонечныйОстаток;
        НоваяСтрока.Приход = Итог.Значение.Приход;
        НоваяСтрока.Реализация = Итог.Значение.Реализация;
        НоваяСтрока.ПросрочкаНаНачало = Итог.Значение.ПросрочкаНаНачало;
        НоваяСтрока.ПросрочкаНаКонец = Итог.Значение.ПросрочкаНаКонец;
    КонецЦикла;
КонецПроцедуры






&НаКлиенте
Процедура МТабдокМенеджерПриИзменении(Элемент)
	 // Получаем текущие данные строки
    ТекущаяСтрока = Элементы.МТабдок.ТекущиеДанные;

    Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Менеджер) Тогда
        Объект.ОбрТабдок.Очистить();
        Элементы.ОбрТабдок.Обновить();
        Возврат;
	КонецЕсли;
	// Вызываем серверную функцию для заполнения ОбрТабдок
    ДанныеИзРегистра(ТекущаяСтрока.Менеджер, Объект.Начало,объект.Конец);
	УдалитьПовторыОбрТабдок(Объект.ОбрТабдок);
Для Каждого Эл Из Объект.ОбрТабдок Цикл
    // Проверяем делители на 0 перед каждым делением
    Если Эл.КонечныйОстаток <> 0 Тогда
        Эл.ДоляПросрочки = (Эл.ПросрочкаНаКонец / Эл.КонечныйОстаток) * 100;
    Иначе
        Эл.ДоляПросрочки = 0;
    КонецЕсли;

    Если Эл.ПросрочкаНаНачало <> 0 Тогда
        Эл.ТемпПросрочки = ((Эл.ПросрочкаНаКонец - Эл.ПросрочкаНаНачало) / Эл.ПросрочкаНаНачало) * 100;
    Иначе
        Эл.ТемпПросрочки = 0;
    КонецЕсли;

    Если Эл.ОтсатокНаНачало <> 0 Тогда
        Эл.КоэфПогашения = (Эл.Приход / Эл.ОтсатокНаНачало) * 100;
        Эл.КоэфРеализации = (Эл.Реализация / Эл.ОтсатокНаНачало) * 100;
    Иначе
        Эл.КоэфПогашения = 0;
        Эл.КоэфРеализации = 0;
    КонецЕсли;

    Эл.СреднийДолг = (Эл.ОтсатокНаНачало + Эл.КонечныйОстаток) / 2;

    Если Эл.СреднийДолг <> 0 Тогда
        Эл.КоэфОборачиваемости = (Эл.Реализация / Эл.СреднийДолг) * 100;
    Иначе
        Эл.КоэфОборачиваемости = 0;
    КонецЕсли;

    // Расчет Общего KPI
    Эл.ОбщийKPI = (Эл.ДоляПросрочки * 3 / 10) + 
                  (Эл.ТемпПросрочки * 2 / 10) + 
                  (Эл.КоэфПогашения * 3 / 10) + 
                  (Эл.КоэфРеализации * 2 / 10);
КонецЦикла;

	
    // Обновляем отображение табличной части
    //Объект.ОбрТабдок.Обновить();
КонецПроцедуры



