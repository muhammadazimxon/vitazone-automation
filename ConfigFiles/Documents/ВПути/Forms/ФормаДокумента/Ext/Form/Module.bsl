
&НаКлиенте
Процедура ТабДокСуммаПриИзменении(Элемент)
	Стр=Элементы.ТабДок.ТекущиеДанные;
	Объект.Расходы=Объект.ТабДок.Итог("Сумма");
	Объект.Себестоимость=Объект.Расходы/Объект.КолВо;
	Стр.Валюта=Стр.Сумма/Объект.Курс;
КонецПроцедуры

&НаКлиенте
Процедура КолВоПриИзменении(Элемент)
	Объект.Себестоимость=Объект.Расходы/Объект.КолВо;
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
		Если Объект.Валюта.Пустая()=Истина
		Тогда Объект.Валюта=ВалютаДоллар();
	КонецЕсли;
	Объект.Курс=КурсОламиз.КурсОламиз(Объект.Дата, Объект.Валюта);
	//Сообщить(КурсОтчетга.КурсОламиз(Объект.Дата));
КонецПроцедуры
Функция ВалютаДоллар() 
	Возврат Справочники.Валюта.USD
КонецФункции


&НаКлиенте
Процедура ТабДокВалютаПриИзменении(Элемент)
		Стр=Элементы.ТабДок.ТекущиеДанные;
	Объект.Расходы=Объект.ТабДок.Итог("Сумма");
	Объект.Себестоимость=Объект.Расходы/Объект.КолВо;
	Стр.Сумма=Стр.Валюта*Объект.Курс;

КонецПроцедуры

