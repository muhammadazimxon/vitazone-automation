Процедура Печать(ТабДок, Ссылка) Экспорт
	//{{_КОНСТРУКТОР_ПЕЧАТИ(Печать)
	Макет = Документы.ВычиляемЗПиБонус.ПолучитьМакет("Печать");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВычиляемЗПиБонус.БонусНачисление,
	|	ВычиляемЗПиБонус.ВсегоЗП,
	|	ВычиляемЗПиБонус.Выше,
	|	ВычиляемЗПиБонус.Конец,
	|	ВычиляемЗПиБонус.Куратор,
	|	ВычиляемЗПиБонус.Кураторские,
	|	ВычиляемЗПиБонус.Начало,
	|	ВычиляемЗПиБонус.Ниже,
	|	ВычиляемЗПиБонус.Реализация,
	|	ВычиляемЗПиБонус.Сумма,
	|	ВычиляемЗПиБонус.Табдок.(
	|		НомерСтроки,
	|		Куратор,
	|		МП,
	|		Регион,
	|		Контрагенты,
	|		ИНН,
	|		Номенклатура,
	|		ДокНомер,
	|		ДатаСчФ,
	|		Срок,
	|		Условие,
	|		КолВо,
	|		Реализация,
	|		БонусНачисление,
	|		БонусОплата,
	|		БонусОстаток,
	|		Цена,
	|		Комментарии
	|	),
	|	ВычиляемЗПиБонус.Табдок2.(
	|		НомерСтроки,
	|		Куратор,
	|		МП,
	|		Контрагенты,
	|		Реализация,
	|		БонусНачисление,
	|		БонусОстаток,
	|		Комментарии,
	|		ЗП
	|	),
	|	ВычиляемЗПиБонус.Табдок3.(
	|		НомерСтроки,
	|		Куратор,
	|		МП,
	|		Реализация,
	|		БонусНачисление,
	|		БонусОстаток,
	|		Комментарии,
	|		ЗП
	|	),
	|	ВычиляемЗПиБонус.Табдок4.(
	|		НомерСтроки,
	|		Куратор,
	|		Статья,
	|		Прибавление,
	|		Удержание,
	|		Комментарии
	|	)
	|ИЗ
	|	Документ.ВычиляемЗПиБонус КАК ВычиляемЗПиБонус
	|ГДЕ
	|	ВычиляемЗПиБонус.Ссылка В (&Ссылка)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьТабдокШапка = Макет.ПолучитьОбласть("ТабдокШапка");
	ОбластьТабдок = Макет.ПолучитьОбласть("Табдок");
	ОбластьТабдок2Шапка = Макет.ПолучитьОбласть("Табдок2Шапка");
	ОбластьТабдок2 = Макет.ПолучитьОбласть("Табдок2");
	ОбластьТабдок3Шапка = Макет.ПолучитьОбласть("Табдок3Шапка");
	ОбластьТабдок3 = Макет.ПолучитьОбласть("Табдок3");
	ОбластьТабдок4Шапка = Макет.ПолучитьОбласть("Табдок4Шапка");
	ОбластьТабдок4 = Макет.ПолучитьОбласть("Табдок4");
	 // Определяем области подвалов для итогов
ОбластьТабдокПодвал = Макет.ПолучитьОбласть("ТабдокПодвал");
ОбластьТабдок2Подвал = Макет.ПолучитьОбласть("Табдок2Подвал");
ОбластьТабдок3Подвал = Макет.ПолучитьОбласть("Табдок3Подвал");
ОбластьТабдок4Подвал = Макет.ПолучитьОбласть("Табдок4Подвал");

ТабДок.Очистить();
	
	
	
	
	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ТабДок.Вывести(ОбластьЗаголовок);

		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка, Выборка.Уровень());

		ТабДок.Вывести(ОбластьТабдокШапка);
		ВыборкаТабдок = Выборка.Табдок.Выбрать();
		ИтогиТабдок = Новый Структура("КолВо, Реализация, БонусНачисление, БонусОплата, БонусОстаток, Цена", 0, 0, 0, 0, 0, 0);
		
		Пока ВыборкаТабдок.Следующий() Цикл
			ОбластьТабдок.Параметры.Заполнить(ВыборкаТабдок);
			ТабДок.Вывести(ОбластьТабдок, ВыборкаТабдок.Уровень());
			// Суммируем числовые поля
		ИтогиТабдок.КолВо = ИтогиТабдок.КолВо + ВыборкаТабдок.КолВо;
		ИтогиТабдок.Реализация = ИтогиТабдок.Реализация + ВыборкаТабдок.Реализация;
		ИтогиТабдок.БонусНачисление = ИтогиТабдок.БонусНачисление + ВыборкаТабдок.БонусНачисление;
		ИтогиТабдок.БонусОплата = ИтогиТабдок.БонусОплата + ВыборкаТабдок.БонусОплата;
		ИтогиТабдок.БонусОстаток = ИтогиТабдок.БонусОстаток + ВыборкаТабдок.БонусОстаток;
		//ИтогиТабдок.Цена = ИтогиТабдок.Цена + ВыборкаТабдок.Цена;
	КонецЦикла;
	    ОбластьТабдокПодвал.Параметры.Заполнить(ИтогиТабдок);
		ТабДок.Вывести(ОбластьТабдокПодвал);
	
		//Табдок2
		ТабДок.Вывести(ОбластьТабдок2Шапка);
		ВыборкаТабдок2 = Выборка.Табдок2.Выбрать();
		ИтогиТабдок2 = Новый Структура("Реализация, БонусНачисление, БонусОстаток, ЗП", 0, 0, 0, 0);
		Пока ВыборкаТабдок2.Следующий() Цикл
			ОбластьТабдок2.Параметры.Заполнить(ВыборкаТабдок2);
			ТабДок.Вывести(ОбластьТабдок2, ВыборкаТабдок2.Уровень());
			// Суммируем числовые поля
		ИтогиТабдок2.Реализация = ИтогиТабдок2.Реализация + ВыборкаТабдок2.Реализация;
		ИтогиТабдок2.БонусНачисление = ИтогиТабдок2.БонусНачисление + ВыборкаТабдок2.БонусНачисление;
		ИтогиТабдок2.БонусОстаток = ИтогиТабдок2.БонусОстаток + ВыборкаТабдок2.БонусОстаток;
		ИтогиТабдок2.ЗП = ИтогиТабдок2.ЗП + ВыборкаТабдок2.ЗП;
	КонецЦикла;
	// Выводим подвал для Табдок2
	ОбластьТабдок2Подвал.Параметры.Заполнить(ИтогиТабдок2);
	ТабДок.Вывести(ОбластьТабдок2Подвал);

	
	     // Табдок3
		ТабДок.Вывести(ОбластьТабдок3Шапка);
		ВыборкаТабдок3 = Выборка.Табдок3.Выбрать();
		ИтогиТабдок3 = Новый Структура("Реализация, БонусНачисление, БонусОстаток, ЗП", 0, 0, 0, 0);
		Пока ВыборкаТабдок3.Следующий() Цикл
			ОбластьТабдок3.Параметры.Заполнить(ВыборкаТабдок3);
			ТабДок.Вывести(ОбластьТабдок3, ВыборкаТабдок3.Уровень());
			// Суммируем числовые поля
		ИтогиТабдок3.Реализация = ИтогиТабдок3.Реализация + ВыборкаТабдок3.Реализация;
		ИтогиТабдок3.БонусНачисление = ИтогиТабдок3.БонусНачисление + ВыборкаТабдок3.БонусНачисление;
		ИтогиТабдок3.БонусОстаток = ИтогиТабдок3.БонусОстаток + ВыборкаТабдок3.БонусОстаток;
		ИтогиТабдок3.ЗП = ИтогиТабдок3.ЗП + ВыборкаТабдок3.ЗП;
	КонецЦикла;
	// Выводим подвал для Табдок3
	ОбластьТабдок3Подвал.Параметры.Заполнить(ИтогиТабдок3);
	ТабДок.Вывести(ОбластьТабдок3Подвал);

		ТабДок.Вывести(ОбластьТабдок4Шапка);
		ВыборкаТабдок4 = Выборка.Табдок4.Выбрать();
		ИтогиТабдок4 = Новый Структура("Прибавление, Удержание", 0, 0);
		Пока ВыборкаТабдок4.Следующий() Цикл
			ОбластьТабдок4.Параметры.Заполнить(ВыборкаТабдок4);
			ТабДок.Вывести(ОбластьТабдок4, ВыборкаТабдок4.Уровень());
			// Суммируем числовые поля
		ИтогиТабдок4.Прибавление = ИтогиТабдок4.Прибавление + ВыборкаТабдок4.Прибавление;
		ИтогиТабдок4.Удержание = ИтогиТабдок4.Удержание + ВыборкаТабдок4.Удержание;
	КонецЦикла;
	// Выводим подвал для Табдок4
	ОбластьТабдок4Подвал.Параметры.Заполнить(ИтогиТабдок4);
	ТабДок.Вывести(ОбластьТабдок4Подвал);

		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
	//}}
КонецПроцедуры



