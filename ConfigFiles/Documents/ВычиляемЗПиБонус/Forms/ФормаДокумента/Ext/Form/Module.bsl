Продолжить;
КонецЕсли;
// Рассчитываем ЗП для Куратора
СтрокаТабдок3.ЗП = ((СтрокаТабдок3.КРеализации+СтрокаТабдок3.Реализация) * Объект.Кураторские / 100);
РассчитатьРМНаСервере();
Сообщить("Рассчитана ЗП для Куратора " + СтрокаТабдок3.Куратор + ": " + СтрокаТабдок3.ЗП);
КонецЦикла;
Сообщить("Расчёт зарплаты завершён для Табдок2 и Табдок3!", СтатусСообщения.Информация);
Объект.ВсегоЗП=Объект.Табдок2.Итог("ЗП")+Объект.Табдок3.Итог("ЗП");
