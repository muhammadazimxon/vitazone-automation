&НаКлиенте
Процедура Собрать(Команда)
Если Объект.Тасдикланди=Истина
Тогда Сообщить ("ТАСДИКЛАНГАН документга узгартириш киритманг",СтатусСообщения.ОченьВажное);
Иначе
СобратьНаСервере();
ОбработатьТабличнуюЧасть();
Объект.Реализация=Объект.Табдок.Итог("Реализация")+Объект.Табдок.Итог("КРеализации");
Объект.БонусНачисление=Объект.Табдок.Итог("БонусНачисление")+Объект.Табдок.Итог("КБонусы");
Объект.БонусОстаток=Объект.Табдок.Итог("БонусОстаток");
КонецЕсли
КонецПроцедуры
&НаСервере
Процедура СобратьНаСервере()
    // Проверка заполненности реквизитов
    Если Не ЗначениеЗаполнено(Объект.Начало) Или Не ЗначениеЗаполнено(Объект.Конец) Или Не ЗначениеЗаполнено(Объект.Куратор) Тогда
        Сообщить("Заполните поля Начало, Конец и Куратор!", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    // Диагностика параметров
    Сообщить("Период: " + Формат(Объект.Начало, "ДФ=dd.MM.yyyy") + " - " + Формат(Объект.Конец, "ДФ=dd.MM.yyyy"));
    Сообщить("Куратор: " + Объект.Куратор + ", Код: " + Объект.Куратор.Код);
    // Запрос
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | Остатки.Номенклатура КАК Номенклатура,
    | Остатки.Регион КАК Регион,
    | Остатки.Контрагенты КАК Контрагенты,
    | Остатки.Контрагенты.ИНН КАК ИНН,
    | Остатки.ДокНомер.МП КАК МП,
    | Остатки.ДокНомер.МП.Куратор КАК Куратор,
    | Остатки.ДокНомер КАК ДокНомер,
    | Остатки.ДокНомер.ДатаСоставления КАК ДатаСчФ,
    | Остатки.ДокНомер.СрокДействия КАК Срок,
    | Остатки.ДокНомер.УсловиеПредоплаты КАК Условие,
    | СУММА(Остатки.КолвоРасход) КАК КолВо,
    | СУММА(Остатки.СуммаРасход) КАК Реализация
    |ПОМЕСТИТЬ ОстаткиАгрегат
    |ИЗ
    | РегистрНакопления.Остатки.ОстаткиИОбороты(&Начало, &Конец, День, , МП.Куратор = &Куратор) КАК Остатки
    |ГДЕ
    | Остатки.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И Остатки.Контрагенты.Сеть = ЛОЖЬ
    |СГРУППИРОВАТЬ ПО
    | Остатки.Номенклатура,
    | Остатки.Регион,
    | Остатки.Контрагенты,
    | Остатки.Контрагенты.ИНН,
    | Остатки.ДокНомер.МП,
    | Остатки.ДокНомер.МП.Куратор,
    | Остатки.ДокНомер,
    | Остатки.ДокНомер.ДатаСоставления,
    | Остатки.ДокНомер.СрокДействия,
    | Остатки.ДокНомер.УсловиеПредоплаты
    |;
    |
    |ВЫБРАТЬ
    | ОстаткиВозвраты.Номенклатура КАК Номенклатура,
    | ОстаткиВозвраты.Регион КАК Регион,
    | ОстаткиВозвраты.Контрагенты КАК Контрагенты,
    | ОстаткиВозвраты.Контрагенты.ИНН КАК ИНН,
    | ОстаткиВозвраты.ДокНомер.МП КАК МП,
    | ОстаткиВозвраты.ДокНомер.МП.Куратор КАК Куратор,
    | ОстаткиВозвраты.ДокНомер КАК ДокНомер,
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления КАК ДатаСчФ,
    | ОстаткиВозвраты.ДокНомер.СрокДействия КАК Срок,
    | ОстаткиВозвраты.ДокНомер.УсловиеПредоплаты КАК Условие,
    | СУММА(ОстаткиВозвраты.КолвоРасход) КАК КолВо,
    | СУММА(ОстаткиВозвраты.СуммаРасход) КАК Реализация
    |ПОМЕСТИТЬ Возвраты
    |ИЗ
    | РегистрНакопления.Остатки.ОстаткиИОбороты(&Начало, &КонецВозвратов, День, , МП.Куратор = &Куратор) КАК ОстаткиВозвраты
    |ГДЕ
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И ОстаткиВозвраты.КолвоРасход < 0
    | И ОстаткиВозвраты.Контрагенты.Сеть = ЛОЖЬ
    |СГРУППИРОВАТЬ ПО
    | ОстаткиВозвраты.Номенклатура,
    | ОстаткиВозвраты.Регион,
    | ОстаткиВозвраты.Контрагенты,
    | ОстаткиВозвраты.Контрагенты.ИНН,
    | ОстаткиВозвраты.ДокНомер.МП,
    | ОстаткиВозвраты.ДокНомер.МП.Куратор,
    | ОстаткиВозвраты.ДокНомер,
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления,
    | ОстаткиВозвраты.ДокНомер.СрокДействия,
    | ОстаткиВозвраты.ДокНомер.УсловиеПредоплаты
    |;
    |
    |ВЫБРАТЬ
    | Бонусы.ДокНомер КАК ДокНомер,
    | Бонусы.Номенклатура КАК Номенклатура,
    | Бонусы.ДокНомер.МП КАК МП,
    | Бонусы.ДокНомер.МП.Куратор КАК Куратор,
    | Бонусы.ДокНомер.Владелец КАК Контрагенты,
    | СУММА(Бонусы.СуммаПриход) КАК БонусНачисление,
    | СУММА(Бонусы.СуммаРасход) КАК БонусОплата
    |ПОМЕСТИТЬ БонусыАгрегат
    |ИЗ
    | РегистрНакопления.Бонусы.ОстаткиИОбороты(&Начало, &КонецВозвратов, День, , МП.Куратор = &Куратор) КАК Бонусы
    |ГДЕ
    | Бонусы.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И Бонусы.ДокНомер.Владелец.Сеть = ЛОЖЬ
    |СГРУППИРОВАТЬ ПО
    | Бонусы.ДокНомер,
    | Бонусы.Номенклатура,
    | Бонусы.ДокНомер.МП,
    | Бонусы.ДокНомер.МП.Куратор,
    | Бонусы.ДокНомер.Владелец
    |;
    |
    |ВЫБРАТЬ
    | ЕСТЬNULL(ОстаткиАгрегат.Номенклатура, БонусыАгрегат.Номенклатура) КАК Номенклатура,
    | ОстаткиАгрегат.Регион КАК Регион,
    | ЕСТЬNULL(ОстаткиАгрегат.Контрагенты, БонусыАгрегат.Контрагенты) КАК Контрагенты,
    | ОстаткиАгрегат.ИНН КАК ИНН,
    | ЕСТЬNULL(ОстаткиАгрегат.МП, БонусыАгрегат.МП) КАК МП,
    | ЕСТЬNULL(ОстаткиАгрегат.МП.Куратор, БонусыАгрегат.МП.Куратор) КАК Куратор,
    | ЕСТЬNULL(ОстаткиАгрегат.ДокНомер, БонусыАгрегат.ДокНомер) КАК ДокНомер,
    | ОстаткиАгрегат.ДатаСчФ КАК ДатаСчФ,
    | ОстаткиАгрегат.Срок КАК Срок,
    | ОстаткиАгрегат.Условие КАК Условие,
    | ЕСТЬNULL(ОстаткиАгрегат.КолВо, 0) - ЕСТЬNULL(Возвраты.КолВо, 0) КАК КолВо,
    | ЕСТЬNULL(ОстаткиАгрегат.Реализация, 0) - ЕСТЬNULL(Возвраты.Реализация, 0) КАК Реализация,
    | ЕСТЬNULL(БонусыАгрегат.БонусНачисление, 0) КАК БонусНачисление,
    | ЕСТЬNULL(БонусыАгрегат.БонусОплата, 0) КАК БонусОплата,
    | ЕСТЬNULL(БонусыАгрегат.БонусНачисление, 0) - ЕСТЬNULL(БонусыАгрегат.БонусОплата, 0) КАК БонусОстаток
    |ИЗ
    | ОстаткиАгрегат КАК ОстаткиАгрегат
    | ЛЕВОЕ СОЕДИНЕНИЕ Возвраты КАК Возвраты
    | ПО ОстаткиАгрегат.ДокНомер = Возвраты.ДокНомер
    | И ОстаткиАгрегат.Номенклатура = Возвраты.Номенклатура
    | И ОстаткиАгрегат.Контрагенты = Возвраты.Контрагенты
    | И ОстаткиАгрегат.МП = Возвраты.МП
    | ЛЕВОЕ СОЕДИНЕНИЕ БонусыАгрегат КАК БонусыАгрегат
    | ПО ОстаткиАгрегат.ДокНомер = БонусыАгрегат.ДокНомер
    | И ОстаткиАгрегат.Номенклатура = БонусыАгрегат.Номенклатура
    | И ОстаткиАгрегат.МП = БонусыАгрегат.МП
    | И ОстаткиАгрегат.Контрагенты = БонусыАгрегат.Контрагенты";
    Запрос.УстановитьПараметр("Начало", Объект.Начало);
    Запрос.УстановитьПараметр("Конец", Объект.Конец);
    Запрос.УстановитьПараметр("КонецВозвратов", КонецМесяца(ДобавитьМесяц(Объект.Конец, 1)));
    Запрос.УстановитьПараметр("Куратор", Объект.Куратор);
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Сообщить("За указанный период для куратора " + Объект.Куратор + " данных не найдено.", СтатусСообщения.Информация);
        Возврат;
    КонецЕсли;
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если НЕ ЗначениеЗаполнено(Выборка.МП) Тогда
            Сообщить("МП не заполнен для документа: " + Выборка.ДокНомер, СтатусСообщения.Внимание);
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(Выборка.Куратор) Тогда
            Сообщить("Куратор не заполнен для МП: " + Выборка.МП, СтатусСообщения.Внимание);
        КонецЕсли;
        НоваяСтрока = Объект.Табдок.Добавить();
        НоваяСтрока.Куратор = Выборка.Куратор;
        НоваяСтрока.МП = Выборка.МП;
        НоваяСтрока.Регион = Выборка.Регион;
        НоваяСтрока.Контрагенты = Выборка.Контрагенты;
        НоваяСтрока.ИНН = Выборка.ИНН;
        НоваяСтрока.Номенклатура = Выборка.Номенклатура;
        НоваяСтрока.ДокНомер = Строка(Выборка.ДокНомер);
        НоваяСтрока.ДатаСчФ = Выборка.ДатаСчФ;
        НоваяСтрока.Срок = Выборка.Срок;
        НоваяСтрока.Условие = Выборка.Условие;
        НоваяСтрока.КолВо = Выборка.КолВо;
        НоваяСтрока.Реализация = Выборка.Реализация;
        НоваяСтрока.БонусНачисление = Выборка.БонусНачисление;
        НоваяСтрока.БонусОплата = Выборка.БонусОплата;
        НоваяСтрока.БонусОстаток = Выборка.БонусОстаток;
        // Предполагаем, что КРеализации и КБонусы существуют в таблице, но не возвращаются запросом
        // Если они вычисляются, нужно добавить их логику здесь
        НоваяСтрока.КРеализации = 0; // Замените на актуальное вычисление, если необходимо
        НоваяСтрока.КБонусы = 0; // Замените на актуальное вычисление, если необходимо
        // Проверка отрицательной Реализации
        Если Выборка.Реализация < 0 Тогда
            НоваяСтрока.КолВо = 0;
            НоваяСтрока.Реализация=0;
            НоваяСтрока.КРеализации = 0;
            НоваяСтрока.БонусНачисление = 0;
            НоваяСтрока.БонусОплата = 0;
            НоваяСтрока.БонусОстаток = 0;
            НоваяСтрока.КБонусы = 0;
            НоваяСтрока.Цена = 0;
        Иначе
            Если Выборка.КолВо > 0 Тогда
                НоваяСтрока.Цена = Выборка.Реализация / Выборка.КолВо;
            Иначе
                НоваяСтрока.Цена = 0;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Сообщить("Табличная часть заполнена для куратора " + Объект.Куратор, СтатусСообщения.Информация);
КонецПроцедуры
&НаКлиенте
Процедура Собрать2(Команда)
Если Объект.Тасдикланди=Истина
Тогда Сообщить ("ТАСДИКЛАНГАН документга узгартириш киритманг",СтатусСообщения.ОченьВажное);
Иначе
СобратьНаСервере2();
ОбработатьТабличнуюЧасть();
Объект.Реализация=Объект.Табдок.Итог("Реализация")+Объект.Табдок.Итог("КРеализации");
Объект.БонусНачисление=Объект.Табдок.Итог("БонусНачисление")+Объект.Табдок.Итог("КБонусы");
Объект.БонусОстаток=Объект.Табдок.Итог("БонусОстаток");
КонецЕсли
КонецПроцедуры
&НаСервере
Процедура СобратьНаСервере2()
    // Проверка заполненности реквизитов
    Если Не ЗначениеЗаполнено(Объект.Начало) Или Не ЗначениеЗаполнено(Объект.Конец) Или Не ЗначениеЗаполнено(Объект.Куратор) Тогда
        Сообщить("Заполните поля Начало, Конец и Куратор!", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    // Диагностика параметров
    Сообщить("Период: " + Формат(Объект.Начало, "ДФ=dd.MM.yyyy") + " - " + Формат(Объект.Конец, "ДФ=dd.MM.yyyy"));
    Сообщить("Куратор: " + Объект.Куратор + ", Код: " + Объект.Куратор.Код);
    // Запрос
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | Остатки.Номенклатура КАК Номенклатура,
    | Остатки.Регион КАК Регион,
    | Остатки.Контрагенты КАК Контрагенты,
    | Остатки.Контрагенты.ИНН КАК ИНН,
    | Остатки.ДокНомер.МП КАК МП,
    | Остатки.ДокНомер.МП.Куратор КАК Куратор,
    | Остатки.ДокНомер КАК ДокНомер,
    | Остатки.ДокНомер.ДатаСоставления КАК ДатаСчФ,
    | Остатки.ДокНомер.СрокДействия КАК Срок,
    | Остатки.ДокНомер.УсловиеПредоплаты КАК Условие,
    | СУММА(Остатки.КолвоРасход) КАК КолВо,
    | СУММА(Остатки.СуммаРасход) КАК Реализация
    |ПОМЕСТИТЬ ОстаткиАгрегат
    |ИЗ
    | РегистрНакопления.Остатки.ОстаткиИОбороты(&Начало, &Конец, День, , МП.Куратор = &Куратор) КАК Остатки
    |ГДЕ
    | Остатки.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И Остатки.Контрагенты.Сеть = ИСТИНА
    |СГРУППИРОВАТЬ ПО
    | Остатки.Номенклатура,
    | Остатки.Регион,
    | Остатки.Контрагенты,
    | Остатки.Контрагенты.ИНН,
    | Остатки.ДокНомер.МП,
    | Остатки.ДокНомер.МП.Куратор,
    | Остатки.ДокНомер,
    | Остатки.ДокНомер.ДатаСоставления,
    | Остатки.ДокНомер.СрокДействия,
    | Остатки.ДокНомер.УсловиеПредоплаты
    |;
    |
    |ВЫБРАТЬ
    | ОстаткиВозвраты.Номенклатура КАК Номенклатура,
    | ОстаткиВозвраты.Регион КАК Регион,
    | ОстаткиВозвраты.Контрагенты КАК Контрагенты,
    | ОстаткиВозвраты.Контрагенты.ИНН КАК ИНН,
    | ОстаткиВозвраты.ДокНомер.МП КАК МП,
    | ОстаткиВозвраты.ДокНомер.МП.Куратор КАК Куратор,
    | ОстаткиВозвраты.ДокНомер КАК ДокНомер,
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления КАК ДатаСчФ,
    | ОстаткиВозвраты.ДокНомер.СрокДействия КАК Срок,
    | ОстаткиВозвраты.ДокНомер.УсловиеПредоплаты КАК Условие,
    | СУММА(ОстаткиВозвраты.КолвоРасход) КАК КолВо,
    | СУММА(ОстаткиВозвраты.СуммаРасход) КАК Реализация
    |ПОМЕСТИТЬ Возвраты
    |ИЗ
    | РегистрНакопления.Остатки.ОстаткиИОбороты(&Начало, &КонецВозвратов, День, , МП.Куратор = &Куратор) КАК ОстаткиВозвраты
    |ГДЕ
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И ОстаткиВозвраты.КолвоРасход < 0
    | И ОстаткиВозвраты.Контрагенты.Сеть = ИСТИНА
    |СГРУППИРОВАТЬ ПО
    | ОстаткиВозвраты.Номенклатура,
    | ОстаткиВозвраты.Регион,
    | ОстаткиВозвраты.Контрагенты,
    | ОстаткиВозвраты.Контрагенты.ИНН,
    | ОстаткиВозвраты.ДокНомер.МП,
    | ОстаткиВозвраты.ДокНомер.МП.Куратор,
    | ОстаткиВозвраты.ДокНомер,
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления,
    | ОстаткиВозвраты.ДокНомер.СрокДействия,
    | ОстаткиВозвраты.ДокНомер.УсловиеПредоплаты
    |;
    |
    |ВЫБРАТЬ
    | Бонусы.ДокНомер КАК ДокНомер,
    | Бонусы.Номенклатура КАК Номенклатура,
    | Бонусы.ДокНомер.МП КАК МП,
    | Бонусы.ДокНомер.МП.Куратор КАК Куратор,
    | Бонусы.ДокНомер.Владелец КАК Контрагенты,
    | СУММА(Бонусы.СуммаПриход) КАК БонусНачисление,
    | СУММА(Бонусы.СуммаРасход) КАК БонусОплата
    |ПОМЕСТИТЬ БонусыАгрегат
    |ИЗ
    | РегистрНакопления.Бонусы.ОстаткиИОбороты(&Начало, &КонецВозвратов, День, , МП.Куратор = &Куратор) КАК Бонусы
    |ГДЕ
    | Бонусы.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И Бонусы.ДокНомер.Владелец.Сеть = ИСТИНА
    |СГРУППИРОВАТЬ ПО
    | Бонусы.ДокНомер,
    | Бонусы.Номенклатура,
    | Бонусы.ДокНомер.МП,
    | Бонусы.ДокНомер.МП.Куратор,
    | Бонусы.ДокНомер.Владелец
    |;
    |
    |ВЫБРАТЬ
    | ЕСТЬNULL(ОстаткиАгрегат.Номенклатура, БонусыАгрегат.Номенклатура) КАК Номенклатура,
    | ОстаткиАгрегат.Регион КАК Регион,
    | ЕСТЬNULL(ОстаткиАгрегат.Контрагенты, БонусыАгрегат.Контрагенты) КАК Контрагенты,
    | ОстаткиАгрегат.ИНН КАК ИНН,
    | ЕСТЬNULL(ОстаткиАгрегат.МП, БонусыАгрегат.МП) КАК МП,
    | ЕСТЬNULL(ОстаткиАгрегат.МП.Куратор, БонусыАгрегат.МП.Куратор) КАК Куратор,
    | ЕСТЬNULL(ОстаткиАгрегат.ДокНомер, БонусыАгрегат.ДокНомер) КАК ДокНомер,
    | ОстаткиАгрегат.ДатаСчФ КАК ДатаСчФ,
    | ОстаткиАгрегат.Срок КАК Срок,
    | ОстаткиАгрегат.Условие КАК Условие,
    | ЕСТЬNULL(ОстаткиАгрегат.КолВо, 0) + ЕСТЬNULL(Возвраты.КолВо, 0) КАК КолВо,
    | ЕСТЬNULL(ОстаткиАгрегат.Реализация, 0) + ЕСТЬNULL(Возвраты.Реализация, 0) КАК Реализация,
    | ЕСТЬNULL(БонусыАгрегат.БонусНачисление, 0) КАК БонусНачисление,
    | ЕСТЬNULL(БонусыАгрегат.БонусОплата, 0) КАК БонусОплата,
    | ЕСТЬNULL(БонусыАгрегат.БонусНачисление, 0) - ЕСТЬNULL(БонусыАгрегат.БонусОплата, 0) КАК БонусОстаток
    |ИЗ
    | ОстаткиАгрегат КАК ОстаткиАгрегат
    | ЛЕВОЕ СОЕДИНЕНИЕ Возвраты КАК Возвраты
    | ПО ОстаткиАгрегат.ДокНомер = Возвраты.ДокНомер
    | И ОстаткиАгрегат.Номенклатура = Возвраты.Номенклатура
    | И ОстаткиАгрегат.Контрагенты = Возвраты.Контрагенты
    | И ОстаткиАгрегат.МП = Возвраты.МП
    | ЛЕВОЕ СОЕДИНЕНИЕ БонусыАгрегат КАК БонусыАгрегат
    | ПО ОстаткиАгрегат.ДокНомер = БонусыАгрегат.ДокНомер
    | И ОстаткиАгрегат.Номенклатура = БонусыАгрегат.Номенклатура
    | И ОстаткиАгрегат.МП = БонусыАгрегат.МП
    | И ОстаткиАгрегат.Контрагенты = БонусыАгрегат.Контрагенты";
    Запрос.УстановитьПараметр("Начало", Объект.Начало);
    Запрос.УстановитьПараметр("Конец", Объект.Конец);
    Запрос.УстановитьПараметр("КонецВозвратов", КонецМесяца(ДобавитьМесяц(Объект.Конец, 1)));
    Запрос.УстановитьПараметр("Куратор", Объект.Куратор);
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Сообщить("За указанный период для куратора " + Объект.Куратор + " данных не найдено.", СтатусСообщения.Информация);
        Возврат;
    КонецЕсли;
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если НЕ ЗначениеЗаполнено(Выборка.МП) Тогда
            Сообщить("МП не заполнен для документа: " + Выборка.ДокНомер, СтатусСообщения.Внимание);
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(Выборка.Куратор) Тогда
            Сообщить("Куратор не заполнен для МП: " + Выборка.МП, СтатусСообщения.Внимание);
        КонецЕсли;
        НоваяСтрока = Объект.Табдок.Добавить();
        НоваяСтрока.Куратор = Выборка.Куратор;
        НоваяСтрока.МП = Выборка.МП;
        НоваяСтрока.Регион = Выборка.Регион;
        НоваяСтрока.Контрагенты = Выборка.Контрагенты;
        НоваяСтрока.ИНН = Выборка.ИНН;
        НоваяСтрока.Номенклатура = Выборка.Номенклатура;
        НоваяСтрока.ДокНомер = Строка(Выборка.ДокНомер);
        НоваяСтрока.ДатаСчФ = Выборка.ДатаСчФ;
        НоваяСтрока.Срок = Выборка.Срок;
        НоваяСтрока.Условие = Выборка.Условие;
        НоваяСтрока.КолВо = Выборка.КолВо;
        НоваяСтрока.Реализация = Выборка.Реализация;
        НоваяСтрока.БонусНачисление = Выборка.БонусНачисление;
        НоваяСтрока.БонусОплата = Выборка.БонусОплата;
        НоваяСтрока.БонусОстаток = Выборка.БонусОстаток;
        // Предполагаем, что КРеализации и КБонусы существуют в таблице, но не возвращаются запросом
        // Если они вычисляются, нужно добавить их логику здесь
        НоваяСтрока.КРеализации = 0; // Замените на актуальное вычисление, если необходимо
        НоваяСтрока.КБонусы = 0; // Замените на актуальное вычисление, если необходимо
        // Проверка отрицательной Реализации
        Если Выборка.Реализация < 0 Тогда
            НоваяСтрока.КолВо = 0;
            НоваяСтрока.Реализация=0;
            НоваяСтрока.КРеализации = 0;
            НоваяСтрока.БонусНачисление = 0;
            НоваяСтрока.БонусОплата = 0;
            НоваяСтрока.БонусОстаток = 0;
            НоваяСтрока.КБонусы = 0;
            НоваяСтрока.Цена = 0;
        Иначе
            Если Выборка.КолВо > 0 Тогда
                НоваяСтрока.Цена = Выборка.Реализация / Выборка.КолВо;
            Иначе
                НоваяСтрока.Цена = 0;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Сообщить("Табличная часть заполнена для куратора " + Объект.Куратор, СтатусСообщения.Информация);
КонецПроцедуры
&НаКлиенте
Процедура Возврать(Команда)
Если Объект.Тасдикланди=Истина
Тогда Сообщить ("ТАСДИКЛАНГАН документга узгартириш киритманг",СтатусСообщения.ОченьВажное);
Иначе
ВозвратьНаСервере();
ОбработатьТабличнуюЧасть();
Объект.Реализация=Объект.Табдок5.Итог("Реализация")+Объект.Табдок5.Итог("КРеализации");
Объект.БонусНачисление=Объект.Табдок5.Итог("БонусНачисление")+Объект.Табдок5.Итог("КБонусы");
Объект.БонусОстаток=Объект.Табдок5.Итог("БонусОстаток");
КонецЕсли
КонецПроцедуры
&НаСервере
Процедура ВозвратьНаСервере()
    // Проверка заполненности реквизитов
   Если Не ЗначениеЗаполнено(Объект.Начало) Или Не ЗначениеЗаполнено(Объект.Конец) Или Не ЗначениеЗаполнено(Объект.Куратор) Тогда
        Сообщить("Заполните поля Начало, Конец и Куратор!", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    // Диагностика параметров
    Сообщить("Период: " + Формат(Объект.Начало, "ДФ=dd.MM.yyyy") + " - " + Формат(Объект.Конец, "ДФ=dd.MM.yyyy"));
    Сообщить("Куратор: " + Объект.Куратор + ", Код: " + Объект.Куратор.Код);
    // Запрос
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | Остатки.Номенклатура КАК Номенклатура,
    | Остатки.Регион КАК Регион,
    | Остатки.Контрагенты КАК Контрагенты,
    | Остатки.Контрагенты.ИНН КАК ИНН,
    | Остатки.ДокНомер.МП КАК МП,
    | Остатки.ДокНомер.МП.Куратор КАК Куратор,
    | Остатки.ДокНомер КАК ДокНомер,
    | Остатки.ДокНомер.ДатаСоставления КАК ДатаСчФ,
    | Остатки.ДокНомер.СрокДействия КАК Срок,
    | Остатки.ДокНомер.УсловиеПредоплаты КАК Условие,
    | СУММА(Остатки.КолвоРасход) КАК КолВо,
    | СУММА(Остатки.СуммаРасход) КАК Реализация
    |ПОМЕСТИТЬ ОстаткиАгрегат
    |ИЗ
    | РегистрНакопления.Остатки.ОстаткиИОбороты(&Начало, &Конец, День, , МП.Куратор = &Куратор) КАК Остатки
    |ГДЕ
    | Остатки.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И Остатки.Контрагенты.Сеть = ЛОЖЬ
    |СГРУППИРОВАТЬ ПО
    | Остатки.Номенклатура,
    | Остатки.Регион,
    | Остатки.Контрагенты,
    | Остатки.Контрагенты.ИНН,
    | Остатки.ДокНомер.МП,
    | Остатки.ДокНомер.МП.Куратор,
    | Остатки.ДокНомер,
    | Остатки.ДокНомер.ДатаСоставления,
    | Остатки.ДокНомер.СрокДействия,
    | Остатки.ДокНомер.УсловиеПредоплаты
    |;
    |
    |ВЫБРАТЬ
    | ОстаткиВозвраты.Номенклатура КАК Номенклатура,
    | ОстаткиВозвраты.Регион КАК Регион,
    | ОстаткиВозвраты.Контрагенты КАК Контрагенты,
    | ОстаткиВозвраты.Контрагенты.ИНН КАК ИНН,
    | ОстаткиВозвраты.ДокНомер.МП КАК МП,
    | ОстаткиВозвраты.ДокНомер.МП.Куратор КАК Куратор,
    | ОстаткиВозвраты.ДокНомер КАК ДокНомер,
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления КАК ДатаСчФ,
    | ОстаткиВозвраты.ДокНомер.СрокДействия КАК Срок,
    | ОстаткиВозвраты.ДокНомер.УсловиеПредоплаты КАК Условие,
    | СУММА(ОстаткиВозвраты.КолвоРасход) КАК КолВо,
    | СУММА(ОстаткиВозвраты.СуммаРасход) КАК Реализация
    |ПОМЕСТИТЬ Возвраты
    |ИЗ
    | РегистрНакопления.Остатки.ОстаткиИОбороты(&Начало, &КонецВозвратов, День, , МП.Куратор = &Куратор) КАК ОстаткиВозвраты
    |ГДЕ
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И ОстаткиВозвраты.КолвоРасход > 0
    | И ОстаткиВозвраты.Контрагенты.Сеть = ЛОЖЬ
    |СГРУППИРОВАТЬ ПО
    | ОстаткиВозвраты.Номенклатура,
    | ОстаткиВозвраты.Регион,
    | ОстаткиВозвраты.Контрагенты,
    | ОстаткиВозвраты.Контрагенты.ИНН,
    | ОстаткиВозвраты.ДокНомер.МП,
    | ОстаткиВозвраты.ДокНомер.МП.Куратор,
    | ОстаткиВозвраты.ДокНомер,
    | ОстаткиВозвраты.ДокНомер.ДатаСоставления,
    | ОстаткиВозвраты.ДокНомер.СрокДействия,
    | ОстаткиВозвраты.ДокНомер.УсловиеПредоплаты
    |;
    |
    |ВЫБРАТЬ
    | Бонусы.ДокНомер КАК ДокНомер,
    | Бонусы.Номенклатура КАК Номенклатура,
    | Бонусы.ДокНомер.МП КАК МП,
    | Бонусы.ДокНомер.МП.Куратор КАК Куратор,
    | Бонусы.ДокНомер.Владелец КАК Контрагенты,
    | СУММА(Бонусы.СуммаПриход) КАК БонусНачисление,
    | СУММА(Бонусы.СуммаРасход) КАК БонусОплата
    |ПОМЕСТИТЬ БонусыАгрегат
    |ИЗ
    | РегистрНакопления.Бонусы.ОстаткиИОбороты(&Начало, &КонецВозвратов, День, , МП.Куратор = &Куратор) КАК Бонусы
    |ГДЕ
    | Бонусы.ДокНомер.ДатаСоставления МЕЖДУ &Начало И &Конец
    | И Бонусы.ДокНомер.Владелец.Сеть = ЛОЖЬ
    |СГРУППИРОВАТЬ ПО
    | Бонусы.ДокНомер,
    | Бонусы.Номенклатура,
    | Бонусы.ДокНомер.МП,
    | Бонусы.ДокНомер.МП.Куратор,
    | Бонусы.ДокНомер.Владелец
    |;
    |
    |ВЫБРАТЬ
    | ЕСТЬNULL(ОстаткиАгрегат.Номенклатура, БонусыАгрегат.Номенклатура) КАК Номенклатура,
    | ОстаткиАгрегат.Регион КАК Регион,
    | ЕСТЬNULL(ОстаткиАгрегат.Контрагенты, БонусыАгрегат.Контрагенты) КАК Контрагенты,
    | ОстаткиАгрегат.ИНН КАК ИНН,
    | ЕСТЬNULL(ОстаткиАгрегат.МП, БонусыАгрегат.МП) КАК МП,
    | ЕСТЬNULL(ОстаткиАгрегат.МП.Куратор, БонусыАгрегат.МП.Куратор) КАК Куратор,
    | ЕСТЬNULL(ОстаткиАгрегат.ДокНомер, БонусыАгрегат.ДокНомер) КАК ДокНомер,
    | ОстаткиАгрегат.ДатаСчФ КАК ДатаСчФ,
    | ОстаткиАгрегат.Срок КАК Срок,
    | ОстаткиАгрегат.Условие КАК Условие,
    | ЕСТЬNULL(ОстаткиАгрегат.КолВо, 0) - ЕСТЬNULL(Возвраты.КолВо, 0) КАК КолВо,
    | ЕСТЬNULL(ОстаткиАгрегат.Реализация, 0) - ЕСТЬNULL(Возвраты.Реализация, 0) КАК Реализация,
    | ЕСТЬNULL(БонусыАгрегат.БонусНачисление, 0) КАК БонусНачисление,
    | ЕСТЬNULL(БонусыАгрегат.БонусОплата, 0) КАК БонусОплата,
    | ЕСТЬNULL(БонусыАгрегат.БонусНачисление, 0) - ЕСТЬNULL(БонусыАгрегат.БонусОплата, 0) КАК БонусОстаток
    |ИЗ
    | ОстаткиАгрегат КАК ОстаткиАгрегат
    | ЛЕВОЕ СОЕДИНЕНИЕ Возвраты КАК Возвраты
    | ПО ОстаткиАгрегат.ДокНомер = Возвраты.ДокНомер
    | И ОстаткиАгрегат.Номенклатура = Возвраты.Номенклатура
    | И ОстаткиАгрегат.Контрагенты = Возвраты.Контрагенты
    | И ОстаткиАгрегат.МП = Возвраты.МП
    | ЛЕВОЕ СОЕДИНЕНИЕ БонусыАгрегат КАК БонусыАгрегат
    | ПО ОстаткиАгрегат.ДокНомер = БонусыАгрегат.ДокНомер
    | И ОстаткиАгрегат.Номенклатура = БонусыАгрегат.Номенклатура
    | И ОстаткиАгрегат.МП = БонусыАгрегат.МП
    | И ОстаткиАгрегат.Контрагенты = БонусыАгрегат.Контрагенты";
    Запрос.УстановитьПараметр("Начало", Объект.Начало);
    Запрос.УстановитьПараметр("Конец", Объект.Конец);
    Запрос.УстановитьПараметр("КонецВозвратов", КонецМесяца(ДобавитьМесяц(Объект.Конец, 1)));
    Запрос.УстановитьПараметр("Куратор", Объект.Куратор);
    Результат = Запрос.Выполнить();
   
    Объект.Табдок5.Очистить();
    Если Результат.Пустой() Тогда
        Сообщить("Данных за период не найдено.", СтатусСообщения.Информация);
        Возврат;
    КонецЕсли;
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        // ГЛАВНОЕ УСЛОВИЕ: оставляем ТОЛЬКО если итоговая реализация отрицательная
        Если Выборка.Реализация >= 0 Тогда
            Продолжить; // Это не возврат — пропускаем строку полностью
        КонецЕсли;
        НоваяСтрока = Объект.Табдок5.Добавить();
       
        // Копируем всё как есть
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
        НоваяСтрока.ДокНомер = Строка(Выборка.ДокНомер);
        // Делаем отрицательные значения положительными — чтобы в таблице возврат выглядел красиво
        НоваяСтрока.КолВо = -Выборка.КолВо;
        НоваяСтрока.Реализация = -Выборка.Реализация;
        // Цена по модулю
        НоваяСтрока.Цена = ?(НоваяСтрока.КолВо > 0, НоваяСтрока.Реализация / НоваяСтрока.КолВо, 0);
        // Бонусы и корректировки — обнуляем (в возвратах обычно не нужны)
        НоваяСтрока.БонусНачисление = 0;
        НоваяСтрока.БонусОплата = 0;
        НоваяСтрока.БонусОстаток = 0;
        НоваяСтрока.КРеализации = 0;
        НоваяСтрока.КБонусы = 0;
    КонецЦикла;
    Если Объект.Табдок5.Количество() = 0 Тогда
        Сообщить("Возвратов (отрицательных реализаций) за указанный период не найдено.", СтатусСообщения.Информация);
    Иначе
        Сообщить("Загружено только возвратов: " + Объект.Табдок5.Количество() + " строк.", СтатусСообщения.Информация);
    КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ОбработатьТабличнуюЧастьВозвраты()
    Объект.Реализация = Объект.Табдок5.Итог("Реализация"); // уже положительные суммы возвратов
    Объект.БонусНачисление = 0;
    Объект.БонусОстаток = 0;
    Если Объект.Табдок5.Количество() = 0 Тогда
