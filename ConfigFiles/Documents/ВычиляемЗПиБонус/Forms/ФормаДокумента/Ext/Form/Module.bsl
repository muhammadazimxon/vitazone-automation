&НаСервере
Процедура РассчитатьРМНаСервере()
    
    // Читаем данные из регистра (срез последних, предполагаем периодический регистр)
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   НадбавкиРМ.Первый КАК Первый,
    |   НадбавкиРМ.Второй КАК Второй,
    |   НадбавкиРМ.Третий КАК Третий,
    |   НадбавкиРМ.Четвертый КАК Четвертый,
    |   НадбавкиРМ.Пятый КАК Пятый,
    |   НадбавкиРМ.Шестой КАК Шестой,
    |   НадбавкиРМ.Седьмой КАК Седьмой,
    |   НадбавкиРМ.Восьмой КАК Восьмой,
    |   НадбавкиРМ.Кф1 КАК Кф1,
    |   НадбавкиРМ.Кф2 КАК Кф2,
    |   НадбавкиРМ.Кф3 КАК Кф3,
    |   НадбавкиРМ.Кф4 КАК Кф4,
    |   НадбавкиРМ.Кф5 КАК Кф5,
    |   НадбавкиРМ.Кф6 КАК Кф6,
    |   НадбавкиРМ.Кф7 КАК Кф7,
    |   НадбавкиРМ.Кф8 КАК Кф8
    |ИЗ
    |   РегистрСведений.НадбавкиРМ.СрезПоследних КАК НадбавкиРМ";
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Если Выборка.Следующий() Тогда
        
        // Собираем пороги и надбавки в массивы для удобства (индексы 0-7)
        Пороги = Новый Массив;
        Пороги.Добавить(Выборка.Первый);
        Пороги.Добавить(Выборка.Второй);
        Пороги.Добавить(Выборка.Третий);
        Пороги.Добавить(Выборка.Четвертый);
        Пороги.Добавить(Выборка.Пятый);
        Пороги.Добавить(Выборка.Шестой);
        Пороги.Добавить(Выборка.Седьмой);
        Пороги.Добавить(Выборка.Восьмой);
        
        Надбавки = Новый Массив;
        Надбавки.Добавить(Выборка.Кф1);
        Надбавки.Добавить(Выборка.Кф2);
        Надбавки.Добавить(Выборка.Кф3);
        Надбавки.Добавить(Выборка.Кф4);
        Надбавки.Добавить(Выборка.Кф5);
        Надбавки.Добавить(Выборка.Кф6);
        Надбавки.Добавить(Выборка.Кф7);
        Надбавки.Добавить(Выборка.Кф8);
        
        // Проходим по табличной части (Объект.Табдок4 — замените на реальное имя)
        Для Каждого СтрокаТЧ Из Объект.Табдок3 Цикл
            
            // Предполагаем, что "значение" — это реквизит "База" в строке ТЧ.
            // Если это другой реквизит (например, "Объем" или "СуммаБаза"), замените.
            Значение = СтрокаТЧ.КРеализации+СтрокаТЧ.Реализация; // Уточните имя реквизита!
            
            // Определяем надбавку по порогам
            Надбавка = 0; // По умолчанию, если > всех порогов
            Для Индекс = 0 По 7 Цикл
                Если Значение <= Пороги[Индекс] Тогда
                    Надбавка = Надбавки[Индекс];
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            
            // Устанавливаем рассчитанную сумму (здесь Сумма = Надбавка; если нужно добавить к базе, то СтрокаТЧ.Сумма = СтрокаТЧ.База + Надбавка)
            СтрокаТЧ.ЗП = СтрокаТЧ.ЗП+Надбавка;
            
        КонецЦикла;
        
    Иначе
        Сообщить("Нет данных в регистре НадбавкиРМ!");
    КонецЕсли;
    
КонецПроцедуры






