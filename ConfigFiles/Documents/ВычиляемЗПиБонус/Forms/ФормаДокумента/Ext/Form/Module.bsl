// КОМАНДА ФОРМЫ
&НаКлиенте
Процедура УдалитьСтрокиКромеРуч(Команда)
    // Можно спросить подтверждение (по желанию):
    //Если Вопрос("Удалить все строки, кроме отмеченных 'Руч'?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
    // Возврат;
    //КонецЕсли;
Если Объект.Тасдикланди=Истина
Тогда Сообщить ("ТАСДИКЛАНГАН документга узгартириш киритманг",СтатусСообщения.ОченьВажное);
Иначе
    КолВоУдалено = ОставитьТолькоРучныеНаСервере();
    // Аккуратно обновим элемент формы, если он есть
    Элемент = Элементы.Найти("Табдок");
    Если Элемент <> Неопределено Тогда
        Элемент.Обновить();
    КонецЕсли;
    Если КолВоУдалено > 0 Тогда
        Сообщить("Удалено строк: " + КолВоУдалено);
    Иначе
        Сообщить("Нечего удалять — все строки помечены 'Руч'.");
КонецЕсли;
КонецЕсли
КонецПроцедуры
// СЕРВЕР
&НаСервере
Функция ОставитьТолькоРучныеНаСервере() Экспорт
    КУдалению = Новый Массив;
    Для Каждого Строка Из Объект.Табдок Цикл
        Если Не Строка.Руч Тогда
            КУдалению.Добавить(Строка);
        КонецЕсли;
    КонецЦикла;
    Для Каждого СтрокаКУдалению Из КУдалению Цикл
        Объект.Табдок.Удалить(СтрокаКУдалению);
    КонецЦикла;
    Возврат КУдалению.Количество();
КонецФункции
