// Обработка табличной части с учетом возвратов
&НаКлиенте
Процедура ОбработатьТабличнуюЧасть()
    КУдалению = Новый Массив;
    // Инициализируем итоговые суммы
    Объект.Реализация = 0;
    Объект.БонусНачисление = 0;
    Объект.БонусОстаток = 0;
    Для Каждого Строка Из Объект.Табдок Цикл
        НачалоМесяцаДатаСчФ = НачалоМесяца(Строка.ДатаСчФ);
        НачалоМесяцаДатаДок = НачалоМесяца(Объект.Дата);
       
        Если Строка.КолВо < 0 Тогда
            Сообщить("Возврат: Кол-во: " + Формат(Строка.КолВо, "ЧГ=0; ЧД=0") +
                " шт; Месяц СФ: " + Формат(НачалоМесяцаДатаСчФ, "ДФ=MM.yyyy") +
                "; Месяц документа: " + Формат(НачалоМесяцаДатаДок, "ДФ=MM.yyyy"), СтатусСообщения.ОченьВажное);
           
            Если НачалоМесяцаДатаСчФ < НачалоМесяца(Объект.Начало) Или НачалоМесяцаДатаСчФ > НачалоМесяца(Объект.Конец) Тогда
                КУдалению.Добавить(Строка);
                Продолжить;
            КонецЕсли;
        КонецЕсли;
        // Учитываем все строки в итоговых суммах
        Объект.Реализация = Объект.Реализация + ?(Строка.Реализация = Неопределено, 0, Строка.Реализация) + ?(Строка.КРеализации = Неопределено, 0, Строка.КРеализации);
        Объект.БонусНачисление = Объект.БонусНачисление + ?(Строка.БонусНачисление = Неопределено, 0, Строка.БонусНачисление) + ?(Строка.КБонусы = Неопределено, 0, Строка.КБонусы);
        Объект.БонусОстаток = Объект.БонусОстаток + ?(Строка.БонусОстаток = Неопределено, 0, Строка.БонусОстаток);
    КонецЦикла;
    // Удаляем строки, не относящиеся к периоду счетов-фактур
    Для Каждого СтрКУдалению Из КУдалению Цикл
        Объект.Табдок.Удалить(СтрКУдалению);
    КонецЦикла;
    Если КУдалению.Количество() > 0 Тогда
        Сообщить("Удалено строк: " + КУдалению.Количество() + ", не соответствующих периоду счетов-фактур.", СтатусСообщения.Информация);
    КонецЕсли;
    Если Объект.Табдок.Количество() = 0 Тогда
        Сообщить("Табличная часть Табдок пуста после обработки!", СтатусСообщения.Важное);
    Иначе
        Сообщить("Итоговые суммы: Реализация = " + Формат(Объект.Реализация, "ЧДЦ=2") +
                 ", БонусНачисление = " + Формат(Объект.БонусНачисление, "ЧДЦ=2") +
                 ", БонусОстаток = " + Формат(Объект.БонусОстаток, "ЧДЦ=2"), СтатусСообщения.Информация);
    КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура Ставки(Команда)
    // Проверяем заполненность куратора на клиенте
    Если Не ЗначениеЗаполнено(Объект.Куратор) Тогда
        Сообщить("Не указан куратор!");
        Возврат;
    КонецЕсли;
   
    // Вызываем серверную процедуру
    ЗаполнитьСтавкиНаСервере();
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьСтавкиНаСервере()
   
    // Дата документа для среза
    ДатаСреза = Объект.Дата;
    Куратор = Объект.Куратор;
   
    // Запрос к регистру сведений
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | УчетЗПБонусовСрезПоследних.Куратор,
    | УчетЗПБонусовСрезПоследних.Выше,
    | УчетЗПБонусовСрезПоследних.Ниже,
| УчетЗПБонусовСрезПоследних.Порог,
| УчетЗПБонусовСрезПоследних.ВышеПорога,
    | УчетЗПБонусовСрезПоследних.Кураторские
    |ИЗ
    | РегистрСведений.УчетЗПБонусов.СрезПоследних(&ДатаСреза, Куратор = &Куратор) КАК УчетЗПБонусовСрезПоследних";
   
    Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
    Запрос.УстановитьПараметр("Куратор", Куратор);
   
    РезультатЗапроса = Запрос.Выполнить();
   
    Если РезультатЗапроса.Пустой() Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Данные по куратору на дату " + Формат(ДатаСреза, "ДФ=dd.MM.yyyy") + " не найдены!";
        Сообщение.Сообщить();
        Возврат;
    КонецЕсли;
   
    // Получаем данные из результата
    Выборка = РезультатЗапроса.Выбрать();
    Выборка.Следующий();
   
    // Заполняем реквизиты документа
    Объект.Выше = Выборка.Выше;
    Объект.Ниже = Выборка.Ниже;
Объект.Порог = Выборка.Порог;
Объект.ВышеПорога = Выборка.ВышеПорога;
    Объект.Кураторские = Выборка.Кураторские;
   
    // Обновляем форму (не нужно использовать ЗначениеВРеквизитФормы, так как работаем напрямую с Объект)
    Модифицированность = Истина; // Устанавливаем флаг изменения формы
   
    // Сообщаем об успешном заполнении
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = "Реквизиты документа успешно заполнены!";
    Сообщение.Сообщить();
   
КонецПроцедуры
