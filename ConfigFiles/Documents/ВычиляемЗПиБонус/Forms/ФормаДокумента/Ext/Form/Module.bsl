Процедура Расчитать(Команда)
// Проверяем заполненность реквизитов документа
Если НЕ ЗначениеЗаполнено(Объект.Сумма) Тогда
Сообщить("Не заполнен реквизит Сумма!", СтатусСообщения.Важное);
Возврат;
КонецЕсли;
Если НЕ ЗначениеЗаполнено(Объект.Выше) Тогда
Сообщить("Не заполнен реквизит Выше!", СтатусСообщения.Важное);
//Возврат;
КонецЕсли;
Если НЕ ЗначениеЗаполнено(Объект.Ниже) Тогда
Сообщить("Не заполнен реквизит Ниже!", СтатусСообщения.Важное);
//Возврат;
КонецЕсли;
Если НЕ ЗначениеЗаполнено(Объект.Кураторские) Тогда
Сообщить("Не заполнен реквизит Кураторские!", СтатусСообщения.Важное);
//Возврат;
КонецЕсли;
// Проверяем, есть ли данные в Табдок2
Если Объект.Табдок2.Количество() = 0 Тогда
Сообщить("Табличная часть Табдок2 пуста! Выполните команду Обитожить.", СтатусСообщения.Важное);
Возврат;
КонецЕсли;
// Проверяем, есть ли данные в Табдок3
Если Объект.Табдок3.Количество() = 0 Тогда
Сообщить("Табличная часть Табдок3 пуста! Выполните команду Обитожить.", СтатусСообщения.Важное);
Возврат;
КонецЕсли;
// Рассчитываем ЗП для Табдок2
Для Каждого СтрокаТабдок2 Из Объект.Табдок2 Цикл
   
    Если НЕ ЗначениеЗаполнено(СтрокаТабдок2.МП) Тогда
        Сообщить("Обнаружена строка с пустым МП в Табдок2, строка №" + СтрокаТабдок2.НомерСтроки, СтатусСообщения.Важное);
        Продолжить;
    КонецЕсли;
   
    // Сумма продаж для проверки порогов
    СуммаПродаж = СтрокаТабдок2.Реализация; // Или (СтрокаТабдок2.КРеализации + СтрокаТабдок2.Реализация), если нужно учитывать оба
   
    // Выбираем процент в зависимости от реализации и порогов
    Если ЗначениеЗаполнено(Объект.Порог) И СуммаПродаж >= Объект.Порог Тогда
        Процент = Объект.ВышеПорога; // 10% для превышения индивидуального порога (150/200 млн)
    ИначеЕсли СуммаПродаж >= Объект.Сумма Тогда
        Процент = Объект.Выше; // 9% для базового порога (100 млн)
    Иначе
        Процент = Объект.Ниже; // 8% если ниже базового
    КонецЕсли;
   
    // Рассчитываем ЗП
    СтрокаТабдок2.ЗП = (СтрокаТабдок2.КРеализации + СтрокаТабдок2.Реализация) * Процент / 100;
   
    // Сообщение для отладки
    Сообщить("Рассчитана ЗП для МП " + СтрокаТабдок2.МП + ": " + СтрокаТабдок2.ЗП + " (процент: " + Процент + "%)");
   
КонецЦикла;
// Рассчитываем ЗП для Табдок3
Для Каждого СтрокаТабдок3 Из Объект.Табдок3 Цикл
