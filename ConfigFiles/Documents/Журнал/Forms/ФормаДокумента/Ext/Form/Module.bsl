				КонецЕсли;
				
				
					
					Если ПустаяСтрока(Элемент.Контрагенты) Тогда
					СоздатьКонтр(Элемент.ЗКонтрагенты,Элемент.ЗИНН,МП2Оламиз(ЗапасМП));
