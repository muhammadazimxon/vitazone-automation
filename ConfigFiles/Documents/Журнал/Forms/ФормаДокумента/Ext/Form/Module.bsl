&НаКлиенте
Процедура Команда2(Команда)
	Для Каждого Элемент Из Объект.Табдок2 Цикл
		
		
			
		Если ПустаяСтрока(Элемент.ЗИНН) = ЛОЖЬ Тогда
			Элемент.Контрагенты=КонтрОламиз(Элемент.Зинн);
			
		КонецЕсли;
		
		//////Элемент.ТипОплаты=Типоплатыоламиз("2");
		//Элемент.Дата=Объект.Дата;
		//Если Элемент.Приход<>0 Тогда
		//	Элемент.Примечание="Оплата";
		//Иначе  
		//	Элемент.Примечание="Расход";
		//КонецЕсли;
		Если ПустаяСтрока(Элемент.Организация)=Истина
			Тогда 
			Элемент.Организация=КассаниКурсатиш("Касса");
			КонецЕсли;
			
		Если ПустаяСтрока(Элемент.ФинИст)= Истина
			Тогда 
			  Элемент.Финансирование=ФинИсточник("Фойдадан");
		  КонецЕсли;
		  
		  
		Если ПустаяСтрока(Элемент.МП)= Истина
			Тогда 
			  Элемент.МП=КонтрагенМП(Элемент.Контрагенты);
		  КонецЕсли;
		  
		  
		  Если ПустаяСтрока(Элемент.Статья)=Истина Тогда
		  
		  Если Найти(Элемент.Назначение, "доставка")>0 ИЛИ Найти(Элемент.Назначение, "Доставка")>0  
			  тогда 
			  Вариант1="Доставка";
			  Элемент.Статья= НазначениеТексти(Вариант1);
			  
		  ИначеЕсли Найти(Элемент.Назначение, "аванс")>0  ИЛИ Найти(Элемент.Назначение, "ойлик")>0  ИЛИ Найти(Элемент.Назначение, "оулик")>0
			  Тогда
			  Вариант1="Зарплата";
			  Элемент.Статья= НазначениеТексти(Вариант1);
			  
		  ИначеЕсли Найти(Элемент.Назначение, "бунус")>0   ИЛИ Найти(Элемент.Назначение, "бонус")>0

			  Тогда
			  Вариант1="Бонусы";
			  Элемент.Статья= НазначениеТексти(Вариант1);
			  
		  ИначеЕсли Найти(Элемент.Назначение, "авиа")>0
			  Тогда
			  Вариант1="Командировки";
			  Элемент.Статья= НазначениеТексти(Вариант1);
			  
		ИначеЕсли Найти(Элемент.Назначение, "пред.инв")>0  ИЛИ Найти(Элемент.Назначение, "пред инв")>0

			  Тогда
			  Вариант1="Пред.инв";
			  Элемент.Статья= НазначениеТексти(Вариант1);
  


		ИначеЕсли Найти(Элемент.Назначение, "под.от")>0  ИЛИ Найти(Элемент.Назначение, "под от")>0

			  Тогда
			  Вариант1="Под отчет";
			  Элемент.Статья= НазначениеТексти(Вариант1);
  
			  
			  
		  ИначеЕсли Найти(Элемент.Назначение, " ПО")>0 ИЛИ Найти(Элемент.Назначение, " по")>0 
			  тогда
			 Вариант1="Пул олган";
			  Элемент.Статья= НазначениеТексти(Вариант1); 
			  
			  		  
			ИначеЕсли Найти(Элемент.Назначение, "Курс")>0 ИЛИ Найти(Элемент.Назначение, "курс")>0

			  Тогда
			  Вариант1="Курсовая разница";
			  Элемент.Статья= НазначениеТексти(Вариант1);

			  
		  ИначеЕсли ПустаяСтрока(Элемент.Статья)=Истина Тогда
			  Вариант1="Прочие";
			  Элемент.Статья= НазначениеТексти(Вариант1);

		  КонецЕсли;
	  КонецЕсли;
	  
	  Если ПустаяСтрока(Элемент.НомерДок)=Ложь Тогда
		  Элемент.НомерДокС=НомерДокОлиш(Элемент.НомерДок);
	  КонецЕсли;
	  Если ПустаяСтрока(Элемент.Регион)=Истина тогда
		  Элемент.Регион=КонтрагенРегион(Элемент.Контрагенты);
	  КонецЕсли
	  
		//Если ПустаяСтрока(Элемент.Регион)= Истина
		//	Тогда 
		//	  Элемент.Регион=КонтрагенРегион(Элемент.Регион);
		//КонецЕсли;
   
		 
		 КонеЦЦикла;
	 Объект.Приход=Объект.Табдок.Итог("Приход");
		 Объект.Расход=Объект.Табдок.Итог("Расход");
		 Объект.ПриходНал=Объект.Табдок2.Итог("Приход");
		 Объект.РасходНал=Объект.Табдок2.Итог("Расход");
		 Объект.ПриходВсего=Объект.Приход+Объект.ПриходНал;
		 Объект.РасходВсего=Объект.Расход+Объект.РасходНал;
КонецПроцедуры



