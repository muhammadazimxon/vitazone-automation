					//	Элемент.Контрагенты=Контр2Наим(Элемент.ЗКонтрагенты);
					//КонецЕсли
									
				КонецЕсли;
				КонецЕсли;

				
				Если ТипОплатАниклаймиз2(Элемент.ТипОплаты)="2" Тогда
					Элемент.Перенос=Истина;
					ПереносСтроки(Объект.Табдок, Объект.Табдок2);
				ИначеЕсли
					 ТипОплатАниклаймиз2(Элемент.ТипОплаты)<>"1" 
