				КонецЕсли;
		//		Элемент.Регион=Регион2Оламиз(Элемент.Контрагенты);
			КонецЕсли;
						
			Если ПустаяСтрока(Элемент.Контрагенты) Тогда
					//Элемент.Контрагенты=ЗначениеЗаполнено("");
					Элемент.Контрагенты=Контр2Наим(Элемент.ЗКонтрагенты);
