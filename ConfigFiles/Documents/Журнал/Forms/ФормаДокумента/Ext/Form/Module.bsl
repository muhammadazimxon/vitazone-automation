		Если ПустаяСтрока(Элемент.Организация)=Истина ТОгда
			
			Элемент.Организация=Объект.Счет;	
			
		КонецЕсли;
		
				Если ПустаяСтрока(Элемент.Контрагенты) Тогда
				Элемент.Контрагенты=КонтрОламиз(Элемент.ЗИНН);
