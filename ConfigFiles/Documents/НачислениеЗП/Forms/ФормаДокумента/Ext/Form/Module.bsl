&НаСервере
Процедура ЗаполнитьТабличнуюЧасть()
Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Менеджер.Ссылка
        |ИЗ
        |    Справочник.Менеджер КАК Менеджер";

    РезультатЗапроса = Запрос.Выполнить().Выгрузить();
    
    Для каждого Стр из РезультатЗапроса Цикл
        НоваяСтрока = Объект.Табдок.Добавить();
        НоваяСтрока.Менеджеры = Стр.Ссылка;
    КонецЦикла
КонецПроцедуры

&НаКлиенте
Процедура Команда1(Команда)
	ЗаполнитьТабличнуюЧасть();
КонецПроцедуры





&НаКлиенте
Процедура Команда2(Команда)
