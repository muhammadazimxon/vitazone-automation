		Эл.Статья=СтатьяОламиз();

		КонецЦикла
КонецПроцедуры

&НаСервере
Функция КураторОборотОламиз (Начало,Конец,Сотрудник) 
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиОстаткиИОбороты.МП КАК МП,
		|	ОстаткиОстаткиИОбороты.СуммаРасход КАК СуммаРасход,
		|	ОстаткиОстаткиИОбороты.Куратор КАК Куратор,
		|	ОстаткиОстаткиИОбороты.Куратор КАК Кураторские,
		|	ОстаткиОстаткиИОбороты.КолвоРасход КАК КолвоРасход,
		|	ОстаткиОстаткиИОбороты.КураторскиеРасход КАК КураторскиеРасход
		|ИЗ
		|	РегистрНакопления.Остатки.ОстаткиИОбороты(&Начало, &Конец, , , ) КАК ОстаткиОстаткиИОбороты
		|ГДЕ
		|	ОстаткиОстаткиИОбороты.Куратор = &Сотрудник";
	
	Запрос.УстановитьПараметр("КОНЕЦ", Конец);
	Запрос.УстановитьПараметр("НАЧАЛО", Начало);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.КураторскиеРасход;
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

	
	
