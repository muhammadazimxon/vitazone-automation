&НаКлиенте
Процедура ПоставитьПриИзменении(Элемент)
	Если Объект.Поставить=Истина Тогда
		Для Каждого Эл ИЗ Объект.Табдок Цикл
			Эл.Коэф=Объект.Коэф;
		КонецЦикла;
		ИНАЧЕ
		Для Каждого Эл ИЗ Объект.Табдок Цикл
			Эл.Коэф=0;
		КонецЦикла;
		КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура Расчет(Команда)
	
	Для Каждого Эл ИЗ Объект.Табдок Цикл
		Если Эл.Ручная=Ложь Тогда
		Эл.Сумма=Эл.Коэф/100*Эл.Реализация;
		Эл.КСумма1=Эл.КурКоэф/100*Эл.Ксумма;
		КонецЕсли;
	КонецЦикла;
	Объект.Всего=Объект.Табдок.Итог("Сумма");
	Объект.КурВсего=Объект.Табдок.Итог("КСУММА1");
КонецПроцедуры

&НаКлиенте
Процедура ТабдокСуммаПриИзменении(Элемент)
	Объект.Всего=Объект.Табдок.Итог("Сумма");
	Объект.КурВсего=Объект.Табдок.Итог("КСУММА");
КонецПроцедуры

&НаКлиенте
Процедура Пустые(Команда)
	Для Каждого Эл Из Объект.Табдок Цикл
		Если Эл.Сумма+Эл.Вычеты+Эл.Реализация+Эл.КСумма=0 Тогда
			Объект.Табдок.Удалить(Эл);
			КонецЕсли;
		КонецЦикла;
		
КонецПроцедуры

