&НаСервере
Процедура ЗаполнитьНаСервере()
 // Очистка табличной части перед расчетом
    Объект.Табдок2.Очистить();

// 1. Получаем данные о продажах за период
Запрос = Новый Запрос;
Запрос.Текст = 
"ВЫБРАТЬ
|    Остатки.МП КАК Менеджер,
|    Остатки.Куратор КАК Куратор,
|    СУММА(Остатки.Сумма)/2 КАК СуммаПродаж
|ИЗ
|    РегистрНакопления.Остатки КАК Остатки
|ГДЕ
|    Остатки.Период МЕЖДУ &Начало И &Конец
|СГРУППИРОВАТЬ ПО
|    Остатки.МП,
|    Остатки.Куратор
|ИМЕЮЩИЕ
|    СУММА(Остатки.Сумма) > 0";

Запрос.УстановитьПараметр("Начало", Объект.Начало);
Запрос.УстановитьПараметр("Конец", Объект.Конец_);
РезультатПродажи = Запрос.Выполнить().Выгрузить();

// Отладочный вывод для проверки
Для Каждого Строка Из РезультатПродажи Цикл
    Сообщить("Менеджер: " + Строка.Менеджер + ", Куратор: " + Строка.Куратор + ", СуммаПродаж: " + Строка.СуммаПродаж);
КонецЦикла;

// 2. Получаем параметры ставок кураторов
Запрос = Новый Запрос;
Запрос.Текст = 
"ВЫБРАТЬ
|    Ставки.Куратор КАК Куратор,
|    Ставки.ТипСтавки КАК ТипСтавки,
|    Ставки.Процент КАК Процент,
|    Ставки.ГраницаСуммы КАК ГраницаСуммы,
|    Ставки.ПроцентВышеГраницы КАК ПроцентВышеГраницы,
|    Ставки.ФиксированнаяСумма КАК ФиксированнаяСумма,
|    Ставки.НадбавкаКуратора КАК НадбавкаКуратора
|ИЗ
|    РегистрСведений.СтавкиЗарплатыКураторов.СрезПоследних(&Конец, ) КАК Ставки";

Запрос.УстановитьПараметр("Конец", Объект.Конец_);
РезультатСтавки = Запрос.Выполнить().Выгрузить();

// 3. Заполняем табличную часть для менеджеров
Для Каждого СтрокаПродажи Из РезультатПродажи Цикл
    НоваяСтрока = Объект.Табдок2.Добавить();
    НоваяСтрока.Менеджер = СтрокаПродажи.Менеджер;
    НоваяСтрока.Куратор = СтрокаПродажи.Куратор;
    НоваяСтрока.СуммаПродаж = СтрокаПродажи.СуммаПродаж;
    
    // Находим параметры куратора
    СтрокаСтавки = РезультатСтавки.Найти(СтрокаПродажи.Куратор, "Куратор");
    Если СтрокаСтавки <> Неопределено Тогда
        НоваяСтрока.ТипСтавки = СтрокаСтавки.ТипСтавки;
        
        // Расчет зарплаты менеджера
        Если СтрокаСтавки.ТипСтавки = Перечисления.ТипСтавки.Фиксированная Тогда
            НоваяСтрока.Зарплата = СтрокаСтавки.ФиксированнаяСумма;
        ИначеЕсли СтрокаСтавки.ТипСтавки = Перечисления.ТипСтавки.Процентная Тогда
            Если СтрокаПродажи.СуммаПродаж <= СтрокаСтавки.ГраницаСуммы Тогда
                НоваяСтрока.Зарплата = СтрокаПродажи.СуммаПродаж * СтрокаСтавки.Процент / 100;
            Иначе
                НоваяСтрока.Зарплата = СтрокаПродажи.СуммаПродаж * СтрокаСтавки.ПроцентВышеГраницы / 100;
            КонецЕсли;
        ИначеЕсли СтрокаСтавки.ТипСтавки = Перечисления.ТипСтавки.ПроцентПлюсФикс Тогда
            Если СтрокаПродажи.СуммаПродаж <= СтрокаСтавки.ГраницаСуммы Тогда
                НоваяСтрока.Зарплата = СтрокаПродажи.СуммаПродаж * СтрокаСтавки.Процент / 100 + СтрокаСтавки.ФиксированнаяСумма;
            Иначе
                НоваяСтрока.Зарплата = СтрокаПродажи.СуммаПродаж * СтрокаСтавки.ПроцентВышеГраницы / 100 + СтрокаСтавки.ФиксированнаяСумма;
            КонецЕсли;
        КонецЕсли;
        
        НоваяСтрока.ИтоговаяЗарплата = НоваяСтрока.Зарплата; // Пока без надбавки
    Иначе
        Сообщить("Для куратора " + СтрокаПродажи.Куратор + " не найдены ставки!");
    КонецЕсли;
КонецЦикла;

// 4. Расчет надбавки для кураторов
Кураторы = Объект.Табдок2.Выгрузить(, "Куратор");
Кураторы.Свернуть("Куратор");

Для Каждого СтрокаКуратор Из Кураторы Цикл
    Куратор = СтрокаКуратор.Куратор;
    Если Не ЗначениеЗаполнено(Куратор) Тогда
        Продолжить;
    КонецЕсли;
    
    // Сумма продаж подчиненных
    Подчиненные = Объект.Табдок2.НайтиСтроки(Новый Структура("Куратор", Куратор));
    СуммаПродажПодчиненных = 0;
    Для Каждого Подчиненный Из Подчиненные Цикл
        СуммаПродажПодчиненных = СуммаПродажПодчиненных + Подчиненный.СуммаПродаж;
    КонецЦикла;
    
    // Находим параметры куратора
    СтрокаСтавки = РезультатСтавки.Найти(Куратор, "Куратор");
    Если СтрокаСтавки <> Неопределено Тогда
        Надбавка = СуммаПродажПодчиненных * СтрокаСтавки.НадбавкаКуратора / 100;
        
        // Проверяем, есть ли куратор уже в табличной части
        СтрокаКуратора = Объект.Табдок2.Найти(Куратор, "Менеджер");
        Если СтрокаКуратора <> Неопределено Тогда
            СтрокаКуратора.НадбавкаКуратора = Надбавка;
            СтрокаКуратора.ИтоговаяЗарплата = СтрокаКуратора.Зарплата + Надбавка;
        Иначе
            // Если куратора нет, добавляем новую строку
            НоваяСтрока = Объект.Табдок2.Добавить();
            НоваяСтрока.Менеджер = Куратор;
            НоваяСтрока.Куратор = Куратор; // Или пусто, если куратор сам себе куратор
            НоваяСтрока.СуммаПродаж = 0;
            НоваяСтрока.Зарплата = 0;
            НоваяСтрока.НадбавкаКуратора = Надбавка;
            НоваяСтрока.ТипСтавки = СтрокаСтавки.ТипСтавки;
            НоваяСтрока.ИтоговаяЗарплата = Надбавка;
        КонецЕсли;
    КонецЕсли;
КонецЦикла;

Для каждого Стр Из Объект.Табдок2 Цикл 
	Стр.ТипСтавки=БеремТипСтавки(Стр.Куратор, Объект.Начало);
КонецЦикла;


КонецПроцедуры


Функция БеремТипСтавки (Куратор, Период)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтавкиЗарплатыКураторов.Период КАК Период,
		|	СтавкиЗарплатыКураторов.Куратор КАК Куратор,
		|	СтавкиЗарплатыКураторов.ТипСтавки КАК ТипСтавки,
		|	СтавкиЗарплатыКураторов.Процент КАК Процент,
		|	СтавкиЗарплатыКураторов.ГраницаСуммы КАК ГраницаСуммы,
		|	СтавкиЗарплатыКураторов.ПроцентВышеГраницы КАК ПроцентВышеГраницы,
		|	СтавкиЗарплатыКураторов.ФиксированнаяСумма КАК ФиксированнаяСумма,
		|	СтавкиЗарплатыКураторов.НадбавкаКуратора КАК НадбавкаКуратора
		|ИЗ
		|	РегистрСведений.СтавкиЗарплатыКураторов КАК СтавкиЗарплатыКураторов
		|ГДЕ
		|	СтавкиЗарплатыКураторов.Куратор = &Куратор
		|	И СтавкиЗарплатыКураторов.Период >= &Период";
	
	Запрос.УстановитьПараметр("Куратор", Куратор);
	Запрос.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	
