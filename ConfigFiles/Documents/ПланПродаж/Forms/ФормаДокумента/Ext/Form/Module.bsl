
&НаКлиенте
Процедура КураторПриИзменении(Элемент)
	Объект.Группа=КураторГруппасиниОламиз(Объект.Куратор)// Вставить содержимое обработчика.
КонецПроцедуры

&НаСервере
Функция КураторГруппасиниОламиз (Куратор)
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Менеджер.Ссылка КАК Ссылка,
		|	Менеджер.ГруппыРМ.Ссылка КАК ГруппыРМСсылка
		|ИЗ
		|	Справочник.Менеджер КАК Менеджер
		|ГДЕ
		|	Менеджер.Ссылка = &Куратор";
	
	Запрос.УстановитьПараметр("Куратор", Куратор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ГруппыРМСсылка;	// Вставить обработку выборки ВыборкаДетальныеЗаписи
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
КонецФункции


&НаКлиенте
Процедура ЗаполнитьПоРегиону(Команда)
	ЗаполнитьПоРегионуНаСервере();// Вставить содержимое обработчика.
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьПоРегионуНаСервере()
    Объект.ТабДок1.Очистить();
    
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |    Менеджер.Ссылка КАК МП
                   |ИЗ
                   |    Справочник.Менеджер КАК Менеджер
                   |ГДЕ
                   |    Менеджер.Куратор = &Куратор
                   |    И НЕ Менеджер.ПометкаУдаления";
    Запрос.УстановитьПараметр("Куратор", Объект.Куратор);
    МПСписок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("МП");
    КолвоМП = МПСписок.Количество();
    Если КолвоМП = 0 Тогда
        Возврат; // Пропуск без ошибки, по вашему пункту 6
    КонецЕсли;
    
    Для Каждого СтрокаРегион Из Объект.ТабДок Цикл
        ОбщееКолво = СтрокаРегион.КолВо;
        Если ОбщееКолво = 0 Тогда Продолжить; КонецЕсли;
        
        Базовое = Цел(ОбщееКолво / КолвоМП);
        Остаток = ОбщееКолво % КолвоМП;
        
        Для Сч = 0 По КолвоМП - 1 Цикл
            НоваяСтрока = Объект.ТабДок1.Добавить();
            НоваяСтрока.МП = МПСписок[Сч];
            НоваяСтрока.Номенклатура = СтрокаРегион.Номенклатура;
            НоваяСтрока.КолВо = Базовое + ?(Сч < Остаток, 1, 0);
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры



&НаСервере
Процедура ЗаполнитьПоМПНаСервере()
    Объект.ТабДок.Очистить();
    
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |    ТабДок1.Номенклатура КАК Номенклатура,
                   |    ТабДок1.КолВо КАК КолВо
                   |ПОМЕСТИТЬ ВтТабДок1
                   |ИЗ
                   |    &ТабДок1 КАК ТабДок1
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВтТабДок1.Номенклатура,
                   |    СУММА(ВтТабДок1.КолВо) КАК КолВо
                   |ИЗ
                   |    ВтТабДок1 КАК ВтТабДок1
                   |СГРУППИРОВАТЬ ПО
                   |    ВтТабДок1.Номенклатура";
    Запрос.УстановитьПараметр("ТабДок1", Объект.ТабДок1.Выгрузить());
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        НоваяСтрока = Объект.ТабДок.Добавить();
        НоваяСтрока.Номенклатура = Выборка.Номенклатура;
        НоваяСтрока.КолВо = Выборка.КолВо;
    КонецЦикла;
КонецПроцедуры             


&НаКлиенте
Процедура ЗаполнитьПоМП(Команда)
    Если Вопрос("Данные в РЕГИОНЛАР будут перезаписаны на основе МП. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
        ЗаполнитьПоМПНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Для каждого Стр Из Объект.Табдок Цикл
		Стр.Цена=ПрайсОламиз.ПрайсОламиз(Объект.дата,Стр.Номенклатура,"ЮзФоиз");
		Стр.Сумма=Стр.Цена*Стр.Колво;
	КонецЦикла;
	
	Для каждого Стр Из Объект.Табдок1 Цикл
		Стр.Цена=ПрайсОламиз.ПрайсОламиз(Объект.дата,Стр.Номенклатура,"ЮзФоиз");
		Стр.Сумма=Стр.Цена*Стр.Колво;
	КонецЦикла;   
	
	// Проверяем, что дата задана
    Если ЗначениеЗаполнено(Объект.ДатаПериодники) Тогда
        
        // Получаем месяц и год
        НомерМесяца = Месяц(Объект.ДатаПериодники);
        ГодДаты = Год(Объект.ДатаПериодники);
        
        // Массив названий месяцев на русском
        НазванияМесяцев = Новый Массив;
        НазванияМесяцев.Добавить("Январь");
        НазванияМесяцев.Добавить("Февраль");
        НазванияМесяцев.Добавить("Март");
        НазванияМесяцев.Добавить("Апрель");
        НазванияМесяцев.Добавить("Май");
        НазванияМесяцев.Добавить("Июнь");
        НазванияМесяцев.Добавить("Июль");
        НазванияМесяцев.Добавить("Август");
        НазванияМесяцев.Добавить("Сентябрь");
        НазванияМесяцев.Добавить("Октябрь");
        НазванияМесяцев.Добавить("Ноябрь");
        НазванияМесяцев.Добавить("Декабрь");
        
        // Формируем строку периода
        НазваниеМесяца = НазванияМесяцев[НомерМесяца - 1];
        Объект.Период = НазваниеМесяца + " " + Формат(ГодДаты, "ЧГ=0");
        
    Иначе
        // Если дата пустая, очищаем период (опционально)
        Объект.Период = "";
	КонецЕсли;
	Объект.ПланСумма=Объект.Табдок1.Итог("Сумма");
	Объект.ПланКолво=Объект.Табдок1.Итог("Колво");
КонецПроцедуры

