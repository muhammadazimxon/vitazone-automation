Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    // Вычисление начала месяца на основе реквизита Период
    ДатаНачалаМесяца = НачалоМесяца(Период);
    
    // Подстановка цен из регистра сведений Прайсы
    Для Каждого ТекСтрокаТабдок Из Табдок Цикл
        ЗапросЦена = Новый Запрос;
        ЗапросЦена.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |	Прайсы.Цена КАК Цена
        |ИЗ
        |	РегистрСведений.Прайсы КАК Прайсы
        |ГДЕ
        |	Прайсы.Номенклатура = &Номенклатура
        |	И Прайсы.УсловиеОплаты = &УсловиеОплаты";
        ЗапросЦена.УстановитьПараметр("Номенклатура", ТекСтрокаТабдок.Номенклатура);
        ЗапросЦена.УстановитьПараметр("УсловиеОплаты", "ЭлликБешФоиз");
        РезультатЦена = ЗапросЦена.Выполнить();
        ВыборкаЦена = РезультатЦена.Выбрать();
        Если ВыборкаЦена.Следующий() Тогда
            ТекСтрокаТабдок.Цена = ВыборкаЦена.Цена;
            ТекСтрокаТабдок.Сумма = ТекСтрокаТабдок.Количество * ТекСтрокаТабдок.Цена;
        Иначе
            // Если цена не найдена, можно записать ошибку или использовать значение по умолчанию
            ТекСтрокаТабдок.Сумма = ТекСтрокаТабдок.Количество * 0; // Или другое значение
            Сообщить("Для номенклатуры " + ТекСтрокаТабдок.Номенклатура + " не найдена цена!");
        КонецЕсли;
    КонецЦикла;
    
    // Запись в регистр
    Движения.ПланыПродажРС.Записывать = Истина;
    Для Каждого ТекСтрокаТабдок Из Табдок Цикл
        Движение = Движения.ПланыПродажРС.Добавить();
        Движение.Период = ДатаНачалаМесяца;
        Движение.Месяц = ДатаНачалаМесяца;
        Движение.Аптека = Аптека;
        Движение.МП = МП;
        Движение.Куратор = Куратор;
        Движение.Номенклатура = ТекСтрокаТабдок.Номенклатура;
        Движение.Количество = ТекСтрокаТабдок.Количество;
        Движение.Сумма = ТекСтрокаТабдок.Сумма;
    КонецЦикла;
    
КонецПроцедуры