Процедура УдалитьДубликатыПоДокНомеру()
    // Создаем временный массив для хранения уникальных строк
    УникальныеСтроки = Новый Массив;

    // Создаем массив для хранения уже встреченных ДокНомер
    ВстреченныеДокНомера = Новый Массив;

    // Перебираем строки оригинальной таблицы и собираем уникальные строки
    Для Каждого Строка Из Объект.Табдок2 Цикл
        // Проверяем, есть ли уже такой ДокНомер в массиве встреченных
        Найден = Ложь;
        Для Каждого ДокНомер Из ВстреченныеДокНомера Цикл
            Если ДокНомер = Строка.ДокНомер Тогда
                Найден = Истина;
                break;
            КонецЕсли;
        КонецЦикла;

        // Если ДокНомер не найден, добавляем строку и сам ДокНомер в массивы
        Если Не Найден Тогда
            ВстреченныеДокНомера.Добавить(Строка.ДокНомер);
            УникальныеСтроки.Добавить(Строка);
        КонецЕсли;
    КонецЦикла;

    // Очищаем оригинальную таблицу
    Объект.Табдок2.Очистить();

    // Заполняем оригинальную таблицу уникальными записями
    Для Каждого УникальнаяСтрока Из УникальныеСтроки Цикл
