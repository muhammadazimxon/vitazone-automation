	Функция ОбщаяСуммаПрихода()
// Очистим Табдок3 перед копированием
Объект.Табдок3.Очистить();

// Создаем временную таблицу
ВременнаяТаблица = Новый ТаблицаЗначений;
ВременнаяТаблица.Колонки.Добавить("Контрагенты",, Новый ОписаниеТипов("Строка"));
ВременнаяТаблица.Колонки.Добавить("Приход", Новый ОписаниеТипов("Число"));
ВременнаяТаблица.Колонки.Добавить("Расход", Новый ОписаниеТипов("Число"));
ВременнаяТаблица.Колонки.Добавить("СуммаЗадолженности", Новый ОписаниеТипов("Число"));
ВременнаяТаблица.Колонки.Добавить("Переплата", Новый ОписаниеТипов("Число"));

// Проходим по Табдок и агрегируем данные
Для Каждого Строка Из Объект.Табдок Цикл
    // Проверяем, есть ли уже контрагент в временной таблице
    Найдено = Ложь;
    Для Каждого СтрокаВременной Из ВременнаяТаблица Цикл
        Если СтрокаВременной.Контрагенты = Строка.Контрагенты Тогда
            СтрокаВременной.Приход = СтрокаВременной.Приход + Строка.Приход;
            СтрокаВременной.Расход = СтрокаВременной.Расход + Строка.Расход;
           // СтрокаВременной.СуммаЗадолженности = СтрокаВременной.СуммаЗадолженности + Строка.СуммаЗадолженности;
           // СтрокаВременной.Переплата = СтрокаВременной.Переплата + Строка.Переплата;
            Найдено = Истина;
            Прервать; // Выходим из внутреннего цикла
        КонецЕсли;
    КонецЦикла;

    // Если контрагент не найден, добавляем новую запись
    Если Не Найдено Тогда
        НоваяСтрока = ВременнаяТаблица.добавить();
        НоваяСтрока.Контрагенты = Строка.Контрагенты;
        НоваяСтрока.Приход = Строка.Приход;
        НоваяСтрока.Расход = Строка.Расход;
        НоваяСтрока.СуммаЗадолженности = Строка.СуммаЗадолженности;
        НоваяСтрока.Переплата = Строка.Переплата;
    КонецЕсли;
КонецЦикла;

// Заполняем Табдок3
Объект.Табдок3.Очистить(); // Очистить перед заполнением
Для Каждого Строка Из ВременнаяТаблица Цикл
    НоваяСтрока = Объект.Табдок3.Добавить();
    НоваяСтрока.Контрагенты = Строка.Контрагенты;
    НоваяСтрока.Приход = Строка.Приход;
    НоваяСтрока.Расход = Строка.Расход;
    НоваяСтрока.СуммаЗадолженности = Строка.СуммаЗадолженности;
    НоваяСтрока.Переплата = Строка.Переплата;
КонецЦикла;


