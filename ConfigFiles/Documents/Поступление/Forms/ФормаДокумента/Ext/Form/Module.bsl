&НаСервере
Процедура ЗарегистрироватьПоступления(Документ)
    // Проходим по всем строкам в табличной части "Табдок"
    Для Каждого Строка Из Объект.Табдок Цикл
        // Получаем данные из текущей строки
        ИНН = Строка.ИНН;
        Контрагенты = Строка.Контрагенты;
        СуммаПоступления = Строка.Приход; // Сумма поступления
        
        // Получаем счета-фактуры по контрагенту с задолженностью
        Запрос = Новый Запрос;
        Запрос.Текст = 
           	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДебиторкаОстаткиИОбороты.Контрагенты КАК Контрагенты,
		|	ДебиторкаОстаткиИОбороты.ДокНомер КАК ДокНомер,
		|	ДебиторкаОстаткиИОбороты.Период КАК Период,
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток КАК ЗадолженностьСумКонечныйОстаток
		|ИЗ
		|	РегистрНакопления.Дебиторка.ОстаткиИОбороты(, , Секунда, , ) КАК ДебиторкаОстаткиИОбороты
		|ГДЕ
		|	ДебиторкаОстаткиИОбороты.Контрагенты = &Контрагенты
		|	И ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток <> 0
		|	И ДебиторкаОстаткиИОбороты.Период <= &Дата";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
        Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
        
        РезультатЗапроса = Запрос.Выполнить();
        ВыборкаСчетов = РезультатЗапроса.Выбрать();

        // Проверяем, есть ли счета-фактуры
        Если Не ВыборкаСчетов.Следующий() Тогда
            Сообщить("Нет задолженности по счетам-фактурам для контрагента " + Контрагенты);
            Продолжить; // Переход к следующему контрагенту
        КонецЕсли;

        // Перебираем счета-фактуры
        Пока ВыборкаСчетов.Следующий() Цикл
            // Обрабатываем каждую счет-фактуру
            Счет = ВыборкаСчетов.ДокНомер;
            Остаток = ВыборкаСчетов.ЗадолженностьСумКонечныйОстаток;

            // Здесь можно зафиксировать поступление
            // Например, записать информацию в регистр или журнал
            Сообщить("Поступление " + СуммаПоступления + " зарегистрировано для счета-фактуры: " + Счет + " с остатком: " + Остаток);
            
            // Если нужно обновить остаток, можно добавить сюда логику
            // Остаток = Остаток - СуммаПоступления; // Логика обновления остатков
        КонецЦикла;
    КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ЗарегистрироватьПоступления(ЭтотОбъект);
	//Подбор(ЭтотОбъект);
	
КонецПроцедуры



&НаСервере
Процедура СчетФактурыПодбор(Документ)
        // Проходим по всем строкам в табличной части "Табдок"
    Для Каждого Строка Из Объект.Табдок3 Цикл
        ИНН = Строка.ИНН;
        Контрагенты = Строка.Контрагенты;
        СуммаПоступления = Строка.Приход+Строка.Переплата; // Сумма поступления
        
        // Получаем счета-фактуры по контрагенту с задолженностью
        Запрос = Новый Запрос;
        Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДебиторкаОстаткиИОбороты.Контрагенты КАК Контрагенты,
		|	ДебиторкаОстаткиИОбороты.ДокНомер КАК ДокНомер,
		|	ДебиторкаОстаткиИОбороты.Период КАК Период,
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.Дебиторка.ОстаткиИОбороты(, , Секунда, , ) КАК ДебиторкаОстаткиИОбороты
		|ГДЕ
		|	ДебиторкаОстаткиИОбороты.Контрагенты = &Контрагенты
		|	И ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток <> 0
		|	И ДебиторкаОстаткиИОбороты.Период <= &Дата";

	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
        Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
        
        РезультатЗапроса = Запрос.Выполнить();
        ВыборкаСчетов = РезультатЗапроса.Выбрать();

        // Распределяем поступление по счетам-фактурам
        Пока СуммаПоступления > 0 И ВыборкаСчетов.Следующий() Цикл
            Счет = ВыборкаСчетов.ДокНомер;
            Остаток = ВыборкаСчетов.Остаток;

            // Определяем сумму погашения
            СуммаПогашения = Мин(СуммаПоступления, Остаток);

            // Добавляем строку в табличную часть "Табдок2"
            НоваяСтрока = Объект.Табдок2.Добавить();
            НоваяСтрока.ИНН = ИНН;
            НоваяСтрока.Контрагенты = Контрагенты;
            НоваяСтрока.ДокНомер = Счет;
            НоваяСтрока.СуммаЗадолженности = Остаток;
            НоваяСтрока.СуммаПогашения = СуммаПогашения;
            НоваяСтрока.Назначение = Строка.Назначение;

            // Уменьшаем сумму поступления на погашенную сумму
            СуммаПоступления = СуммаПоступления - СуммаПогашения;
        КонецЦикла;

        Если СуммаПоступления > 0 Тогда
            Сообщить("Осталась нераспределенная сумма: " + СуммаПоступления + " для контрагента: " + Контрагенты);
        КонецЕсли;

    КонецЦикла;
КонецПроцедуры




