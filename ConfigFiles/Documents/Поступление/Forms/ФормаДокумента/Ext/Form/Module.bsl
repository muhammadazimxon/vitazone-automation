        НоваяСтрока.СуммаЗадолженности = УникальнаяСтрока.СуммаЗадолженности;
        НоваяСтрока.СуммаПогашения = УникальнаяСтрока.СуммаПогашения;
        НоваяСтрока.СуммаДоговора = УникальнаяСтрока.СуммаДоговора;
        НоваяСтрока.УсловиеПредоплаты = УникальнаяСтрока.УсловиеПредоплаты;
        НоваяСтрока.Переплата = УникальнаяСтрока.Переплата;
    КонецЦикла;

