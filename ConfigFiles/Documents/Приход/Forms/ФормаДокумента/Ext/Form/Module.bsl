КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
		Если Объект.Валюта.Пустая()=Истина
		Тогда Объект.Валюта=ВалютаДоллар();
	КонецЕсли;
	Объект.Курс=КурсОламиз.КурсОламиз(Объект.Дата, Объект.Валюта);

КонецПроцедуры
Функция ВалютаДоллар() 
	Возврат Справочники.Валюта.USD
КонецФункции

&НаСервере
Процедура НоменклатураПриИзмененииНаСервере()
    // Очищаем текущую табличную часть
    Объект.Табдок1.Очистить();
    
    // Получаем дату документа для остатков
    ДатаОстатков = Объект.Дата;
    
    // Создаем запрос для получения остатков
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	ФинансыОстатки.ФинИст КАК ФинИст,
    |	ФинансыОстатки.ВалютаОстаток КАК НаКонец
    |ИЗ
    |	РегистрНакопления.Финансы.Остатки(&ДатаОстатков, ) КАК ФинансыОстатки
    |ГДЕ
    |	ФинансыОстатки.ФинИст В
    |			(ВЫБРАТЬ
    |				ФинИст.Ссылка
    |			ИЗ
    |				Справочник.ФинИст КАК ФинИст
    |			ГДЕ
    |				ФинИст.Номенклатура = &Номенклатура
	|				И ФинансыОстатки.ВалютаОстаток<>&ноль)";
    
    Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
    Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
	Запрос.УстановитьПараметр("ноль", 0);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    // Заполняем табличную часть
    Пока Выборка.Следующий() Цикл
        НоваяСтрока = Объект.Табдок1.Добавить();
        НоваяСтрока.Номенклатура = Объект.Номенклатура;
        НоваяСтрока.ФинИст = Выборка.ФинИст;
        НоваяСтрока.СуммаВал = Выборка.НаКонец;
		НоваяСтрока.Примечание = "из баланса";
		Если Объект.КолВо<>0 Тогда
		НоваяСтрока.Цена = Выборка.НаКонец/Объект.КолВо;
		Объект.Себестоимость = Объект.Табдок1.Итог("СуммаВал")/Объект.КолВо;
		КонецЕсли;
	
    КонецЦикла;

КонецПроцедуры




&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	НоменклатураПриИзмененииНаСервере();
КонецПроцедуры



&НаКлиенте
Процедура ЗаполнитьИзФОМ(Команда)
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Сообщить("Сначала установите дату документа!");
		Возврат;
	КонецЕсли;
	
	Сообщить("==================================================");
	Сообщить("Запрашиваем данные ПРИХОДА из ФОМ за " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + "...");
	
	ЗаполнитьИзФОМНаСервере();
	
	Сообщить("==================================================");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзФОМНаСервере()
	
	ФОМСерверСырой = Константы.ФОМсервер.Получить();
	Если ПустаяСтрока(ФОМСерверСырой) Тогда
		Сообщить("ОШИБКА: Не заполнен IP-адрес ФОМ в константах!");
		Возврат;
	КонецЕсли;

	// Очищаем и разделяем IP и порт
	ФОМСерверСырой = СтрЗаменить(ФОМСерверСырой, "http://", "");
	ФОМСерверСырой = СтрЗаменить(ФОМСерверСырой, "https://", "");
	МассивURL = СтрРазделить(ФОМСерверСырой, ":");
	IPАдрес = МассивURL[0];
	Порт = ?(МассивURL.Количество() > 1, Число(МассивURL[1]), 80);

	СтрокаДаты = Формат(Объект.Дата, "ДФ=yyyy-MM-dd");
	
	// Метод API для прихода
	URLЗапроса = "/api/1c/prih_per?DateBegin=" + СтрокаДаты + "&DateEnd=" + СтрокаДаты;
	
	HTTPСоединение = Новый HTTPСоединение(IPАдрес, Порт, , , , 30);
	HTTPЗапрос = Новый HTTPЗапрос(URLЗапроса);
	HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
	
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
		Если Ответ.КодСостояния = 200 Тогда
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
			ДанныеФОМ = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Если ТипЗнч(ДанныеФОМ) = Тип("Структура") И ДанныеФОМ.Свойство("data") Тогда
				МассивСтрок = ДанныеФОМ.data;
				Если ТипЗнч(МассивСтрок) <> Тип("Массив") ИЛИ МассивСтрок.Количество() = 0 Тогда
					Сообщить("Нет приходов за этот день в ФОМ.");
					Возврат;
				КонецЕсли;
				
				Объект.Табдок.Очистить();
				ИтогСумма = 0; 
				ИтогКолВо = 0; 
				
				Для Каждого ДанныеТовара Из МассивСтрок Цикл
					НовСтр = Объект.Табдок.Добавить();
					
					// 1. ПОИСК И АВТОМАТИЧЕСКОЕ СОЗДАНИЕ НОМЕНКЛАТУРЫ ПО КОДУ (BARCODE)
Штрихкод = СокрЛП(Строка(?(ДанныеТовара.Свойство("BARCODE"), ДанныеТовара.BARCODE, "")));
ИмяТовара = СокрЛП(Строка(?(ДанныеТовара.Свойство("NAME"), ДанныеТовара.NAME, "Без названия")));

Если Не ПустаяСтрока(Штрихкод) Тогда
	ТоварСсылка = Справочники.Номенклатура.НайтиПоКоду(Штрихкод);
	
	// Если товар не найден - создаем новый!
	Если Не ЗначениеЗаполнено(ТоварСсылка) Тогда
		НовыйТовар = Справочники.Номенклатура.СоздатьЭлемент();
		
		// Если штрихкод длиннее 20 символов, обрезаем, чтобы не было ошибки БД
		НовыйТовар.Код = Лев(Штрихкод, 20); 
		// Наименование в справочнике ограничено 100 символами
		НовыйТовар.Наименование = Лев(ИмяТовара, 100); 
		
		// Пробуем сразу привязать Производителя (PRNAME из JSON)
		ИмяПроизв = СокрЛП(?(ДанныеТовара.Свойство("PRNAME"), ДанныеТовара.PRNAME, ""));
		Если Не ПустаяСтрока(ИмяПроизв) Тогда
			ПроизвСсылка = Справочники.Производитель.НайтиПоНаименованию(ИмяПроизв);
			Если ЗначениеЗаполнено(ПроизвСсылка) Тогда
				НовыйТовар.Производитель = ПроизвСсылка;
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			НовыйТовар.Записать();
			ТоварСсылка = НовыйТовар.Ссылка;
			Сообщить(" + Автоматически создан новый товар: " + НовыйТовар.Наименование);
		Исключение
			Сообщить(" ! Ошибка при создании товара " + ИмяТовара + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	НовСтр.Номенклатура = ТоварСсылка;
Иначе
	Сообщить(" ! Внимание: пришел пустой штрихкод у товара: " + ИмяТовара);
КонецЕсли;;
					
					// Заполнение количественных и суммовых показателей
					НовСтр.КолВо = ?(ДанныеТовара.Свойство("KOL"), ДанныеТовара.KOL, 0);
					НовСтр.Цена = ?(ДанныеТовара.Свойство("PRICEPRIH"), ДанныеТовара.PRICEPRIH, 0);
					НовСтр.Сумма = ?(ДанныеТовара.Свойство("SUMMA"), ДанныеТовара.SUMMA, 0);
					НовСтр.НДС = ?(ДанныеТовара.Свойство("SUMMANDS"), ДанныеТовара.SUMMANDS, 0);
					
					// Комбинируем поставщика и PURPOSE в Примечание
					ТекстПримечание = СокрЛП(?(ДанныеТовара.Свойство("PURPOSE"), ДанныеТовара.PURPOSE, ""));
					Поставщик = СокрЛП(?(ДанныеТовара.Свойство("FULL_NAME"), ДанныеТовара.FULL_NAME, ""));
					
					Если Не ПустаяСтрока(Поставщик) Тогда
						ТекстПримечание = Поставщик + " | " + ТекстПримечание;
					КонецЕсли;
					
					НовСтр.Примечание = ТекстПримечание;
					
					// Накапливаем общие итоги документа
					ИтогСумма = ИтогСумма + НовСтр.Сумма;
					ИтогКолВо = ИтогКолВо + НовСтр.КолВо;
				КонецЦикла;
				
				// Заполняем реквизиты шапки (если они выведены на форму)
				Объект.Сумма = ИтогСумма;
				Объект.КолВо = ИтогКолВо;
				
				Сообщить("Успешно заполнено строк: " + Объект.Табдок.Количество());
			КонецЕсли;
		Иначе
			Сообщить("Ошибка сервера ФОМ! Код: " + Ответ.КодСостояния);
		КонецЕсли;
	Исключение
		Сообщить("Сбой соединения с ФОМ: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры