
&НаКлиенте
Процедура Перенос(Команда)
   // Очищаем целевую табличную часть
   // Объект.Табдок.Очистить();
    
    // Вычисляем общую сумму по колонке НаКонец для текущей номенклатуры
    ОбщаяСумма = Окр(0,15);
    Для Каждого СтрокаТабдок1 Из Объект.Табдок1 Цикл
        Если СтрокаТабдок1.Номенклатура = Объект.Номенклатура Тогда
            ОбщаяСумма = Окр(ОбщаяСумма,15) + Окр(СтрокаТабдок1.СуммаВал,15);
        КонецЕсли;
    КонецЦикла;
    
    // Проверяем, что количество не равно нулю
    Если Объект.Колво = 0 Тогда
        Сообщить("Ошибка: количество не может быть равно нулю!");
        Возврат;
    КонецЕсли;
    
    // Вычисляем цену с точностью до 15 знаков
    Цена = Окр(ОбщаяСумма / Объект.Колво, 15);
    
    // Добавляем одну строку с общей суммой
    НоваяСтрока = Объект.Табдок.Добавить();
    НоваяСтрока.Номенклатура = Объект.Номенклатура;
    НоваяСтрока.СуммаВал = ОбщаяСумма;
	//НоваяСтрока.Примечение = "Из баланса";
    НоваяСтрока.Цена = Цена*Объект.Курс;
	
	Для каждого Стр из Объект.Табдок Цикл
		Если Стр.Колво=0 Тогда
			Стр.Колво=Объект.КолВо;
			Стр.сумма=Стр.Цена*Стр.Колво;
			Стр.Примечание="Из баланса";
		КонецЕсли;
		
	КонецЦикла;
	
    // Поле ФинИст оставляем пустым, так как оно не требуется
КонецПроцедуры

&НаКлиенте
Процедура ТабдокКолВоПриИзменении(Элемент)
	Стр=Элементы.Табдок.ТекущиеДанные;
	Стр.Сумма=Стр.Колво*Стр.Цена;
	Стр.НДС=Стр.Сумма/112*12;
	Объект.Сумма=объект.Табдок.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура ТабдокЦенаПриИзменении(Элемент)
	Стр=Элементы.Табдок.ТекущиеДанные;
	Стр.Сумма=Стр.Колво*Стр.Цена;
	Стр.НДС=Стр.Сумма/112*12;
	Объект.Сумма=объект.Табдок.Итог("Сумма");// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура ТабдокСуммаПриИзменении(Элемент)
	Стр=Элементы.Табдок.ТекущиеДанные;
	
	Если Стр.КолВо <>0 Тогда
		Стр.Цена=Стр.Сумма/Стр.Колво;
	Иначе
		Стр.Цена=0;
	КонецЕсли;
	Стр.НДС=Стр.Сумма/112*12;
	Объект.Сумма=объект.Табдок.Итог("Сумма");
КонецПроцедуры

