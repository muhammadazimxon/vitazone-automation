&НаСервере
Процедура ЗаполнитьПрограмму() Экспорт
    // Убедимся, что дата заполнена
    Если Не ЗначениеЗаполнено(ЭтотОбъект.Дата) Тогда
        Сообщить("Необходимо указать дату документа.", СтатусСообщения.Внимание);
        Возврат;
    КонецЕсли;

    // Очистим табличную часть перед заполнением
    ЭтотОбъект.Программа.Очистить();

    // Получим дату документа
    ДатаДокумента = ЭтотОбъект.Дата;

    // Запрос для выбора данных из регистра "Дебиторка"
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "
    |ВЫБРАТЬ
        |    ДебиторкаОстаткиИОбороты.Контрагенты КАК Контрагенты,
            |ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток КАК СуммаЗадолженности
        |ИЗ
            |РегистрНакопления.Дебиторка.ОстаткиИОбороты(, &ДатаНаМомент, , , ) КАК ДебиторкаОстаткиИОбороты";
    
    // Установим параметр даты
    Запрос.УстановитьПараметр("ДатаНаМомент", ДатаДокумента);

    // Выполним запрос
    Результат = Запрос.Выполнить();
    
    // Заполним табличную часть данными из результата запроса
    Для Каждого Строка Из Результат.Выбрать() Цикл
        НоваяСтрока = ЭтотОбъект.Программа.Добавить();
        НоваяСтрока.Контрагенты = Строка.Контрагенты;
        Если Строка.СуммаЗадолженности < 0 Тогда
            НоваяСтрока.Дебиторкаси = Строка.СуммаЗадолженности;
        Иначе
            НоваяСтрока.Кредиторкаси = Строка.СуммаЗадолженности;
        КонецЕсли;
    КонецЦикла;

    Сообщить("Заполнение завершено.");
КонецПроцедуры;
