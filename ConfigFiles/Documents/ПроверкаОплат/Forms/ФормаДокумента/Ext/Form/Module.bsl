&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Для каждого Эл Из Объект.Эксел Цикл
		Эл.Счет= Объект.Счет;
		КонецЦикла
КонецПроцедуры
&НаСервере
Функция КонтрОламиз(ИНН)
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.инн КАК инн
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.инн = &инн";
	
	Запрос.УстановитьПараметр("инн", инн);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;// Вставить обработку выборки ВыборкаДетальныеЗаписи
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
КонецФункции

Функция ЗадолженностьОлиш(Дата, Контрагенты, Счет)
    Если Не ЗначениеЗаполнено(Контрагенты) Тогда
        Сообщить("Контрагент не указан. Дата: " + Дата + ", Счет: " + Счет);
        Возврат 0;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Счет) Тогда
        Сообщить("Счет не указан. Контрагент: " + Контрагенты + ", Дата: " + Дата);
        Возврат 0;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   ДебиторкаОстаткиИОбороты.Контрагенты КАК Контрагенты,
        |   ДебиторкаОстаткиИОбороты.Счет КАК Счет,
        |   ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток 
        |     КАК ЗадолженностьОбщая
        |ИЗ
        |   РегистрНакопления.Дебиторка.ОстаткиИОбороты(&Дата1, &Дата, , , ) КАК ДебиторкаОстаткиИОбороты
        |ГДЕ
        |   ДебиторкаОстаткиИОбороты.Контрагенты = &Контрагенты
        |   И ДебиторкаОстаткиИОбороты.Счет = &Счет";

    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Дата1", '20010101'); // Начало периода
    Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
    Запрос.УстановитьПараметр("Счет", Счет);

    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий() ;
	Возврат Выборка.ЗадолженностьОбщая;
	//Если Выборка.Следующий() Тогда
	//    Сообщить("Общая задолженность для контрагента: " + Контрагенты + " = " + Выборка.ЗадолженностьОбщая);
	//    Возврат Выборка.ЗадолженностьОбщая;
	//Иначе
	//    Сообщить("Задолженность не найдена для контрагента: " + Контрагенты + ", счет: " + Счет);
	//    Возврат 0; // Возвращаем 0, если данных нет
	//КонецЕсли;
КонецФункции




