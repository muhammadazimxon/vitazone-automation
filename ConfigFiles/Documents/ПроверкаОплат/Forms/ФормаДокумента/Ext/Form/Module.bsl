Функция СоздатьКонтр (Наименование, ИНН, Регион, Адрес, МП)
	
	КонтрЯрат = Справочники.Контрагенты.СоздатьЭлемент();
	КонтрЯрат.Наименование = Наименование;
	КонтрЯрат.ИНН = ИНН;
	КонтрЯрат.Регион = Регион;
	КонтрЯрат.Адрес = Адрес;
	КонтрЯрат.МП=МП;
	КонтрЯрат.Записать();
	
	
КонецФункции




