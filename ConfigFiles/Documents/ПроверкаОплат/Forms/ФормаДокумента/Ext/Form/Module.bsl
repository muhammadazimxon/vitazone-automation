Функция СуммироватьПоКонтрагентам(ТабличнаяЧасть)
    // Создадим временное хранилище для суммы по каждому контрагенту
    СуммыПоКонтрагентам = Новый Соответствие;

    // Пройдемся по строкам табличной части
    Для Каждого Строка Из ТабличнаяЧасть Цикл
        Контрагент = Строка.Контрагенты;

        // Проверяем наличие ключа через Попытка-Исключение
        Если СуммыПоКонтрагентам.СодержитКлюч(Контрагент) Тогда
            // Если ключ существует, добавляем сумму
            СуммыПоКонтрагентам[Контрагент] = СуммыПоКонтрагентам[Контрагент] + Строка.СуммаЭксель;
        Иначе
            // Инициализируем сумму для нового контрагента
            СуммыПоКонтрагентам.Вставить(Контрагент, Строка.СуммаЭксель);
        КонецЕсли;
    КонецЦикла;

    // Возвращаем итоговые суммы по контрагентам
    Возврат СуммыПоКонтрагентам;
КонецФункции





&НаКлиенте
Процедура КонтрагентУдалитьПовторыОбрТабдок(ТабличнаяЧасть)
    // Создаем временное соответствие для агрегирования данных
    ВременныеДанные = Новый Соответствие;

    // Проходим по каждой строке табличной части
    Для Каждого Строка Из ТабличнаяЧасть Цикл
        ИНН = Строка.ИНН;

        // Если ИНН уже есть в соответствии, суммируем данные
        Если ВременныеДанные[ИНН] <> Неопределено Тогда
            ВременныеДанные[ИНН] = ВременныеДанные[ИНН] + Строка.СуммаЭксель;
        Иначе
            // Если ИНН нет, добавляем его в соответствие
            ВременныеДанные.Вставить(ИНН, Строка.СуммаЭксель);
        КонецЕсли;
    КонецЦикла;

    // Очищаем табличную часть
    ТабличнаяЧасть.Очистить();

    // Переносим агрегированные данные обратно в табличную часть
    Для Каждого Итог Из ВременныеДанные Цикл
        НоваяСтрока = ТабличнаяЧасть.Добавить();
        НоваяСтрока.ИНН = Итог.Ключ; // Используем ключ из соответствия как ИНН
        НоваяСтрока.СуммаЭксель = Итог.Значение; // Суммированное значение
    КонецЦикла;
КонецПроцедуры


