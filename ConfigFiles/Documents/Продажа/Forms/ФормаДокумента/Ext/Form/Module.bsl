&НаКлиенте
Процедура ЗаполнитьИзФОМ(Команда)
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Сообщить("Сначала установите дату документа!");
		Возврат;
	КонецЕсли;
	
	Сообщить("==================================================");
	Сообщить("Запрашиваем данные ФОМ за " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + "...");
	
	ЗаполнитьИзФОМНаСервере();
	
	Сообщить("Готово! Первичные данные загружены.");
	//Сообщить("Теперь вы можете поочередно нажимать: Команда1 -> Куратор -> Бонус");
	Сообщить("==================================================");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзФОМНаСервере()
	
	ФОМСерверСырой = Константы.ФОМсервер.Получить();
	Если ПустаяСтрока(ФОМСерверСырой) Тогда
		Сообщить("ОШИБКА: Не заполнен IP-адрес ФОМ в константах!");
		Возврат;
	КонецЕсли;

	// Очищаем и разделяем IP и порт для HTTP-соединения
	ФОМСерверСырой = СтрЗаменить(ФОМСерверСырой, "http://", "");
	ФОМСерверСырой = СтрЗаменить(ФОМСерверСырой, "https://", "");
	МассивURL = СтрРазделить(ФОМСерверСырой, ":");
	IPАдрес = МассивURL[0];
	Порт = ?(МассивURL.Количество() > 1, Число(МассивURL[1]), 80);

	СтрокаДаты = Формат(Объект.Дата, "ДФ=yyyy-MM-dd");
	URLЗапроса = "/api/1c/prod_per?DateBegin=" + СтрокаДаты + "&DateEnd=" + СтрокаДаты;
	
	HTTPСоединение = Новый HTTPСоединение(IPАдрес, Порт, , , , 30);
	HTTPЗапрос = Новый HTTPЗапрос(URLЗапроса);
	HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
	
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
		Если Ответ.КодСостояния = 200 Тогда
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
			ДанныеФОМ = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Если ТипЗнч(ДанныеФОМ) = Тип("Структура") И ДанныеФОМ.Свойство("data") Тогда
				МассивСтрок = ДанныеФОМ.data;
				Если ТипЗнч(МассивСтрок) <> Тип("Массив") ИЛИ МассивСтрок.Количество() = 0 Тогда
					Сообщить("Нет продаж за этот день в ФОМ.");
					Возврат;
				КонецЕсли;
				
				Объект.Табдок.Очистить();
				ИтогСумма = 0; ИтогКолВо = 0; ИтогПрибыль = 0;
				
				Для Каждого ДанныеТовара Из МассивСтрок Цикл
					НовСтр = Объект.Табдок.Добавить();
					НовСтр.ДатаПродажи = Объект.Дата;
					
					// =========================================================
					// БАЗОВЫЕ ПОЛЯ ДЛЯ ПОСЛЕДУЮЩЕЙ ОБРАБОТКИ В "Команда1"
					// =========================================================
					НовСтр.НомерДок = СокрЛП(Строка(?(ДанныеТовара.Свойство("NUMBER"), ДанныеТовара.NUMBER, "")));
					//НовСтр.ДатаОплаты = СокрЛП(Строка(?(ДанныеТовара.Свойство("OTSR"), ДанныеТовара.OTSR, ""))); 
					НовСтр.ЗапКонтрНоми = СокрЛП(?(ДанныеТовара.Свойство("POLUCH"), ДанныеТовара.POLUCH, ""));
					// 1. ЗАГРУЖАЕМ PURPOSE В НАЗНАЧЕНИЕ
НовСтр.Назначение = СокрЛП(?(ДанныеТовара.Свойство("PURPOSE"), ДанныеТовара.PURPOSE, ""));
					// ИНН - критически важен для создания и поиска Контрагентов в Команда1
					СыройИНН = СокрЛП(?(ДанныеТовара.Свойство("INN"), ДанныеТовара.INN, ""));
					Попытка НовСтр.ИНН = Число(СыройИНН); Исключение НовСтр.ИНН = 0; КонецПопытки;
					
					// ЗМП - текстовое имя менеджера для поиска Ссылки МП в Команда1
					НовСтр.ЗМП = СокрЛП(?(ДанныеТовара.Свойство("MP"), ДанныеТовара.MP, ""));
					
					// ПОИСК НОМЕНКЛАТУРЫ ПО ШТРИХКОДУ
					Штрихкод = СокрЛП(Строка(?(ДанныеТовара.Свойство("BARCODE"), ДанныеТовара.BARCODE, "")));
					Если Не ПустаяСтрока(Штрихкод) Тогда
						ТоварСсылка = Справочники.Номенклатура.НайтиПоКоду(Штрихкод);
						Если ЗначениеЗаполнено(ТоварСсылка) Тогда
							НовСтр.Номенклатура = ТоварСсылка;
						КонецЕсли;
					КонецЕсли;
					
					
					// --- НОВЫЙ БЛОК: ЗАПОЛНЕНИЕ ДАТЫ ОПЛАТЫ ИЗ ПОЛЯ "OTSR" ---
СыраяДатаОплаты = СокрЛП(?(ДанныеТовара.Свойство("OTSR"), ДанныеТовара.OTSR, ""));
Если Не ПустаяСтрока(СыраяДатаОплаты) И СыраяДатаОплаты <> "null" Тогда
	// Убираем лишние символы для конвертации "2026-08-26 00:00:00" -> "20260826000000"
	СтрДатаОплаты = СтрЗаменить(СыраяДатаОплаты, "-", "");
	СтрДатаОплаты = СтрЗаменить(СтрДатаОплаты, ":", "");
	СтрДатаОплаты = СтрЗаменить(СтрДатаОплаты, " ", "");
	Попытка
		НовСтр.ДатаОплаты = Дата(СтрДатаОплаты);
	Исключение
		// Если дата пришла в неизвестном формате, поле просто останется пустым
	КонецПопытки;
КонецЕсли;
					// =========================================================
					// ЧИСЛОВЫЕ ПОКАЗАТЕЛИ (Цены, количество, сумма)
					// =========================================================
					НовСтр.КолВо = ?(ДанныеТовара.Свойство("KOL"), ДанныеТовара.KOL, 0);
					НовСтр.Цена = ?(ДанныеТовара.Свойство("PRICE"), ДанныеТовара.PRICE, 0);
					НовСтр.Сумма = ?(ДанныеТовара.Свойство("SUMMA"), ДанныеТовара.SUMMA, 0);
					НовСтр.ЦенаПр = ?(ДанныеТовара.Свойство("PRICEPRIH"), ДанныеТовара.PRICEPRIH, 0);
					НовСтр.НДС = ?(ДанныеТовара.Свойство("SUMMA_NDS"), ДанныеТовара.SUMMA_NDS, 0);
					
					// Предварительный итог, который Команда1 потом пересчитает по-своему
					НовСтр.Себестоим = НовСтр.ЦенаПр * НовСтр.КолВо;
					НовСтр.Прибыль = НовСтр.Сумма - НовСтр.Себестоим;
					
					ИтогСумма = ИтогСумма + НовСтр.Сумма;
					ИтогКолВо = ИтогКолВо + НовСтр.КолВо;
					ИтогПрибыль = ИтогПрибыль + НовСтр.Прибыль;
				КонецЦикла;
				
				// Заполняем итоги в шапке документа
				Объект.Продажа = ИтогСумма;
				Объект.КолВо = ИтогКолВо;
				Объект.Прибыль = ИтогПрибыль;
				Объект.Себестоимость = ИтогСумма - ИтогПрибыль;
				
				Сообщить("Успешно заполнено строк: " + Объект.Табдок.Количество());
			КонецЕсли;
		Иначе
			Сообщить("Ошибка сервера ФОМ! Код: " + Ответ.КодСостояния);
		КонецЕсли;
	Исключение
		Сообщить("Сбой соединения с ФОМ: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЛьготаПриИзменении(Элемент)
	Если Контрагент<>"" Тогда
		//Если Элементы.Льгота=истина Тогда
			Для каждого Стр Из Объект.Табдок Цикл
				Если Стр.Контрагенты=Контрагент Тогда
					Стр.Льгота=Льгота;
					Стр.ЛьготаНалогНаПрибыль=Льгота;
					Стр.НалогНаПрибыль=0;
					стр.НДС=0;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
КонецПроцедуры
