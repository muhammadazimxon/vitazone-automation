&НаСервере
Процедура СчетФактураларНаСервере()
    Объект.ПТабдок2.Очистить();

    Для Каждого Рек из Объект.ПТабдок3 Цикл
        Дата = Объект.Дата;
        Контрагенты = Рек.Контрагенты;
     
        Поступление = Рек.Приход + Рек.Переплата;
        Организация = Объект.Счет;
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |	ДебиторкаОстатки.Контрагенты КАК Контрагенты,
            |	ДебиторкаОстатки.ДокНомер КАК ДокНомер,
            |	ДебиторкаОстатки.ДокНомер.УсловиеПредоплаты КАК УсловиеПредоплаты,
            |	ДебиторкаОстатки.ДокНомер.ДатаСоставления КАК ДатаСоставления,
            |	ДебиторкаОстатки.Счет КАК Организация,
            |	ДебиторкаОстатки.ЗадолженностьСумОстаток КАК ЗадолженностьСумОстаток,
            |	ДебиторкаОстатки.ДокНомер.СрокДействия КАК ДокНомерСрокДействия,
            |	ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход КАК ЗадолженностьСумРасход,
            |	ДебиторкаОстаткиИОбороты.ЗадолженностьСумПриход КАК ЗадолженностьСумПриход
            |ИЗ
            |	РегистрНакопления.Дебиторка.Остатки(&Дата, Контрагенты = &Контрагенты) КАК ДебиторкаОстатки
            |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Дебиторка.ОстаткиИОбороты КАК ДебиторкаОстаткиИОбороты
            |		ПО ДебиторкаОстатки.Контрагенты = ДебиторкаОстаткиИОбороты.Контрагенты
            |			И ДебиторкаОстатки.ДокНомер = ДебиторкаОстаткиИОбороты.ДокНомер
            |			И ДебиторкаОстатки.Счет = ДебиторкаОстаткиИОбороты.Счет
            |ГДЕ
            |	ДебиторкаОстатки.ЗадолженностьСумОстаток < 0
            |	И ДебиторкаОстаткиИОбороты.Счет = &Организация
            |
            |УПОРЯДОЧИТЬ ПО
            |	ДебиторкаОстатки.ДокНомер.ДатаСоставления УБЫВ,
            |	ДебиторкаОстатки.ДокНомер.УсловиеПредоплаты УБЫВ";
        
        Запрос.УстановитьПараметр("Дата", Дата);
        Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
        Запрос.УстановитьПараметр("Организация", Организация);
        
        РезультатЗапроса = Запрос.Выполнить();
        ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

        // Первый этап: распределяем по непросроченным документам
        Пока Поступление > 0 И ВыборкаДетальныеЗаписи.Следующий() Цикл
            // Проверяем, что документ не просрочен
            Если ВыборкаДетальныеЗаписи.ДокНомерСрокДействия <> Неопределено И ТипЗнч(ВыборкаДетальныеЗаписи.ДокНомерСрокДействия) = Тип("Дата") И ТипЗнч(Объект.Дата) = Тип("Дата") И Объект.Дата > ВыборкаДетальныеЗаписи.ДокНомерСрокДействия Тогда
                Продолжить;
            КонецЕсли;
            
            Если ТипЗнч(ВыборкаДетальныеЗаписи.УсловиеПредоплаты) = Тип("Число") Тогда
				
			Если ВыборкаДетальныеЗаписи.ЗадолженностьСумОстаток*(-1)>=ВыборкаДетальныеЗаписи.ЗадолженностьСумРасход * (ВыборкаДетальныеЗаписи.УсловиеПредоплаты / 100) Тогда 
				ПредоплатаТребуемая = (ВыборкаДетальныеЗаписи.ЗадолженностьСумОстаток*(-1))-ВыборкаДетальныеЗаписи.ЗадолженностьСумРасход * (ВыборкаДетальныеЗаписи.УсловиеПредоплаты / 100);
				МаксимальнаяСуммаПогашения = ВыборкаДетальныеЗаписи.ЗадолженностьСумРасход * (ВыборкаДетальныеЗаписи.УсловиеПредоплаты / 100)-ВыборкаДетальныеЗаписи.ЗадолженностьСумПриход;
			Иначе
                ПредоплатаТребуемая = 0; // Значение по умолчанию, если УсловиеПредоплаты не является числом
				МаксимальнаяСуммаПогашения = -ВыборкаДетальныеЗаписи.ЗадолженностьСумОстаток; 
			КонецЕсли;
		КонецЕсли;
		
    Остаток = Мин(-ВыборкаДетальныеЗаписи.ЗадолженностьСумОстаток, МаксимальнаяСуммаПогашения);
    СуммаПогашения = Мин(Поступление, Остаток );
            // Учитываем предоплату для текущего документа
            //СуммаПогашения = Мин(Поступление,Остаток);

            Если СуммаПогашения > 0 Тогда
                НоваяСтрока = Объект.ПТабдок2.Добавить();
                НоваяСтрока.Контрагенты = Контрагенты;
                НоваяСтрока.ДокНомер = ВыборкаДетальныеЗаписи.ДокНомер;
                НоваяСтрока.СуммаЗадолженности = Остаток;
                НоваяСтрока.счет = Рек.Счет;
                НоваяСтрока.Статья = Рек.Статья;
                НоваяСтрока.СуммаПогашения = СуммаПогашения;
                НоваяСтрока.УсловиеПредоплаты = ВыборкаДетальныеЗаписи.УсловиеПредоплаты;

                Поступление = Поступление - СуммаПогашения;
            КонецЕсли;
        КонецЦикла;

        // Второй этап: распределяем остаток по просроченным документам
        ВыборкаДетальныеЗаписи.Сбросить();
        Пока Поступление > 0 И ВыборкаДетальныеЗаписи.Следующий() Цикл
            Если ВыборкаДетальныеЗаписи.ДокНомерСрокДействия <> Неопределено И ТипЗнч(ВыборкаДетальныеЗаписи.ДокНомерСрокДействия) = Тип("Дата") И ТипЗнч(Объект.Дата) = Тип("Дата") И Объект.Дата <= ВыборкаДетальныеЗаписи.ДокНомерСрокДействия Тогда
                Продолжить;
            КонецЕсли;

            Остаток = -ВыборкаДетальныеЗаписи.ЗадолженностьСумОстаток;
            СуммаПогашения = Мин(Поступление, Остаток ); 
            
            Если СуммаПогашения > 0 Тогда
                НоваяСтрока = Объект.ПТабдок2.Добавить();
                НоваяСтрока.Контрагенты = Контрагенты;
                НоваяСтрока.ДокНомер = ВыборкаДетальныеЗаписи.ДокНомер;
                НоваяСтрока.СуммаЗадолженности = Остаток;              
                НоваяСтрока.счет = Рек.Счет;
				
				НоваяСтрока.Статья = Рек.Статья;
                НоваяСтрока.СуммаПогашения = СуммаПогашения;
                НоваяСтрока.УсловиеПредоплаты = ВыборкаДетальныеЗаписи.УсловиеПредоплаты;

                Поступление = Поступление - СуммаПогашения;
            КонецЕсли;
        КонецЦикла;

        // Сообщение о нераспределенной сумме, если таковая осталась
        Если Поступление > 0 Тогда
            НоваяСтрока = Объект.ПТабдок.Добавить();
            НоваяСтрока.Контрагенты = Контрагенты;
			
			НоваяСтрока.ДокНомер = ДоговорОлиш("Переплата",Контрагенты);
			Если ПустаяСтрока(НоваяСтрока.ДокНомер) Тогда
			НоваяСтрока.ДокНомер = СоздатьНомерДокС2(Контрагенты,,Объект.Дата,,"Переплата",,);
			КонецЕсли;
			НоваяСтрока.ДокНомер = ДоговорОлиш("Переплата",Контрагенты);

            НоваяСтрока.счет = Рек.Счет;
            НоваяСтрока.Статья = Рек.Статья;
            НоваяСтрока.Переплата = Поступление;

            Сообщить("Осталась нераспределенная сумма: " + Поступление + " для контрагента: " + Контрагенты);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

