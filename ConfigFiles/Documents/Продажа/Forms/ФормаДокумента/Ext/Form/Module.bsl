Процедура СчетФактураМП(Команда)
	Для Каждого Строка из Объект.Табдок Цикл
		Если ПустаяСтрока(Строка.Контрагенты) Тогда
			Строка.Контрагенты=КонтрОламиз(Строка.ИНН);
		КонецЕсли;
		Строка.НомерДокС=НомерДокОлиш(Строка.НомерДок,Строка.Контрагенты);
	КонецЦикла;
	// Создаем массив для передачи данных
	МассивНомерДокС = Новый Массив;
	// Заполняем массив данными из табличной части
	Для Каждого Строка Из Объект.Табдок Цикл
		СтрокаМассива = Новый Структура;
		СтрокаМассива.Вставить("НомерДокс", Строка.НомерДокС);
		СтрокаМассива.Вставить("МП", Строка.МП);
		СтрокаМассива.Вставить("УсловиеПредоплаты", Строка.УсловиеПредоплаты);
		МассивНомерДокС.Добавить(СтрокаМассива);
	КонецЦикла;
	// Вызов серверной процедуры
	ЗаполнитьРеквизитДоговораМП(МассивНомерДокС);
