&НаСервере
Процедура ЗаполнитьРеквизитМП(МассивКонтрагентов)
    // Обходим массив данных
    Для Каждого Строка Из МассивКонтрагентов Цикл
        Контрагент = Строка.Контрагент;

        // Проверяем, заполнен ли контрагент
        Если ЗначениеЗаполнено(Контрагент) Тогда
            // Получаем объект контрагента для редактирования
            КонтрагентОбъект = Контрагент.ПолучитьОбъект();

            // Если реквизит МП пуст, заполняем его
            Если НЕ ЗначениеЗаполнено(КонтрагентОбъект.МП) Тогда
                КонтрагентОбъект.МП = Строка.МП;

                // Сохраняем изменения
                КонтрагентОбъект.Записать();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьРеквизитДоговораМП(МассивНомерДокС)
	// Обходим массив данных
	Для Каждого Строка Из МассивНомерДокС Цикл
		НомерДокС = Строка.НомерДокС;
		// Проверяем, заполнен ли контрагент
		Если ЗначениеЗаполнено(НомерДокС) Тогда
			// Получаем объект контрагента для редактирования
			НомерДокСОбъект = НомерДокС.ПолучитьОбъект();
			Изменено = Ложь;
			// Если реквизит МП пуст, заполняем его
			Если НЕ ЗначениеЗаполнено(НомерДокСОбъект.МП) Тогда
				НомерДокСОбъект.МП = Строка.МП;
				Изменено = Истина;
			КонецЕсли;
			// Если реквизит УсловиеПредоплаты пуст, заполняем его
			Если НЕ ЗначениеЗаполнено(НомерДокСОбъект.УсловиеПредоплаты) Тогда
				НомерДокСОбъект.УсловиеПредоплаты = Строка.УсловиеПредоплаты;
				Изменено = Истина;
			КонецЕсли;
			// Сохраняем изменения, если что-то изменилось
			Если Изменено Тогда
				НомерДокСОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры



	 
