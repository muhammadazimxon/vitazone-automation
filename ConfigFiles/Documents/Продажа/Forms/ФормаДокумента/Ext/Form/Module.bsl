&НаКлиенте
Процедура Команда1(Команда)
		Для Каждого Элемент Из Объект.Табдок Цикл
			
			
			Если ПустаяСтрока(ПартияНоменклатуры(Элемент.Номенклатура)) = Ложь Тогда
			Элемент.Партия=ПартияНоменклатуры(Элемент.Номенклатура);
			КонецЕсли;
			
		Если ПустаяСтрока(Элемент.Контрагенты) Тогда
        Если Не ПустаяСтрока(Элемент.ИНН) Тогда
            // Попробуем найти контрагента по ИНН
            Элемент.Контрагенты = КонтрОламиз(Элемент.ИНН);

           
			ОбщаяСтоимость=РассчитатьНомерДок(Элемент.НомерДок, Объект.Ссылка);
			//Сообщить(" " + "Общая стоимость счета-фактуры номер: " + Элемент.НомерДок + " составляет: " + ОбщаяСтоимость + " сум");
 			// Если не найден, создаём
            Если ПустаяСтрока(Элемент.Контрагенты) Тогда
                СоздатьКонтр(Элемент.ЗапКонтрНоми, Элемент.ИНН, Элемент.Регион, Элемент.Адрес, Элемент.ЗМП);
                Сообщить("Контрагент " + Элемент.ЗапКонтрНоми + " создан. ИНН: " + Элемент.ИНН, СтатусСообщения.ОченьВажное);

                // Повторно назначаем контрагента после создания
                Элемент.Контрагенты = КонтрОламиз(Элемент.ИНН);

                // Если и после создания не найден, сообщаем о проблеме
                Если ПустаяСтрока(Элемент.Контрагенты) Тогда
                    Сообщить("Не удалось найти созданного контрагента: " + Элемент.ЗапКонтрНоми, СтатусСообщения.Важное);
                КонецЕсли;
            КонецЕсли;
