Функция СЕТВИП(Контр)
Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Сеть КАК Сеть,
	|	Контрагенты.Вип КАК Вип
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", Контр);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.Сеть  Тогда
			Возврат "1";
		ИначеЕсли Выборка.Вип Тогда
			Возврат "1";
		ИНАЧЕ 
			Возврат "2";
		КонецЕсли;
		КонецЕСли;
	
