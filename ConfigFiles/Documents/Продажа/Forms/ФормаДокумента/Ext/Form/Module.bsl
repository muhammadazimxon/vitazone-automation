&НаСервере	 
Функция РассчитатьНомерДок(НомерДок, Ссылка)
    Стоимость = 0;

    // Проходим по строкам табличной части и суммируем значения КолВо для нужной номенклатуры
    Для Каждого Строка Из Объект.Табдок Цикл
        Если Строка.НомерДок =НомерДок Тогда
             Стоимость =  Стоимость + (Строка.Сумма+Строка.НДС);
        КонецЕсли;
    КонецЦикла;

    Возврат  Стоимость;
	КонецФункции

&НаСервере	 
Функция ПартияНоменклатуры (Номенклатура)
	
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.АктуальнаяПартия КАК АктуальнаяПартия
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.АктуальнаяПартия;
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

	
	
