	//Если Объект.Дата>Дата('20240430') Тогда
	Если Стр.Льгота=Ложь тогда  
		Если Объект.Дата >= Дата('20260813') Тогда
			Стр.НДС=Стр.Сумма/100*6;
		Иначе
			Стр.НДС=Стр.Сумма/100*12;
		КонецЕсли;
	КонецЕсли;
	//КонецЕсли;
	Стр.Себестоим=(Стр.ЦенаПр*Стр.Колво);
	Стр.Прибыль=Стр.Сумма-Стр.Себестоим;

