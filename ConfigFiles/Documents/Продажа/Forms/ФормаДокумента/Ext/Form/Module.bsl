		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток КАК ЗадолженностьСумКонечныйОстаток,
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход КАК ЗадолженностьСумРасход
		|ИЗ
		|	РегистрНакопления.Дебиторка.ОстаткиИОбороты(&Дата1, &Дата, , , Контрагенты = &Контрагенты) КАК ДебиторкаОстаткиИОбороты
		|ГДЕ
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток <> 0
		|	И ДебиторкаОстаткиИОбороты.Контрагенты.Наименование <> ""Прочие операции""
		|	И ДебиторкаОстаткиИОбороты.Контрагенты.РучныеПроводки=ЛОЖЬ
		|	И ДебиторкаОстаткиИОбороты.Счет = &Организация";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Дата1", '20010101');
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока  ВыборкаДетальныеЗаписи.Следующий() Цикл
		СчетФактура = ВыборкаДетальныеЗаписи.ДокНомер;
		
		    // Обнуляем переменные перед каждой итерацией
    Остаток = 0;
    Переплата = 0;
		
		
		Если ВыборкаДетальныеЗаписи.ЗадолженностьСумКонечныйОстаток<0 Тогда
			 Остаток=(ВыборкаДетальныеЗаписи.ЗадолженностьСумКонечныйОстаток)*(-1);
		 ИначеЕсли ВыборкаДетальныеЗаписи.ЗадолженностьСумКонечныйОстаток>0 Тогда
			 Переплата=ВыборкаДетальныеЗаписи.Переплата;
		 КонецЕсли;
		 
		
		
				 
		  // Определяем сумму погашения
            //СуммаПогашения = Мин(Поступление, Остаток); 
		НоваяСтрока = Объект.ПТабдок1.Добавить();
		НоваяСтрока.Контрагенты = Рек.Контрагенты;
		НоваяСтрока.ДокНомер=СчетФактура;
		НоваяСтрока.Назначение=Строка(" " + Рек.НомерСтроки + " катордаги " + Рек.Контрагенты);
		НоваяСтрока.Инн=Рек.Инн;
		НоваяСтрока.Счет = Объект.Счет;
		//НоваяСтрока.Статья=Рек.Статья;
		НоваяСтрока.СуммаЗадолженности = Остаток;
		НоваяСтрока.УсловиеПредоплаты = СчетФактура.УсловиеПредоплаты;
		//НоваяСтрока.СуммаПогашения=СуммаПогашения;
		НоваяСтрока.СуммаДоговора=ВыборкаДетальныеЗаписи.ЗадолженностьСумРасход;
		    // Добавляем переплату только если она есть
			Если Переплата <> 0 Тогда
				НоваяСтрока.докНомер1=ДоговорОлиш("Переплата",Рек.Контрагенты);
				Если ПустаяСтрока(НоваяСтрока.докНомер1)=Истина Тогда
					СоздатьНомерДокС2(Рек.Контрагенты,Объект.Дата,Объект.Дата,,"Переплата",,);
					НоваяСтрока.докНомер1=ДоговорОлиш("Переплата",Рек.Контрагенты);
					КонецЕсли;

        НоваяСтрока.Переплата = Переплата;
    КонецЕсли;
КонецЦикла;
КонецЦикла

КонецПроцедуры

