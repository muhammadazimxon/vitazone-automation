Процедура ЗаполнитьТабличнуюЧастьПродажи(ДатаДокумента)
    
    // Установка параметров соединения
    СтрокаСоединения = "Srvr='192.168.1.240';Ref='hed2021';Usr='Sherzod';Pwd='1';";
    
    Попытка
        COMОбъект = Новый COMОбъект("V83.COMConnector");
        Соединение = COMОбъект.Connect(СтрокаСоединения);
    Исключение
        Сообщить("Ошибка подключения: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    
    // Формирование запроса
    Запрос = Соединение.NewObject("Запрос");
    
    ТекстЗапроса = 
    "ВЫБРАТЬ
    |	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
    |	РеализацияТоваровУслуг.Дата КАК Дата,
    |	РеализацияТоваровУслуг.Партнер КАК Партнер,
	|	РеализацияТоваровУслуг.Номер КАК НомерДок,
    |	РеализацияТоваровУслуг.Договор КАК Договор,
    |	РеализацияТоваровУслуг.Товары.(
    |		Номенклатура КАК Номенклатура,
    |		Количество КАК Количество,
    |		Цена КАК Цена,
    |		Сумма КАК Сумма,
    |		СуммаНДС КАК СуммаНДС
    |	) КАК Товары,
    |	РеализацияТоваровУслуг.Супервайзер КАК Супервайзер,
    |	РеализацияТоваровУслуг.Партнер.БизнесРегион КАК ПартнерБизнесРегион,
    |	РеализацияТоваровУслуг.Партнер.ИНН КАК ПартнерИНН,
    |	РеализацияТоваровУслуг.ЭтапыГрафикаОплаты.(
    |		ДатаПлатежа КАК ДатаПлатежа
    |	) КАК ЭтапыГрафикаОплаты,
    |	РеализацияТоваровУслуг.Соглашение КАК Соглашение
    |ИЗ
    |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
    |ГДЕ
    |	РеализацияТоваровУслуг.Дата МЕЖДУ &Дата И &Дата1
    |	И РеализацияТоваровУслуг.Проведен = ИСТИНА";
    
    Запрос.Text = ТекстЗапроса;
    Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаДокумента));
    Запрос.УстановитьПараметр("Дата1", КонецДня(ДатаДокумента));
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    // Очистка табличной части
    ОбъектДокумента = Объект.Табдок;
    ОбъектДокумента.Очистить();
    
    // Заполнение табличной части
    Пока Выборка.Следующий() Цикл
        
        ВыборкаТовары = Выборка.Товары.Выбрать();
        Пока ВыборкаТовары.Следующий() Цикл
            
            НоваяСтрока = ОбъектДокумента.Добавить();
            
            // Заполнение реквизитов
            НоваяСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(
                ВыборкаТовары.Номенклатура.Наименование);
            НоваяСтрока.ДатаПродажи = Выборка.Дата;
            НоваяСтрока.ИНН = Число(Выборка.ПартнерИНН);
            НоваяСтрока.Регион = Справочники.Регион.НайтиПоНаименованию(Выборка.ПартнерБизнесРегион.Наименование);
            НоваяСтрока.ЗапКонтрНоми = Выборка.Партнер.Наименование;
            НоваяСтрока.НомерДок = Выборка.НомерДок;
            
            // Получение первой даты оплаты из этапов
            ВыборкаЭтапы = Выборка.ЭтапыГрафикаОплаты.Выбрать();
            Если ВыборкаЭтапы.Следующий() Тогда
                НоваяСтрока.ДатаОплаты = ВыборкаЭтапы.ДатаПлатежа;
            КонецЕсли;
            
            НоваяСтрока.УсловиеПредоплаты = Выборка.Соглашение.наименование;
            НоваяСтрока.ЗМП = Выборка.Супервайзер.Наименование;
            НоваяСтрока.Колво = ВыборкаТовары.Количество;
            НоваяСтрока.Цена = ВыборкаТовары.Цена;
            НоваяСтрока.Сумма = ВыборкаТовары.Сумма;
            НоваяСтрока.НДС = ВыборкаТовары.СуммаНДС;
            
        КонецЦикла;
        
    КонецЦикла;
    
	
	
	// Запись документа
    Попытка
       // ОбъектДокумента.Записать();
        //Сообщить("Данные успешно перенесены");
    Исключение
        Сообщить("Ошибка записи: " + ОписаниеОшибки());
    КонецПопытки;
    
    // Закрытие соединения
    Соединение = Неопределено;
	//
	//	    Объект.Табдок.Очистить();
	//
	//// Переносим данные из ТабдокУт в Табдок
	//Для Каждого СтрокаУт Из Объект.Табдок Цикл
	//    НоваяСтрока = Объект.Табдок.Добавить();
	//    НоваяСтрока.Номенклатура        = СтрокаУт.Номенклатура;
	//    НоваяСтрока.ДатаПродажи         = СтрокаУт.ДатаПродажи;
	//    НоваяСтрока.ИНН                 = СтрокаУт.ИНН;
	//    НоваяСтрока.Регион              = СтрокаУт.Регион;
	//    НоваяСтрока.ЗапКонтрНоми        = СтрокаУт.ЗапКонтрНоми;
	//    НоваяСтрока.НомерДок            = СтрокаУт.НомерДок;
	//    НоваяСтрока.УсловиеПредоплаты   = СтрокаУт.УсловиеПредоплаты;
	//    НоваяСтрока.ЗМП                 = СтрокаУт.ЗМП;
	//    НоваяСтрока.Колво               = СтрокаУт.Колво;
	//    НоваяСтрока.Цена                = СтрокаУт.Цена;
	//    НоваяСтрока.Сумма               = СтрокаУт.Сумма;
	//    НоваяСтрока.НДС                 = СтрокаУт.НДС;
	//КонецЦикла;
    
    // Сообщаем пользователю об успешном переносе
    Сообщить("Данные успешно импортированы из УТ");

    
КонецПроцедуры

