// Модуль формы обработки

#Область ОбработчикиСобытийФормы

// При создании формы на сервере
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Инициализация реквизитов формы
    Объект.Начало = НачалоМесяца(ТекущаяДатаСеанса());
    Объект.Конец2 = КонецМесяца(ТекущаяДатаСеанса());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды "Выполнять"
&НаКлиенте
Процедура Выполнять(Команда)
    // Проверка заполненности периода
    Если НЕ ЗначениеЗаполнено(Объект.Начало) Тогда
        ПоказатьПредупреждение(, "Укажите начало периода!",, "Ошибка");
        Возврат;
    КонецЕсли;
    
    Если НЕ ЗначениеЗаполнено(Объект.Конец2) Тогда
        ПоказатьПредупреждение(, "Укажите конец периода!",, "Ошибка");
        Возврат;
    КонецЕсли;
    
    Если Объект.Начало > Объект.Конец2 Тогда
        ПоказатьПредупреждение(, "Дата начала периода не может быть больше даты конца!",, "Ошибка");
        Возврат;
    КонецЕсли;
    
    // Вызов серверной процедуры для заполнения табличной части
    ЗаполнитьТабличнуюЧастьНаСервере();
    
    // Оповещение пользователя об успешном выполнении
    ПоказатьОповещениеПользователя("Заполнение завершено",, "Табличная часть заполнена данными.", БиблиотекаКартинок.Информация);
КонецПроцедуры

// Обработчик команды "ФИФО"
&НаКлиенте
Процедура ФИФО(Команда)
    // Подтверждение выполнения
    Оповещение = Новый ОписаниеОповещения("ФИФОПослеПодтверждения", ЭтотОбъект);
    ПоказатьВопрос(Оповещение, "Выполнить распределение сумм по ФИФО?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
КонецПроцедуры

// Обработчик подтверждения команды "ФИФО"
&НаКлиенте
Процедура ФИФОПослеПодтверждения(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ВыполнитьФИФОНаСервере();
        ПоказатьОповещениеПользователя("Распределение завершено",, "Суммы распределены по ФИФО, строки с нулевым остатком удалены.", БиблиотекаКартинок.Информация);
    КонецЕсли;
КонецПроцедуры

// Обработчик команды "Сформировать"
&НаКлиенте
Процедура Сформировать(Команда)
    // Вызов команды "Выполнять"
    Выполнять(Неопределено);
    
    // Проверка, что табличная часть заполнена после выполнения команды "Выполнять"
    Если Объект.ТабДок.Количество() = 0 Тогда
        Возврат; // Если заполнение не выполнено (например, из-за ошибки), прекращаем
    КонецЕсли;
    
    // Вызов ФИФО без диалога подтверждения
    ФИФОПослеПодтверждения(КодВозвратаДиалога.Да, Неопределено);  
	Объект.Контроль=0;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Серверная процедура для заполнения табличной части
&НаСервере
Процедура ЗаполнитьТабличнуюЧастьНаСервере()
    // Формирование запроса
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ДебиторкаОстаткиИОбороты.Контрагенты КАК Контрагенты,
        |    ДебиторкаОстаткиИОбороты.Статья КАК Статья,
        |    ДебиторкаОстаткиИОбороты.ДокНомер КАК ДокНомер,
        |    ДебиторкаОстаткиИОбороты.Счет КАК Счет,
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток КАК НачальныйОстаток,
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумПриход КАК РПриход,
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход КАК РРасход,
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток КАК КонечныйОстаток,
        |    ДебиторкаОстаткиИОбороты.ДокНомер.ДатаСоставления КАК ДатаДоговора,
        |    ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия КАК СрокДоговора,
        |    ДебиторкаОстаткиИОбороты.МП КАК МП,
        |    ВЫБОР
        |        КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
        |                И &Начало > ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия
        |            ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток
        |        ИНАЧЕ 0
        |    КОНЕЦ КАК СуммаПросрочкиНачало,  
		|
        |    ВЫБОР
        |        КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток <> 0
        |            ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток
        |    КОНЕЦ КАК СуммаПоОстатку,
        |    
		|	ВЫБОР 
		|
        |        КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
        |            ТОГДА КОЛИЧЕСТВО(ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток)
        |        ИНАЧЕ 0
        |    КОНЕЦ КАК СуммаПоПросрочке, 
		|
        |    ВЫБОР
        |        КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
        |                И ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия < &Конец
        |                И ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток < 0
        |            ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток
        |        ИНАЧЕ 0
        |    КОНЕЦ КАК СуммаПросрочки,
		|
        |    ВЫБОР
        |        КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
        |            ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток
        |        ИНАЧЕ 0
        |    КОНЕЦ КАК Количество,
		|
        |    ВЫБОР
        |        КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток <> 0
        |                И ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток < 0
        |            ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток / ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток * 100
        |        ИНАЧЕ 0
        |    КОНЕЦ КАК КоэфПросрочки,
		|
        |    ВЫБОР
        |        КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумПриход <> 0
        |            ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход / ДебиторкаОстаткиИОбороты.ЗадолженностьСумПриход * 100
        |        ИНАЧЕ 0
        |    КОНЕЦ КАК КоэфОплаты,
		|
        |    ВЫБОР
        |        КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток <> 0
        |            ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход / ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток * 100
        |        ИНАЧЕ 0
        |    КОНЕЦ КАК КоэфРеализации,
		|
        |    
		|	ДебиторкаОстаткиИОбороты.ДокНомер.МП.Куратор КАК Куратор,
        |    ДебиторкаОстаткиИОбороты.МП.Регион КАК Регион
        |ИЗ
        |    РегистрНакопления.Дебиторка.ОстаткиИОбороты(&Начало, &Конец,,,) КАК ДебиторкаОстаткиИОбороты
        |ГДЕ
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток <> 0
        |СГРУППИРОВАТЬ ПО
        |    ДебиторкаОстаткиИОбороты.Контрагенты,
        |    ДебиторкаОстаткиИОбороты.Статья,
        |    ДебиторкаОстаткиИОбороты.ДокНомер,
        |    ДебиторкаОстаткиИОбороты.Счет,
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумНачальныйОстаток,
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумПриход,
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход,
        |    ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток,
        |    ДебиторкаОстаткиИОбороты.ДокНомер.ДатаСоставления,
        |    ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия,
        |    ДебиторкаОстаткиИОбороты.МП,
        |    ДебиторкаОстаткиИОбороты.ДокНомер.МП.Куратор,
        |    ДебиторкаОстаткиИОбороты.МП.Регион";

    Запрос.УстановитьПараметр("Начало", Объект.Начало);
    Запрос.УстановитьПараметр("Конец", Объект.Конец2);

    // Выполнение запроса и заполнение табличной части
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    Объект.ТабДок.Очистить();

    Пока Выборка.Следующий() Цикл
        НоваяСтрока = Объект.ТабДок.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
    КонецЦикла;
КонецПроцедуры

// Серверная процедура для выполнения распределения по ФИФО
&НаСервере
Процедура ВыполнитьФИФОНаСервере()
    // Проверка, что табличная часть заполнена
    Если Объект.ТабДок.Количество() = 0 Тогда
        Сообщить("Табличная часть пуста! Сначала выполните заполнение.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;

    // Получение списка уникальных контрагентов
    МассивКонтрагентов = Новый Массив;
    Для Каждого СтрокаТабДок Из Объект.ТабДок Цикл
        МассивКонтрагентов.Добавить(СтрокаТабДок.Контрагенты);
    КонецЦикла;
    Контрагенты = ПолучитьУникальныеЗначенияМассива(МассивКонтрагентов);

    // Обработка каждого контрагента
    Для Каждого Контрагент Из Контрагенты Цикл
        // Получение строк для текущего контрагента
        Отбор = Новый Структура("Контрагенты", Контрагент);
        СтрокиКонтрагента = Объект.ТабДок.НайтиСтроки(Отбор);

        // Разделение на положительные и отрицательные остатки
        ПоложительныеОстатки = Новый Массив;
        ОтрицательныеОстатки = Новый Массив;

        Для Каждого Строка Из СтрокиКонтрагента Цикл
            Если Строка.КонечныйОстаток > 0 Тогда
                ПоложительныеОстатки.Добавить(Строка);
            ИначеЕсли Строка.КонечныйОстаток < 0 Тогда
                ОтрицательныеОстатки.Добавить(Строка);
            КонецЕсли;
        КонецЦикла;

        // Сортировка отрицательных остатков по дате договора (от старых к новым)
        ТаблицаОтрицательных = Новый ТаблицаЗначений;
        ТаблицаОтрицательных.Колонки.Добавить("Строка");
        ТаблицаОтрицательных.Колонки.Добавить("ДатаДоговора", Новый ОписаниеТипов("Дата"));
        Для Каждого Строка Из ОтрицательныеОстатки Цикл
            НоваяСтрока = ТаблицаОтрицательных.Добавить();
            НоваяСтрока.Строка = Строка;
            НоваяСтрока.ДатаДоговора = Строка.ДатаДоговора;
        КонецЦикла;
        ТаблицаОтрицательных.Сортировать("ДатаДоговора Возр");
        ОтрицательныеОстатки = ТаблицаОтрицательных.ВыгрузитьКолонку("Строка");

        // Распределение положительных остатков
        Для Каждого СтрокаПоложительная Из ПоложительныеОстатки Цикл
            ОстатокДляРаспределения = СтрокаПоложительная.КонечныйОстаток;

            Для Каждого СтрокаОтрицательная Из ОтрицательныеОстатки Цикл
                Если ОстатокДляРаспределения <= 0 Тогда
                    Прервать;
                КонецЕсли;

                // Сумма, которую можно распределить
                СуммаДляПогашения = Мин(-СтрокаОтрицательная.КонечныйОстаток, ОстатокДляРаспределения);

                // Обновление остатков
                СтрокаПоложительная.КонечныйОстаток = СтрокаПоложительная.КонечныйОстаток - СуммаДляПогашения;
                СтрокаОтрицательная.КонечныйОстаток = СтрокаОтрицательная.КонечныйОстаток + СуммаДляПогашения;

                // Пересчет просрочек
                ПересчитатьПросрочку(СтрокаПоложительная);
                ПересчитатьПросрочку(СтрокаОтрицательная);

                ОстатокДляРаспределения = ОстатокДляРаспределения - СуммаДляПогашения;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;

    // Удаление строк с нулевым конечным остатком
    Индекс = Объект.ТабДок.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Если Объект.ТабДок[Индекс].КонечныйОстаток = 0 Тогда
            Объект.ТабДок.Удалить(Индекс);
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;
КонецПроцедуры

// Функция для получения уникальных значений массива
&НаСервере
Функция ПолучитьУникальныеЗначенияМассива(Массив)
    УникальныеЗначения = Новый Массив;
    Соответствие = Новый Соответствие;

    Для Каждого Элемент Из Массив Цикл
        Если Соответствие[Элемент] = Неопределено Тогда
            Соответствие.Вставить(Элемент, Истина);
            УникальныеЗначения.Добавить(Элемент);
        КонецЕсли;
    КонецЦикла;

    Возврат УникальныеЗначения;
КонецФункции

// Процедура для пересчета просрочек
&НаСервере
Процедура ПересчитатьПросрочку(СтрокаТабДок)
    // Пересчет СуммаПоОстатку
    Если СтрокаТабДок.КонечныйОстаток <> 0 Тогда
        СтрокаТабДок.СуммаПоОстатку = СтрокаТабДок.КонечныйОстаток;
    Иначе
        СтрокаТабДок.СуммаПоОстатку = 0;
    КонецЕсли;

    // Пересчет СуммаПоПросрочке
    Если ЗначениеЗаполнено(СтрокаТабДок.СрокДоговора) Тогда
        СтрокаТабДок.СуммаПоПросрочке = ?(СтрокаТабДок.КонечныйОстаток <> 0, 1, 0);
    Иначе
        СтрокаТабДок.СуммаПоПросрочке = 0;
    КонецЕсли;

    // Пересчет СуммаПросрочки
    Если ЗначениеЗаполнено(СтрокаТабДок.СрокДоговора) 
        И СтрокаТабДок.СрокДоговора < Объект.Конец2 
        И СтрокаТабДок.КонечныйОстаток <> 0 Тогда
        СтрокаТабДок.СуммаПросрочки = СтрокаТабДок.КонечныйОстаток;
    Иначе
        СтрокаТабДок.СуммаПросрочки = 0;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти                  


&НаКлиенте
Процедура УдалитьСтрокиСНеВключать(Команда)
 
  
    // Собираем уникальные кураторы
    УникальныеКураторы = Новый Массив;
    СоответствиеКураторов = Новый Соответствие; // Для кэша, чтобы не дублировать
   
    Для Каждого Строка Из Объект.Табдок Цикл
        Если ЗначениеЗаполнено(Строка.Куратор) И СоответствиеКураторов[Строка.Куратор] = Неопределено Тогда
            УникальныеКураторы.Добавить(Строка.Куратор);
            СоответствиеКураторов.Вставить(Строка.Куратор, Истина); // Просто метка
        КонецЕсли;
    КонецЦикла;
   
    Если УникальныеКураторы.Количество() = 0 Тогда
        Возврат; // Нет кураторов для проверки
    КонецЕсли;
   
    // Получаем реквизиты с сервера
    РеквизитыКураторов = ПолучитьРеквизитыКураторовНаСервере(УникальныеКураторы);
   
    // Собираем уникальные строки к удалению с помощью соответствия
    КУдалению = Новый Соответствие;
   
    Для Каждого Строка Из Объект.Табдок Цикл
		Если //ЗначениеЗаполнено(Строка.Куратор) И 
			РеквизитыКураторов[Строка.Куратор] = Истина Тогда
            КУдалению.Вставить(Строка, Истина);
        КонецЕсли;
    КонецЦикла;
    
	Для Каждого Строка Из Объект.Табдок Цикл
	    Если ПустаяСтрока(Строка.Куратор) = Истина Тогда
	        КУдалению.Вставить(Строка, Истина);
	    КонецЕсли;
	КонецЦикла;
    
    Для Каждого Строка Из Объект.Табдок Цикл
        Если ПолучимСчетХуршида(Строка.Счет) = "Хуршида хисоб раками" Тогда
            КУдалению.Вставить(Строка, Истина);
        КонецЕсли;
    КонецЦикла;
   
    // Преобразуем в массив уникальных строк
    СтрокиКУдалению = Новый Массив;
    Для Каждого КлючИЗначение Из КУдалению Цикл
        СтрокиКУдалению.Добавить(КлючИЗначение.Ключ);
    КонецЦикла;
   
    // Удаляем строки
    Для Каждого Строка Из СтрокиКУдалению Цикл
        Объект.Табдок.Удалить(Строка);
    КонецЦикла;
   
    // Обновляем форму
    Элементы.Табдок.Обновить(); 
	
	
	
	//ВТОРАЯ ЧАСТЬ
	  Если Объект.Контроль<>1 Тогда 
	// 1. Формируем соответствие: ДокНомер → Строка Табдок1 (для быстрого поиска)
    СоответствиеТабдок1 = Новый Соответствие;
    Для Каждого СтрокаТабдок1 Из Объект.Табдок1 Цикл
        Если ЗначениеЗаполнено(СтрокаТабдок1.ДокНомер) Тогда
            СоответствиеТабдок1.Вставить(СтрокаТабдок1.ДокНомер, СтрокаТабдок1);
        КонецЕсли;
    КонецЦикла;
    
    // 2. Вычитаем по каждой строке Табдок
    Для Каждого СтрокаТабдок Из Объект.Табдок Цикл
        СтрокаТабдок1 = СоответствиеТабдок1[СтрокаТабдок.ДокНомер];
        
        Если СтрокаТабдок1 <> Неопределено Тогда
            СтрокаТабдок.НачальныйОстаток = СтрокаТабдок.НачальныйОстаток + СтрокаТабдок1.НачальныйОстаток;
            СтрокаТабдок.КонечныйОстаток   = СтрокаТабдок.КонечныйОстаток   + СтрокаТабдок1.КонечныйОстаток;
            СтрокаТабдок.СуммаПросрочки    = СтрокаТабдок.СуммаПросрочки    + СтрокаТабдок1.СуммаПросрочки;
        КонецЕсли;
    КонецЦикла;
    
    // 3. Обновляем таблицу на форме
    Элементы.Табдок.Обновить();
    
    // Опционально: сообщение пользователю
    Сообщить("Вычитание выполнено (Табдок = Табдок - Табдок1 по ДокНомер).");
   Объект.Контроль=1;
   КонецЕсли;
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ПолучимСчетХуршида (Ссылка)
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организация.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Организация КАК Организация
		|ГДЕ
		|	Организация.Ссылка = &Ссылка";
	
