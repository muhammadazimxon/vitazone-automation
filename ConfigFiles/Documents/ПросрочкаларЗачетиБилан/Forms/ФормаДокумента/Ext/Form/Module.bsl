	КонецЦикла; 
	
	КонецФункции
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

	




&НаСервереБезКонтекста
Функция ПолучитьРеквизитыКураторовНаСервере(УникальныеКураторы)
    
    Реквизиты = Новый Соответствие;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Менеджеры.Ссылка КАК Ссылка,
    |   Менеджеры.НеВключатьВСписок КАК НеВключатьВСписок
    |ИЗ
    |   Справочник.Менеджер КАК Менеджеры
    |ГДЕ
    |   Менеджеры.Ссылка В (&УникальныеКураторы)";
    
    Запрос.УстановитьПараметр("УникальныеКураторы", УникальныеКураторы);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        Реквизиты.Вставить(Выборка.Ссылка, Выборка.НеВключатьВСписок);
    КонецЦикла;
    
    Возврат Реквизиты;
    
КонецФункции