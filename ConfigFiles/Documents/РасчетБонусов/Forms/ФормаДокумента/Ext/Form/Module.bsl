// Серверная функция для получения Цены из регистра
&НаСервереБезКонтекста
Функция ПолучитьЦенуБонуса(Номенклатура, Дата)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Или Не ЗначениеЗаполнено(Дата) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныБонусов.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныБонусов.СрезПоследних(&Дата, Номенклатура = &Номенклатура) КАК ЦеныБонусов";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// Клиентская процедура для пересчета СуммаПоСеть
&НаКлиенте
Процедура ПересчитатьСуммуПоСеть()
	
	Объект.СуммаПоСеть = 0;
	Для Каждого Строка Из Объект.Табдок Цикл
		Объект.СуммаПоСеть = Объект.СуммаПоСеть + Строка.Сумма;
		Объект.Разница=Объект.Остаток-Объект.СуммаПоСеть;
	КонецЦикла;
	
	
	
КонецПроцедуры

// Клиентская процедура для заполнения Начисления и Оплаты
&НаКлиенте
Процедура ЗаполнитьНачислениеИОплату()
	
	Если Не ЗначениеЗаполнено(Объект.Сеть) Тогда
		Объект.Начисление = 0;
		Объект.Оплата = 0;
		Возврат;
	КонецЕсли;
	
	Структура = ПолучитьНачислениеИОплатуНаСервере(Объект.Сеть, Объект.ДатаНачало, Объект.ДатаКонец, Объект.Дата);
	Объект.Начисление = Структура.Начисление;
	Объект.Оплата = Структура.Оплата;
	
КонецПроцедуры

// Клиентская процедура для обновления Цен в Табдок
&НаКлиенте
Процедура ОбновитьЦеныТабдок()
	
	Для Каждого Строка Из Объект.Табдок Цикл
		Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Строка.Цена = ПолучитьЦенуБонуса(Строка.Номенклатура, Объект.Датаконец);
			Строка.Сумма = Строка.Количество * Строка.Цена;
		КонецЕсли;
	КонецЦикла;
	
	ПересчитатьСуммуПоСеть();
	
КонецПроцедуры         




// Серверная функция для получения сумм из регистра Бонусы
&НаСервереБезКонтекста
Функция ПолучитьНачислениеИОплатуНаСервере(Сеть, ДатаНачало, ДатаКонец, Дата)
	
	Структура = Новый Структура("Начисление, Оплата", 0, 0);
	Если Не ЗначениеЗаполнено(Сеть) Или Не ЗначениеЗаполнено(ДатаНачало) Тогда
		Возврат Структура;
	КонецЕсли;
	
	// Получаем все договоры, подчиненные Сети
	ЗапросДоговоры = Новый Запрос;
	ЗапросДоговоры.Текст = 
	"ВЫБРАТЬ
	|	Договор.Ссылка КАК ДокНомер
	|ИЗ
	|	Справочник.Договор КАК Договор
	|ГДЕ
	|	Договор.Владелец = &Сеть";
	
	ЗапросДоговоры.УстановитьПараметр("Сеть", Сеть);
	Договоры = ЗапросДоговоры.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокНомер");
	
	Если Договоры.Количество() = 0 Тогда
		Возврат Структура;
	КонецЕсли;
	
	// Запрос на Начисление (Приход за ДатаНачало - ДатаКонец)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(Бонусы.Сумма) КАК Сумма
	|ИЗ
	|	РегистрНакопления.Бонусы КАК Бонусы
	|ГДЕ
	|	Бонусы.Период МЕЖДУ &ДатаНачало И &ДатаКонец
	|	И Бонусы.ДокНомер В (&Договоры)
	|	И Бонусы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)";
	
	Запрос.УстановитьПараметр("ДатаНачало", ДатаНачало);
	Запрос.УстановитьПараметр("ДатаКонец", ?(ЗначениеЗаполнено(ДатаКонец), КонецДня(ДатаКонец), КонецДня(ТекущаяДатаСеанса())));
	Запрос.УстановитьПараметр("Договоры", Договоры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Структура.Начисление = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
	КонецЕсли;
	
	// Запрос на Оплату (Расход за ДатаНачало - Дата)
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(Бонусы.Сумма) КАК Сумма
	|ИЗ
	|	РегистрНакопления.Бонусы КАК Бонусы
	|ГДЕ
	|	Бонусы.Период МЕЖДУ &ДатаНачало И &Дата
	|	И Бонусы.ДокНомер В (&Договоры)
	|	И Бонусы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
	
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Дата), КонецДня(Дата), КонецДня(ТекущаяДатаСеанса())));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Структура.Оплата = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

