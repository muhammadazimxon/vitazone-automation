// Обработчик изменения Сети на форме
&НаКлиенте
Процедура СетьПриИзменении(Элемент)
	
	// Заполняем Начисление и Оплату
	ЗаполнитьНачислениеИОплату();
	
	// Пересчитываем Остаток
	Объект.Остаток = Объект.Начисление - Объект.Оплата;
	
КонецПроцедуры

// Обработчик изменения ДатаНачало на форме
&НаКлиенте
Процедура ДатаНачалоПриИзменении(Элемент)
	
	// Обновляем Цены в Табдок
	ОбновитьЦеныТабдок();
	
	// Обновляем Начисление и Оплату
	ЗаполнитьНачислениеИОплату();
	
	// Пересчитываем Остаток
	Объект.Остаток = Объект.Начисление - Объект.Оплата;
	
КонецПроцедуры

