// Обработчик изменения Номенклатуры в табличной части Табдок
&НаКлиенте
Процедура ТабдокНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Табдок.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заполняем Цену из регистра ЦеныБонусов на ДатаНачало
	ТекущиеДанные.Цена = ПолучитьЦенуБонуса(ТекущиеДанные.Номенклатура, Объект.ДатаКонец);
	
	// Пересчитываем Сумму в строке
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
	
	// Пересчитываем итог по сети
	ПересчитатьСуммуПоСеть();
	
КонецПроцедуры

