Процедура ОбработкаПроведения(Отказ, РежимПроведения)
   
    Если Не ЗначениеЗаполнено(ДатаНачало) Тогда
        Отказ = Истина;
        Сообщить("Ошибка: ДатаНачало не заполнена! Проведение невозможно.");
        Возврат;
    КонецЕсли;
   
    РасчетныйПериод = НачалоМесяца(ДатаНачало);
   
    // Очистка старых движений (стандартно для повторного проведения)
    Движения.НачисленныеЗП.Очистить();
    Движения.НачисленныеЗП.Записывать = Истина;
   
    // Для МП: начисления как приход
    Для Каждого СтрокаМП Из ТабдокМП Цикл
        Если Не ЗначениеЗаполнено(СтрокаМП.Куратор) Или Не ЗначениеЗаполнено(СтрокаМП.МП) Тогда
            Продолжить;
        КонецЕсли;
       
        Движение = Движения.НачисленныеЗП.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период = Дата; // Дата документа
        Движение.ПериодРасчета = РасчетныйПериод;
        Движение.Куратор = СтрокаМП.Куратор;
        Движение.МП = СтрокаМП.МП;
        Движение.Зарплата = СтрокаМП.Зарплата;
        Движение.Бонус = СтрокаМП.Бонус;
        Движение.СуммаРеализации = СтрокаМП.Сумма;
        // Коэффициент и пороги в реквизитах
        Если СтрокаМП.Сумма < БазоваяСумма Тогда
            Движение.Коэффициент = Ниже;
        ИначеЕсли СтрокаМП.Сумма < Порог Тогда
            Движение.Коэффициент = Выше;
        Иначе
            Движение.Коэффициент = ВышеПорога;
        КонецЕсли;
        Движение.БазоваяСумма = БазоваяСумма;
        Движение.Порог = Порог;
    КонецЦикла;
   
    // Для перерасчетов: удержания как расход
    Для Каждого СтрокаПерерасчет Из ТабдокПерерасчет Цикл
        Если Не ЗначениеЗаполнено(СтрокаПерерасчет.Период) Тогда
            Продолжить;
        КонецЕсли;
       
        Движение = Движения.НачисленныеЗП.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Дата; // Текущая дата документа
        Движение.ПериодРасчета = СтрокаПерерасчет.Период; // Прошлый период
        Движение.Куратор = СтрокаПерерасчет.Куратор;
        Движение.МП = СтрокаПерерасчет.МП;
        Движение.Зарплата = СтрокаПерерасчет.СуммаРазницыЗП; // Разница как расход
        Движение.СуммаРеализации = - (СтрокаПерерасчет.РеализацияСтарая - СтрокаПерерасчет.РеализацияНовая); // Корректировка реализации
        Движение.Коэффициент = СтрокаПерерасчет.КоэфНовый;
        Движение.Комментарий = СтрокаПерерасчет.Комментарий;
    КонецЦикла;
   
    Движения.Записать();
   
КонецПроцедуры