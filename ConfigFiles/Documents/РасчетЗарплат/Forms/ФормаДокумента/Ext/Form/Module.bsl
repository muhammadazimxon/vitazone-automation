&НаКлиенте
Процедура Ставки(Команда)
    // Вызываем серверную процедуру для запроса
    СтавкиСервер();
КонецПроцедуры

&НаСервере
Процедура СтавкиСервер()
    // Запрос к регистру УчетЗПБонусов по Куратору
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   УчетЗПБонусов.Выше КАК Выше,
    |   УчетЗПБонусов.Ниже КАК Ниже,
    |   УчетЗПБонусов.ВышеПорога КАК ВышеПорога,
    |   УчетЗПБонусов.Кураторские КАК Кураторские,
    |   УчетЗПБонусов.Порог КАК Порог
    |ИЗ
    |   РегистрСведений.УчетЗПБонусов КАК УчетЗПБонусов
    |ГДЕ
    |   УчетЗПБонусов.Куратор = &Куратор";
    
    Запрос.УстановитьПараметр("Куратор", Объект.Куратор);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Объект.Выше = Выборка.Выше;
        Объект.Ниже = Выборка.Ниже;
        Объект.ВышеПорога = Выборка.ВышеПорога;
        Объект.Кураторские = Выборка.Кураторские;
        Объект.Порог = Выборка.Порог; // Добавляем загрузку Порога, как уточнил
    Иначе
        Сообщить("Ставки не найдены для куратора!");
    КонецЕсли;
    
    Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Собрать(Команда)
    // Вызываем серверную процедуру
    СобратьСервер();
КонецПроцедуры

&НаСервере
Процедура СобратьСервер()
    // Очищаем табличные части перед сбором
    Объект.Табдок.Очистить();
    Объект.Табдок1.Очистить();
   
    // Запрос к табличной части документов Продажа
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | ПродажаТабдок.НомерДокС КАК НомерДокС,
    | ПродажаТабдок.МП.Куратор КАК Куратор,
    | ПродажаТабдок.МП КАК МП,
    | ПродажаТабдок.Контрагенты КАК Контрагенты,
    | ПродажаТабдок.Сумма КАК Сумма,
    | ПродажаТабдок.ИНН КАК ИНН,
    | ПродажаТабдок.ДатаОплаты КАК Срок,
    | ПродажаТабдок.НомерДокС.УсловиеПредоплаты КАК Условие,
    | ПродажаТабдок.Номенклатура КАК Номенклатура,
    | ПродажаТабдок.Колво КАК Колво,
    | ПродажаТабдок.ДатаПродажи КАК ДатаПродажи,
    | ПродажаТабдок.Бонус КАК Бонус
    |ИЗ
    | Документ.Продажа.Табдок КАК ПродажаТабдок
    |ГДЕ
    | ПродажаТабдок.Ссылка.Проведен = ИСТИНА
    | И ПродажаТабдок.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
    | И (&Куратор = ЗНАЧЕНИЕ(Справочник.Менеджер.ПустаяСсылка) ИЛИ ПродажаТабдок.Куратор = &Куратор)";
   
    Запрос.УстановитьПараметр("НачалоПериода", Объект.ДатаНачало);
    Запрос.УстановитьПараметр("КонецПериода", Объект.ДатаОкончания);
    Запрос.УстановитьПараметр("Куратор", Объект.Куратор);
   
    Выборка = Запрос.Выполнить().Выбрать();
   
    Пока Выборка.Следующий() Цикл
        Если Выборка.Колво > 0 Тогда
            // Положительные - в Табдок
            НоваяСтрока = Объект.Табдок.Добавить();
            ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
        ИначеЕсли Выборка.Колво < 0 Тогда
            // Отрицательные (возвраты) - в Табдок1, инвертируем значения
            НоваяСтрока = Объект.Табдок1.Добавить();
            ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
            НоваяСтрока.Колво = -НоваяСтрока.Колво;
            Если НоваяСтрока.Сумма < 0 Тогда
                НоваяСтрока.Сумма = -НоваяСтрока.Сумма;
            КонецЕсли;
            Если НоваяСтрока.Бонус < 0 Тогда
                НоваяСтрока.Бонус = -НоваяСтрока.Бонус;
            КонецЕсли;
            Сообщить("Отладка: Добавлен возврат в Табдок1: НомерДокС = " + Выборка.НомерДокС + ", ДатаПродажи = " + Строка(Выборка.ДатаПродажи) + ", Сумма = " + Строка(НоваяСтрока.Сумма));
        КонецЕсли;
    КонецЦикла;
   
    Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Обитожить(Команда)
    // Вызываем серверную процедуру
    ОбитожитьСервер();
КонецПроцедуры

&НаСервере
Процедура ОбитожитьСервер()
    // Очищаем итоговые табличные части
    Объект.ТабдокМП.Очистить();
    Объект.ТабдокКуратор.Очистить();
    Объект.ТабдокПерерасчет.Очистить();
   
    // Шаг 1: Создаём временные таблицы по отдельности, чтобы обойти ошибку с параметрами
    Запрос = Новый Запрос;
    Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
   
    // 1.1: ВТ для продаж (Табдок, положительные)
    Запрос.Текст =
    "ВЫБРАТЬ
    | Табдок.Куратор КАК Куратор,
    | Табдок.МП КАК МП,
    | Табдок.Сумма КАК Сумма,
    | Табдок.Бонус КАК Бонус,
    | Табдок.ДатаПродажи КАК ДатаПродажи,
    | Табдок.НомерДокС КАК НомерДокС
    |ПОМЕСТИТЬ ВТ_Продажи
    |ИЗ
    | &Табдок КАК Табдок";
   
    Запрос.УстановитьПараметр("Табдок", Объект.Табдок.Выгрузить());
    Запрос.Выполнить();
   
    // 1.2: ВТ для возвратов (Табдок1, с минусами)
    Запрос.Текст =
    "ВЫБРАТЬ
    | Табдок1.Куратор КАК Куратор,
    | Табдок1.МП КАК МП,
    | -Табдок1.Сумма КАК Сумма,
    | -Табдок1.Бонус КАК Бонус,
    | Табдок1.ДатаПродажи КАК ДатаПродажи,
    | Табдок1.НомерДокС КАК НомерДокС
    |ПОМЕСТИТЬ ВТ_Возвраты
    |ИЗ
    | &Табдок1 КАК Табдок1";
   
    Запрос.УстановитьПараметр("Табдок1", Объект.Табдок1.Выгрузить());
    Запрос.Выполнить();
   
    // 1.3: Объединяем в основную ВТ_ВсеДанные (теперь из ВТ, без параметров)
    Запрос.Текст =
    "ВЫБРАТЬ
    | ВТ_Продажи.Куратор КАК Куратор,
    | ВТ_Продажи.МП КАК МП,
    | ВТ_Продажи.Сумма КАК Сумма,
    | ВТ_Продажи.Бонус КАК Бонус,
    | ВТ_Продажи.ДатаПродажи КАК ДатаПродажи,
    | ВТ_Продажи.НомерДокС КАК НомерДокС
    |ПОМЕСТИТЬ ВТ_ВсеДанные
    |ИЗ
    | ВТ_Продажи КАК ВТ_Продажи
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    | ВТ_Возвраты.Куратор,
    | ВТ_Возвраты.МП,
    | ВТ_Возвраты.Сумма,
    | ВТ_Возвраты.Бонус,
    | ВТ_Возвраты.ДатаПродажи,
    | ВТ_Возвраты.НомерДокС
    |ИЗ
    | ВТ_Возвраты КАК ВТ_Возвраты";
   
    Запрос.Выполнить(); // Теперь безопасно, параметры не в объединении
   
    // Шаг 2: Выборка netto по МП для ТабдокМП
    Запрос.Текст =
    "ВЫБРАТЬ
    | ВТ_ВсеДанные.Куратор КАК Куратор,
    | ВТ_ВсеДанные.МП КАК МП,
    | СУММА(ВТ_ВсеДанные.Сумма) КАК СуммаNetto,
    | СУММА(ВТ_ВсеДанные.Бонус) КАК БонусNetto
    |ИЗ
    | ВТ_ВсеДанные КАК ВТ_ВсеДанные
    |ГДЕ
    | ВТ_ВсеДанные.ДатаПродажи МЕЖДУ &ДатаНачало И &ДатаОкончания
    |
    |СГРУППИРОВАТЬ ПО
    | ВТ_ВсеДанные.Куратор,
    | ВТ_ВсеДанные.МП";
   
    Запрос.УстановитьПараметр("ДатаНачало", Объект.ДатаНачало);
    Запрос.УстановитьПараметр("ДатаОкончания", Объект.ДатаОкончания);
   
    ВыборкаМП = Запрос.Выполнить().Выбрать();
   
    Пока ВыборкаМП.Следующий() Цикл
        Если ВыборкаМП.СуммаNetto < 0 Тогда
            Продолжить;
        КонецЕсли;
       
        // Определяем коэффициент для МП
        Коэффициент = 0;
        Если ВыборкаМП.СуммаNetto < Объект.БазоваяСумма Тогда
            Коэффициент = Объект.Ниже;
        ИначеЕсли ВыборкаМП.СуммаNetto < Объект.Порог Тогда
            Коэффициент = Объект.Выше;
        Иначе
            Коэффициент = Объект.ВышеПорога;
        КонецЕсли;
       
        Зарплата = ВыборкаМП.СуммаNetto * Коэффициент / 100;
       
        // Добавляем строку в ТабдокМП
        НоваяСтрока = Объект.ТабдокМП.Добавить();
        НоваяСтрока.Куратор = ВыборкаМП.Куратор;
        НоваяСтрока.МП = ВыборкаМП.МП;
        НоваяСтрока.Сумма = ВыборкаМП.СуммаNetto;
        НоваяСтрока.Зарплата = Зарплата;
        НоваяСтрока.Бонус = ВыборкаМП.БонусNetto; // Фиксированный
    КонецЦикла;
   
    // Шаг 3: Заполнение ТабдокКуратор (по Кураторам, группировка)
    Запрос.Текст =
    "ВЫБРАТЬ
    | ВТ_ВсеДанные.Куратор КАК Куратор,
    | СУММА(ВТ_ВсеДанные.Сумма) КАК СуммаNetto,
    | СУММА(ВТ_ВсеДанные.Бонус) КАК БонусNetto
    |ИЗ
    | ВТ_ВсеДанные КАК ВТ_ВсеДанные
    |ГДЕ
    | ВТ_ВсеДанные.ДатаПродажи МЕЖДУ &ДатаНачало И &ДатаОкончания
    |
    |СГРУППИРОВАТЬ ПО
    | ВТ_ВсеДанные.Куратор";
   
    ВыборкаКуратор = Запрос.Выполнить().Выбрать();
   
    Пока ВыборкаКуратор.Следующий() Цикл
        Если ВыборкаКуратор.СуммаNetto < 0 Тогда
            Продолжить;
        КонецЕсли;
       
        Зарплата = ВыборкаКуратор.СуммаNetto * Объект.Кураторские / 100;
       
        НоваяСтрока = Объект.ТабдокКуратор.Добавить();
        НоваяСтрока.Куратор = ВыборкаКуратор.Куратор;
        НоваяСтрока.Сумма = ВыборкаКуратор.СуммаNetto;
        НоваяСтрока.Зарплата = Зарплата;
        НоваяСтрока.Бонус = ВыборкаКуратор.БонусNetto;
    КонецЦикла;
   
    // Шаг 4: Перерасчеты для возвратов из прошлых периодов
    Запрос.Текст =
    "ВЫБРАТЬ
    | ВТ_ВсеДанные.Куратор КАК Куратор,
    | ВТ_ВсеДанные.МП КАК МП,
    | ВТ_ВсеДанные.НомерДокС КАК НомерДокС,
    | ВТ_ВсеДанные.ДатаПродажи КАК ДатаПродажи,
    | ВТ_ВсеДанные.Сумма КАК Сумма, // Отрицательная для возвратов
    | ВТ_ВсеДанные.Бонус КАК Бонус
    |ИЗ
    | ВТ_ВсеДанные КАК ВТ_ВсеДанные
    |ГДЕ
    | ВТ_ВсеДанные.Сумма < 0 // Только возвраты
    | И ВТ_ВсеДанные.ДатаПродажи < &ДатаНачало"; // Прошлые периоды
   
    ВыборкаВозвраты = Запрос.Выполнить().Выбрать();
   
    Сообщить("Отладка: Количество возвратов из прошлых периодов: " + Строка(ВыборкаВозвраты.Количество())); // Отладка: сколько строк в выборке
   
    Пока ВыборкаВозвраты.Следующий() Цикл
        Сообщить("Отладка: Возврат найден: НомерДокС = " + ВыборкаВозвраты.НомерДокС + ", ДатаПродажи = " + Строка(ВыборкаВозвраты.ДатаПродажи) + ", Сумма = " + Строка(ВыборкаВозвраты.Сумма)); // Отладка внутри цикла
       
        // Для каждого возврата: найти старые данные из регистра
        СтарыйПериод = НачалоМесяца(ВыборкаВозвраты.ДатаПродажи);
       
        ЗапросРегистр = Новый Запрос;
        ЗапросРегистр.Текст =
        "ВЫБРАТЬ
        | НачисленныеЗП.СуммаРеализации КАК РеализацияСтарая,
        | НачисленныеЗП.Коэффициент КАК КоэфСтарый,
        | НачисленныеЗП.Зарплата КАК ЗарпСтарая,
        | НачисленныеЗП.БазоваяСумма КАК БазоваяСумма,
        | НачисленныеЗП.Порог КАК Порог
        |ИЗ
        | РегистрСведений.НачисленныеЗП КАК НачисленныеЗП
        |ГДЕ
        | НачисленныеЗП.Период = &Период // Исправлено: встроенный Период
        | И НачисленныеЗП.Куратор = &Куратор
        | И НачисленныеЗП.МП = &МП";
       
        ЗапросРегистр.УстановитьПараметр("Период", СтарыйПериод);
        ЗапросРегистр.УстановитьПараметр("Куратор", ВыборкаВозвраты.Куратор);
        ЗапросРегистр.УстановитьПараметр("МП", ВыборкаВозвраты.МП);
       
        ВыборкаРегистр = ЗапросРегистр.Выполнить().Выбрать();
        Если ВыборкаРегистр.Следующий() Тогда
            Сообщить("Отладка: Данные из регистра найдены для возврата.");
           
            ВозвратСумма = -ВыборкаВозвраты.Сумма; // Положительная сумма возврата
           
            // Новая реализация
            РеализацияНовая = ВыборкаРегистр.РеализацияСтарая - ВозвратСумма;
           
            // Новый коэффициент (по старым порогам)
            КоэфНовый = 0;
            Если РеализацияНовая < ВыборкаРегистр.БазоваяСумма Тогда
                КоэфНовый = Объект.Ниже;
            ИначеЕсли РеализацияНовая < ВыборкаРегистр.Порог Тогда
                КоэфНовый = Объект.Выше;
            Иначе
                КоэфНовый = Объект.ВышеПорога;
            КонецЕсли;
           
            ЗарпНовая = РеализацияНовая * КоэфНовый / 100;
           
            // Проверяем, изменился ли коэффициент
            ИзменениеКоэф = (КоэфНовый <> ВыборкаРегистр.КоэфСтарый);
            Если ИзменениеКоэф Тогда
                // Полный перерасчет
                СуммаРазницыЗП = ВыборкаРегистр.ЗарпСтарая - ЗарпНовая;
                Комментарий = СтрШаблон("Изменение коэффициента с %1%% на %2%% из-за возврата %3 по док. %4", ВыборкаРегистр.КоэфСтарый, КоэфНовый, ВозвратСумма, ВыборкаВозвраты.НомерДокС);
            Иначе
                // Только на возврат
                СуммаРазницыЗП = ВозвратСумма * ВыборкаРегистр.КоэфСтарый / 100;
                Комментарий = СтрШаблон("Удержание на возврат %1 по док. %2 без изменения коэффициента", ВозвратСумма, ВыборкаВозвраты.НомерДокС);
            КонецЕсли;
           
            // Удержание для куратора (всегда на возврат * Кураторские)
            СуммаРазницыЗП = СуммаРазницыЗП + ВозвратСумма * Объект.Кураторские / 100;
           
            // Добавляем строку в ТабдокПерерасчет
            НоваяСтрока = Объект.ТабдокПерерасчет.Добавить();
            НоваяСтрока.Куратор = ВыборкаВозвраты.Куратор;
            НоваяСтрока.МП = ВыборкаВозвраты.МП;
            НоваяСтрока.Период = СтарыйПериод;
            НоваяСтрока.РеализацияСтарая = ВыборкаРегистр.РеализацияСтарая;
            НоваяСтрока.КоэфСтарый = ВыборкаРегистр.КоэфСтарый;
            НоваяСтрока.ЗарпСтарая = ВыборкаРегистр.ЗарпСтарая;
            НоваяСтрока.РеализацияНовая = РеализацияНовая;
            НоваяСтрока.КоэфНовый = КоэфНовый;
            НоваяСтрока.ЗарпНовая = ЗарпНовая;
            НоваяСтрока.СуммаРазницыЗП = СуммаРазницыЗП;
            НоваяСтрока.Комментарий = Комментарий;
            Сообщить("Отладка: Добавлена строка в ТабдокПерерасчет.");
        Иначе
            Сообщить("Отладка: Данные из регистра не найдены для возврата: " + ВыборкаВозвраты.НомерДокС);
        КонецЕсли;
    КонецЦикла;
   
    Модифицированность = Истина;
КонецПроцедуры


