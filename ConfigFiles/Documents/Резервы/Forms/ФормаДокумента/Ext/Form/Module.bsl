&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	Объект.Курс=КурсОламиз.КурсОламиз(Объект.Дата, Объект.Валюта);
КонецПроцедуры


Функция ВалютаДоллар() 
	Возврат Справочники.Валюта.USD
КонецФункции

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	Если Объект.Валюта.Пустая()=Истина
		Тогда Объект.Валюта=ВалютаДоллар();
	КонецЕсли;
	Объект.Курс=КурсОламиз.КурсОламиз(Объект.Дата, Объект.Валюта);
КонецПроцедуры

&НаКлиенте
Процедура ТабдокСуммаПриИзменении(Элемент)
	Эл = Элементы.Табдок.ТекущиеДанные;
		Эл.Сумма1=Эл.Сумма/Объект.Курс;
КонецПроцедуры

&НаКлиенте
Процедура ТабдокРасходПриИзменении(Элемент)
	Эл = Элементы.Табдок.ТекущиеДанные;
		Эл.Расход1=Эл.Расход/Объект.Курс;

КонецПроцедуры

&НаКлиенте
Процедура ТабдокСумма1ПриИзменении(Элемент)
	Эл = Элементы.Табдок.ТекущиеДанные;
		Эл.Сумма=Эл.Сумма1*Объект.Курс;

КонецПроцедуры

&НаКлиенте
Процедура ТабдокРасход1ПриИзменении(Элемент)
	Эл = Элементы.Табдок.ТекущиеДанные;
		Эл.Расход=Эл.Расход1*Объект.Курс;
КонецПроцедуры
