Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Запись движений для регистра УчетСети (расход)
	Движения.УчетСети.Записывать = Истина;
	Для Каждого ТекСтрокаТабдок Из Табдок Цикл
		Движение = Движения.УчетСети.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТабдок.Номенклатура;
		Если ПастдагиСетлар=Истина Тогда
			   Движение.Сеть=ТекСтрокаТабдок.Сеть;
			   Иначе
		Движение.Сеть = Сеть;
		КонецЕсли;
		Движение.МП = ТекСтрокаТабдок.МП;
		Движение.Количество = ТекСтрокаТабдок.КолВо;
		Движение.Бонус = ТекСтрокаТабдок.Бонус;
	КонецЦикла;
	
	// Запись движений для регистра УчетСети (приход)
	Движения.УчетСети.Записывать = Истина;
	Для Каждого ТекСтрокаТабдок Из Табдок Цикл
		Если НЕ ПустаяСтрока(ТекСтрокаТабдок.Контрагент) Тогда
			Движение = Движения.УчетСети.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Номенклатура = ТекСтрокаТабдок.Номенклатура;
			Движение.Сеть = ТекСтрокаТабдок.Контрагент;
			Движение.МП = ТекСтрокаТабдок.МП;
			Движение.Количество = ТекСтрокаТабдок.КолВо;
			Движение.Бонус = ТекСтрокаТабдок.Бонус;
		КонецЕсли;
	КонецЦикла;
	
	
	
	
	
Сообщить("Начало проведения документа 'Сети'. Дата документа: " + Формат(Дата, "ДФ=dd.MM.yyyy"));
	
	// Движения по регистру "Бонусы".
	Движения.Бонусы.Записывать = Истина;
	Движения.Бонусы.Очистить();
	Сообщить("Очистка движений по регистру 'Бонусы'.");
	
	// Храним уже обработанные договоры для Сеть и Контрагент, чтобы избежать дублирования.
	ОбработанныеСписания = Новый Соответствие; // Сеть -> Соответствие(Договор -> СуммаСписания).
	ОбработанныеПриходы = Новый Соответствие; // Контрагент -> Договор (самый новый).
	
	// Обрабатываем каждую строку Табдок напрямую.
	Для Каждого СтрокаТаб Из Табдок Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаб.Контрагент) Тогда
			Продолжить; // Пропуск без сообщений.
		КонецЕсли;
		
		Если СтрокаТаб.Бонус <= 0 Тогда
			Продолжить; // Пропуск без сообщений.
		КонецЕсли;
		
		Сообщить("Обработка строки Табдок №" + СтрокаТаб.НомерСтроки + 
				 ": Сеть = " + СтрокаТаб.Сеть + 
				 ", Контрагент = " + СтрокаТаб.Контрагент + 
				 ", МП = " + СтрокаТаб.МП + 
				 ", Номенклатура = " + СтрокаТаб.Номенклатура + 
				 ", Бонус = " + СтрокаТаб.Бонус);
		
		СуммаБонуса = СтрокаТаб.Бонус;
		Сеть = СтрокаТаб.Сеть; // Источник (списание).
		Контрагент = СтрокаТаб.Контрагент; // Получатель (прибавление).
		
		// Получаем все договоры источника (Сеть), отсортированные по дате составления (старые сначала).
		ДоговорыИсточника = ПолучитьДоговорыКонтрагента(Сеть);
		Сообщить("  - Получены договоры источника (" + Сеть + "). Количество: " + Строка(ДоговорыИсточника.Количество()));
		
		// Получаем остатки по регистру "Бонусы" для договоров источника (только положительные).
		ОстаткиПоДоговорам = ПолучитьОстаткиПоБонусам(ДоговорыИсточника);
		Сообщить("  - Получены остатки по договорам источника. Количество с остатками > 0: " + Строка(ОстаткиПоДоговорам.Количество()));
		
		// Если нет договоров у источника — создаём/находим "Авто договор".
		Если ДоговорыИсточника.Количество() = 0 Тогда
			Сообщить("  - Нет договоров у источника. Создание/поиск 'Авто договор'.");
			АвтоДоговорИсточника = СоздатьИлиНайтиАвтоДоговор(Сеть);
			ДоговорыИсточника.Добавить(АвтоДоговорИсточника);
			ОстаткиПоДоговорам.Вставить(АвтоДоговорИсточника, 0);
			Сообщить("    - Создан/найден Авто договор: " + АвтоДоговорИсточника);
		КонецЕсли;
		
		// Сортируем договоры источника по дате (старые сначала для списания).
		ДоговорыИсточника.Сортировать("ДатаСоставления Возр");
		Сообщить("  - Договоры источника отсортированы по дате (старые сначала).");
		
		// Инициализируем суммы списания для этой Сети, если ещё не было.
		Если ОбработанныеСписания[Сеть] = Неопределено Тогда
			ОбработанныеСписания[Сеть] = Новый Соответствие;
		КонецЕсли;
		
		// Распределяем списание по источнику.
		ОставшаясяСумма = СуммаБонуса;
		Сообщить("  - Начало распределения списания. Оставшаяся сумма: " + ОставшаясяСумма);
		
		Для Каждого СтрокаДоговора Из ДоговорыИсточника Цикл
			Договор = СтрокаДоговора.Договор;
			Остаток = ОстаткиПоДоговорам.Получить(Договор);
			Сообщить("    - Проверка договора: " + Договор + ", Остаток: " + ?(Остаток = Неопределено, "0", Строка(Остаток)));
			
			Если Остаток > 0 И ОставшаясяСумма > 0 Тогда
				Списать = Мин(Остаток, ОставшаясяСумма);
				Сообщить("      - Списание: " + Списать + " с договора " + Договор);
				ДобавитьДвижениеСписание(Движения.Бонусы, СтрокаТаб, Договор, -Списать);
				ОставшаясяСумма = ОставшаясяСумма - Списать;
				// Учитываем списание для этого договора.
				ОбработанныеСписания[Сеть][Договор] = ?(ОбработанныеСписания[Сеть][Договор] = Неопределено, 0, ОбработанныеСписания[Сеть][Договор]) + Списать;
				Сообщить("      - Оставшаяся сумма после списания: " + ОставшаясяСумма);
			Иначе
				Сообщить("      - Пропуск: Остаток <= 0 или сумма исчерпана.");
			КонецЕсли;
		КонецЦикла;
		
		// Если осталась сумма (бонус > остатков) — списываем на самый последний договор источника.
		Если ОставшаясяСумма > 0 Тогда
			ПоследнийДоговорИсточника = ДоговорыИсточника[ДоговорыИсточника.Количество() - 1].Договор;
			Сообщить("  - Остаток суммы > 0 (" + ОставшаясяСумма + "). Списание на последний договор: " + ПоследнийДоговорИсточника);
			ДобавитьДвижениеСписание(Движения.Бонусы, СтрокаТаб, ПоследнийДоговорИсточника, -ОставшаясяСумма);
			ОбработанныеСписания[Сеть][ПоследнийДоговорИсточника] = 
				?(ОбработанныеСписания[Сеть][ПоследнийДоговорИсточника] = Неопределено, 0, ОбработанныеСписания[Сеть][ПоследнийДоговорИсточника]) + ОставшаясяСумма;
		КонецЕсли;
		
		// Для получателя: находим/создаём самый новый договор.
		Если ОбработанныеПриходы[Контрагент] = Неопределено Тогда
			ДоговорыПолучателя = ПолучитьДоговорыКонтрагента(Контрагент);
			Сообщить("  - Получены договоры получателя (" + Контрагент + "). Количество: " + Строка(ДоговорыПолучателя.Количество()));
			
			Если ДоговорыПолучателя.Количество() = 0 Тогда
				Сообщить("  - Нет договоров у получателя. Создание/поиск 'Авто договор'.");
				АвтоДоговорПолучателя = СоздатьИлиНайтиАвтоДоговор(Контрагент);
				ДоговорыПолучателя.Добавить(АвтоДоговорПолучателя);
				Сообщить("    - Создан/найден Авто договор: " + АвтоДоговорПолучателя);
			КонецЕсли;
			
			ДоговорыПолучателя.Сортировать("ДатаСоставления Убыв"); // Новый сначала.
			ОбработанныеПриходы[Контрагент] = ДоговорыПолучателя[0].Договор;
			Сообщить("  - Выбран самый новый договор получателя: " + ОбработанныеПриходы[Контрагент]);
		КонецЕсли;
		
		// Добавляем всю сумму как приход к получателю на новый договор.
		Сообщить("  - Добавление прихода: " + СуммаБонуса + " на договор " + ОбработанныеПриходы[Контрагент]);
		ДобавитьДвижениеПриход(Движения.Бонусы, СтрокаТаб, ОбработанныеПриходы[Контрагент], СуммаБонуса);
		
	КонецЦикла;
	
	// Запись движений.
	Движения.Записать();
	Сообщить("Движения по регистру 'Бонусы' записаны. Завершение проведения.");
	
КонецПроцедуры


// Вспомогательные функции (с отладкой, без изменений в логике)
Функция ПолучитьДоговорыКонтрагента(Контрагент)
	
	Сообщить("Запрос договоров для контрагента: " + Контрагент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Договор,
	|	Договоры.ДатаСоставления КАК ДатаСоставления,
	|	Договоры.МП КАК МП // Куратор берётся из договора.
	|ИЗ
	|	Справочник.Договор КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент
	|	И НЕ Договоры.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Сообщить("  - Получено договоров: " + Строка(Результат.Количество()));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОстаткиПоБонусам(Договоры)
	
	Если Договоры.Количество() = 0 Тогда
		Сообщить("Нет договоров для запроса остатков. Возврат пустого соответствия.");
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Сообщить("Запрос остатков по бонусам для " + Строка(Договоры.Количество()) + " договоров.");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БонусыОстатки.ДокНомер КАК ДокНомер,
	|	БонусыОстатки.СуммаОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.Бонусы.Остатки(, ДокНомер В (&Договоры)) КАК БонусыОстатки
	|ГДЕ
	|	БонусыОстатки.СуммаОстаток > 0";
	Запрос.УстановитьПараметр("Договоры", Договоры.ВыгрузитьКолонку("Договор"));
	
	Остатки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(Выборка.ДокНомер, Выборка.Остаток);
		Сообщить("  - Остаток для " + Выборка.ДокНомер + ": " + Выборка.Остаток);
	КонецЦикла;
	
	Для Каждого СтрокаДоговора Из Договоры Цикл
		Если Остатки.Получить(СтрокаДоговора.Договор) = Неопределено Тогда
			Остатки.Вставить(СтрокаДоговора.Договор, 0);
			Сообщить("  - Остаток для " + СтрокаДоговора.Договор + ": 0 (добавлен по умолчанию)");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Остатки;
	
КонецФункции

Функция СоздатьИлиНайтиАвтоДоговор(Контрагент)
	
	Сообщить("Поиск 'Авто договор' для контрагента: " + Контрагент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Договоры.Ссылка КАК Договор
	|ИЗ
	|	Справочник.Договор КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент
	|	И Договоры.Наименование = ""Авто договор""
	|	И НЕ Договоры.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщить("  - Найден существующий 'Авто договор': " + Выборка.Договор);
		Возврат Выборка.Договор;
	КонецЕсли;
	
	Сообщить("  - 'Авто договор' не найден. Создание нового.");
	
	НовыйДоговор = Справочники.Договоры.СоздатьЭлемент();
	НовыйДоговор.Владелец = Контрагент;
	НовыйДоговор.Наименование = "Авто договор";
	НовыйДоговор.ДатаСоставления = ТекущаяДата();
	// МП (Куратор) для нового договора — взять из текущей строки Табдок или оставить пустым?
	// Если нужно, уточните, откуда брать МП для нового договора.
	НовыйДоговор.Записать();
	
	Сообщить("  - Новый 'Авто договор' создан: " + НовыйДоговор.Ссылка);
	
	Возврат НовыйДоговор.Ссылка;
	
КонецФункции

Процедура ДобавитьДвижениеСписание(НаборЗаписей, СтрокаТаб, Договор, Сумма) // Сумма уже отрицательная при вызове.
	
	Сообщить("Добавление движения списания: Договор = " + Договор + ", Сумма = " + Сумма);
	
	Движение = НаборЗаписей.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход; // Уменьшение начислений (отрицательная сумма).
	Движение.Период = Дата;
	Движение.МП = СтрокаТаб.МП;
	Движение.Куратор = Договор.МП;
	Движение.ДокНомер = Договор;
	Движение.Номенклатура = СтрокаТаб.Номенклатура;
	Движение.Месяц = Месяц(Договор.ДатаСоставления);
	Движение.Год = Год(Договор.ДатаСоставления);
	Движение.Статья = Справочники.Статьи.Бонусы;
	Движение.Сумма = Сумма; // Отрицательная для уменьшения.
	
КонецПроцедуры

Процедура ДобавитьДвижениеПриход(НаборЗаписей, СтрокаТаб, Договор, Сумма) // Сумма положительная.
	
	Сообщить("Добавление движения прихода: Договор = " + Договор + ", Сумма = " + Сумма);
	
	Движение = НаборЗаписей.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход; // Начисление (положительная сумма).
	Движение.Период = Дата;
	Движение.МП = СтрокаТаб.МП;
	Движение.Куратор = Договор.МП;
	Движение.ДокНомер = Договор;
	Движение.Номенклатура = СтрокаТаб.Номенклатура;
	Движение.Месяц = Месяц(Договор.ДатаСоставления);
	Движение.Год = Год(Договор.ДатаСоставления);
	Движение.Статья = Справочники.Статьи.Бонусы;
	Движение.Сумма = Сумма;
	
КонецПроцедуры