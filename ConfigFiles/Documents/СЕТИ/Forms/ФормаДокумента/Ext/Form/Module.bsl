&НаКлиенте
Процедура МППриИзменении(Элемент)
    ОбновитьИтогиПоМП();
КонецПроцедуры

&НаСервере
Процедура ОбновитьИтогиПоМП()
    // Расчет итогов для выбранного МП
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    СУММА(ТабДок.КолВо) КАК ИтогКолВо,
        |    СУММА(ТабДок.Бонус) КАК ИтогБонус,
        |    СУММА(ТабДок.Сумма) КАК ИтогСумма,
        |    СУММА(ТабДок.Зарплата) КАК ИтогЗарплата
        |ИЗ
        |    Документ.СЕТИ.ТабДок КАК ТабДок
        |ГДЕ
        |    ТабДок.Ссылка = &Ссылка
        |    И ТабДок.МП = &МП";
    Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
    Запрос.УстановитьПараметр("МП", МП); // Используем реквизит формы МП
    Результат = Запрос.Выполнить().Выбрать();
    Если Результат.Следующий() Тогда
        ИтогКолВо = ?(Результат.ИтогКолВо = NULL, 0, Результат.ИтогКолВо);
        ИтогБонус = ?(Результат.ИтогБонус = NULL, 0, Результат.ИтогБонус);
        ИтогСумма = ?(Результат.ИтогСумма = NULL, 0, Результат.ИтогСумма);
        ИтогЗарплата = ?(Результат.ИтогЗарплата = NULL, 0, Результат.ИтогЗарплата);
    Иначе
        ИтогКолВо = 0;
        ИтогБонус = 0;
        ИтогСумма = 0;
        ИтогЗарплата = 0;
    КонецЕсли;

    // Обновление элементов формы (если это надписи)
    Элементы.ИтогКолВо.Заголовок = "Кол-во: ";
    Элементы.ИтогБонус.Заголовок = "Бонус: ";
    Элементы.ИтогСумма.Заголовок = "Сумма: ";
    Элементы.ИтогЗарплата.Заголовок = "Зарплата: ";
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Инициализация итогов при открытии формы, если МП заполнен
    Если ЗначениеЗаполнено(МП) Тогда
        ОбновитьИтогиПоМП();
    КонецЕсли;
КонецПроцедуры
