			НоваяСтрока = Табдок.Добавить();
			НоваяСтрока.Приход = ТекСтрокаТабдок.ДБезНал;
			НоваяСтрока.Расход = ТекСтрокаТабдок.КБезНал;
			НоваяСтрока.Тип="2";
			НоваяСтрока.Контрагенты = ТекСтрокаТабдок.Контрагенты;
			НоваяСтрока.Примечание = ТекСтрокаТабдок.Назначение;
			НоваяСтрока.НомерДокС = ТекСтрокаТабдок.Договор;
			НоваяСтрока.Статья = ТекСтрокаТабдок.Статья;
		КонецЦикла;
	КонецЕсли;
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
КонецПроцедуры

