		Движение.Период = Дата;
		Движение.Номенклатуры = ТекСтрокаТабдок.Номенклатура;
		Движение.Статья = ТекСтрокаТабдок.Статья;
		Движение.Сумма = ТекСтрокаТабдок.Приход;
		Движение.СуммаВал = ТекСтрокаТабдок.Приход/Курс;
		Если ТекСтрокаТабдок.Валюта=Истина тогда 
			 Движение.Сумма=0;
			 Движение.СуммаВал = ТекСтрокаТабдок.Приход/Курс;
		 КонецЕсли;

		КонецЕсли;
	КонецЦикла;

