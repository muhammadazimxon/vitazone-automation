		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.ФинИст = ТекСтрокаТабдок.Счет.ДебиторкаБалансдаги;
		Движение.Статья = ТекСтрокаТабдок.Статья;
		Если ТекСтрокаТабдок.Валюта=Истина Тогда
			Движение.Валюта=ТекСтрокаТабдок.Приход;
			Иначе
		Движение.Сумма = ТекСтрокаТабдок.Приход;
	КонецЕсли;
	КонецЕсли;
КонецЦикла;


	
	
	
	// регистр Финансы Приход
	Движения.Финансы.Записывать = Истина;
	Для Каждого ТекСтрокаТабдок Из Табдок Цикл
		Если ТекСтрокаТабдок.тип=4 Тогда
		Движение = Движения.Финансы.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.ФинИст = ТекСтрокаТабдок.ФинИст;
		Движение.Статья = ТекСтрокаТабдок.Статья;
		Если ТекСтрокаТабдок.Валюта=Истина Тогда
			Движение.Валюта=ТекСтрокаТабдок.Приход;
			Иначе
		Движение.Сумма = ТекСтрокаТабдок.Приход;
	КонецЕсли;
	КонецЕсли;
	КонецЦикла;

	// регистр Финансы Расход
	Движения.Финансы.Записывать = Истина;
	Для Каждого ТекСтрокаТабдок Из Табдок Цикл
		Если ТекСтрокаТабдок.тип=4 Тогда
		Движение = Движения.Финансы.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.ФинИст = ТекСтрокаТабдок.ФинИст;
		Движение.Статья = ТекСтрокаТабдок.Статья;
		Если ТекСтрокаТабдок.Валюта=Истина Тогда
			Движение.Валюта=ТекСтрокаТабдок.Расход;
			Иначе
		Движение.Сумма = ТекСтрокаТабдок.Расход;
	КонецЕсли;
КонецЕсли;

	КонецЦикла;

	// регистр ВПути Приход
	Движения.ВПути.Записывать = Истина;
	Для Каждого ТекСтрокаТабдок Из Табдок Цикл
