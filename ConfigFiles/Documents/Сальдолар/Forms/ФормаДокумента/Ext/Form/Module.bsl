&НаСервере
Процедура ЗаполнитьРеквизитДоговораМП(МассивНомерДокС)
    // Обходим массив данных
    Для Каждого Строка Из МассивНомерДокС Цикл
        НомерДокС = Строка.НомерДокС;

        // Проверяем, заполнен ли контрагент
        Если ЗначениеЗаполнено(НомерДокС) Тогда
            // Получаем объект контрагента для редактирования
            НомерДокСОбъект = НомерДокС.ПолучитьОбъект();

            // Если реквизит МП пуст, заполняем его
            Если НЕ ЗначениеЗаполнено(НомерДокСОбъект.МП) Тогда
                НомерДокСОбъект.МП = Строка.МП;

                // Сохраняем изменения
                НомерДокСОбъект.Записать();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура СчетФактураМП(Команда)
		    // Создаем массив для передачи данных
    МассивНомерДокС = Новый Массив;

    // Заполняем массив данными из табличной части
    Для Каждого Строка Из Объект.Табдок Цикл
        СтрокаМассива = Новый Структура;
        СтрокаМассива.Вставить("НомерДокс", Строка.НомерДокС);
        СтрокаМассива.Вставить("МП", Строка.МП);
        МассивНомерДокС.Добавить(СтрокаМассива);
    КонецЦикла;

    // Вызов серверной процедуры
    ЗаполнитьРеквизитДоговораМП(МассивНомерДокС);

	

КонецПроцедуры

