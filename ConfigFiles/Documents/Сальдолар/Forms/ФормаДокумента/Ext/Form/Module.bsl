&НаСервере
Функция МПоламиз (Контрагентдан)
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Менеджер.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Менеджер КАК Менеджер
		|ГДЕ
		|	Менеджер.Ссылка = &Контрагентдан";
	
	Запрос.УстановитьПараметр("Контрагентдан", Контрагентдан);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
КонецФункции

&НаКлиенте
Процедура ТабдокКонтрагентыПриИзменении(Элемент)
	Эл=Элементы.Табдок.ТекущиеДанные;
	Эл.МП=МПоламиз(Эл.Контрагенты);
КонецПроцедуры

Функция ВалютаДоллар() 
	Возврат Справочники.Валюта.USD
КонецФункции

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	Если Объект.Валюта.Пустая()=Истина
		Тогда Объект.Валюта=ВалютаДоллар();
	КонецЕсли;
	Объект.Курс=КурсОламиз.КурсОламиз(Объект.Дата, Объект.Валюта);
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	Объект.Курс=КурсОламиз.КурсОламиз(Объект.Дата, Объект.Валюта);
КонецПроцедуры

