&НаСервере
Процедура ВЕБЗаполнитьТабличнуюЧастьПродажи(ДатаДокумента) Экспорт
       ЕСЛИ Объект.Дата<'20260116' Тогда
    Сообщить("=== НАЧАЛО ОТЛАДКИ ===");

    // 1. Формируем даты — уже идеально
    ДатаСтрокой = Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
    StartStr = ДатаСтрокой + " 00:00";
    EndStr   = ДатаСтрокой + " 23:59";
    Сообщить("Даты: " + StartStr + " → " + EndStr);

    // 2. JSON
    ТелоЗапроса = Новый Структура;
    ТелоЗапроса.Вставить("page", 0);
    ТелоЗапроса.Вставить("size", 1000);
    ТелоЗапроса.Вставить("type", Новый Массив);
    ТелоЗапроса.type.Добавить("REALIZATION");
    ТелоЗапроса.Вставить("startDate", StartStr);
    ТелоЗапроса.Вставить("endDate",   EndStr);

