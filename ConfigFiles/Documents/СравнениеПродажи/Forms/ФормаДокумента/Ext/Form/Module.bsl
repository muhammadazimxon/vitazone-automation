&НаСервере
Процедура ЗаполнитьРеквизитМП(МассивКонтрагентов)
    // Обходим массив данных
    Для Каждого Строка Из МассивКонтрагентов Цикл
        Контрагент = Строка.Контрагент;

        // Проверяем, заполнен ли контрагент
        Если ЗначениеЗаполнено(Контрагент) Тогда
            // Получаем объект контрагента для редактирования
            КонтрагентОбъект = Контрагент.ПолучитьОбъект();

            // Если реквизит МП пуст, заполняем его
            Если НЕ ЗначениеЗаполнено(КонтрагентОбъект.МП) Тогда
                КонтрагентОбъект.МП = Строка.МП;

                // Сохраняем изменения
                КонтрагентОбъект.Записать();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры




