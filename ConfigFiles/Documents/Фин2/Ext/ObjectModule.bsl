Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//{{__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Журнал") Тогда
		// Заполнение шапки
		Валюта = ДанныеЗаполнения.Валюта;
		Курс = ДанныеЗаполнения.Курс;
		Дата = ДанныеЗаполнения.Дата;
		Примечание = ДанныеЗаполнения.Счет;
		Для Каждого ТекСтрокаТабдок Из ДанныеЗаполнения.Табдок Цикл
			НоваяСтрока = Табдок.Добавить();
			НоваяСтрока.ИНН = ТекСтрокаТабдок.ИНН;
			НоваяСтрока.Контрагенты = ТекСтрокаТабдок.Контрагенты;
			НоваяСтрока.Договор = ТекСтрокаТабдок.НомерДокС;
			НоваяСтрока.Назначение = ТекСтрокаТабдок.Примечание;
			НоваяСтрока.ДБезНал = ТекСтрокаТабдок.Приход;
			НоваяСтрока.КБезНал = ТекСтрокаТабдок.Расход;
			
		Если ТекСтрокаТабдок.статья=Справочники.Статьи.Продажа И ТекСтрокаТабдок.ФинИст=Справочники.ФинИст.Фойдадан Тогда
			НоваяСтрока.БезНалФин = "";
		Иначе
			НоваяСтрока.БезНалФин = ТекСтрокаТабдок.ФинИст;
		КонецЕсли;
		
			НоваяСтрока.Статья = ТекСтрокаТабдок.Статья;
			НоваяСтрока.Счет = ТекСтрокаТабдок.Организация;
			НоваяСтрока.НомерДок = ТекСтрокаТабдок.НомерДок;
		КонецЦикла;
		Для Каждого ТекСтрокаТабдок2 Из ДанныеЗаполнения.Табдок2 Цикл
			НоваяСтрока = Табдок.Добавить();
			НоваяСтрока.ИНН = ТекСтрокаТабдок2.ЗИНН;
			НоваяСтрока.Контрагенты = ТекСтрокаТабдок2.Контрагенты;
			НоваяСтрока.Назначение = ТекСтрокаТабдок2.Назначение;
			НоваяСтрока.ДНал = ТекСтрокаТабдок2.Приход;
			НоваяСтрока.КНал = ТекСтрокаТабдок2.Расход;
			
		Если ТекСтрокаТабдок2.статья=Справочники.Статьи.Продажа И ТекСтрокаТабдок2.Финансирование=Справочники.ФинИст.Фойдадан Тогда
			НоваяСтрока.НалФин1  = "";
		Иначе
			НоваяСтрока.НалФин1  = ТекСтрокаТабдок2.Финансирование;
		КонецЕсли;

			
			НоваяСтрока.Статья = ТекСтрокаТабдок2.Статья;
			НоваяСтрока.Счет = ТекСтрокаТабдок2.Организация;
			НоваяСтрока.Договор = ТекСтрокаТабдок2.НомерДокС;
			НоваяСтрока.НомерДок = ТекСтрокаТабдок2.НомерДок;
		КонецЦикла;
		Для Каждого ТекСтрокаТабдок3 Из ДанныеЗаполнения.Табдок3 Цикл
			НоваяСтрока = Табдок.Добавить();
			НоваяСтрока.ВоздухК = ТекСтрокаТабдок3.Финансирование;
			НоваяСтрока.ВоздухД = ТекСтрокаТабдок3.Финансирование1;
			НоваяСтрока.Контрагенты = ТекСтрокаТабдок3.Контрагенты1;
			НоваяСтрока.Статья = ТекСтрокаТабдок3.Статья1;
			НоваяСтрока.Назначение = ТекСтрокаТабдок3.Назначение;
			НоваяСтрока.СВоздух = ТекСтрокаТабдок3.Приход+ТекСтрокаТабдок3.Расход;
			НоваяСтрока.НомерДок = ТекСтрокаТабдок3.НомерДок;
		КонецЦикла;
	КонецЕсли;
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
