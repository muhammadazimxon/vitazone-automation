Процедура ОбработкаПроведения(Отказ, Режим)
	
	
	
	// Хисоб ракам ва кассалардаги остаткалар Приход
	Движения.КассаУчети.Записывать = Истина;
	Для Каждого ТекСтрокаТабдок Из Табдок Цикл
		Движение = Движения.КассаУчети.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Кассалар = ТекСтрокаТабдок.Счет;
		Движение.Статья= ТекСтрокаТабдок.Статья;
		Движение.Сумма = ТекСтрокаТабдок.ДНал+ТекСтрокаТабдок.ДБезНал;
	КонецЦикла;

	
	 // Хисоб ракам ва кассалардаги остаткалар Расход
	Движения.КассаУчети.Записывать = Истина;
	Для Каждого ТекСтрокаТабдок Из Табдок Цикл
		Движение = Движения.КассаУчети.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Кассалар = ТекСтрокаТабдок.Счет;
		Движение.Статья= ТекСтрокаТабдок.Статья;
		Движение.Сумма = ТекСтрокаТабдок.КНал+ТекСтрокаТабдок.КБезНал;
	КонецЦикла;
	

	//Дебиторканинг хисоби буйича ошиб бориш 
	Движения.Дебиторка.Записывать = Истина;
	Для каждого ТекстрокаТабдок Из Табдок Цикл
		Если ТекСтрокаТабдок.Статья=Справочники.Статьи.Продажа  Тогда
			Движение = Движения.Дебиторка.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Контрагенты=ТекСтрокаТабдок.Контрагенты;
			Движение.ДокНомер=ТекСтрокаТабдок.Договор;
			Движение.Статья=ТекСтрокаТабдок.Статья;
			Движение.Регион=ТекСтрокаТабдок.Контрагенты.Регион;
			Если ТекСтрокаТабдок.ДебБулево=Истина Тогда
				Движение.ЗадолженностьСум=ТекСтрокаТабдок.ДБезНал+ТекСтрокаТабдок.ДНал+ТекСтрокаТабдок.СВоздух;
				Движение.ЗадолженностьВалюта=(ТекСтрокаТабдок.ДБезНал+ТекСтрокаТабдок.ДНал+ТекСтрокаТабдок.СВоздух)/Курс;
				Движение.Счет=ТекСтрокаТабдок.Счет2;
			Иначе
				Движение.ЗадолженностьСум=ТекСтрокаТабдок.ДБезНал+ТекСтрокаТабдок.ДНал;
				Движение.ЗадолженностьВалюта=(ТекСтрокаТабдок.ДБезНал+ТекСтрокаТабдок.ДНал)/Курс;
				Движение.Счет=ТекСтрокаТабдок.Счет;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
		//Дебиторканинг хисоби буйича Камайиш 
	Движения.Дебиторка.Записывать = Истина;
	Для каждого ТекстрокаТабдок Из Табдок Цикл
		Если ТекСтрокаТабдок.Статья=Справочники.Статьи.Продажа Тогда
			Движение = Движения.Дебиторка.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Контрагенты=ТекСтрокаТабдок.Контрагенты;
			Движение.ДокНомер=ТекСтрокаТабдок.Договор;
			Движение.Статья=ТекСтрокаТабдок.Статья;
			Движение.Регион=ТекСтрокаТабдок.Контрагенты.Регион;

			Если ТекСтрокаТабдок.ДебБулево=Истина Тогда
				Движение.ЗадолженностьСум=ТекСтрокаТабдок.КБезНал+ТекСтрокаТабдок.КНал+ТекСтрокаТабдок.СВоздух;
				Движение.ЗадолженностьВалюта=(ТекСтрокаТабдок.КБезНал+ТекСтрокаТабдок.КНал+ТекСтрокаТабдок.СВоздух)/Курс;
				Движение.Счет=ТекСтрокаТабдок.Счет2;
			Иначе
				Движение.ЗадолженностьСум=ТекСтрокаТабдок.КБезНал+ТекСтрокаТабдок.КНал;
				Движение.ЗадолженностьВалюта=(ТекСтрокаТабдок.КБезНал+ТекСтрокаТабдок.КНал)/Курс;
				Движение.Счет=ТекСтрокаТабдок.Счет;
			КонецЕсли;

			КонецЕсли;
		//Движение.ЗадолженностьСум=ТекСтрокаТабдок.ДБезНал+ТекСтрокаТабдок.ДНал+ТекСтрокаТабдок.СВоздух;

	КонецЦикла;

	
			
	//Финансы БЕЗ НАЛ буйича Купайиб бориш:
	
	Движения.Финансы.Записывать = Истина;
	Для каждого ТекСтрокаТабдок Из Табдок Цикл
		Движение = Движения.Финансы.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.ФинИст = ТекСтрокаТабдок.БезНалФин;
		Движение.Статья = ТекСтрокаТабдок.Статья;
		Движение.Назначение = ТекСтрокаТабдок.Назначение;
		Если ТекСтрокаТабдок.БезНалФин.КатегорияБаланса=1 Тогда
			Если ТекСтрокаТабдок.БезНалФин.Валюта.Наименование="USD" Тогда
				
				Если ТекСтрокаТабдок.БезНалКурс<> 0 Тогда
				Движение.Валюта=ТекСтрокаТабдок.КБезНал/ТекСтрокаТабдок.БезНалКурс;
			Иначе
				Движение.Валюта=ТекСтрокаТабдок.КБезНал/Курс;
				КонецЕсли;
			Иначе
				Движение.Сумма=ТекСтрокаТабдок.КБезНал;
			КонецЕсли;
		ИначеЕсли
			ТекСтрокаТабдок.БезНалФин.КатегорияБаланса=2 Тогда
			Если ТекСтрокаТабдок.БезНалФин.Валюта.Наименование="USD" Тогда
				
				
				Если ТекСтрокаТабдок.БезНалКурс <>0 Тогда
				Движение.Валюта=ТекСтрокаТабдок.ДБезНал/ТекСтрокаТабдок.БезНалКурс;
				Иначе
				Движение.Валюта=ТекСтрокаТабдок.ДБезНал/Курс;
				КонецЕСли;
			Иначе
			Движение.Сумма=ТекСтрокаТабдок.ДБезНал;
			КонецЕсли;
		Иначе
			Сообщить(" " + ТекСтрокаТабдок.БезНалФин + " Без Нал операции Категория баланса НЕ определена ", СтатусСообщения.ОченьВажное);
		КонецЕсли;
				 			
	КонецЦикла;
	
	
	
	
	
	
	
	
	    	//КУРСОВАЯ РАЗНИЦА УЧУН БЕЗ НАЛ буйича Купайиб бориш:
	
	Движения.Финансы.Записывать = Истина;
	Для каждого ТекСтрокаТабдок Из Табдок Цикл
		
		
		Если ТекСтрокаТабдок.БезНалФин.КатегорияБаланса=1 Тогда
		Если ТекСтрокаТабдок.БезНалФин.Валюта.Наименование="USD" Тогда
		Если ТекСтрокаТабдок.КурсоваяРазница = истина Тогда	
		Движение = Движения.Финансы.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.ФинИст = Справочники.ФинИст.Фойдадан;
		Движение.Назначение = ТекСтрокаТабдок.Назначение;

		Движение.Статья =Справочники.Статьи.НайтиПоНаименованию("курсовая разница");
		//Движение.Валюта=ТекСтрокаТабдок.КБезНал/ТекСтрокаТабдок.БезНалКурс;
		 Если ТекСтрокаТабдок.БезНалКурс<>0 Тогда
		Движение.Валюта=(ТекСтрокаТабдок.КБезНал/ТекСтрокаТабдок.БезНалКурс)-(ТекСтрокаТабдок.КБезНал/курс);
	Иначе
		Движение.Валюта=0;
		КонецЕсли
	КонецЕсли;
КонецЕсли;
КонецЕсли;

	    Если ТекСтрокаТабдок.БезНалФин.КатегорияБаланса=2 Тогда
