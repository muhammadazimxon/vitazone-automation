&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	
	
	
	Для Каждого Эл Из Объект.Табдок Цикл
		
		ОйКушиш=30;
		Если ПустаяСтрока(Эл.Дата)=истина Тогда
			Эл.дата=Объект.Дата;
		КонецЕсли;
		Если ПустаяСтрока(Эл.Дата1)=Истина Тогда
			Эл.Дата1=Эл.Дата+ОйКушиш;
			Сообщить(" " + Эл.Контрагенты + " " + Эл.Дата + " " + Эл.Дата1, СтатусСообщения.Важное);
		КонецЕсли;
		
	//Если ПустаяСтрока(Эл.НомерДок)=Ложь Тогда
		Эл.Договор=ДоговорОлиш(Эл.НомерДок,Эл.Контрагенты);
	//КонецЕсли;
	
	Если 
		ПустаяСтрока(Эл.Договор)=Истина И  ПустаяСтрока(Эл.Контрагенты)=Ложь Тогда
		СоздатьНомерДокС(Эл.Контрагенты, Эл.дата,Эл.дата1, ,Эл.НомерДок,,,50);
			Эл.Договор=ДоговорОлиш(Эл.НомерДок, Эл.Контрагенты);
			КонецЕсли;
			
			
	Стр=Элементы.Табдок.ТекущиеДанные;  
	 Если ТабдокБезНалФинПриИзмененииНаСервере(Стр.НалФин1)="USD" Тогда
		 Если стр.НалКурс=0 Тогда
			 Сообщить(" " + Стр.НомерСтроки + " Курс");
		 КонецЕсли;
		 КонецЕсли;
	Если ТабдокБезНалФинПриИзмененииНаСервере(Стр.БезНалФин)="USD" Тогда
		 Если стр.БезНалКурс=0 Тогда
			 Сообщить(" " + Стр.НомерСтроки + " Курс");
		 КонецЕсли;
		 КонецЕсли;
	 
		 
			
			
			
	КонецЦикла;
	
	
	Объект.ПрБезНал=Объект.Табдок.Итог("ДБезНал");
	Объект.РсБезНал=Объект.Табдок.Итог("КБезНал");
	Объект.ПрНал=Объект.Табдок.Итог("ДНал");
	Объект.РсНал=Объект.Табдок.Итог("КНал");
	Объект.Воздух=Объект.Табдок.Итог("СВоздух");

КонецПроцедуры

