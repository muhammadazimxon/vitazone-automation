		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумРасход КАК ЗадолженностьСумРасход
		|ИЗ
		|	РегистрНакопления.Дебиторка.ОстаткиИОбороты(&Дата1, &Дата, , , Контрагенты = &Контрагенты) КАК ДебиторкаОстаткиИОбороты
		|ГДЕ
		|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток <> 0
		|	И ДебиторкаОстаткиИОбороты.Контрагенты.Наименование <> ""Прочие операции""";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Дата1", '20010101');
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);

	
	РезультатЗапроса = Запрос.Выполнить();
	
ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
ОбщаяЗадолженность = 0; // Переменная для накопления суммы задолженностей

Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
    Остаток = 0;

    // Учитываем только положительные задолженности (долги)
    Если ВыборкаДетальныеЗаписи.ЗадолженностьСумКонечныйОстаток < 0 Тогда
        Остаток = ВыборкаДетальныеЗаписи.ЗадолженностьСумКонечныйОстаток*(-1);
    КонецЕсли;

    // Суммируем только задолженность
    ОбщаяЗадолженность = (ОбщаяЗадолженность + Остаток);
КонецЦикла;

Возврат ОбщаяЗадолженность;

