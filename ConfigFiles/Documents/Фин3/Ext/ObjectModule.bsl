Процедура ДобавитьВИзменения(Ссылка)
    Попытка
        НаборЗаписей = РегистрыСведений.ИзменённыеОбъекты.СоздатьНаборЗаписей();
        Запись = НаборЗаписей.Записи.Добавить();
        Запись.ТипОбъекта = Строка(ТипЗнч(Ссылка));
        Запись.Ссылка = Ссылка;
        Запись.ДатаИзменения = ТекущаяДата();
        НаборЗаписей.Записать();
    Исключение
        Сообщить("Ошибка добавления в ИзменённыеОбъекты: " + ОписаниеОшибки());
    КонецПопытки;
