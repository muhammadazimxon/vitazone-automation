&НаКлиенте
Процедура ПереносСтрокиДляНал(Источник, Приемник) 
  
  Стр=Элементы.Табдок.ТекущиеДанные;
    Если (Стр.ДНал+Стр.КНал)<>0 Тогда
      НоваяСтрока= Приемник.Добавить();
       НоваяСтрока.Назначение=Строка(" " + Стр.НомерСтроки + " катордаги НАКД " + Стр.Назначение + " " + Стр.Контрагенты);
    Если ПустаяСтрока(Стр.НалФин1)=ЛОЖь Тогда
       НоваяСтрока.НалФин1=Стр.НалФин1;
   КонецЕсли;
   НоваяСтрока.Контрагенты = Стр.Контрагенты; 
       НоваяСтрока.Счет=Стр.Счет;
       НоваяСтрока.Статья=Стр.Статья;
       НоваяСтрока.Договор = Стр.Договор;
       НоваяСтрока.ДНал = Стр.Днал;
       НоваяСтрока.Кнал=Стр.Кнал;
         //Источник.Удалить(Стр);
     КонецЕсли;

КонецПроцедуры

