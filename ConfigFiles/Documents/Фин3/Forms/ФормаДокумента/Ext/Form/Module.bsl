    НовыеКонтрагентыСумма = 0;

    Для Каждого Рек из Объект.Табдок Цикл
        // Проверка на нового контрагента (ранее не было оборотов и не содержится в ПТабдок2)
        Если СписокКонтрагентовПТабдок2.Найти(Рек.Контрагенты) = Неопределено Тогда
            Запрос = Новый Запрос;
            Запрос.Текст = 
                "ВЫБРАТЬ РАЗЛИЧНЫЕ
