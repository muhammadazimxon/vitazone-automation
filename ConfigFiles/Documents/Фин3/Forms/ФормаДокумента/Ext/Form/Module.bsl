&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	
	
	
	Для Каждого Эл Из Объект.Табдок Цикл
		
	Если ПустаяСтрока(Эл.Договор)=Истина Тогда
		Эл.Договор=ДоговорОлиш(Эл.НомерДок,Эл.Контрагенты);
	КонецЕсли;
	
	Если 
		ПустаяСтрока(Эл.Договор)=Истина И  ПустаяСтрока(Эл.Контрагенты)=Ложь Тогда
		СоздатьНомерДокС(Эл.Контрагенты, Объект.дата, Объект.дата,,Эл.НомерДок,,);
			Эл.Договор=ДоговорОлиш(Эл.НомерДок, Эл.Контрагенты);
		КонецЕсли;
		
		Если Эл.РазницаКорр = Ложь Тогда
		Если Эл.БезНалКурс+Эл.НалКурс+Эл.ВоздухКурс<>0 И (ВалютаОламиз(ФинИсточникБелгилаймиз(Эл.БезНалФин, Эл.НалФин1, Эл.ВоздухД))="USD" Или ПустаяСтрока(ФинИсточникБелгилаймиз(Эл.БезНалФин, Эл.НалФин1, Эл.ВоздухД))) И СчетВалютасиниОламиз(Эл.Счет)<>"USD"  Тогда
			Если 	Эл.ДБезНал+Эл.ДНал+Эл.СВоздух<>0 Тогда
				
				Эл.Разница=((Эл.ДБезНал+Эл.ДНал+Эл.СВоздух)/(Эл.БезНалКурс+Эл.НалКурс+Эл.ВоздухКурс)-(Эл.ДБезНал+Эл.ДНал+Эл.СВоздух)/(Объект.Курс));
			Иначе
				Эл.Разница=((Эл.КБезНал+Эл.КНал+Эл.СВоздух)/(Объект.Курс)-(Эл.КБезНал+Эл.КНал+Эл.СВоздух)/(Эл.БезНалКурс+Эл.НалКурс+Эл.ВоздухКурс));
			КонецЕсли
		ИначеЕсли Эл.БезНалКурс+Эл.НалКурс+Эл.ВоздухКурс<>0 И (ВалютаОламиз(ФинИсточникБелгилаймиз(Эл.БезНалФин, Эл.НалФин1, Эл.ВоздухД))="USD" Или ПустаяСтрока(ФинИсточникБелгилаймиз(Эл.БезНалФин, Эл.НалФин1, Эл.ВоздухД))) И Объект.дата>'20250104' Тогда

					
		КонецЕсли;
		КонецЕсли;
				 Если Объект.Назначение=Истина Тогда
			 Если ПустаяСтрока(Эл.Контрагенты) = Ложь Тогда
				 Эл.Назначение=Строка(Эл.Контрагенты);
			 КонецЕсли;
		 КонецЕсли;
		 Эл.Дата=Объект.Дата;
		 КонецЦикла;
		 
		    Для Каждого Эл Из Объект.ПТабдок4 Цикл

		 	Если Объект.Назначение=Истина Тогда
			 Если ПустаяСтрока(Эл.Контрагенты) = Ложь Тогда
				 Эл.Назначение=Строка(Эл.Контрагенты);
			 КонецЕсли;
		 КонецЕсли;
		 КонецЦикла;

		 
		 
	
	 Для Каждого Эл Из Объект.Табдок2 Цикл
		
		 Если ПустаяСтрока(Эл.Год)=0 тогда 
			 Эл.Год=Год(Объект.Дата);
		 КонецЕсли;
		КонецЦикла; 
	
	
	Объект.ПрБезНал=Объект.Табдок.Итог("ДБезНал");
	Объект.РсБезНал=Объект.Табдок.Итог("КБезНал");
	Объект.ПрНал=Объект.Табдок.Итог("ДНал");
	Объект.РсНал=Объект.Табдок.Итог("КНал");
	Объект.Воздух=Объект.Табдок.Итог("СВоздух");
	
	Если Объект.Примечание=Строка(Объект.ТипОперации+" ЗАЧЕТ АВАНСОВ")=истина тогда
		
		Зачет=СтатьяНаим("Зачет");
		Для Каждого Эл Из Объект.Табдок Цикл
			Эл.Статья=Зачет;
			//Эл.Счет2=Эл.Счет;
			Эл.Счет="";
			//Эл.ДебБулево=Истина;
			//Эл.СВоздух=Эл.Дбезнал;
			//Эл.Дбезнал=0;
		КонецЦикла;
	КонецЕсли;	
ЗаполнитьСверку();
//ЗаполнитьРегистрСверка()
КонецПроцедуры

