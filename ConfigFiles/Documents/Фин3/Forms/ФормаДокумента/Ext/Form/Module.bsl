&НаСервере
Функция СоздатьКонтр (Наименование, ИНН)
	
	КонтрЯрат = Справочники.Контрагенты.СоздатьЭлемент();
	КонтрЯрат.Наименование = Наименование;
	КонтрЯрат.ИНН = ИНН;
	Сообщить(" " + Наименование + " " + Инн, СтатусСообщения.Важное);
	КонтрЯрат.Записать();
	
	
