                НоваяСтрока.СуммаПогашения = СуммаПогашения;
                НоваяСтрока.УсловиеПредоплаты = ВыборкаДетальныеЗаписи.УсловиеПредоплаты;

                Поступление = Поступление - СуммаПогашения;
            КонецЕсли;
        КонецЦикла;

        // Второй этап: распределяем остаток по просроченным документам
ВыборкаДетальныеЗаписи.Сбросить();

// Собираем просроченные документы в массив для сортировки
ПросроченныеДокументы = Новый Массив;
Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
    Если ВыборкаДетальныеЗаписи.ДокНомерСрокДействия <> Неопределено 
        И ТипЗнч(ВыборкаДетальныеЗаписи.ДокНомерСрокДействия) = Тип("Дата") 
        И ТипЗнч(Объект.Дата) = Тип("Дата") 
        И Объект.Дата <= ВыборкаДетальныеЗаписи.ДокНомерСрокДействия Тогда
        Продолжить; // Пропускаем непросроченные документы
    КонецЕсли;
    
    СтруктураДокумента = Новый Структура;
    СтруктураДокумента.Вставить("Контрагенты", ВыборкаДетальныеЗаписи.Контрагенты);
    СтруктураДокумента.Insert("ДокНомер", ВыборкаДетальныеЗаписи.ДокНомер);
    СтруктураДокумента.Insert("СуммаЗадолженности", -ВыборкаДетальныеЗаписи.ЗадолженностьСумОстаток);
    СтруктураДокумента.Insert("УсловиеПредоплаты", ВыборкаДетальныеЗаписи.УсловиеПредоплаты);
    СтруктураДокумента.Insert("СрокДействия", ВыборкаДетальныеЗаписи.ДокНомерСрокДействия);
    СтруктураДокумента.Insert("ДатаСоставления", ВыборкаДетальныеЗаписи.ДатаСоставления); // Запасной критерий
    ПросроченныеДокументы.Add(СтруктураДокумента);
КонецЦикла;

// Преобразуем массив в таблицу значений для сортировки
ТаблицаПросроченных = Новый ТаблицаЗначений;
ТаблицаПросроченных.Колонки.Add("Контрагенты");
//Сообщить(ТаблицаПросроченных.Колонки.Add("Контрагенты"));
ТаблицаПросроченных.Колонки.Add("ДокНомер");
ТаблицаПросроченных.Колонки.Add("СуммаЗадолженности", Новый ОписаниеТипов("Число"));
ТаблицаПросроченных.Колонки.Add("УсловиеПредоплаты");
ТаблицаПросроченных.Колонки.Add("СрокДействия", Новый ОписаниеТипов("Дата"));
ТаблицаПросроченных.Колонки.Add("ДатаСоставления", Новый ОписаниеТипов("Дата"));

Для Каждого Документ Из ПросроченныеДокументы Цикл
    НоваяСтрока = ТаблицаПросроченных.Add();
    НоваяСтрока.Контрагенты = Документ.Контрагенты;
    НоваяСтрока.ДокНомер = Документ.ДокНомер;
    НоваяСтрока.СуммаЗадолженности = Документ.СуммаЗадолженности;
    НоваяСтрока.УсловиеПредоплаты = Документ.УсловиеПредоплаты;
    НоваяСтрока.СрокДействия = Документ.СрокДействия;
    НоваяСтрока.ДатаСоставления = Документ.ДатаСоставления;
КонецЦикла;

// Сортируем таблицу по возрастанию срока действия, с запасным критерием даты составления
ТаблицаПросроченных.Сортировать("СрокДействия ВОЗР, ДатаСоставления ВОЗР");

// Обрабатываем просроченные документы в нужном порядке
Для Каждого Документ Из ТаблицаПросроченных Цикл
    Если Поступление <= 0 Тогда
        Прервать;
    КонецЕсли;

    Остаток = Документ.СуммаЗадолженности;
    СуммаПогашения = Мин(Поступление, Остаток);
    
    Если СуммаПогашения > 0 Тогда
        НоваяСтрока = Объект.ПТабдок2.Add();
        НоваяСтрока.Контрагенты = Документ.Контрагенты;
        НоваяСтрока.ДокНомер = Документ.ДокНомер;
        НоваяСтрока.СуммаЗадолженности = Остаток;              
        НоваяСтрока.счет = Рек.Счет;
        НоваяСтрока.Статья = Рек.Статья;
        НоваяСтрока.СуммаПогашения = СуммаПогашения;
        НоваяСтрока.УсловиеПредоплаты = Документ.УсловиеПредоплаты;

        Поступление = Поступление - СуммаПогашения;
    КонецЕсли;
КонецЦикла;

        // Сообщение о нераспределенной сумме, если таковая осталась
        Если Поступление > 0 Тогда
            НоваяСтрока = Объект.ПТабдок.Add();
            НоваяСтрока.Контрагенты = Контрагенты;
            НоваяСтрока.ДокНомер = ДоговорОлиш("Переплата", Контрагенты);
            Если ПустаяСтрока(НоваяСтрока.ДокНомер) Тогда
                НоваяСтрока.ДокНомер = СоздатьНомерДокС(Контрагенты, , Объект.Дата, , "Переплата", ,);
            КонецЕсли;
            НоваяСтрока.ДокНомер = ДоговорОлиш("Переплата", Контрагенты);

            НоваяСтрока.счет = Рек.Счет;
            НоваяСтрока.Статья = Рек.Статья;
            НоваяСтрока.Переплата = Поступление;

            Сообщить("Осталась нераспределенная сумма: " + Поступление + " для контрагента: " + Контрагенты);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры





