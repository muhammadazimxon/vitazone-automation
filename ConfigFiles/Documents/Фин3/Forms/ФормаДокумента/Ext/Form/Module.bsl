Функция РасчетБаланса(Дата1, Дата2, Курс, КатегорияБаланса)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   ФинансыОстаткиИОбороты.ФинИст КАК ФинИст,
        |   ФинансыОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
        |   ФинансыОстаткиИОбороты.ВалютаКонечныйОстаток КАК ВалютаКонечныйОстаток,
        |   ФинансыОстаткиИОбороты.ВалютаКонечныйОстаток * &Курс + ФинансыОстаткиИОбороты.СуммаКонечныйОстаток КАК Итог
        |ИЗ
        |   РегистрНакопления.Финансы.ОстаткиИОбороты(&Дата1, &Дата2, , , ) КАК ФинансыОстаткиИОбороты
        |ГДЕ
        |   ФинансыОстаткиИОбороты.ФинИст.КатегорияБаланса = &КатегорияБаланса";
    
    Запрос.УстановитьПараметр("Дата1", Дата1);
    Запрос.УстановитьПараметр("Дата2", Дата2);
    Запрос.УстановитьПараметр("Курс", Курс);
    Запрос.УстановитьПараметр("КатегорияБаланса", КатегорияБаланса);
    
    РезультатЗапроса = Запрос.Выполнить();
    ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

    Итог = 0;
    Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
        Итог = Итог + ВыборкаДетальныеЗаписи.Итог;
    КонецЦикла;
    
    Возврат Итог;
КонецФункции



Функция РасчетБалансаДебит(Дата1, Дата2, КатегорияБаланса, ФинИст)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ФинансыОстаткиИОбороты.ФинИст КАК ФинИст,
