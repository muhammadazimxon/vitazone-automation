&НаСервере
Процедура ЗаполнитьСверку()

    // Создаем временную таблицу для суммирования СуммаПогашения
    ВременнаяТаблица = Новый ТаблицаЗначений;
    ВременнаяТаблица.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка"));
    ВременнаяТаблица.Колонки.Добавить("Контрагенты", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
    ВременнаяТаблица.Колонки.Добавить("СуммаПогашения", Новый ОписаниеТипов("Число"));

    // Группируем и суммируем данные из Птабдок2
    Для Каждого СтрокаПтабдок2 Из Объект.Птабдок2 Цикл
        НайденнаяСтрока = ВременнаяТаблица.Найти(СтрокаПтабдок2.Контрагенты, "Контрагенты");
        Если НайденнаяСтрока = Неопределено Тогда
            НоваяСтрока = ВременнаяТаблица.Добавить();
            НоваяСтрока.ИНН = СтрокаПтабдок2.ИНН;
            НоваяСтрока.Контрагенты = СтрокаПтабдок2.Контрагенты;
            НоваяСтрока.СуммаПогашения = СтрокаПтабдок2.СуммаПогашения;
        Иначе
            НайденнаяСтрока.СуммаПогашения = НайденнаяСтрока.СуммаПогашения + СтрокаПтабдок2.СуммаПогашения;
        КонецЕсли;
    КонецЦикла;

    // Очищаем табличную часть Сверка
    Объект.Сверка.Очистить();

    // Заполняем табличную часть Сверка из временной таблицы и Птабдок3
    Для Каждого СтрокаПтабдок3 Из Объект.Птабдок3 Цикл
        НайденнаяСтрокаВремТаблица = ВременнаяТаблица.Найти(СтрокаПтабдок3.Контрагенты, "Контрагенты");
        Если НайденнаяСтрокаВремТаблица <> Неопределено Тогда
            НоваяСтрокаСверка = Объект.Сверка.Добавить();
            НоваяСтрокаСверка.ИНН = СтрокаПтабдок3.ИНН;
            НоваяСтрокаСверка.Контрагенты = СтрокаПтабдок3.Контрагенты;
            НоваяСтрокаСверка.СуммаПогашения = НайденнаяСтрокаВремТаблица.СуммаПогашения;
            НоваяСтрокаСверка.СуммаПрихода = СтрокаПтабдок3.Приход;
			НоваяСтрокаСверка.Переплата = СтрокаПтабдок3.Переплата;
        КонецЕсли;
    КонецЦикла;

	
	
	Для Каждого Стр Из Объект.Сверка Цикл
		Стр.Счет=Стр.СуммаПрихода+Стр.Переплата-Стр.СуммаПогашения;
	КонецЦикла;
	
КонецПроцедуры





