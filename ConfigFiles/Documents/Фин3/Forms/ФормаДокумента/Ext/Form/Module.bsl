Процедура ЗаполнитьРегистрСверка()

    // Запрос к регистру накопления "Финансы"
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   ФинансыОстаткиИОбороты.СуммаКонечныйОстаток КАК Сумма,
        |   ФинансыОстаткиИОбороты.Назначение КАК Назначение
        |ИЗ
        |   РегистрНакопления.Финансы.ОстаткиИОбороты(&Дата, &Дата, Регистратор, , ФинИст = &ФинИст
        |   И Статья = &Статья)КАК ФинансыОстаткиИОбороты";
   //     |   И ВидДвижения = &ВидДвижения) КАК ФинансыОстаткиИОбороты";

    Запрос.УстановитьПараметр("Дата", Объект.Дата);
    Запрос.УстановитьПараметр("ФинИст", Объект.Откуда.БалансдагиИфодаси);
    Запрос.УстановитьПараметр("Статья", Справочники.Статьи.Продажа);
  //  Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);

    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();

    // Заполнение реквизита "Регистр" в табличной части "Сверка"
    Пока Выборка.Следующий() Цикл
        Для Каждого СтрокаСверка Из Объект.Сверка Цикл
            // Извлекаем наименование контрагента из строки "Назначение"
            НаименованиеКонтрагента = Лев(Выборка.Назначение, Найти(Выборка.Назначение, " @ ") - 1);

            // Ищем контрагента по наименованию
            Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеКонтрагента);

            Если Контрагент <> Справочники.Контрагенты.ПустаяСсылка() Тогда
                Если СтрокаСверка.Контрагенты = Контрагент Тогда
                    СтрокаСверка.Переплата = Выборка.Сумма;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

КонецПроцедуры

 
 
