&НаКлиенте
Процедура Заполнять(Команда)
	
	
	Для Каждого Элемент Из Объект.Табдок Цикл
		
			
		//Если ПустаяСтрока(Элемент.ИНН)=истина тогда
		//	Элемент.Контрагенты=БезИнн();
		//КонецЕсли;

			Если ПустаяСтрока(Элемент.Контрагенты)=Истина И Элемент.ИНН<>0 Тогда
				Элемент.Контрагенты=КонтрОламиз(Элемент.ИНН);
				//Элемент.ИНН=ИННОламиз(Элемент.Контрагенты);
			КонецЕсли;
			
			
			
			//Если ПустаяСтрока(Элемент.Контрагенты) Тогда
			//		Элемент.Контрагенты=Контр2Наим(Элемент.Назначение);
			//		Элемент.ИНН=ИННОламиз(Элемент.Контрагенты);
			
			
			Если Элемент.ИНН=0 Тогда
				Элемент.Контрагенты="";
				
			КонецЕсли;
			Если КонтрОламиз(Элемент.ИНН)=Неопределено Тогда
					СоздатьКонтр(Элемент.Назначение,Элемент.ИНН);
					Сообщить("Контрагент " + Элемент.Контрагенты + "создан" + эЛЕМЕНТ.Назначение,СтатусСообщения.ОченьВажное);
					Если Элемент.ИНН<>0 Тогда
					Элемент.Контрагенты=КонтрОламиз(Элемент.ИНН);
					КонецЕсли;
				КонецЕсли;
				
				
				Если (Элемент.ДБезНал)<>0 Тогда
				Элемент.Статья=СтатьяНаим("Продажа");
				КонецЕсли;
				
								
	Если  СтрНайти(Элемент.Назначение, "bank")>0 Тогда
				 Вариант1="Банк расходлари";
				 Элемент.Статья=СтатьяНоми(Вариант1);
			 ИначеЕсли
				 
				СтрНайти(Элемент.Назначение, "налог")>0 Тогда
				 Вариант1="Налог";
				 Элемент.Статья=СтатьяНоми(Вариант1);
				 
				  ИначеЕсли
				 
				СтрНайти(Элемент.Назначение, "банк")>0  Тогда
				 Вариант1="Банк расходлари";
				 Элемент.Статья=СтатьяНоми(Вариант1);
				 
			ИначеЕсли
				 
				СтрНайти(Элемент.Назначение, "Банк")>0  Тогда
				 Вариант1="Банк расходлари";
				 Элемент.Статья=СтатьяНоми(Вариант1);
			ИначеЕсли
				 
				СтрНайти(Элемент.Назначение, "аванс")>0  Тогда
				 Вариант1="Зарплата";
				 Элемент.Статья=СтатьяНоми(Вариант1);


			 ИначеЕсли
				 
				СтрНайти(Элемент.Назначение, " по ")>0	 Тогда
				 Вариант1="Под отчет";
				 Элемент.Статья=СтатьяНоми(Вариант1);
				
				 
			 ИначеЕсли
				СтрНайти(Элемент.Назначение, "доставка")>0	 Тогда
				 Вариант1="Доставка";
				 Элемент.Статья=СтатьяНоми(Вариант1);
					 ИначеЕсли
						СтрНайти(Элемент.Назначение, "даставка")>0	 Тогда
				 Вариант1="Доставка";
				 Элемент.Статья=СтатьяНоми(Вариант1);
				
				 
		
	 
			 ИначеЕсли

				 СтрНайти(Элемент.Назначение, "ойлик")>0 Тогда
				 Вариант1="Зарплата";
				 Элемент.Статья=СтатьяНоми(Вариант1);
				 
			 ИначеЕсли
				 
				  СтрНайти(Элемент.Назначение, "бонус")>0  Тогда
				 Вариант1="бонусы";
				 Элемент.Статья=СтатьяНоми(Вариант1);

			 ИначеЕсли
				 
				  СтрНайти(Элемент.Назначение, "бунус")>0  Тогда
				 Вариант1="бонусы";
				 Элемент.Статья=СтатьяНоми(Вариант1);
				
				 
				 ИначеЕсли


				 	
				ПустаяСтрока(Элемент.Статья)=Истина ТОгда
				Если (Элемент.ДБезНал+Элемент.ДНал)<>0 И Элемент.ИНН<>0 Тогда
				Элемент.Статья=СтатьяНаим("Продажа");
				КонецЕсли;
			КонецЕсли;
									
		//Элемент.Дата=Объект.Дата;
		Если (Элемент.ДБезНал+Элемент.Днал)>0 И Элемент.ИНН<>0 Тогда
			Элемент.Назначение="Оплата";

		КонецЕсли;
		  
		
				Если ПустаяСтрока(Элемент.Контрагенты)=Истина И Элемент.ИНН<>0 Тогда
				Элемент.Контрагенты=КонтрОламиз(Элемент.ИНН);
				Элемент.ИНН=ИННОламиз(Элемент.Контрагенты);
				
КонецЕсли;

//Если Элемент.ТипОплат=2  Тогда

//Элемент.Днал= Элемент.ДБезНал+ Элемент.СВоздух;
//Элемент.Кнал=Элемент.КБезНал+Элемент.Своздух;
//Элемент.ДБезНал=0;
//Элемент.Своздух=0;
//Элемент.КБезНал=0;
//Элемент.Счет=ОрганизацияНоми("Касса");

//ИначеЕсли
//Элемент.ТипОплат<>1 И Элемент.ТипОплат<>2 Тогда
//Элемент.СВоздух= (Элемент.ДБезНал+Элемент.ДНал+Элемент.КБезНал+Элемент.КНал);
//Элемент.ДБезНал=0;
//Элемент.ДНал=0;
//Элемент.КБезНал=0;
//Элемент.КНал=0;

//КонецЕсли;
				
Если Элемент.ТипОплат=1 и ПустаяСтрока(Элемент.Счет) Тогда
	Элемент.Счет=Объект.Откуда;
	КонецЕсли;
				
		 
 КонеЦЦикла;
	
	
