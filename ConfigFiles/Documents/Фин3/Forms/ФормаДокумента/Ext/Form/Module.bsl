&НаСервере
Процедура СформироватьНаСервере()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Сообщить("Укажите период для выборки документов!");
        Возврат;
    КонецЕсли;
    
    ТаблицаДокументов = ПолучитьСписокДокументов(НачалоДня(Объект.Дата), КонецДня(Объект.Дата));
    
    Если ТаблицаДокументов = Неопределено Тогда
        Сообщить("Не удалось получить список документов!");
        Возврат;
    КонецЕсли;
    
    // Очищаем табличную часть
    Объект.Табдок.Очистить();
    
    // Заполняем табличную часть и сразу подтягиваем контрагентов
    Для Каждого Строка Из ТаблицаДокументов Цикл
        НоваяСтрока = Объект.Табдок.Добавить();
		НоваяСтрока.Дата = Строка.Дата;
		НоваяСтрока.Назначение = Строка.Контрагент;
		НоваяСтрока.ИНН = Строка.ИННКонтрагента;
		НоваяСтрока.ДБезНал=Строка.СуммаДокумента;
       // ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
        
      КонецЦикла;
    
    // Сортируем табличную часть по дате
    Объект.Табдок.Сортировать("Дата");
    
    Если Объект.Табдок.Количество() = 0 Тогда
        Сообщить("За указанный период проведенных документов не найдено!");
    КонецЕсли;
КонецПроцедуры

// Функция получения списка проведенных документов через COM-соединение
&НаСервере
Функция ПолучитьСписокДокументов(ДатаНачала, ДатаОкончания, ИННКонтрагента = "") Экспорт
    Попытка
        V83COMConnector = Новый COMОбъект("V83.COMConnector");
        Соединение = V83COMConnector.Connect("Srvr=""192.168.1.214"";Ref=""buh2"";Usr=""Администратор"";Pwd=""4545""");
    Исключение
        Сообщить("Ошибка подключения: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    
    ТаблицаДокументов = Новый ТаблицаЗначений;
    ТаблицаДокументов.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
    ТаблицаДокументов.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
    ТаблицаДокументов.Колонки.Добавить("ВидОперации", Новый ОписаниеТипов("Строка"));
    ТаблицаДокументов.Колонки.Добавить("Валюта", Новый ОписаниеТипов("Строка"));
    ТаблицаДокументов.Колонки.Добавить("Организация", Новый ОписаниеТипов("Строка"));
    ТаблицаДокументов.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("Строка"));
    ТаблицаДокументов.Колонки.Добавить("СуммаДокумента", Новый ОписаниеТипов("Число"));
    ТаблицаДокументов.Колонки.Добавить("ИННКонтрагента", Новый ОписаниеТипов("Строка"));
    
    Запрос = Соединение.NewObject("Запрос");
    ТекстЗапроса = 
    "ВЫБРАТЬ
    |   Док.Дата КАК Дата,
    |   Док.Номер КАК Номер,
    |   Док.ВидОперации КАК ВидОперации,
    |   Док.ВалютаДокумента.Наименование КАК Валюта,
    |   Док.Организация.Наименование КАК Организация,
    |   Док.Контрагент.Наименование КАК Контрагент,
    |   Док.Контрагент.ИНН КАК ИННКонтрагента,
    |   Док.СуммаДокумента КАК СуммаДокумента,
    |   Док.ДоговорКонтрагента.Наименование КАК Договор,
    |   Док.НазначениеПлатежа КАК НазначениеПлатежа,
    |   Док.Ответственный.Наименование КАК Ответственный
    |ИЗ
    |   Документ.ПлатежноеПоручениеВходящее КАК Док
    |ГДЕ
    |   Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
    |   И Док.Проведен = ИСТИНА";
    
    
    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        НоваяСтрока = ТаблицаДокументов.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
        НоваяСтрока.ВидОперации = Строка(Выборка.ВидОперации);
    КонецЦикла;
    
    V83COMConnector = Неопределено;
    Соединение = Неопределено;
    
    Возврат ТаблицаДокументов;
КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеБиллзНаСервере()
	
	Токен = Константы.ТокенБиллз.Получить();
	Если ПустаяСтрока(Токен) Тогда
		Сообщить("ОШИБКА: Токен пустой. Сначала обновите токен.");
		Возврат;
	КонецЕсли;

	СтрокаДаты = Формат(Объект.Дата, "ДФ=yyyy-MM-dd"); 
	
	Сервер = "api-admin.billz.ai";
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	HTTPСоединение = Новый HTTPСоединение(Сервер, 443, , , , 15, ЗащищенноеСоединение);
	
	// --- Подготовка справочников и статей ---
	СтатьяФилиалПродажа = Справочники.Статьи.НайтиПоНаименованию("Филиал продажа");
	СтатьяПеремещение   = Справочники.Статьи.НайтиПоНаименованию("Перемишение"); 
	СтатьяСавдоПули     = Справочники.Статьи.НайтиПоНаименованию("Савдо пули");
	
	ПапкаКарта          = Справочники.ФинИст.НайтиПоНаименованию("Карта");
	ФинИстКоллЦентр     = Справочники.ФинИст.НайтиПоНаименованию("Карта Call центр оператор");
	
	// Запрос для поиска ФинИст по БиллзНоми и КатегорииБаланса
	ЗапросФинИст = Новый Запрос;
	// Отдельный поиск складского финансового источника BILLZ
	ЗапросФинИстСклад = Новый Запрос;

	ЗапросФинИстСклад.Текст =
	    "ВЫБРАТЬ ПЕРВЫЕ 1
	    |   ФинИст.Ссылка КАК Ссылка
	    |ИЗ
	    |   Справочник.ФинИст КАК ФинИст
	    |ГДЕ
	    |   ФинИст.БиллзНоми = &БиллзНоми
	    |   И ФинИст.КатегорияБаланса = 1
	    |   И ФинИст.Наименование ПОДОБНО &ШаблонСклада
	    |   И НЕ ФинИст.ПометкаУдаления";
	
	ЗапросФинИст.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ФинИст 
		|ГДЕ БиллзНоми = &БиллзНоми И КатегорияБаланса = &КатегорияБаланса И НЕ ПометкаУдаления";

	// Запрос для поиска Организации по БиллзНоми (для Налички)
	ЗапросОрг = Новый Запрос;
	ЗапросОрг.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Организация 
		|ГДЕ БиллзНоми = &БиллзНоми И НЕ ПометкаУдаления";

	// Запрос для поиска ФинИст по БиллзНоми внутри папки "Карта" (для Терминала)
	ЗапросФинИстКарта = Новый Запрос;
	ЗапросФинИстКарта.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ФинИст 
		|ГДЕ БиллзНоми = &БиллзНоми И Родитель = &Родитель И НЕ ПометкаУдаления";
	ЗапросФинИстКарта.УстановитьПараметр("Родитель", ПапкаКарта);

	СчетчикДобавленных = 0;
	МассивИДМагазинов = Новый Массив;

	// =========================================================================================
	// ЧАСТЬ 1: ЗАГРУЗКА ПРОДАЖ И КАПИТАЛА (Сводный отчет)
	// =========================================================================================
	АдресПродаж = "/v1/general-report-table?start_date=" + СтрокаДаты + "&end_date=" + СтрокаДаты + "&limit=100&page=1&currency=UZS&detalization=day";
	ЗапросПродажи = Новый HTTPЗапрос(АдресПродаж);
	ЗапросПродажи.Заголовки.Вставить("Content-Type", "application/json");
	ЗапросПродажи.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	Попытка
		ОтветПродажи = HTTPСоединение.Получить(ЗапросПродажи);
		Если ОтветПродажи.КодСостояния = 200 Тогда
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветПродажи.ПолучитьТелоКакСтроку());
			ДанныеПродаж = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Если ТипЗнч(ДанныеПродаж) = Тип("Структура") И ДанныеПродаж.Свойство("shop_stats_by_date") Тогда
				Для Каждого СтрокаОтчета Из ДанныеПродаж.shop_stats_by_date Цикл
					
					// Собираем ID магазинов для следующих запросов
					ТекИДМагазина = ?(СтрокаОтчета.Свойство("shop_id"), СтрокаОтчета.shop_id, "");
					Если ЗначениеЗаполнено(ТекИДМагазина) И МассивИДМагазинов.Найти(ТекИДМагазина) = Неопределено Тогда
						МассивИДМагазинов.Добавить(ТекИДМагазина);
					КонецЕсли;
					
					ИмяМагазина = ?(СтрокаОтчета.Свойство("shop_name"), СтрокаОтчета.shop_name, "НЕТ_ИМЕНИ");
					Себестоимость = ?(СтрокаОтчета.Свойство("sales_supply_price"), СтрокаОтчета.sales_supply_price, 0);
					ВаловаяПрибыль = ?(СтрокаОтчета.Свойство("gross_profit"), СтрокаОтчета.gross_profit, 0);
					
					//Если Себестоимость <> 0 И ИмяМагазина <> "НЕТ_ИМЕНИ" Тогда
					//	ЗапросФинИст.УстановитьПараметр("БиллзНоми", ИмяМагазина);
					//	ЗапросФинИст.УстановитьПараметр("КатегорияБаланса", 1);
					//	Выб = ЗапросФинИст.Выполнить().Выбрать();
					//	Если Выб.Следующий() Тогда
					//		НовСтр = Объект.Табдок.Добавить();  
					//		// old version added by azimxon
					//		//НовСтр.СВоздух = Себестоимость;
					//		//НовСтр.ВоздухК = Выб.Ссылка;
					//		//НовСтр.Назначение = "Продажа " + ИмяМагазина;
					//		//НовСтр.Статья = СтатьяФилиалПродажа;
					//		//СчетчикДобавленных = СчетчикДобавленных + 1;
					//		//new version:
					//		НовСтр.СВоздух = Себестоимость;
					//		НовСтр.ВоздухК2 = Выб.Ссылка;
					//		НовСтр.Назначение = "Продажа " + ИмяМагазина;
					//		НовСтр.Статья = СтатьяФилиалПродажа;
					//	КонецЕсли;
					//КонецЕсли;
					Если Себестоимость <> 0
					    И ИмяМагазина <> "НЕТ_ИМЕНИ" Тогда

					    ЗапросФинИстСклад.УстановитьПараметр(
					        "БиллзНоми", ИмяМагазина);

					    ЗапросФинИстСклад.УстановитьПараметр(
					        "ШаблонСклада", "Склад%");

					    ВыборкаСклада =
					        ЗапросФинИстСклад.Выполнить().Выбрать();

					    Если ВыборкаСклада.Следующий() Тогда

					        НовСтр = Объект.Табдок.Добавить();

					        НовСтр.СВоздух = Себестоимость;

					        // Себестоимость записываем в основное поле ВоздухК
					        НовСтр.ВоздухК = ВыборкаСклада.Ссылка;

					        НовСтр.Назначение = "Продажа " + ИмяМагазина;
					        НовСтр.Статья = СтатьяФилиалПродажа;

					        СчетчикДобавленных = СчетчикДобавленных + 1;

					    Иначе

					        Сообщить(
					            "Не найден склад BILLZ для магазина: "
					            + ИмяМагазина
					            + ". Проверьте БиллзНоми и наименование склада в ФинИст.");

					    КонецЕсли;

					КонецЕсли;
					
					Если ВаловаяПрибыль <> 0 И ИмяМагазина <> "НЕТ_ИМЕНИ" Тогда
						ЗапросФинИст.УстановитьПараметр("БиллзНоми", ИмяМагазина);
						ЗапросФинИст.УстановитьПараметр("КатегорияБаланса", 2);
						Выб = ЗапросФинИст.Выполнить().Выбрать();
						Если Выб.Следующий() Тогда
							НовСтр = Объект.Табдок.Добавить();
							НовСтр.СВоздух = ВаловаяПрибыль; 
							НовСтр.ВоздухК = Выб.Ссылка;
							НовСтр.Назначение = "Капиталь " + ИмяМагазина;
							НовСтр.Статья = СтатьяФилиалПродажа;
							СчетчикДобавленных = СчетчикДобавленных + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить("Ошибка блока продаж: " + ОписаниеОшибки());
	КонецПопытки;

	Если МассивИДМагазинов.Количество() = 0 Тогда
		Сообщить("Магазины не найдены в отчете. Дальнейшая загрузка прервана.");
		Возврат;
	КонецЕсли;
	СтрокаИДМагазинов = СтрСоединить(МассивИДМагазинов, ",");

	// =========================================================================================
	// ЧАСТЬ 2: ЗАГРУЗКА ПЕРЕМЕЩЕНИЙ
	// =========================================================================================
	АдресПеремещений = "/v1/transfer-report-table?start_date=" + СтрокаДаты + "&end_date=" + СтрокаДаты + "&limit=1000&page=1&display_currency=UZS&shop_ids=" + СтрокаИДМагазинов;
	ЗапросПеремещения = Новый HTTPЗапрос(АдресПеремещений);
	ЗапросПеремещения.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	Попытка
		ОтветПеремещения = HTTPСоединение.Получить(ЗапросПеремещения);
		Если ОтветПеремещения.КодСостояния = 200 Тогда
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветПеремещения.ПолучитьТелоКакСтроку());
			ДанныеПеремещений = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Если ТипЗнч(ДанныеПеремещений) = Тип("Структура") И ДанныеПеремещений.Свойство("rows") Тогда
				МассивПеремещений = ДанныеПеремещений.rows;
				Если ТипЗнч(МассивПеремещений) = Тип("Массив") Тогда
					Для Каждого СтрПерем Из МассивПеремещений Цикл
						Отправитель = ?(СтрПерем.Свойство("from_shop"), СтрПерем.from_shop, "");
						Получатель  = ?(СтрПерем.Свойство("to_shop"), СтрПерем.to_shop, "");
						СуммаПоставки = ?(СтрПерем.Свойство("sum_supply_price"), СтрПерем.sum_supply_price, 0);
						
						Если СуммаПоставки = 0 ИЛИ ПустаяСтрока(Отправитель) ИЛИ ПустаяСтрока(Получатель) Тогда Продолжить; КонецЕсли;
						
						//ЗапросФинИст.УстановитьПараметр("БиллзНоми", Отправитель);
						//ЗапросФинИст.УстановитьПараметр("КатегорияБаланса", 1);
						//ВыбОтпр = ЗапросФинИст.Выполнить().Выбрать();
						//
						//ЗапросФинИст.УстановитьПараметр("БиллзНоми", Получатель);
						//ЗапросФинИст.УстановитьПараметр("КатегорияБаланса", 1);
						//ВыбПолуч = ЗапросФинИст.Выполнить().Выбрать();  4
						
						// new version 1:
						//// Отправитель складини топиш
						//ЗапросФинИстСклад.УстановитьПараметр("БиллзНоми", Отправитель);
						//ЗапросФинИстСклад.УстановитьПараметр("ШаблонСклада", "СКЛАД%");
						//ВыбОтпр = ЗапросФинИстСклад.Выполнить().Выбрать();

						//// Получатель складини топиш
						//ЗапросФинИстСклад.УстановитьПараметр("БиллзНоми", Получатель);
						//ЗапросФинИстСклад.УстановитьПараметр("ШаблонСклада", "СКЛАД%");
						//ВыбПолуч = ЗапросФинИстСклад.Выполнить().Выбрать();
						//
						//Если ВыбОтпр.Следующий() И ВыбПолуч.Следующий() Тогда
						//	НовСтр = Объект.Табдок.Добавить();   
						//	// old version
						//	//НовСтр.СВоздух = СуммаПоставки;
						//	//НовСтр.ВоздухК = ВыбОтпр.Ссылка;
						//	//НовСтр.ВоздухД = ВыбПолуч.Ссылка;
						//	//НовСтр.Назначение = "Перемешение";
						//	//НовСтр.Статья = СтатьяПеремещение;    
						//	// new version
						//	НовСтр.СВоздух = СуммаПоставки;
						//	НовСтр.ВоздухК2 = ВыбОтпр.Ссылка;
						//	НовСтр.ВоздухД2 = ВыбПолуч.Ссылка;
						//	НовСтр.Назначение = "Перемишение";
						//	НовСтр.Статья = СтатьяПеремещение;
						//	СчетчикДобавленных = СчетчикДобавленных + 1;
						//КонецЕсли;           
						// Отправитель склада     new version 2
						ЗапросФинИстСклад.УстановитьПараметр("БиллзНоми", Отправитель);
						ЗапросФинИстСклад.УстановитьПараметр("ШаблонСклада", "СКЛАД%");
						ВыбОтпр = ЗапросФинИстСклад.Выполнить().Выбрать();

						// Получатель склада
						ЗапросФинИстСклад.УстановитьПараметр("БиллзНоми", Получатель);
						ЗапросФинИстСклад.УстановитьПараметр("ШаблонСклада", "СКЛАД%");
						ВыбПолуч = ЗапросФинИстСклад.Выполнить().Выбрать();

						// Проверка: оба склада найдены
						Если ВыбОтпр.Следующий() И ВыбПолуч.Следующий() Тогда
						    НовСтр = Объект.Табдок.Добавить();
						    НовСтр.СВоздух = СуммаПоставки;
						    НовСтр.ВоздухК = ВыбОтпр.Ссылка;
						    НовСтр.ВоздухД = ВыбПолуч.Ссылка;
						    НовСтр.Назначение = "Перемишение";
						    НовСтр.Статья = СтатьяПеремещение;
						    СчетчикДобавленных = СчетчикДобавленных + 1;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить("Ошибка перемещений: " + ОписаниеОшибки());
	КонецПопытки;

	// =========================================================================================
	// ЧАСТЬ 3: ЗАГРУЗКА ОПЛАТ И ТРАНЗАКЦИЙ (ГРУППИРОВКА)
	// =========================================================================================
	ТаблицаОплат = Новый ТаблицаЗначений;
	ТаблицаОплат.Колонки.Добавить("ShopName", Новый ОписаниеТипов("Строка"));
	ТаблицаОплат.Колонки.Добавить("CashSum", Новый ОписаниеТипов("Число"));
	ТаблицаОплат.Колонки.Добавить("CardSum", Новый ОписаниеТипов("Число"));
	ТаблицаОплат.Колонки.Добавить("TransferSum", Новый ОписаниеТипов("Число")); // <--- Добавили колонку для Переводов
	ТаблицаОплат.Колонки.Добавить("CallCenterSum", Новый ОписаниеТипов("Число"));

	АдресТранзакций = "/v1/transaction-report-table?start_date=" + СтрокаДаты + "&end_date=" + СтрокаДаты + "&limit=5000&page=1&shop_ids=" + СтрокаИДМагазинов;
	ЗапросТранзакции = Новый HTTPЗапрос(АдресТранзакций);
	ЗапросТранзакции.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	Попытка
		ОтветТранзакции = HTTPСоединение.Получить(ЗапросТранзакции);
		Если ОтветТранзакции.КодСостояния = 200 Тогда
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветТранзакции.ПолучитьТелоКакСтроку());
			ДанныеТранзакций = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Если ТипЗнч(ДанныеТранзакций) = Тип("Структура") И ДанныеТранзакций.Свойство("rows") Тогда
				МассивТранзакций = ДанныеТранзакций.rows;
				
				Если ТипЗнч(МассивТранзакций) = Тип("Массив") Тогда
					
					// Группируем чеки в память
					Для Каждого Чек Из МассивТранзакций Цикл
						МагазинОплаты = ?(Чек.Свойство("shop_name"), Чек.shop_name, "");
						Если ПустаяСтрока(МагазинОплаты) ИЛИ Не Чек.Свойство("payments") Тогда Продолжить; КонецЕсли;
						
						НайденнаяСтрока = ТаблицаОплат.Найти(МагазинОплаты, "ShopName");
						Если НайденнаяСтрока = Неопределено Тогда
							НайденнаяСтрока = ТаблицаОплат.Добавить();
							НайденнаяСтрока.ShopName = МагазинОплаты;
							НайденнаяСтрока.CashSum = 0; НайденнаяСтрока.CardSum = 0; 
							НайденнаяСтрока.TransferSum = 0; НайденнаяСтрока.CallCenterSum = 0;
						КонецЕсли;
						
						Для Каждого Платеж Из Чек.payments Цикл
							ТипОплаты = Платеж.payment_type_name;
							СуммаОплаты = Платеж.sum;
							
							Если ТипОплаты = "Наличные" Тогда
								НайденнаяСтрока.CashSum = НайденнаяСтрока.CashSum + СуммаОплаты;
							ИначеЕсли ТипОплаты = "Карта" Тогда
								НайденнаяСтрока.CardSum = НайденнаяСтрока.CardSum + СуммаОплаты;
							ИначеЕсли ТипОплаты = "Перевод" Тогда // <--- Ловим переводы
								НайденнаяСтрока.TransferSum = НайденнаяСтрока.TransferSum + СуммаОплаты;
							ИначеЕсли ТипОплаты = "Call centre" Тогда
								НайденнаяСтрока.CallCenterSum = НайденнаяСтрока.CallCenterSum + СуммаОплаты;
							КонецЕсли;
						КонецЦикла;
					КонецЦикла;
					
					// Выводим сгруппированные суммы в Табдок
					Для Каждого СтрОплат Из ТаблицаОплат Цикл
						МагазинИмя = СтрОплат.ShopName;
						
						// 1. НАЛИЧНЫЕ
						Если СтрОплат.CashSum <> 0 Тогда
							ЗапросОрг.УстановитьПараметр("БиллзНоми", МагазинИмя);
							ВыбОрг = ЗапросОрг.Выполнить().Выбрать();
							Если ВыбОрг.Следующий() Тогда
								НовСтр = Объект.Табдок.Добавить();
								НовСтр.Счет = ВыбОрг.Ссылка;
								НовСтр.Назначение = "Накд " + МагазинИмя;
								НовСтр.Статья = СтатьяСавдоПули;
								НовСтр.ДНал = СтрОплат.CashSum;
								СчетчикДобавленных = СчетчикДобавленных + 1;
							Иначе
								Сообщить("ВНИМАНИЕ: Не найдена Организация для налички: " + МагазинИмя);
							КонецЕсли;
						КонецЕсли;
						
						// 2. КАРТА И ПЕРЕВОД (Оба ищут ФинИст в одной папке "Карта")
						Если СтрОплат.CardSum <> 0 ИЛИ СтрОплат.TransferSum <> 0 Тогда
							ЗапросФинИстКарта.УстановитьПараметр("БиллзНоми", МагазинИмя);
							ВыбКарта = ЗапросФинИстКарта.Выполнить().Выбрать();
							
							Если ВыбКарта.Следующий() Тогда
								
								// Строка для Терминала
								Если СтрОплат.CardSum <> 0 Тогда
									НовСтр = Объект.Табдок.Добавить();
									НовСтр.ВоздухД = ВыбКарта.Ссылка;
									НовСтр.Назначение = "Терминал " + МагазинИмя;
									НовСтр.Статья = СтатьяСавдоПули;
									НовСтр.СВоздух = СтрОплат.CardSum;
									СчетчикДобавленных = СчетчикДобавленных + 1;
								КонецЕсли;
								
								// Строка для Перевода
								Если СтрОплат.TransferSum <> 0 Тогда
									НовСтр = Объект.Табдок.Добавить();
									НовСтр.ВоздухД = ВыбКарта.Ссылка;
									НовСтр.Назначение = "Перевод " + МагазинИмя;
									НовСтр.Статья = СтатьяСавдоПули;
									НовСтр.СВоздух = СтрОплат.TransferSum;
									СчетчикДобавленных = СчетчикДобавленных + 1;
								КонецЕсли;
								
							Иначе
								Сообщить("ВНИМАНИЕ: Не найден ФинИст в папке 'Карта' для: " + МагазинИмя);
							КонецЕсли;
						КонецЕсли;
						
						// 3. CALL CENTRE
						Если СтрОплат.CallCenterSum <> 0 Тогда
							Если ЗначениеЗаполнено(ФинИстКоллЦентр) Тогда
								НовСтр = Объект.Табдок.Добавить();
								НовСтр.ВоздухД = ФинИстКоллЦентр;
								НовСтр.Назначение = "Call centre Карта " + МагазинИмя;
								НовСтр.Статья = СтатьяСавдоПули;
								НовСтр.СВоздух = СтрОплат.CallCenterSum;
								СчетчикДобавленных = СчетчикДобавленных + 1;
							Иначе
								Сообщить("ВНИМАНИЕ: Не найден элемент ФинИст 'Карта Call центр оператор'");
							КонецЕсли;
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить("Ошибка обработки транзакций: " + ОписаниеОшибки());
	КонецПопытки;

	Сообщить("Загрузка завершена! Добавлено строк: " + СчетчикДобавленных);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзBILLZ(Команда)
	
	// Предупреждаем пользователя (опционально)
	Ответ = Вопрос("Загрузить данные продаж из BILLZ за дату документа?", РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьДанныеБиллзНаСервере();
	Сообщить("Загрузка данных из BILLZ завершена!");
	
КонецПроцедуры
// Функция поиска контрагента по числовому ИНН

