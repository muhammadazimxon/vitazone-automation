Процедура ЗаполнитьТабдокПоДоговору()
    // Очищаем табличную часть перед заполнением
    Объект.Табдок.Очистить();
    
    // Параметры для запроса
	Начало='2025-01-01';
    Дата = Объект.Дата;
  //  Наименование = ПолучимСсылкуНа("Переплата"); // Ссылка на конкретный договор
	Счет=Объект.Откуда;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДебиторкаОстаткиИОбороты.ДокНомер.Владелец КАК Контрагенты,
		|	ДебиторкаОстаткиИОбороты.ДокНомер.Владелец.инн КАК ИНН,
		|	ДебиторкаОстаткиИОбороты.ДокНомер КАК ДокНомер,
		|	ДебиторкаОстаткиИОбороты.Счет КАК Счет,
		|	ВЫБОР
		|		КОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток > 0
		|			ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток
		|	КОНЕЦ КАК Остаток
		|ИЗ
		|	РегистрНакопления.Дебиторка.ОстаткиИОбороты(&Начало, &Дата, , , ) КАК ДебиторкаОстаткиИОбороты
		|ГДЕ
		|	 ДебиторкаОстаткиИОбороты.Счет = &Счет";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	//Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Счет", Счет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	
    // Заполнение табличной части
    Пока Выборка.Следующий() Цикл
		 Если НЕ ПустаяСтрока(Выборка.остаток) И Число(Выборка.остаток) > 0 Тогда
		НоваяСтрока = Объект.Табдок.Добавить();
        НоваяСтрока.Контрагенты = Выборка.Контрагенты;
        НоваяСтрока.ИНН = Выборка.ИНН;
		НоваяСтрока.Договор = Выборка.ДокНомер;
		НоваяСтрока.Счет= Выборка.Счет;
		НоваяСтрока.КБезНал= Выборка.Остаток;
		НоваяСтрока.Статья=СтатьяНаим("Продажа");
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

