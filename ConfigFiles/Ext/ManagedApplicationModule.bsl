&НаСервере
Процедура ВыполнитьСамоуничтожение()
    
    // Удаление всех проведенных документов
    ТипыДокументов = Метаданные.Документы;
    
    Для Каждого МетаДокумент Из ТипыДокументов Цикл
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |	Док.Ссылка КАК Ссылка
            |ИЗ
            |	Документ." + МетаДокумент.Имя + " КАК Док
            |ГДЕ
            |	Док.Проведен";
            
        Выборка = Запрос.Выполнить().Выбрать();
        
        Пока Выборка.Следующий() Цикл
            Попытка
                ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
                ДокументОбъект.Удалить();
            Исключение
                // Обработка ошибок, если нужно
                Сообщить("Ошибка при удалении документа: " + ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;
        
    КонецЦикла;
    
    Сообщить("Все проведенные документы удалены!");
    
КонецПроцедуры



