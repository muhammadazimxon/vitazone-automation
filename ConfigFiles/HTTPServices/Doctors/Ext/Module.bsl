Функция EditPOST(Запрос) Экспорт
    Попытка
        // Инициализация переменной ИзБазы
        ИзБазы = Ложь;

        // Отладка получения запроса
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Начало обработки запроса. Метод: " + Запрос.HTTPМетод + ", URL: " + Запрос.БазовыйURL + Запрос.ОтносительныйURL);
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Заголовки запроса: " + СериализоватьЗаголовки(Запрос.Заголовки));

        // Чтение JSON
        ТекстТела = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Получен текст тела: " + ТекстТела);

        Чт = Новый ЧтениеJSON;
        Чт.УстановитьСтроку(ТекстТела);
        Данные = ПрочитатьJSON(Чт);
        Чт.Закрыть();

        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Тип данных: " + ТипЗнч(Данные));
        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                "Данные не являются структурой: " + ТекстТела);
            Возврат ОтветСОшибкойJSON(400, "Ожидался JSON-объект с полями.");
        КонецЕсли;

        // Проверка структуры JSON
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Полученные ключи JSON: " + СериализоватьКлючи(Данные));

        // Проверка обязательных полей
        Обяз = Новый Массив;
        Обяз.Добавить("Имя");
        Обяз.Добавить("Фамилия");
        Обяз.Добавить("МестоРаботы");
        Обяз.Добавить("Специальность");
        Обяз.Добавить("Должность");
        Обяз.Добавить("НомерТелефона");
        Обяз.Добавить("managerName");
        Обяз.Добавить("Регион");

        Значения = Новый Структура;
        Для Каждого Ключ Из Обяз Цикл
            Если НЕ Данные.Свойство(Ключ) Тогда
                ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                    "Отсутствует обязательное поле: " + Ключ);
                Возврат ОтветСОшибкойJSON(400, "Отсутствует обязательное поле: " + Ключ);
            КонецЕсли;
            Зн = Данные[Ключ];
            Если Зн = Неопределено Тогда
                ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                    "Поле пусто: " + Ключ);
                Возврат ОтветСОшибкойJSON(400, "Поле пусто: " + Ключ);
            КонецЕсли;
            Если ТипЗнч(Зн) <> Тип("Строка") Тогда
                Зн = Строка(Зн);
            КонецЕсли;
            Зн = СокрЛП(Зн);
            Если СтрДлина(Зн) = 0 Тогда
                ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                    "Поле пусто после очистки: " + Ключ);
                Возврат ОтветСОшибкойJSON(400, "Поле пусто: " + Ключ);
            КонецЕсли;
            Значения.Вставить(Ключ, Зн);
        КонецЦикла;

        // Отчество – не обязательное
        Отчество = "";
        Если Данные.Свойство("Отчество") Тогда
            ЗнО = Данные["Отчество"];
            Если ЗнО <> Неопределено Тогда
                Если ТипЗнч(ЗнО) <> Тип("Строка") Тогда
                    ЗнО = Строка(ЗнО);
                КонецЕсли;
                Отчество = СокрЛП(ЗнО);
            КонецЕсли;
        КонецЕсли;
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Отчество: " + Отчество);

        // Валидация телефона
        Тел = Значения["НомерТелефона"];
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Проверка номера телефона: " + Тел);
        Если СтрДлина(Тел) <> 12 ИЛИ Лев(Тел, 3) <> "998" ИЛИ НЕ ТолькоЦифры(Тел) Тогда
            ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                "Неверный формат номера телефона: " + Тел);
            Возврат ОтветСОшибкойJSON(400, "Неверный формат номера телефона. Ожидается 998XXXXXXXXX (12 цифр).");
        КонецЕсли;

        // Поиск сущностей
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Поиск менеджера: " + Значения["managerName"]);
        МенеджерСсылка = Справочники.Менеджер.НайтиПоНаименованию(Значения["managerName"], Истина);
        Если МенеджерСсылка.Пустая() Тогда
            ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                "Менеджер не найден: " + Значения["managerName"]);
            Возврат ОтветСОшибкойJSON(400, "Менеджер не найден.");
        КонецЕсли;
        МенеджерОбъект = МенеджерСсылка.ПолучитьОбъект();

        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Поиск региона: " + Значения["Регион"]);
        РегионСсылка = Справочники.Регион.НайтиПоНаименованию(Значения["Регион"], Истина);
        Если РегионСсылка.Пустая() Тогда
            ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                "Регион не найден: " + Значения["Регион"]);
            Возврат ОтветСОшибкойJSON(400, "Регион не найден.");
        КонецЕсли;

        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Поиск специальности: " + Значения["Специальность"]);
        СпециальностьСсылка = Справочники.Специальности.НайтиПоНаименованию(Значения["Специальность"], Истина);
        Если СпециальностьСсылка.Пустая() Тогда
            ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                "Специальность не найдена: " + Значения["Специальность"]);
            Возврат ОтветСОшибкойJSON(400, "Специальность не найдена.");
        КонецЕсли;

        // Поиск дубля по телефону
        ВрачСсылка = Справочники.Врачи.ПустаяСсылка();

        ЗапросДубль = Новый Запрос;
        ЗапросДубль.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |	Врачи.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Врачи КАК Врачи
        |ГДЕ
        |	Врачи.НомерТелефона = &НомерТелефона";
        ЗапросДубль.УстановитьПараметр("НомерТелефона", Тел);

        Выборка = ЗапросДубль.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            ВрачСсылка = Выборка.Ссылка;
            ИзБазы = Истина;
            ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
                "Врач найден в базе по телефону: " + Тел);
        Иначе
            // Создаём нового врача
            НовыйВрач = Справочники.Врачи.СоздатьЭлемент();
            НовыйВрач.Имя          = Значения["Имя"];
            НовыйВрач.Фамилия      = Значения["Фамилия"];
            НовыйВрач.Отчество     = Отчество;
            НовыйВрач.МестоРаботы  = Значения["МестоРаботы"];
            НовыйВрач.Специальность= СпециальностьСсылка;
            НовыйВрач.Должность    = Значения["Должность"];
            НовыйВрач.НомерТелефона= Тел;
            НовыйВрач.КтоДобавил   = Значения["managerName"];
            НовыйВрач.Регион       = РегионСсылка;
            НовыйВрач.Наименование = СокрЛП(Значения["Фамилия"] + " " + Значения["Имя"] + ?(ПустаяСтрока(Отчество), "", " " + Отчество));

            Попытка
                НовыйВрач.Записать();
                ВрачСсылка = НовыйВрач.Ссылка;
                ИзБазы = Ложь;
                ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
                    "Создан новый врач с телефоном: " + Тел + ", Наименование: " + НовыйВрач.Наименование);
            Исключение
                ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                    "Ошибка при создании врача: " + ОписаниеОшибки());
                Возврат ОтветСОшибкойJSON(500, "Ошибка при создании врача: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
            КонецПопытки;
        КонецЕсли;

        // Добавляем врача в табличную часть менеджера, если ещё нет
        УжеЕсть = Ложь;
        Для Каждого СтрТч Из МенеджерОбъект.Табдок Цикл
            Если СтрТч.Врач = ВрачСсылка Тогда
                УжеЕсть = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если НЕ УжеЕсть Тогда
            Попытка
                НачатьТранзакцию();
                НоваяСтрока = МенеджерОбъект.Табдок.Добавить();
                НоваяСтрока.Врач = ВрачСсылка;
                МенеджерОбъект.Записать();
                ЗафиксироватьТранзакцию();
                ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
                    "Врач добавлен в список менеджера: " + МенеджерОбъект.Наименование);
            Исключение
                ОтменитьТранзакцию();
                ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
                    "Ошибка при добавлении в список менеджера: " + ОписаниеОшибки());
                Возврат ОтветСОшибкойJSON(500, "Ошибка при добавлении в список менеджера: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
            КонецПопытки;
        Иначе
            ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
                "Врач уже есть в списке менеджера: " + МенеджерОбъект.Наименование);
        КонецЕсли;

        // Успех
        Сообщение = ?(ИзБазы, "Врач добавлен из базы", "Врач создан");
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Информация,,, 
            "Успешное завершение: " + Сообщение);
        ДанныеОтвета = Новый Структура;
        ДанныеОтвета.Вставить("success", Истина);
        ДанныеОтвета.Вставить("message", Сообщение);
        Возврат ОтветJSON(200, ДанныеОтвета);

    Исключение
        ИнфоОбОшибке = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("HTTP.Doctors.Edit", УровеньЖурналаРегистрации.Ошибка,,, 
            "Внутренняя ошибка: " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
        Возврат ОтветСОшибкойJSON(500, "Внутренняя ошибка: " + КраткоеПредставлениеОшибки(ИнфоОбОшибке));
    КонецПопытки;
КонецФункции

// ---------- ВСПОМОГАТЕЛЬНЫЕ ----------

Функция ОтветJSON(КодСост, Объект) Экспорт
    Зап = Новый ЗаписьJSON;
    Зап.УстановитьСтроку();
    ЗаписатьJSON(Зап, Объект);
    Стр = Зап.Закрыть();

    Ответ = Новый HTTPСервисОтвет(КодСост);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Стр);
    Возврат Ответ;
КонецФункции

Функция ОтветСОшибкойJSON(КодСост, Сообщение) Экспорт
    Стркт = Новый Структура;
    Стркт.Вставить("success", Ложь);
    Стркт.Вставить("message", Сообщение);
    Возврат ОтветJSON(КодСост, Стркт);
КонецФункции

Функция ТолькоЦифры(СтрЗн) Экспорт
    Для П = 1 По СтрДлина(СтрЗн) Цикл
        КодСимв = КодСимвола(Сред(СтрЗн, П, 1));
        Если КодСимв < 48 ИЛИ КодСимв > 57 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция СериализоватьЗаголовки(Заголовки) Экспорт
    Результат = "";
    Для Каждого Заголовок Из Заголовки Цикл
        Результат = Результат + Заголовок.Ключ + ": " + Заголовок.Значение + "; ";
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СериализоватьКлючи(Данные) Экспорт
    Результат = "";
    Для Каждого Ключ Из Данные Цикл
        Результат = Результат + Ключ.Ключ + ", ";
    КонецЦикла;
    Возврат Лев(Результат, СтрДлина(Результат) - 2);
КонецФункции