Функция Get(Запрос)
    Попытка
        TelegramID = Запрос.ПараметрыЗапроса.Получить("telegram_id");
        
        Если TelegramID = Неопределено Тогда
            ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Ошибка,,, "GetDeepLink: Параметр telegram_id не указан");
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: параметр telegram_id не указан");
            Возврат Ответ;
        КонецЕсли;
        
        ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Информация,,, "GetDeepLink: Поиск пользователя с TelegramID = " + TelegramID);
        
        Пользователь = НайтиПользователяПоTelegramID(TelegramID);
        Если Пользователь = Неопределено Тогда
            ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Ошибка,,, "GetDeepLink: Пользователь не найден: TelegramID = " + TelegramID);
            Ответ = Новый HTTPСервисОтвет(404);
            Ответ.УстановитьТелоИзСтроки("Пользователь не найден");
            Возврат Ответ;
        КонецЕсли;
        
        Если ПустаяСтрока(Пользователь.Наименование) Тогда
            ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Информация,,, "GetDeepLink: Ожидается ввод имени для TelegramID = " + TelegramID);
            Ответ = Новый HTTPСервисОтвет(202);
            Ответ.УстановитьТелоИзСтроки("Ожидается ввод имени");
            Возврат Ответ;
        КонецЕсли;
        
        Если ПустаяСтрока(Пользователь.DeepLink) Тогда
            ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Ошибка,,, "GetDeepLink: Deep Link не найден для TelegramID = " + TelegramID);
            Ответ = Новый HTTPСервисОтвет(404);
            Ответ.УстановитьТелоИзСтроки("Deep Link не найден");
            Возврат Ответ;
        КонецЕсли;
        
        ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Информация,,, "GetDeepLink: Deep Link возвращён: " + Пользователь.DeepLink);
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.УстановитьТелоИзСтроки(Пользователь.DeepLink);
        Возврат Ответ;
        
    Исключение
        ОписаниеОшибкиТекст = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Ошибка,,, "GetDeepLink: Ошибка обработки запроса: " + ОписаниеОшибкиТекст);
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка: " + ОписаниеОшибкиТекст);
        Возврат Ответ;
    КонецПопытки;
КонецФункции

Функция НайтиПользователяПоTelegramID(TelegramID)
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    Пользователи.Ссылка КАК Ссылка,
            |    Пользователи.userID КАК userID,
            |    Пользователи.Наименование КАК Наименование,
            |    Пользователи.DeepLink КАК DeepLink
            |ИЗ
            |    Справочник.Пользователи КАК Пользователи
            |ГДЕ
            |    Пользователи.TelegramID = &TelegramID";
        
        Запрос.УстановитьПараметр("TelegramID", TelegramID);
        Результат = Запрос.Выполнить();
        
        Если Результат.Пустой() Тогда
            ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Информация,,, "НайтиПользователяПоTelegramID: Пользователь не найден: TelegramID = " + TelegramID);
            Возврат Неопределено;
        КонецЕсли;
        
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Информация,,, "НайтиПользователяПоTelegramID: Пользователь найден: TelegramID = " + TelegramID);
        Возврат Выборка;
    Исключение
        ОписаниеОшибкиТекст = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("GetDeepLink", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка в НайтиПользователяПоTelegramID: " + ОписаниеОшибкиТекст);
        Возврат Неопределено;
    КонецПопытки;
КонецФункции