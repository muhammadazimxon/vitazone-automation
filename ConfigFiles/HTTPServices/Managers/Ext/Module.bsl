Функция ProfilePOST(Запрос) Экспорт
    Попытка                                                                  
        // Отладка получения запроса
        ЗаписьЖурналаРегистрации("HTTP.Managers.Profile", УровеньЖурналаРегистрации.Информация,,, 
            "Начало обработки запроса. Метод: " + Запрос.HTTPМетод + ", URL: " + Запрос.БазовыйURL + Запрос.ОтносительныйURL);

        // Чтение JSON
        ТекстТела = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("HTTP.Managers.Profile", УровеньЖурналаРегистрации.Информация,,, 
            "Получен текст тела: " + ТекстТела);

        Чт = Новый ЧтениеJSON;
        Чт.УстановитьСтроку(ТекстТела);
        Данные = ПрочитатьJSON(Чт);
        Чт.Закрыть();

        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.Profile", УровеньЖурналаРегистрации.Ошибка,,, 
                "Данные не являются структурой: " + ТекстТела);
            Возврат ОтветСОшибкойJSON(400, "Ожидался JSON-объект с полями.");
        КонецЕсли;

        // Проверка обязательного поля telegram_id
        Если НЕ Данные.Свойство("telegram_id") ИЛИ Данные["telegram_id"] = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Данные["telegram_id"])) Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.Profile", УровеньЖурналаРегистрации.Ошибка,,, 
                "Отсутствует или пустое поле telegram_id.");
            Возврат ОтветСОшибкойJSON(400, "Отсутствует или пустое поле telegram_id.");
        КонецЕсли;

        TelegramID = СокрЛП(Данные["telegram_id"]);
        ЗаписьЖурналаРегистрации("HTTP.Managers.Profile", УровеньЖурналаРегистрации.Информация,,, 
            "Поиск менеджера по TelegramID: " + TelegramID);

        // Поиск менеджера
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |	Менеджер.Ссылка КАК Ссылка,
        |	Менеджер.Наименование КАК Наименование,
        |	Менеджер.Контакт КАК Контакт,
        |	Менеджер.Куратор.Наименование КАК Куратор,
        |	Менеджер.TelegramIDM КАК TelegramIDM
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDM = &TelegramID";
        Запрос.УстановитьПараметр("TelegramID", TelegramID);

        Выборка = Запрос.Выполнить().Выбрать();
        Если НЕ Выборка.Следующий() Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.Profile", УровеньЖурналаРегистрации.Ошибка,,, 
                "Менеджер не найден по TelegramID: " + TelegramID);
            Возврат ОтветСОшибкойJSON(400, "Менеджер не найден.");
        КонецЕсли;

        // Формирование ответа
        ДанныеОтвета = Новый Структура;
        ДанныеОтвета.Вставить("Имя", Выборка.Наименование);
        ДанныеОтвета.Вставить("Телефон", Выборка.Контакт);
        ДанныеОтвета.Вставить("Куратор", ?(ЗначениеЗаполнено(Выборка.Куратор), Выборка.Куратор, ""));
        ДанныеОтвета.Вставить("Логин", Выборка.TelegramIDM);

        ЗаписьЖурналаРегистрации("HTTP.Managers.Profile", УровеньЖурналаРегистрации.Информация,,, 
            "Успешное получение профиля: " + Выборка.Наименование);
        Возврат ОтветJSON(200, ДанныеОтвета);

    Исключение
        ИнфоОбОшибке = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("HTTP.Managers.Profile", УровеньЖурналаРегистрации.Ошибка,,, 
            "Внутренняя ошибка: " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
        Возврат ОтветСОшибкойJSON(500, "Внутренняя ошибка: " + КраткоеПредставлениеОшибки(ИнфоОбОшибке));
    КонецПопытки;
КонецФункции

// ---------- ВСПОМОГАТЕЛЬНЫЕ ----------

Функция ОтветJSON(КодСост, Объект) Экспорт
    Зап = Новый ЗаписьJSON;
    Зап.УстановитьСтроку();
    ЗаписатьJSON(Зап, Объект);
    Стр = Зап.Закрыть();

    Ответ = Новый HTTPСервисОтвет(КодСост);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Стр);
    Возврат Ответ;
КонецФункции

Функция ОтветСОшибкойJSON(КодСост, Сообщение) Экспорт
    Стркт = Новый Структура;
    Стркт.Вставить("success", Ложь);
    Стркт.Вставить("message", Сообщение);
    Возврат ОтветJSON(КодСост, Стркт);
КонецФункции



Функция DoctorsPOST(Запрос) Экспорт
    Попытка
        // Отладка получения запроса
