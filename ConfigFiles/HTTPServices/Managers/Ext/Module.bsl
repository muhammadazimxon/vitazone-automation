            "Начало обработки запроса. Метод: " + Запрос.HTTPМетод + ", URL: " + Запрос.БазовыйURL + Запрос.ОтносительныйURL);

        // Чтение JSON
        ТекстТела = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("HTTP.Managers.Doctors", УровеньЖурналаРегистрации.Информация,,, 
            "Получен текст тела: " + ТекстТела);

        Чт = Новый ЧтениеJSON;
        Чт.УстановитьСтроку(ТекстТела);
        Данные = ПрочитатьJSON(Чт);
        Чт.Закрыть();

        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.Doctors", УровеньЖурналаРегистрации.Ошибка,,, 
                "Данные не являются структурой: " + ТекстТела);
            Возврат ОтветСОшибкойJSON(400, "Ожидался JSON-объект с полями.");
        КонецЕсли;

        // Проверка обязательного поля telegram_id
        Если НЕ Данные.Свойство("telegram_id") ИЛИ Данные["telegram_id"] = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Данные["telegram_id"])) Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.Doctors", УровеньЖурналаРегистрации.Ошибка,,, 
                "Отсутствует или пустое поле telegram_id.");
            Возврат ОтветСОшибкойJSON(400, "Отсутствует или пустое поле telegram_id.");
        КонецЕсли;

        TelegramID = СокрЛП(Данные["telegram_id"]);
        ЗаписьЖурналаРегистрации("HTTP.Managers.Doctors", УровеньЖурналаРегистрации.Информация,,, 
            "Поиск менеджера по TelegramID: " + TelegramID);

        // Поиск менеджера
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |	Менеджер.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDM = &TelegramID";
        Запрос.УстановитьПараметр("TelegramID", TelegramID);

        Выборка = Запрос.Выполнить().Выбрать();
        Если НЕ Выборка.Следующий() Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.Doctors", УровеньЖурналаРегистрации.Ошибка,,, 
                "Менеджер не найден по TelegramID: " + TelegramID);
            Возврат ОтветСОшибкойJSON(400, "Менеджер не найден.");
        КонецЕсли;

        // Получение списка врачей
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |	МенеджерТабдок.Врач.Наименование КАК Наименование,
        |	МенеджерТабдок.Врач.НомерТелефона КАК НомерТелефона,
        |	МенеджерТабдок.Врач.Специальность.Наименование КАК Специальность
        |ИЗ
        |	Справочник.Менеджер.Табдок КАК МенеджерТабдок
        |ГДЕ
        |	МенеджерТабдок.Ссылка = &Менеджер";
        Запрос.УстановитьПараметр("Менеджер", Выборка.Ссылка);

        ВыборкаВрачи = Запрос.Выполнить().Выбрать();
        Врачи = Новый Массив;
        Пока ВыборкаВрачи.Следующий() Цикл
            Врач = Новый Структура;
            // Приведение значений к безопасным типам
            Врач.Вставить("Наименование", ?(ВыборкаВрачи.Наименование = Null ИЛИ ВыборкаВрачи.Наименование = Неопределено, "", СокрЛП(ВыборкаВрачи.Наименование)));
            Врач.Вставить("НомерТелефона", ?(ВыборкаВрачи.НомерТелефона = Null ИЛИ ВыборкаВрачи.НомерТелефона = Неопределено, "", СокрЛП(ВыборкаВрачи.НомерТелефона)));
            Врач.Вставить("Специальность", ?(ВыборкаВрачи.Специальность = Null ИЛИ ВыборкаВрачи.Специальность = Неопределено, "", СокрЛП(ВыборкаВрачи.Специальность)));
            Врачи.Добавить(Врач);
        КонецЦикла;

        // Формирование ответа
        ДанныеОтвета = Новый Структура;
        ДанныеОтвета.Вставить("Врачи", Врачи);
        ЗаписьЖурналаРегистрации("HTTP.Managers.Doctors", УровеньЖурналаРегистрации.Информация,,, 
            "Успешное получение списка врачей: " + Формат(Врачи.Количество(), "ЧГ=0"));
        Возврат ОтветJSON(200, ДанныеОтвета);

    Исключение
        ИнфоОбОшибке = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("HTTP.Managers.Doctors", УровеньЖурналаРегистрации.Ошибка,,, 
            "Внутренняя ошибка: " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
        Возврат ОтветСОшибкойJSON(500, "Внутренняя ошибка: " + КраткоеПредставлениеОшибки(ИнфоОбОшибке));
    КонецПопытки;
КонецФункции

Функция DeleteDoctorPOST(Запрос)
	Попытка
        // Отладка получения запроса
        ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Информация,,, 
            "Начало обработки запроса. Метод: " + Запрос.HTTPМетод + ", URL: " + Запрос.БазовыйURL + Запрос.ОтносительныйURL);

        // Чтение JSON
        ТекстТела = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Информация,,, 
            "Получен текст тела: " + ТекстТела);

        Чт = Новый ЧтениеJSON;
        Чт.УстановитьСтроку(ТекстТела);
        Данные = ПрочитатьJSON(Чт);
        Чт.Закрыть();

        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Ошибка,,, 
                "Данные не являются структурой: " + ТекстТела);
            Возврат ОтветСОшибкойJSON(400, "Ожидался JSON-объект с полями.");
        КонецЕсли;

        // Проверка обязательных полей
        Если НЕ Данные.Свойство("telegram_id") ИЛИ Данные["telegram_id"] = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Данные["telegram_id"])) Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Ошибка,,, 
                "Отсутствует или пустое поле telegram_id.");
            Возврат ОтветСОшибкойJSON(400, "Отсутствует или пустое поле telegram_id.");
        КонецЕсли;

        Если НЕ Данные.Свойство("phone_number") ИЛИ Данные["phone_number"] = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Данные["phone_number"])) Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Ошибка,,, 
                "Отсутствует или пустое поле phone_number.");
            Возврат ОтветСОшибкойJSON(400, "Отсутствует или пустое поле phone_number.");
        КонецЕсли;

        TelegramID = СокрЛП(Данные["telegram_id"]);
        НомерТелефона = СокрЛП(Данные["phone_number"]);
        ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Информация,,, 
            "Удаление врача. TelegramID: " + TelegramID + ", НомерТелефона: " + НомерТелефона);

        // Поиск менеджера
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |	Менеджер.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDM = &TelegramID";
        Запрос.УстановитьПараметр("TelegramID", TelegramID);

        Выборка = Запрос.Выполнить().Выбрать();
        Если НЕ Выборка.Следующий() Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Ошибка,,, 
                "Менеджер не найден по TelegramID: " + TelegramID);
            Возврат ОтветСОшибкойJSON(400, "Менеджер не найден.");
        КонецЕсли;

        МенеджерОбъект = Выборка.Ссылка.ПолучитьОбъект();

        // Поиск врача
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |	Врачи.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Врачи КАК Врачи
        |ГДЕ
        |	Врачи.НомерТелефона = &НомерТелефона";
        Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);

        ВыборкаВрач = Запрос.Выполнить().Выбрать();
        Если НЕ ВыборкаВрач.Следующий() Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Ошибка,,, 
                "Врач не найден по НомерТелефона: " + НомерТелефона);
            Возврат ОтветСОшибкойJSON(400, "Врач не найден.");
        КонецЕсли;

        // Удаление врача из табличной части
        НайденныеСтроки = МенеджерОбъект.Табдок.НайтиСтроки(Новый Структура("Врач", ВыборкаВрач.Ссылка));
        Если НайденныеСтроки.Количество() = 0 Тогда
            ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Ошибка,,, 
                "Врач не найден в списке менеджера: " + НомерТелефона);
            Возврат ОтветСОшибкойJSON(400, "Врач не найден в списке менеджера.");
        КонецЕсли;

        Попытка
            НачатьТранзакцию();
            Для Каждого Строка Из НайденныеСтроки Цикл
                МенеджерОбъект.Табдок.Удалить(Строка);
            КонецЦикла;
            МенеджерОбъект.Записать();
            ЗафиксироватьТранзакцию();
            ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Информация,,, 
                "Врач удалён из списка менеджера: " + НомерТелефона);
        Исключение
            ОтменитьТранзакцию();
            ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка при удалении врача: " + ОписаниеОшибки());
            Возврат ОтветСОшибкойJSON(500, "Ошибка при удалении врача: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;

        // Успех
        ДанныеОтвета = Новый Структура;
        ДанныеОтвета.Вставить("success", Истина);
        ДанныеОтвета.Вставить("message", "Врач удалён из списка менеджера.");
        Возврат ОтветJSON(200, ДанныеОтвета);

    Исключение
        ИнфоОбОшибке = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("HTTP.Managers.DeleteDoctor", УровеньЖурналаРегистрации.Ошибка,,, 
            "Внутренняя ошибка: " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
        Возврат ОтветСОшибкойJSON(500, "Внутренняя ошибка: " + КраткоеПредставлениеОшибки(ИнфоОбОшибке));
    КонецПопытки;
КонецФункции

