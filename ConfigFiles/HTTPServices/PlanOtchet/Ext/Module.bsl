// Функция обработки GET-запроса для отчета по планам продаж
Функция PlanOtchetGET(Запрос) Экспорт
    
    // Формирование строки параметров для логирования в порядке запроса
    СтрокаПараметров = "TelegramID=" + Запрос.ПараметрыЗапроса.Получить("TelegramID") +
                       "&ПериодНачало=" + Запрос.ПараметрыЗапроса.Получить("ПериодНачало") +
                       "&ПериодКонец=" + Запрос.ПараметрыЗапроса.Получить("ПериодКонец") +
                       ?(ЗначениеЗаполнено(Запрос.ПараметрыЗапроса.Получить("ИНН")), "&ИНН=" + Запрос.ПараметрыЗапроса.Получить("ИНН"), "") +
                       ?(ЗначениеЗаполнено(Запрос.ПараметрыЗапроса.Получить("Номенклатура")), "&Номенклатура=" + Запрос.ПараметрыЗапроса.Получить("Номенклатура"), "") +
                       ?(ЗначениеЗаполнено(Запрос.ПараметрыЗапроса.Получить("МП")), "&МП=" + Запрос.ПараметрыЗапроса.Получить("МП"), "");
    
    // Полный URL для логирования
    ПолныйURL = Запрос.БазовыйURL + Запрос.ОтносительныйURL + ?(СтрокаПараметров = "", "", "?") + СтрокаПараметров;
    
    // Начало логирования
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Начало обработки запроса: " + ПолныйURL
    );
    
    Попытка
        // Получение параметров запроса
        TelegramID = Запрос.ПараметрыЗапроса.Получить("TelegramID");
        ПериодНачало = Запрос.ПараметрыЗапроса.Получить("ПериодНачало");
        ПериодКонец = Запрос.ПараметрыЗапроса.Получить("ПериодКонец");
        ИНН = Запрос.ПараметрыЗапроса.Получить("ИНН");
        Номенклатура = Запрос.ПараметрыЗапроса.Получить("Номенклатура");
        МП = Запрос.ПараметрыЗапроса.Получить("МП");
        
        // Преобразование ИНН в число, если он указан
        ЧисловойИНН = Неопределено;
        Если ЗначениеЗаполнено(ИНН) Тогда
            Попытка
                ЧисловойИНН = Число(СокрЛП(ИНН));
                ЗаписьЖурналаРегистрации(
                    "HTTPСервис.PlanOtchet",
                    УровеньЖурналаРегистрации.Информация,
                    ,
                    ,
                    "ИНН преобразован в число: " + ЧисловойИНН
                );
            Исключение
                ТекстОшибки = "Ошибка преобразования ИНН в число: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
                ЗаписьЖурналаРегистрации(
                    "HTTPСервис.PlanOtchet",
                    УровеньЖурналаРегистрации.Ошибка,
                    ,
                    ,
                    ТекстОшибки
                );
                Возврат ОтветОшибка(ТекстОшибки);
            КонецПопытки;
        КонецЕсли;
        
        // Поиск номенклатуры по наименованию, если указан параметр
        НоменклатураСсылка = Неопределено;
        Если ЗначениеЗаполнено(Номенклатура) Тогда
            ЗапросНоменклатуры = Новый Запрос;
            ЗапросНоменклатуры.Текст = 
            "ВЫБРАТЬ
            |    Номенклатура.Ссылка
            |ИЗ
            |    Справочник.Номенклатура КАК Номенклатура
            |ГДЕ
            |    Номенклатура.Наименование = &Наименование";
            ЗапросНоменклатуры.УстановитьПараметр("Наименование", Номенклатура);
            РезультатНоменклатуры = ЗапросНоменклатуры.Выполнить();
            
            Если РезультатНоменклатуры.Пустой() Тогда
                ЗаписьЖурналаРегистрации(
                    "HTTPСервис.PlanOtchet",
                    УровеньЖурналаРегистрации.Информация,
                    ,
                    ,
                    "Номенклатура с наименованием '" + Номенклатура + "' не найдена в справочнике Номенклатура"
                );
            Иначе
                Выборка = РезультатНоменклатуры.Выбрать();
                Выборка.Следующий();
                НоменклатураСсылка = Выборка.Ссылка;
                ЗаписьЖурналаРегистрации(
                    "HTTPСервис.PlanOtchet",
                    УровеньЖурналаРегистрации.Информация,
                    ,
                    ,
                    "Номенклатура с наименованием '" + Номенклатура + "' найдена: " + НоменклатураСсылка
                );
            КонецЕсли;
        КонецЕсли;
        
        // Поиск менеджера по имени МП, если указан
        МПСсылка = Неопределено;
        Если ЗначениеЗаполнено(МП) Тогда
            ЗапросМП = Новый Запрос;
            ЗапросМП.Текст = 
            "ВЫБРАТЬ
            |    Менеджер.Ссылка
            |ИЗ
            |    Справочник.Менеджер КАК Менеджер
            |ГДЕ
            |    Менеджер.Наименование = &Наименование";
            ЗапросМП.УстановитьПараметр("Наименование", МП);
            РезультатМП = ЗапросМП.Выполнить();
            Если НЕ РезультатМП.Пустой() Тогда
                ВыборкаМП = РезультатМП.Выбрать();
                ВыборкаМП.Следующий();
                МПСсылка = ВыборкаМП.Ссылка;
                ЗаписьЖурналаРегистрации(
                    "HTTPСервис.PlanOtchet",
                    УровеньЖурналаРегистрации.Информация,
                    ,
                    ,
                    "Менеджер с наименованием '" + МП + "' найден: " + МПСсылка
                );
            Иначе
                ЗаписьЖурналаРегистрации(
                    "HTTPСервис.PlanOtchet",
                    УровеньЖурналаРегистрации.Информация,
                    ,
                    ,
                    "Менеджер с наименованием '" + МП + "' не найден в справочнике Менеджер"
                );
            КонецЕсли;
        КонецЕсли;
        
        // Логирование входных параметров
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            СтрШаблон("Входные параметры: TelegramID=%1, ПериодНачало=%2, ПериодКонец=%3, ИНН=%4, Номенклатура=%5, МП=%6",
                TelegramID, ПериодНачало, ПериодКонец, ИНН, Номенклатура, МП)
        );
        
        // Проверка формата параметров
        Если НЕ ЗначениеЗаполнено(TelegramID) Тогда
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ,
                "Не указан обязательный параметр TelegramID"
            );
            Возврат ОтветОшибка("Не указан обязательный параметр TelegramID");
        КонецЕсли;
        
        // Проверка обязательного параметра
        Если НЕ ЗначениеЗаполнено(ПериодНачало) ИЛИ НЕ ЗначениеЗаполнено(ПериодКонец) Тогда
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ,
                "Не указан обязательный параметр Период"
            );
            Возврат ОтветОшибка("Не указан обязательный параметр Период");
        КонецЕсли;
        
        // Преобразование дат
        Попытка
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Информация,
                ,
                ,
                "Начало преобразования ПериодНачало: " + ПериодНачало
            );
            ДатаНачало = СтрокаВДату(ПериодНачало);
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Информация,
                ,
                ,
                "ДатаНачало успешно преобразована: " + Формат(ДатаНачало, "ДФ=yyyy-MM-dd")
            );
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Информация,
                ,
                ,
                "Начало преобразования ПериодКонец: " + ПериодКонец
            );
            ДатаКонец = СтрокаВДату(ПериодКонец);
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Информация,
                ,
                ,
                "ДатаКонец успешно преобразована: " + Формат(ДатаКонец, "ДФ=yyyy-MM-dd")
            );
        Исключение
            ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ,
                СтрШаблон("Ошибка преобразования дат: ПериодНачало=%1, ПериодКонец=%2, Подробности: %3",
                    ПериодНачало, ПериодКонец, ТекстОшибки)
            );
            Возврат ОтветОшибка("Неверный формат дат в параметрах ПериодНачало или ПериодКонец");
        КонецПопытки;
        
        // Проверка контрагента по ИНН (для отладки)
        Если ЗначениеЗаполнено(ЧисловойИНН) Тогда
            ЗапросПроверки = Новый Запрос;
            ЗапросПроверки.Текст = 
            "ВЫБРАТЬ
            |    Контрагенты.Ссылка,
            |    Контрагенты.Наименование
            |ИЗ
            |    Справочник.Контрагенты КАК Контрагенты
            |ГДЕ
            |    Контрагенты.ИНН = &ИНН";
            ЗапросПроверки.УстановитьПараметр("ИНН", ЧисловойИНН);
            РезультатПроверки = ЗапросПроверки.Выполнить();
            
            Если РезультатПроверки.Пустой() Тогда
                ЗаписьЖурналаРегистрации(
                    "HTTPСервис.PlanOtchet",
                    УровеньЖурналаРегистрации.Информация,
                    ,
                    ,
                    "Контрагент с ИНН " + ЧисловойИНН + " не найден в справочнике Контрагенты"
                );
            Иначе
                Выборка = РезультатПроверки.Выбрать();
                Выборка.Следующий();
                ЗаписьЖурналаРегистрации(
                    "HTTPСервис.PlanOtchet",
                    УровеньЖурналаРегистрации.Информация,
                    ,
                    ,
                    "Контрагент с ИНН " + ЧисловойИНН + " найден: " + Выборка.Наименование
                );
            КонецЕсли;
        КонецЕсли;
        
        // Логирование параметров
        ЛогПараметры = СтрШаблон(
            "Параметры запроса: TelegramID=%1, ПериодНачало=%2, ПериодКонец=%3, ИНН=%4, Номенклатура=%5, МП=%6",
            TelegramID, ПериодНачало, ПериодКонец, ИНН, Номенклатура, МП
        );
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            ЛогПараметры
        );
        
        // Определение роли пользователя
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Определение роли пользователя для TelegramID: " + TelegramID
        );
        Менеджер = ПолучитьМенеджераПоTelegramID(TelegramID);
        ЭтоКуратор = Менеджер.TelegramIDM = Менеджер.TelegramIDK;
        
        // Логирование роли
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Роль пользователя: " + ?(ЭтоКуратор, "Куратор", "Менеджер")
        );
        
        // Формирование условия фильтрации
        УсловиеФильтрации = "";
        Если ЗначениеЗаполнено(ЧисловойИНН) Тогда
            УсловиеФильтрации = УсловиеФильтрации + " И ПланыПродажРС.Аптека В (ВЫБРАТЬ Контрагенты.Ссылка ИЗ Справочник.Контрагенты КАК Контрагенты ГДЕ Контрагенты.ИНН = &ИНН)";
        КонецЕсли;
        Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
            УсловиеФильтрации = УсловиеФильтрации + " И ПланыПродажРС.Номенклатура = &Номенклатура";
        КонецЕсли;
        Если ЭтоКуратор Тогда
            УсловиеФильтрации = УсловиеФильтрации + " И ПланыПродажРС.Куратор = &Куратор";
            Если ЗначениеЗаполнено(МПСсылка) Тогда
                УсловиеФильтрации = УсловиеФильтрации + " И ПланыПродажРС.МП = &МП";
            КонецЕсли;
        Иначе
            УсловиеФильтрации = УсловиеФильтрации + " И ПланыПродажРС.МП = &Менеджер";
        КонецЕсли;
        УсловиеФильтрации = ?(ЗначениеЗаполнено(УсловиеФильтрации), " " + Сред(УсловиеФильтрации, 2), "");
        
        // Формирование запроса СКД
        ЗапросСКД = Новый Запрос;
        ЗапросСКД.Текст = 
        "ВЫБРАТЬ
        |    ЕСТЬNULL(ПланыПродажРС.Аптека, ОстаткиОстаткиИОбороты.Контрагенты) КАК Контрагенты,
        |    ЕСТЬNULL(ПланыПродажРС.МП, ОстаткиОстаткиИОбороты.МП) КАК МП,
        |    ЕСТЬNULL(ПланыПродажРС.Номенклатура, ОстаткиОстаткиИОбороты.Номенклатура) КАК Номенклатура,
        |    СУММА(ЕСТЬNULL(ПланыПродажРС.Количество, 0)) КАК Количество,
        |    СУММА(ЕСТЬNULL(ПланыПродажРС.Сумма, 0)) КАК Сумма,
        |    СУММА(ЕСТЬNULL(ОстаткиОстаткиИОбороты.КолвоРасход, 0)) КАК ФактКоличество,
        |    СУММА(ЕСТЬNULL(ОстаткиОстаткиИОбороты.СуммаРасход, 0)) КАК ФактСумма
        |ПОМЕСТИТЬ ВТ_Данные
        |ИЗ
        |    РегистрСведений.ПланыПродажРС КАК ПланыПродажРС
        |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Остатки.ОстаткиИОбороты КАК ОстаткиОстаткиИОбороты
        |        ПО ПланыПродажРС.Аптека = ОстаткиОстаткиИОбороты.Контрагенты
        |            И ПланыПродажРС.МП = ОстаткиОстаткиИОбороты.МП
        |            И ПланыПродажРС.Номенклатура = ОстаткиОстаткиИОбороты.Номенклатура
        |ГДЕ
        |    ПланыПродажРС.Период МЕЖДУ &НачалоПериода И &КонецПериода" + УсловиеФильтрации + "
        |СГРУППИРОВАТЬ ПО
        |    ЕСТЬNULL(ПланыПродажРС.Аптека, ОстаткиОстаткиИОбороты.Контрагенты),
        |    ЕСТЬNULL(ПланыПродажРС.МП, ОстаткиОстаткиИОбороты.МП),
        |    ЕСТЬNULL(ПланыПродажРС.Номенклатура, ОстаткиОстаткиИОбороты.Номенклатура)
        |;
        |
        |ВЫБРАТЬ
        |    ВТ_Данные.Контрагенты,
        |    ВТ_Данные.МП КАК Менеджер,
        |    ВТ_Данные.Номенклатура,
        |    ВТ_Данные.Количество,
        |    ВТ_Данные.Сумма,
        |    ВТ_Данные.ФактКоличество,
        |    ВТ_Данные.ФактСумма,
        |    ВЫБОР
        |        КОГДА ВТ_Данные.Количество = 0
        |            ТОГДА 0
        |        ИНАЧЕ (ВТ_Данные.ФактКоличество / ВТ_Данные.Количество) * 100
        |    КОНЕЦ КАК ВыполнениеКолво,
        |    ВЫБОР
        |        КОГДА ВТ_Данные.Сумма = 0
        |            ТОГДА 0
        |        ИНАЧЕ (ВТ_Данные.ФактСумма / ВТ_Данные.Сумма) * 100
        |    КОНЕЦ КАК ВыполнениеСумма,
        |    ВЫБОР
        |        КОГДА ВТ_Данные.Сумма = 0 ИЛИ ВТ_Данные.Количество = 0
        |            ТОГДА 0
        |        ИНАЧЕ (((ВТ_Данные.ФактСумма / ВТ_Данные.Сумма) * 100) + 
        |                ((ВТ_Данные.ФактКоличество / ВТ_Данные.Количество) * 100)) / 2
        |    КОНЕЦ КАК ОбщееВыполнение
        |ИЗ
        |    ВТ_Данные КАК ВТ_Данные
        |УПОРЯДОЧИТЬ ПО
        |    ОбщееВыполнение УБЫВ";
        
        // Логирование текста запроса
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Текст запроса СКД: " + СтрЗаменить(ЗапросСКД.Текст, Символы.ПС, " ")
        );
        
        // Установка параметров
        ЗапросСКД.УстановитьПараметр("НачалоПериода", ДатаНачало);
        ЗапросСКД.УстановитьПараметр("КонецПериода", ДатаКонец);
        
        Если ЗначениеЗаполнено(ЧисловойИНН) Тогда
            ЗапросСКД.УстановитьПараметр("ИНН", ЧисловойИНН);
        КонецЕсли;
        
        Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
            ЗапросСКД.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
        КонецЕсли;
        
        Если ЭтоКуратор Тогда
            ЗапросСКД.УстановитьПараметр("Куратор", Менеджер.Ссылка);
            Если ЗначениеЗаполнено(МПСсылка) Тогда
                ЗапросСКД.УстановитьПараметр("МП", МПСсылка);
            КонецЕсли;
        Иначе
            ЗапросСКД.УстановитьПараметр("Менеджер", Менеджер.Ссылка);
        КонецЕсли;
        
        МенеджерСсылка = Менеджер.Ссылка;

        // Логирование примененного фильтра
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            СтрШаблон("Примененный фильтр: Менеджер=%1, ЭтоКуратор=%2, МП=%3, ИНН=%4, Номенклатура=%5",
                Строка(МенеджерСсылка), ЭтоКуратор, ?(ЗначениеЗаполнено(МПСсылка), Строка(МПСсылка), МП), ИНН, ?(ЗначениеЗаполнено(НоменклатураСсылка), Строка(НоменклатураСсылка), Номенклатура))
        );

        // Логирование параметров СКД
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            СтрШаблон("Параметры СКД: НачалоПериода=%1, КонецПериода=%2, ИНН=%3, Номенклатура=%4, МП=%5, Менеджер=%6, Куратор=%7",
                Формат(ДатаНачало, "ДФ=yyyy-MM-dd"),
                Формат(ДатаКонец, "ДФ=yyyy-MM-dd"),
                ?(ЗначениеЗаполнено(ЧисловойИНН), ЧисловойИНН, ""),
                ?(ЗначениеЗаполнено(НоменклатураСсылка), Строка(НоменклатураСсылка), ""),
                ?(ЗначениеЗаполнено(МПСсылка), Строка(МПСсылка), МП),
                ?(НЕ ЭтоКуратор, Строка(МенеджерСсылка), ""),
                ?(ЭтоКуратор, Строка(МенеджерСсылка), ""))
        );
        
        // Проверка количества записей в регистре
        ЗапросПроверки = Новый Запрос;
        ЗапросПроверки.Текст = 
        "ВЫБРАТЬ
        |    КОЛИЧЕСТВО(*) КАК Количество
        |ИЗ
        |    РегистрСведений.ПланыПродажРС КАК ПланыПродажРС
        |ГДЕ
        |    ПланыПродажРС.Период МЕЖДУ &НачалоПериода И &КонецПериода";
        ЗапросПроверки.УстановитьПараметр("НачалоПериода", ДатаНачало);
        ЗапросПроверки.УстановитьПараметр("КонецПериода", ДатаКонец);
        РезультатПроверки = ЗапросПроверки.Выполнить();
        ВыборкаПроверки = РезультатПроверки.Выбрать();
        Если ВыборкаПроверки.Следующий() Тогда
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Информация,
                ,
                ,
                "Количество записей в ПланыПродажРС за период: " + ВыборкаПроверки.Количество
            );
        КонецЕсли;
        
        // Выполнение запроса
        Результат = ЗапросСКД.Выполнить();
        
        // Проверка на пустой результат
        Если Результат.Пустой() Тогда
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Информация,
                ,
                ,
                "Запрос вернул пустой результат"
            );
            Ответ = Новый HTTPСервисОтвет(200);
            Ответ.Заголовки.Insert("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("[]");
            Возврат Ответ;
        КонецЕсли;
        
        // Логирование успешного выполнения запроса
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Запрос выполнен успешно, формирование ответа"
        );
        
        // Формирование JSON-ответа
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        
        МассивРезультат = Новый Массив;
        
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            СтрокаРезультата = Новый Структура;
            СтрокаРезультата.Insert("Контрагенты", ?(ЗначениеЗаполнено(Выборка.Контрагенты), Строка(Выборка.Контрагенты), ""));
            СтрокаРезультата.Insert("Менеджер", ?(ЗначениеЗаполнено(Выборка.Менеджер), Строка(Выборка.Менеджер), ""));
            СтрокаРезультата.Insert("Номенклатура", ?(ЗначениеЗаполнено(Выборка.Номенклатура), Строка(Выборка.Номенклатура), ""));
            СтрокаРезультата.Insert("Количество", ?(Выборка.Количество = NULL, 0, Выборка.Количество));
            СтрокаРезультата.Insert("Сумма", ?(Выборка.Сумма = NULL, 0, Выборка.Сумма));
            СтрокаРезультата.Insert("ФактКоличество", ?(Выборка.ФактКоличество = NULL, 0, Выборка.ФактКоличество));
            СтрокаРезультата.Insert("ФактСумма", ?(Выборка.ФактСумма = NULL, 0, Выборка.ФактСумма));
            СтрокаРезультата.Insert("ВыполнениеКолво", ?(Выборка.ВыполнениеКолво = NULL, 0, Выборка.ВыполнениеКолво));
            СтрокаРезультата.Insert("ВыполнениеСумма", ?(Выборка.ВыполнениеСумма = NULL, 0, Выборка.ВыполнениеСумма));
            СтрокаРезультата.Insert("ОбщееВыполнение", ?(Выборка.ОбщееВыполнение = NULL, 0, Выборка.ОбщееВыполнение));
            МассивРезультат.Add(СтрокаРезультата);
        КонецЦикла;
        
        ЗаписатьJSON(ЗаписьJSON, МассивРезультат);
        
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Insert("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
        
        // Логирование успешного ответа
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Ответ успешно отправлен"
        );
        
        Возврат Ответ;
        
    Исключение
        // Логирование ошибки
        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Ошибка при обработке запроса: " + ТекстОшибки
        );
        
        Возврат ОтветОшибка(ТекстОшибки);
    КонецПопытки;
    
КонецФункции

// Функция для преобразования строки формата ГГГГ-ММ-ДД в дату
Функция СтрокаВДату(Знач СтрокаДата) Экспорт
    // Объявление переменной
    Перем ЧастиДаты;
    
    Если НЕ ЗначениеЗаполнено(СтрокаДата) Тогда
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Пустая строка даты"
        );
        ВызватьИсключение "Пустая строка даты";
    КонецЕсли;
    
    // Очистка строки от пробелов и невидимых символов
    СтрокаДата = СокрЛП(СтрокаДата);
    
    // Логирование входной строки
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Преобразование строки даты: " + СтрокаДата
    );
    
    // Проверка формата ГГГГ-ММ-ДД
    ЧастиДаты = СтрРазделить(СтрокаДата, "-");
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Части даты: " + СтрСоединить(ЧастиДаты, ", ")
    );
    
    Если ЧастиДаты.Количество() <> 3 Тогда
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Неверный формат даты: ожидается ГГГГ-ММ-ДД, получено: " + СтрокаДата
        );
        ВызватьИсключение "Неверный формат даты: ожидается ГГГГ-ММ-ДД, получено: " + СтрокаДата;
    КонецЕсли;
    
    Попытка
        Год = Число(СокрЛП(ЧастиДаты[0]));
        Месяц = Число(СокрЛП(ЧастиДаты[1]));
        День = Число(СокрЛП(ЧастиДаты[2]));
        
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            СтрШаблон("Числовые значения: Год=%1, Месяц=%2, День=%3", Год, Месяц, День)
        );
        
        // Проверка корректности значений
        Если Год < 1900 Или Год > 9999 Тогда
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ,
                "Недопустимый год: " + Год
            );
            ВызватьИсключение "Недопустимый год: " + Год;
        КонецЕсли;
        Если Месяц < 1 Или Месяц > 12 Тогда
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ,
                "Недопустимый месяц: " + Месяц
            );
            ВызватьИсключение "Недопустимый месяц: " + Месяц;
        КонецЕсли;
        Если День < 1 Или День > 31 Тогда
            ЗаписьЖурналаРегистрации(
                "HTTPСервис.PlanOtchet",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ,
                "Недопустимый день: " + День
            );
            ВызватьИсключение "Недопустимый день: " + День;
        КонецЕсли;
        
        Результат = Дата(Год, Месяц, День);
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Дата успешно сформирована: " + Формат(Результат, "ДФ=yyyy-MM-dd")
        );
    Исключение
        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Ошибка преобразования даты: " + СтрокаДата + ", Подробности: " + ТекстОшибки
        );
        ВызватьИсключение "Ошибка преобразования даты: " + СтрокаДата + ", Подробности: " + ТекстОшибки;
    КонецПопытки;
    
    Возврат Результат;
КонецФункции

// Функция для получения менеджера по TelegramID
Функция ПолучитьМенеджераПоTelegramID(TelegramID) Экспорт
    
    // Логирование
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Поиск менеджера по TelegramID: " + TelegramID
    );
    
    // Логирование проверки типа TelegramID
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Тип TelegramID: " + ТипЗнч(TelegramID)
    );
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    Менеджер.Ссылка КАК Ссылка,
    |    Менеджер.TelegramIDM,
    |    Менеджер.TelegramIDK
    |ИЗ
    |    Справочник.Менеджер КАК Менеджер
    |ГДЕ
    |    Менеджер.TelegramIDM = &TelegramID";
    
    // Логирование текста запроса
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Текст запроса: " + Запрос.Текст
    );
    
    Запрос.УстановитьПараметр("TelegramID", TelegramID);
    
    // Логирование значения параметра
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Значение параметра TelegramID: " + TelegramID
    );
    
    Результат = Запрос.Выполнить();
    
    // Логирование результата запроса
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Результат запроса пустой: " + Результат.Пустой()
    );
    
    Если Результат.Пустой() Тогда
        ТекстОшибки = "Пользователь с указанным TelegramID не найден";
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.PlanOtchet",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            ТекстОшибки
        );
        ВызватьИсключение ТекстОшибки;
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    
    // Логирование успешного поиска
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Менеджер найден: " + Выборка.Ссылка
    );
    
    Возврат Выборка;
КонецФункции

// Функция для формирования ответа с ошибкой
Функция ОтветОшибка(ТекстОшибки) Экспорт
    Ответ = Новый HTTPСервисОтвет(400);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    
    СтруктураОшибки = Новый Структура;
    СтруктураОшибки.Insert("error", ТекстОшибки);
    
    ЗаписатьJSON(ЗаписьJSON, СтруктураОшибки);
    
    Ответ.Заголовки.Insert("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
    
    // Логирование ошибки в ответе
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.PlanOtchet",
        УровеньЖурналаРегистрации.Ошибка,
        ,
        ,
        "Отправлен ответ с ошибкой: " + ТекстОшибки
    );
    
    Возврат Ответ;
КонецФункции