Функция PlanProdajPlaniProdaj(Запрос)
    
    // Логирование в журнал регистрации
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Начало обработки запроса");
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Базовый URL: " + Запрос.БазовыйURL);
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Метод: " + Запрос.HTTPМетод);
    Для Каждого Заголовок Из Запрос.Заголовки Цикл
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Заголовок: " + Заголовок.Ключ + " = " + Заголовок.Значение);
    КонецЦикла;
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Тело запроса: " + Запрос.ПолучитьТелоКакСтроку());
    
    // Проверка пути запроса (только базовый путь /plans)
    ОжидаемыйБазовыйПуть = "/plans"; // Базовый путь сервиса
    ТекущийБазовыйПуть = Запрос.БазовыйURL;
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Ожидаемый базовый путь: " + ОжидаемыйБазовыйПуть);
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Текущий базовый путь: " + ТекущийБазовыйПуть);
    
    // Проверка совпадения базового пути
    Если СтрНайти(ТекущийБазовыйПуть, ОжидаемыйБазовыйПуть) = 0 Тогда
        Ответ = Новый HTTPСервисОтвет(404);
        Ответ.УстановитьТелоИзСтроки(ПолучитьСтрокуJSON(Новый Структура("Статус", "Ресурс не найден")));
        Ответ.Заголовки["Content-Type"] = "application/json";
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка: Ресурс не найден. Базовый путь: " + ТекущийБазовыйПуть);
        Возврат Ответ;
    КонецЕсли;
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Проверка пути пройдена успешно.");
    
    // Чтение тела запроса (JSON)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Чтение тела запроса...");
    Попытка
        ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
        ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON, Истина);
        ЧтениеJSON.Закрыть();
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Данные запроса: " + ПолучитьСтрокуJSON(ДанныеЗапроса));
    Исключение
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки(ПолучитьСтрокуJSON(Новый Структура("Статус, ОписаниеОшибки", "Ошибка", "Некорректный формат JSON: " + ОписаниеОшибки())));
        Ответ.Заголовки["Content-Type"] = "application/json";
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при чтении JSON: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
    
    // Создание нового документа
    НовыйДокумент = Документы.ПланыПродаж.СоздатьДокумент();
    ТекущаяДатаДокумента = ТекущаяДата(); // Явно задаем текущую дату
    НовыйДокумент.Дата = ТекущаяДатаДокумента;
    Период = НачалоМесяца(ТекущаяДатаДокумента); // Устанавливаем период как переменную
    НовыйДокумент.Период = Период;
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Создан новый документ. Дата: " + НовыйДокумент.Дата + ", Период: " + НовыйДокумент.Период);
    
    // Заполнение МП и Куратора по TelegramID
    TelegramIDM = ДанныеЗапроса["TelegramID"];
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "TelegramIDM: " + TelegramIDM);
    
    ЗапросМенеджер = Новый Запрос;
    ЗапросМенеджер.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |	Менеджер.Ссылка КАК Ссылка,
    |	Менеджер.Куратор КАК Куратор
    |ИЗ
    |	Справочник.Менеджер КАК Менеджер
    |ГДЕ
    |	Менеджер.TelegramIDM = &TelegramIDM";
    ЗапросМенеджер.УстановитьПараметр("TelegramIDM", TelegramIDM);
    Результат = ЗапросМенеджер.Выполнить();
    Выборка = Результат.Выбрать();
    Если Выборка.Следующий() Тогда
        НовыйДокумент.МП = Выборка.Ссылка;
        НовыйДокумент.Куратор = Выборка.Куратор;
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Менеджер найден: " + НовыйДокумент.МП + ", Куратор: " + НовыйДокумент.Куратор);
    Иначе
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки(ПолучитьСтрокуJSON(Новый Структура("Статус, ОписаниеОшибки", "Ошибка", "Менеджер с TelegramID " + TelegramIDM + " не найден")));
        Ответ.Заголовки["Content-Type"] = "application/json";
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка: Менеджер с TelegramID " + TelegramIDM + " не найден.");
        Возврат Ответ;
    КонецЕсли;
    
    // Проверка ИНН аптеки
    ИННСтрокой = СокрЛП(Строка(ДанныеЗапроса["INN"])); // Получаем строку
    ИННЧисло = ?(ПустаяСтрока(ИННСтрокой), 0, Число(ИННСтрокой)); // Преобразуем в число, если возможно
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "ИНН из запроса (строка): " + ИННСтрокой + ", Число: " + Формат(ИННЧисло, "ЧГ=0"));
    ЗапросКонтрагент = Новый Запрос;
    ЗапросКонтрагент.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |	Контрагенты.Ссылка КАК Ссылка,
    |	Контрагенты.ИНН КАК ИНН_ИзБазы
    |ИЗ
    |	Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |	ВЫРАЗИТЬ(Контрагенты.ИНН КАК ЧИСЛО) = &ИНН";
    ЗапросКонтрагент.УстановитьПараметр("ИНН", ИННЧисло);
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Текст запроса к Контрагенты: " + ЗапросКонтрагент.Текст);
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Параметр ИНН: " + ИННЧисло);
    Попытка
        РезультатКонтрагент = ЗапросКонтрагент.Выполнить();
        ВыборкаКонтрагент = РезультатКонтрагент.Выбрать();
        Если ВыборкаКонтрагент.Следующий() Тогда
            НовыйДокумент.Аптека = ВыборкаКонтрагент.Ссылка;
            ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Аптека найдена: " + НовыйДокумент.Аптека + " (ИНН из базы: " + ВыборкаКонтрагент.ИНН_ИзБазы + ")");
        Иначе
            НовыйДокумент.Примечание = "ИНН: " + ИННСтрокой + " не найден в справочнике";
            ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Аптека не найдена, добавлено в Примечание: " + НовыйДокумент.Примечание);
        КонецЕсли;
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки(ПолучитьСтрокуJSON(Новый Структура("Статус, ОписаниеОшибки", "Ошибка", "Ошибка при выполнении запроса к Контрагенты: " + ОписаниеОшибки())));
        Ответ.Заголовки["Content-Type"] = "application/json";
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при выполнении запроса к Контрагенты: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
    
    // Заполнение табличной части с расчетом цены и суммы
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Заполнение табличной части...");
    Для Каждого СтрокаНоменклатуры Из ДанныеЗапроса["ТабличнаяЧасть"] Цикл
        НоваяСтрока = НовыйДокумент.Табдок.Добавить();
        НоваяСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаНоменклатуры["Номенклатура"], Истина);
        НоваяСтрока.Количество = СтрокаНоменклатуры["Количество"];
        
        // Расчет цены из регистра сведений Прайсы
        ЗапросЦена = Новый Запрос;
        ЗапросЦена.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |	Прайсы.Цена КАК Цена
        |ИЗ
        |	РегистрСведений.Прайсы КАК Прайсы
        |ГДЕ
        |	Прайсы.Номенклатура = &Номенклатура
        |	И Прайсы.УсловиеОплаты = &УсловиеОплаты";
        ЗапросЦена.УстановитьПараметр("Номенклатура", НоваяСтрока.Номенклатура);
        ЗапросЦена.УстановитьПараметр("УсловиеОплаты", "ЭлликБешФоиз");
        РезультатЦена = ЗапросЦена.Выполнить();
        ВыборкаЦена = РезультатЦена.Выбрать();
        Если ВыборкаЦена.Следующий() Тогда
            НоваяСтрока.Цена = ВыборкаЦена.Цена;
            НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
            ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Для номенклатуры " + НоваяСтрока.Номенклатура + " установлена Цена: " + НоваяСтрока.Цена + ", Сумма: " + НоваяСтрока.Сумма);
        Иначе
            НоваяСтрока.Цена = 0;
            НоваяСтрока.Сумма = 0;
            ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Предупреждение, , , "Для номенклатуры " + НоваяСтрока.Номенклатура + " цена не найдена, установлено 0.");
        КонецЕсли;
        
        // Проверка заполнения номенклатуры
        Если Не ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки(ПолучитьСтрокуJSON(Новый Структура("Статус, ОписаниеОшибки", "Ошибка", "Номенклатура с наименованием " + СтрокаНоменклатуры["Номенклатура"] + " не найдена")));
            Ответ.Заголовки["Content-Type"] = "application/json";
            ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка: Номенклатура " + СтрокаНоменклатуры["Номенклатура"] + " не найдена.");
            Возврат Ответ;
        КонецЕсли;
    КонецЦикла;
    
    // Проверка существования записи в регистре перед проведением
    ПериодДляПроверки = Период; // Используем переменную Период
    МП = НовыйДокумент.МП;
    Куратор = НовыйДокумент.Куратор;
    Аптека = НовыйДокумент.Аптека;
    Для Каждого СтрокаТабдок Из НовыйДокумент.Табдок Цикл
        ЗапросПроверка = Новый Запрос;
        ЗапросПроверка.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |	ПланыПродажРС.Количество
        |ИЗ
        |	РегистрСведений.ПланыПродажРС КАК ПланыПродажРС
        |ГДЕ
        |	ПланыПродажРС.Период = &Период
        |	И ПланыПродажРС.Месяц = &Месяц
        |	И (ПланыПродажРС.Аптека = &Аптека ИЛИ ПланыПродажРС.Аптека ЕСТЬ NULL)
        |	И ПланыПродажРС.МП = &МП
        |	И ПланыПродажРС.Куратор = &Куратор
        |	И ПланыПродажРС.Номенклатура = &Номенклатура";
        ЗапросПроверка.УстановитьПараметр("Период", ПериодДляПроверки);
        ЗапросПроверка.УстановитьПараметр("Месяц", ПериодДляПроверки);
        ЗапросПроверка.УстановитьПараметр("Аптека", Аптека);
        ЗапросПроверка.УстановитьПараметр("МП", МП);
        ЗапросПроверка.УстановитьПараметр("Куратор", Куратор);
        ЗапросПроверка.УстановитьПараметр("Номенклатура", СтрокаТабдок.Номенклатура);
        РезультатПроверка = ЗапросПроверка.Выполнить();
        Если Не РезультатПроверка.Пустой() Тогда
            // Логика обновления вместо ошибки (увеличение количества)
            Нз = РегистрыСведений.ПланыПродажРС.СоздатьНаборЗаписей();
            Нз.Отбор.Период.Установить(ПериодДляПроверки);
            Нз.Отбор.Месяц.Установить(ПериодДляПроверки);
            Нз.Отбор.Аптека.Установить(Аптека);
            Нз.Отбор.МП.Установить(МП);
            Нз.Отбор.Куратор.Установить(Куратор);
            Нз.Отбор.Номенклатура.Установить(СтрокаТабдок.Номенклатура);
            Нз.Прочитать();
            Если Нз.Количество() > 0 Тогда
                Для Каждого Запись Из Нз Цикл
                    Запись.Количество = Запись.Количество + СтрокаТабдок.Количество;
                    Запись.Сумма = Запись.Количество * СтрокаТабдок.Цена; // Обновляем сумму
                КонецЦикла;
                Нз.Записать(Истина); // Перезаписываем с контролем
                ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Обновлено количество для номенклатуры " + СтрокаТабдок.Номенклатура + " на " + СтрокаТабдок.Количество);
            КонецЕсли;
            Продолжить; // Пропускаем создание новой записи
        КонецЕсли;
    КонецЦикла;
    
    // Запись и проведение документа
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Попытка записи и проведения документа...");
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Дата перед записью: " + НовыйДокумент.Дата);
    Попытка
        НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.УстановитьТелоИзСтроки(ПолучитьСтрокуJSON(Новый Структура("Статус", "Успешно", "Документ", НовыйДокумент.Ссылка.УникальныйИдентификатор())));
        Ответ.Заголовки["Content-Type"] = "application/json";
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "Документ успешно проведен. ID: " + НовыйДокумент.Ссылка.УникальныйИдентификатор());
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки(ПолучитьСтрокуJSON(Новый Структура("Статус, ОписаниеОшибки", "Ошибка", ОписаниеОшибки())));
        Ответ.Заголовки["Content-Type"] = "application/json";
        ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при проведении: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
    
    // Возвращение ответа
    ЗаписьЖурналаРегистрации("Обработка HTTP-запроса", УровеньЖурналаРегистрации.Информация, , , "=== Завершение обработки запроса ===");
    Возврат Ответ;
    
КонецФункции

// Вспомогательная функция для преобразования в JSON
Функция ПолучитьСтрокуJSON(Данные)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.ПроверятьСтруктуру = Ложь;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции