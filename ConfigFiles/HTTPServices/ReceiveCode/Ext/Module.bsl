Функция ReceiveCodePOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);

    Попытка
        // Получаем тело запроса
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
        ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
            УровеньЖурналаРегистрации.Информация, 
            , 
            , 
            "Тело запроса: " + ТелоЗапроса);

        // Проверка на пустоту
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                УровеньЖурналаРегистрации.Ошибка, 
                , 
                , 
                "Ошибка: Пустое тело запроса");
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Пустое тело запроса");
            Возврат Ответ;
        КонецЕсли;

        // Базовая проверка формата JSON
        Если Не (Лев(СокрЛП(ТелоЗапроса), 1) = "{" И Прав(СокрЛП(ТелоЗапроса), 1) = "}") Тогда
            ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                УровеньЖурналаРегистрации.Ошибка, 
                , 
                , 
                "Ошибка: Некорректный формат JSON");
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Некорректный формат JSON");
            Возврат Ответ;
        КонецЕсли;

        // Извлекаем поля
        КодМаркировки = ИзвлечьЗначениеПоля(ТелоЗапроса, "code");
        Фамилия = ИзвлечьЗначениеПоля(ТелоЗапроса, "surname");
        Имя = ИзвлечьЗначениеПоля(ТелоЗапроса, "name");
        Телефон = ИзвлечьЗначениеПоля(ТелоЗапроса, "phone");
        Аптека = ИзвлечьЗначениеПоля(ТелоЗапроса, "pharmacy");
        Адрес = ИзвлечьЗначениеПоля(ТелоЗапроса, "address");
        
        // Логируем извлеченные поля
        ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
            УровеньЖурналаРегистрации.Информация, 
            , 
            , 
            "Извлеченные данные: Код=" + КодМаркировки + 
            ", Фамилия=" + Фамилия + 
            ", Имя=" + Имя + 
            ", Телефон=" + Телефон + 
            ", Аптека=" + Аптека + 
            ", Адрес=" + Адрес);

        // Проверка обязательных полей
        Если ПустаяСтрока(КодМаркировки) Или ПустаяСтрока(Телефон) Тогда
            ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                УровеньЖурналаРегистрации.Ошибка, 
                , 
                , 
                "Ошибка: Код маркировки и телефон обязательны");
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Код маркировки и телефон обязательны");
            Возврат Ответ;
        КонецЕсли;

        // Поиск продавца по номеру телефона
        Продавец = Справочники.Продавцы.ПустаяСсылка();
        Если Не ПустаяСтрока(Телефон) Тогда
            ЗапросПродавца = Новый Запрос;
            ЗапросПродавца.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   Продавцы.Ссылка КАК Ссылка
                |ИЗ
                |   Справочник.Продавцы КАК Продавцы
                |ГДЕ
                |   Продавцы.НомерТелефона = &НомерТелефона";
            ЗапросПродавца.УстановитьПараметр("НомерТелефона", Телефон);
            РезультатПродавца = ЗапросПродавца.Выполнить();
            
            Если НЕ РезультатПродавца.Пустой() Тогда
                ВыборкаПродавца = РезультатПродавца.Выбрать();
                ВыборкаПродавца.Следующий();
                Продавец = ВыборкаПродавца.Ссылка;
                ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                    УровеньЖурналаРегистрации.Информация, 
                    , 
                    , 
                    "Найден продавец: " + Продавец + " для телефона: " + Телефон);
            Иначе
                ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                    УровеньЖурналаРегистрации.Информация, 
                    , 
                    , 
                    "Продавец не найден для телефона: " + Телефон);
            КонецЕсли;
        КонецЕсли;

        // Очистка кода от символа GS и пробелов
        КодМаркировки = СтрЗаменить(КодМаркировки, Символ(29), "");
        Если СтрНайти(КодМаркировки, " ") > 0 Тогда
            КодМаркировки = Лев(КодМаркировки, СтрНайти(КодМаркировки, " ") - 1);
        КонецЕсли;

        // Извлекаем "чистый" код без суффикса +НомерДокумента
        ПозицияПлюса = СтрНайти(КодМаркировки, "+");
        ЧистыйКод = ?(ПозицияПлюса > 0, Лев(КодМаркировки, ПозицияПлюса - 1), КодМаркировки);

        // Проверка уникальности комбинации КодМаркировки + Телефон
        ЗапросУникальности = Новый Запрос;
        ЗапросУникальности.Текст = 
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   ПринятыйКодМаркировки.Ссылка КАК Документ
            |ИЗ
            |   Документ.ПринятыйКодМаркировки КАК ПринятыйКодМаркировки
            |ГДЕ
            |   (ПринятыйКодМаркировки.КодМаркировки ПОДОБНО &ЧистыйКод + ""%"" 
            |       ИЛИ ПринятыйКодМаркировки.КодМаркировки = &ЧистыйКод)
            |   И ПринятыйКодМаркировки.Телефон = &Телефон";
        ЗапросУникальности.УстановитьПараметр("ЧистыйКод", ЧистыйКод);
        ЗапросУникальности.УстановитьПараметр("Телефон", Телефон);
        РезультатУникальности = ЗапросУникальности.Выполнить();

        Если НЕ РезультатУникальности.Пустой() Тогда
            ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                УровеньЖурналаРегистрации.Ошибка, 
                , 
                , 
                "Ошибка: Код " + ЧистыйКод + " уже был отправлен пользователем с телефоном " + Телефон);
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Этот код уже был отправлен вами");
            Возврат Ответ;
        КонецЕсли;

        // Поиск номенклатуры в регистре КодыМаркировкиРеализаций
        ЗапросНоменклатуры = Новый Запрос;
        ЗапросНоменклатуры.Текст = 
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   КодыМаркировкиРеализаций.Номенклатура КАК Номенклатура
            |ИЗ
            |   РегистрСведений.КодыМаркировкиРеализаций КАК КодыМаркировкиРеализаций
            |ГДЕ
            |   КодыМаркировкиРеализаций.КодМаркировки = &ЧистыйКод";
        ЗапросНоменклатуры.УстановитьПараметр("ЧистыйКод", ЧистыйКод);
        
        РезультатНоменклатуры = ЗапросНоменклатуры.Выполнить();
        
        Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
        
        Если НЕ РезультатНоменклатуры.Пустой() Тогда
            Выборка = РезультатНоменклатуры.Выбрать();
            Выборка.Следующий();
            Номенклатура = Выборка.Номенклатура;
        Иначе
            ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                УровеньЖурналаРегистрации.Информация, 
                , 
                , 
                "Номенклатура не найдена для кода: " + ЧистыйКод);
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Данный товар не найден в базе");
            Возврат Ответ;
        КонецЕсли;

        // Проверка в регистре УникальныеКодыМаркировки
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |   УникальныеКодыМаркировки.Статус,
            |   УникальныеКодыМаркировки.Документ,
            |   УникальныеКодыМаркировки.КодМаркировки,
            |   УникальныеКодыМаркировки.Телефон,
            |   КОЛИЧЕСТВО(РАЗЛИЧНЫЕ УникальныеКодыМаркировки.Документ) КАК КоличествоДокументов
            |ИЗ
            |   РегистрСведений.УникальныеКодыМаркировки КАК УникальныеКодыМаркировки
            |ГДЕ
            |   (УникальныеКодыМаркировки.КодМаркировки ПОДОБНО &ЧистыйКод + ""%"" 
            |   ИЛИ УникальныеКодыМаркировки.КодМаркировки = &ЧистыйКод)
            |СГРУППИРОВАТЬ ПО
            |   УникальныеКодыМаркировки.Статус,
            |   УникальныеКодыМаркировки.Документ,
            |   УникальныеКодыМаркировки.КодМаркировки,
            |   УникальныеКодыМаркировки.Телефон";
        Запрос.УстановитьПараметр("ЧистыйКод", ЧистыйКод);
        Результат = Запрос.Выполнить();

        // Создаем новый документ
        Док = Документы.ПринятыйКодМаркировки.СоздатьДокумент();
        Док.Дата = ТекущаяДата();
        Док.КодМаркировки = ЧистыйКод;
        Док.Номенклатура = Номенклатура;
        Док.Фамилия = Фамилия;
        Док.Имя = Имя;
        Док.Телефон = Телефон;
        Док.Аптека = Аптека;
        Док.Адрес = Адрес;
        Док.Продавец = Продавец; // Заполняем реквизит Продавец
        Док.ПользовательИдентификатор = Телефон;
        Док.ДатаОтправки = ТекущаяДата();
        Док.Бонус = АптекаБонуси.АптекагаБонусОламиз(ТекущаяДата(), Номенклатура);

        // Записываем документ, чтобы получить номер
        Док.Записать(РежимЗаписиДокумента.Запись);

        Если Не Результат.Пустой() Тогда
            Выборка = Результат.Выбрать();
            КоличествоЗаписей = 0;
            ЕстьОжидание = Ложь;
            ЕстьПодтвержденный = Ложь;
            ЕстьОтклоненные = Ложь;
            ЕстьКонфликтный = Ложь;
            ДокументОжидание = Неопределено;
            КодОжидание = "";
            ТелефонОжидание = "";

            // Анализируем записи
            Пока Выборка.Следующий() Цикл
                КоличествоЗаписей = Выборка.КоличествоДокументов;
                Если Выборка.Статус = Перечисления.Статус.Ожидание Тогда
                    ЕстьОжидание = Истина;
                    ДокументОжидание = Выборка.Документ;
                    КодОжидание = Выборка.КодМаркировки;
                    ТелефонОжидание = Выборка.Телефон;
                ИначеЕсли Выборка.Статус = Перечисления.Статус.Подтвержденный Тогда
                    ЕстьПодтвержденный = Истина;
                ИначеЕсли Выборка.Статус = Перечисления.Статус.Отклоненные Тогда
                    ЕстьОтклоненные = Истина;
                ИначеЕсли Выборка.Статус = Перечисления.Статус.Конфликтный Тогда
                    ЕстьКонфликтный = Истина;
                КонецЕсли;
            КонецЦикла;

            // Сценарий 1: Код в статусе Ожидание (второе сканирование)
            Если ЕстьОжидание И Не ЕстьПодтвержденный И Не ЕстьКонфликтный И КоличествоЗаписей = 1 Тогда
                // Проверяем, не является ли это повторной отправкой от того же пользователя
                Если ТелефонОжидание = Телефон Тогда
                    ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                        УровеньЖурналаРегистрации.Ошибка, 
                        , 
                        , 
                        "Ошибка: Код " + ЧистыйКод + " уже зарегистрирован этим пользователем (телефон: " + Телефон + ")");
                    Ответ = Новый HTTPСервисОтвет(400);
                    Ответ.УстановитьТелоИзСтроки("Ошибка: Этот код уже был отправлен вами");
                    Возврат Ответ;
                КонецЕсли;

                Док.Статус = Перечисления.Статус.Конфликтный;
                Док.КодМаркировки = ЧистыйКод;
                Попытка
                    // Проводим новый документ
                    Док.Записать(РежимЗаписиДокумента.Проведение);
                    ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                        УровеньЖурналаРегистрации.Информация, 
                        , 
                        , 
                        "Новый документ проведён: Код=" + Док.КодМаркировки + 
                        ", Статус=Конфликтный");

                    // Изменяем существующий документ
                    ДокОжидание = ДокументОжидание.ПолучитьОбъект();
                    ДокОжидание.Статус = Перечисления.Статус.Конфликтный;
                    ДокОжидание.КодМаркировки = ЧистыйКод;
                    ДокОжидание.Записать(РежимЗаписиДокумента.Проведение);
                    ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                        УровеньЖурналаРегистрации.Информация, 
                        , 
                        , 
                        "Существующий документ изменён и проведён: Код=" + ДокОжидание.КодМаркировки + 
                        ", Статус=Конфликтный, Документ=" + ДокументОжидание);

                    Ответ = Новый HTTPСервисОтвет(400);
                    Ответ.УстановитьТелоИзСтроки("Ваш код находится в списке конфликтных кодов");
                    Возврат Ответ;
                Исключение
                    ОписаниеОшибкиТекст = ОписаниеОшибки();
                    ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                        УровеньЖурналаРегистрации.Ошибка, 
                        , 
                        , 
                        "Ошибка при записи документов: " + ОписаниеОшибкиТекст);
                    Ответ = Новый HTTPСервисОтвет(500);
                    Ответ.УстановитьТелоИзСтроки("Ошибка сервера при записи документа: " + ОписаниеОшибкиТекст);
                    Возврат Ответ;
                КонецПопытки;

            // Сценарий 2: Код в статусе Подтвержденный
            ИначеЕсли ЕстьПодтвержденный Тогда
                Док.Статус = Перечисления.Статус.Отклоненные;
                Док.КодМаркировки = ЧистыйКод;
                Попытка
                    Док.Записать(РежимЗаписиДокумента.Проведение);
                    ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                        УровеньЖурналаРегистрации.Информация, 
                        , 
                        , 
                        "Новый документ проведён: Код=" + Док.КодМаркировки + 
                        ", Статус=Отклоненные, Причина: Код подтверждён");
                    Ответ = Новый HTTPСервисОтвет(400);
                    Ответ.УстановитьТелоИзСтроки("Этот код уже зарегистрирован");
                    Возврат Ответ;
                Исключение
                    ОписаниеОшибкиТекст = ОписаниеОшибки();
                    ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                        УровеньЖурналаРегистрации.Ошибка, 
                        , 
                        , 
                        "Ошибка при записи документа: " + ОписаниеОшибкиТекст);
                    Ответ = Новый HTTPСервисОтвет(500);
                    Ответ.УстановитьТелоИзСтроки("Ошибка сервера при записи документа: " + ОписаниеОшибкиТекст);
                    Возврат Ответ;
                КонецПопытки;

            // Сценарий 3: Код в статусе Отклоненные, Конфликтный или несколько записей
            ИначеЕсли ЕстьОтклоненные Или ЕстьКонфликтный Или КоличествоЗаписей > 1 Тогда
                Док.Статус = Перечисления.Статус.Конфликтный;
                Док.КодМаркировки = ЧистыйКод;
                Попытка
                    Док.Записать(РежимЗаписиДокумента.Проведение);
                    ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                        УровеньЖурналаРегистрации.Информация, 
                        , 
                        , 
                        "Новый документ проведён: Код=" + Док.КодМаркировки + 
                        ", Статус=Конфликтный, Причина: Код отклонён, конфликтный или имеет несколько записей");
                    Ответ = Новый HTTPСервисОтвет(400);
                    Ответ.УстановитьТелоИзСтроки("Ваш код находится в списке конфликтных кодов");
                    Возврат Ответ;
                Исключение
                    ОписаниеОшибкиТекст = ОписаниеОшибки();
                    ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                        УровеньЖурналаРегистрации.Ошибка, 
                        , 
                        , 
                        "Ошибка при записи документа: " + ОписаниеОшибкиТекст);
                    Ответ = Новый HTTPСервисОтвет(500);
                    Ответ.УстановитьТелоИзСтроки("Ошибка сервера при записи документа: " + ОписаниеОшибкиТекст);
                    Возврат Ответ;
                КонецПопытки;
            КонецЕсли;
        КонецЕсли;

        // Сценарий 4: Код отсутствует в регистре
        Док.Статус = Перечисления.Статус.Ожидание;
        Док.КодМаркировки = ЧистыйКод;
        Попытка
            Док.Записать(РежимЗаписиДокумента.Проведение);
            ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                УровеньЖурналаРегистрации.Информация, 
                , 
                , 
                "Документ проведён: Код=" + Док.КодМаркировки + ", Статус=" + Строка(Док.Статус));
            Ответ.УстановитьТелоИзСтроки("Код успешно отправлен для проверки");
        Исключение
            ОписаниеОшибкиТекст = ОписаниеОшибки();
            ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                УровеньЖурналаРегистрации.Ошибка, 
                , 
                , 
                "Ошибка при записи/проведении документа: " + ОписаниеОшибкиТекст);
            Ответ = Новый HTTPСервисОтвет(500);
            Ответ.УстановитьТелоИзСтроки("Ошибка сервера при записи документа: " + ОписаниеОшибкиТекст);
            Возврат Ответ;
        КонецПопытки;

    Исключение
        ОписаниеОшибкиТекст = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
            УровеньЖурналаРегистрации.Ошибка, 
            , 
            , 
            "Ошибка обработки запроса: " + ОписаниеОшибкиТекст);
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка сервера: " + ОписаниеОшибкиТекст);
    КонецПопытки;

    Возврат Ответ;
КонецФункции

Функция ИзвлечьЗначениеПоля(СтрокаJSON, ИмяПоля)
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
        Если Данные.Свойство(ИмяПоля) Тогда
            Значение = Данные[ИмяПоля];
            Если ТипЗнч(Значение) = Тип("Строка") Тогда
                Возврат СокрЛП(Значение);
            Иначе
                Возврат Строка(Значение);
            КонецЕсли;
        Иначе
            ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
                УровеньЖурналаРегистрации.Предупреждение, 
                , 
                , 
                "Поле " + ИмяПоля + " не найдено в JSON");
            Возврат "";
        КонецЕсли;
    Исключение
        ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
            УровеньЖурналаРегистрации.Ошибка, 
            , 
            , 
            "Ошибка разбора JSON для поля " + ИмяПоля + ": " + ОписаниеОшибки());
        Возврат "";
    КонецПопытки;
КонецФункции



Функция GetUserCodesGET(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);

    Попытка
        // Логируем все параметры запроса
        ПараметрыЗапросаСтрокой = "";
        Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
            ПараметрыЗапросаСтрокой = ПараметрыЗапросаСтрокой + Параметр.Ключ + "=" + Строка(Параметр.Значение) + "; ";
        КонецЦикла;
        
        ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
            УровеньЖурналаРегистрации.Информация, 
            , , 
            "Получен GET-запрос. Параметры URL: " + Строка(Запрос.ПараметрыURL) + 
            ", Параметры запроса: " + ПараметрыЗапросаСтрокой);

        // Получаем параметр phone
        Телефон = Запрос.ПараметрыЗапроса.Получить("phone");
        
        // Логируем значение параметра phone
        ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
            УровеньЖурналаРегистрации.Информация, 
            , , 
            "Извлечённый параметр phone: '" + Строка(Телефон) + "'");

        // Проверка на пустое значение
        Если Телефон = Неопределено ИЛИ Строка(Телефон) = "" Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Укажите телефон пользователя");
            Возврат Ответ;
        КонецЕсли;

        // Запрос к базе
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |   ПринятыйКод.Номенклатура КАК Номенклатура,
            |   ПринятыйКод.Бонус КАК Бонус,
            |   ПринятыйКод.ДатаОтправки КАК ДатаОтправки,
            |   ПринятыйКод.Статус КАК Статус
            |ИЗ
            |   Документ.ПринятыйКодМаркировки КАК ПринятыйКод
            |ГДЕ
            |   ПринятыйКод.ПользовательИдентификатор = &Телефон";
        Запрос.УстановитьПараметр("Телефон", Телефон);

        Результат = Запрос.Выполнить();
        МассивКодов = Новый Массив;

        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            ДанныеКода = Новый Структура;
            ДанныеКода.Вставить("nomenclature", ?(ЗначениеЗаполнено(Выборка.Номенклатура), Строка(Выборка.Номенклатура), ""));
            ДанныеКода.Вставить("bonus", Формат(?(ЗначениеЗаполнено(Выборка.Бонус), Выборка.Бонус, 0), "ЧН=0; ЧГ=0"));
            ДатаСтрокой = Формат(Выборка.ДатаОтправки, "ДФ=yyyy-MM-ddTHH:mm:ss");
            ДанныеКода.Вставить("date", ДатаСтрокой);
            ДанныеКода.Вставить("status", Строка(Выборка.Статус));
            МассивКодов.Добавить(ДанныеКода);
        КонецЦикла;

        // Преобразование в JSON
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, МассивКодов);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());

    Исключение
        ОписаниеОшибкиТекст = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("HTTPСервис.CodeReceiver", 
            УровеньЖурналаРегистрации.Ошибка, 
            , , 
            "Ошибка обработки запроса: " + ОписаниеОшибкиТекст + "Тело запроса: " + Запрос.ПолучитьТелоКакСтроку());
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка сервера: " + ОписаниеОшибкиТекст);
    КонецПопытки;

    Возврат Ответ;
КонецФункции
