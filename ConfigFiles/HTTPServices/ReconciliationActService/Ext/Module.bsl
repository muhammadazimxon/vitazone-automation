Функция GetReconciliationActPOST(Запрос)
	
	// Чтение тела запроса
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ПараметрыЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.УстановитьТелоИзСтроки("Ошибка обработки JSON: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;
	
	// Извлечение параметров
	ИНН = ПараметрыЗапроса.ИНН;
	НачалоПериода = XMLЗначение(Тип("Дата"), ПараметрыЗапроса.НачалоПериода);
	КонецПериода = XMLЗначение(Тип("Дата"), ПараметрыЗапроса.КонецПериода);
	Покупатель = ПараметрыЗапроса.Покупатель;
	Поставщик = ПараметрыЗапроса.Поставщик;
	
	// Проверка обязательных параметров
	Если Не ЗначениеЗаполнено(ИНН) Или Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.УстановитьТелоИзСтроки("Ошибка: Не указаны обязательные параметры (ИНН, НачалоПериода, КонецПериода).");
		Возврат Ответ;
	КонецЕсли;
	
	// Подключение к базе
	Сервер = "192.168.1.214";
	НаименованиеБазы = "buh2";
	Пользователь = "Администратор";
	Пароль = "4545";
	ПодключениеКБазе = ПолучитьПодключениеКВнешнейБазе(Сервер, НаименованиеБазы, Пользователь, Пароль);
	
	Если ПодключениеКБазе = Неопределено Тогда
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.УстановитьТелоИзСтроки("Ошибка подключения к базе.");
		Возврат Ответ;
	КонецЕсли;
	
	// Поиск контрагента по ИНН
	КонтрагентКом = ПодключениеКБазе.Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);
	Если КонтрагентКом.Пустая() Тогда
		Ответ = Новый HTTPСервисОтвет(404);
		Ответ.УстановитьТелоИзСтроки("Контрагент с ИНН " + ИНН + " не найден.");
		Возврат Ответ;
	КонецЕсли;
	
	// Проверка флагов Покупатель/Поставщик
	Если Не (Покупатель Или Поставщик) Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.УстановитьТелоИзСтроки("Ошибка: Укажите хотя бы один флаг (Покупатель или Поставщик).");
		Возврат Ответ;
	КонецЕсли;
	
	// Установка параметров объекта
	Объект = Новый Структура;
	Объект.Вставить("НачалоПериода", НачалоПериода);
	Объект.Вставить("КонецПериода", КонецПериода);
	Объект.Вставить("Покупатель", Покупатель);
	Объект.Вставить("Поставщик", Поставщик);
	
	// Формирование акта сверки
	ДокументАктСверка = СоздатьДокументАктСверки(ПодключениеКБазе, КонтрагентКом, Объект);
	Структура = СобратьДанныедляАктСверки(ПодключениеКБазе, ДокументАктСверка.Ссылка);
	ТабДок = ПечатьАктаСверки(Структура);
	
	// Сохранение табличного документа во временный файл (PDF)
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
	
	// Чтение файла в двоичные данные
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	
	// Удаление временного файла
	УдалитьФайлы(ИмяВременногоФайла);
	
	// Удаление документа
	ДокументАктСверка.Удалить();
	
	// Формирование ответа
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/pdf");
	Ответ.Заголовки.Вставить("Content-Disposition", "attachment; filename=ReconciliationAct.pdf");
	Ответ.УстановитьДвоичныеДанные(ДвоичныеДанные);
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьПодключениеКВнешнейБазе(Сервер, БазаДанных, Пользователь, Пароль, Файловая = Ложь, ПутьКФайловойБазе = "")
	Соединение = Новый COMОбъект("V83.COMConnector");
	СтрокаСоединения = ?(Файловая, "File=""" + СокрЛП(ПутьКФайловойБазе) + """",
		"Srvr=""" + СокрЛП(Сервер) + """;Ref=""" + СокрЛП(БазаДанных) + """;Usr=""" + СокрЛП(Пользователь) + """;Pwd=""" + СокрЛП(Пароль) + """");
	Попытка
		Подключение = Соединение.Connect(СтрокаСоединения);
	Исключение
		Сообщить("Не удалось подключиться к базе: " + ОписаниеОшибки());
		Подключение = Неопределено;
	КонецПопытки;
	Возврат Подключение;
КонецФункции

Функция СоздатьДокументАктСверки(ПодключениеКБазе, Контрагент, Объект)
	
	мВалютаРегламентированногоУчета = ПодключениеКБазе.Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументАктСверка = ПодключениеКБазе.Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();
	ДокументАктСверка.Дата = ТекущаяДатаСеанса();
	ПодключениеКБазе.ОбщегоНазначения.ЗаполнитьШапкуДокумента(ДокументАктСверка.ThisObject,
		ПодключениеКБазе.Справочники.Пользователи.НайтиПоНаименованию("Администратор"), мВалютаРегламентированногоУчета);
	
	// Заполнение списка счетов
	ЗаполнитьСписокСчетовЗначениямиПоУмолчанию(ПодключениеКБазе, ДокументАктСверка, Объект);
	
	ДокументАктСверка.СверкаСогласована = Ложь;
	ДокументАктСверка.ДатаОкончания = КонецДня(Объект.КонецПериода);
	ДокументАктСверка.ДатаНачала = НачалоГода(Объект.НачалоПериода);
	ДокументАктСверка.Контрагент = Контрагент;
	ДокументАктСверка.ПредставительКонтрагента = ДокументАктСверка.Контрагент.ОсновноеКонтактноеЛицо;
	
	// Формирование фильтра счетов
	ФильтрСписокСчетов = ПодключениеКБазе.NewObject("Массив");
	Для Каждого СтрокаСчета Из ДокументАктСверка.СписокСчетов Цикл
		Если Не ПодключениеКБазе.ЗначениеЗаполнено(СтрокаСчета.Счет) Или СтрокаСчета.УчаствуетВРасчетах = Ложь Тогда
			Продолжить;
		Иначе
			ФильтрСписокСчетов.Добавить(СтрокаСчета.Счет);
		КонецЕсли;
	КонецЦикла;
	
	ДокументАктСверка.ОстаткиПоДоговорам.Очистить();
	ДокументАктСверка.ЗаполнитьПоДаннымБухгалтерскогоУчета(ФильтрСписокСчетов);
	ДокументАктСверка.ЗаполнитьПоДаннымОрганизации();
	ДокументАктСверка.Записать();
	
	Возврат ДокументАктСверка;
КонецФункции

Процедура ЗаполнитьСписокСчетовЗначениямиПоУмолчанию(ПодключениеКБазе, ДокументАктСверка, Объект)
	
	Если ДокументАктСверка.СписокСчетов.Количество() > 0 Тогда
		ДокументАктСверка.СписокСчетов.Очистить();
	КонецЕсли;
	
	СчетаПоУмолчанию = ПодключениеКБазе.NewObject("Массив");
	Если Объект.Покупатель Тогда
		СчетаПоУмолчанию.Добавить(ПодключениеКБазе.ПланыСчетов.Хозрасчетный.РасчетыСПокупателямиИЗаказчиками);
		СчетаПоУмолчанию.Добавить(ПодключениеКБазе.ПланыСчетов.Хозрасчетный.А6300);
	КонецЕсли;
	Если Объект.Поставщик Тогда
		СчетаПоУмолчанию.Добавить(ПодключениеКБазе.ПланыСчетов.Хозрасчетный.А4300);
		СчетаПоУмолчанию.Добавить(ПодключениеКБазе.ПланыСчетов.Хозрасчетный.РасчетыСПоставщикамиИПодрядчиками);
	КонецЕсли;
	
	Для Счетчик = 1 По СчетаПоУмолчанию.Количество() Цикл
		СтрокаСчета = ДокументАктСверка.СписокСчетов.Добавить();
		СтрокаСчета.УчаствуетВРасчетах = Истина;
	КонецЦикла;
	
	ДокументАктСверка.СписокСчетов.ЗагрузитьКолонку(СчетаПоУмолчанию, "Счет");
КонецПроцедуры

Функция СобратьДанныедляАктСверки(ПодключениеКБазе, СсылкаНаОбъект)
	
	Структура = Новый Структура;
	Приставка = ?(СсылкаНаОбъект.ВыводитьСРегламентом, "Регл", "");
	Структура.Вставить("Приставка", Приставка);
	
	// Название организации
	НазваниеОрганизации = СсылкаНаОбъект.Организация.НаименованиеПолное;
	Если ПустаяСтрока(НазваниеОрганизации) Тогда
		НазваниеОрганизации = ПодключениеКБазе.String(СсылкаНаОбъект.Организация);
	КонецЕсли;
	Структура.Вставить("НазваниеОрганизации", НазваниеОрганизации);
	Структура.Вставить("ВыводитьСРегламентом", СсылкаНаОбъект.ВыводитьСРегламентом);
	
	// Наименование контрагента
	НаименованиеКонтрагента = СсылкаНаОбъект.Контрагент.НаименованиеПолное;
	Если ПустаяСтрока(НаименованиеКонтрагента) Тогда
		НаименованиеКонтрагента = ПодключениеКБазе.String(СсылкаНаОбъект.Контрагент);
	КонецЕсли;
	Структура.Вставить("НаименованиеКонтрагента", НаименованиеКонтрагента);
	
	// Период отчета
	Если СсылкаНаОбъект.ДатаНачала = '00010101' Тогда
		Если СсылкаНаОбъект.ПоДаннымОрганизации.Количество() > 0 Тогда
			Для Каждого Эл Из СсылкаНаОбъект.ПоДаннымОрганизации Цикл
				ДатаНачалаОтчета = Эл.Дата;
				Прервать;
			КонецЦикла;
		Иначе
			ДатаНачалаОтчета = '00010101';
		КонецЕсли;
	Иначе
		ДатаНачалаОтчета = СсылкаНаОбъект.ДатаНачала;
	КонецЕсли;
	
	ОписаниеПериода = "за период: " + ПредставлениеПериода(НачалоДня(ДатаНачалаОтчета), КонецДня(СсылкаНаОбъект.ДатаОкончания), "ФП = Истина");
	ТекстЗаголовка = "взаимных расчетов " + ОписаниеПериода + Символы.ПС
		+ "между " + НазваниеОрганизации + Символы.ПС + "и " + НаименованиеКонтрагента;
	Если Не СсылкаНаОбъект.ДоговорКонтрагента.Пустая() Тогда
		ТекстЗаголовка = ТекстЗаголовка + Символы.ПС + "по договору " + СокрЛП(СсылкаНаОбъект.ДоговорКонтрагента.Наименование);
	КонецЕсли;
	Структура.Вставить("ТекстЗаголовка", ТекстЗаголовка);
	
	// Представитель организации
	ДанныеПредставителяОрганизации = ПодключениеКБазе.ОбщегоНазначения.ДанныеФизЛица(
		СсылкаНаОбъект.Организация, СсылкаНаОбъект.ПредставительОрганизации, СсылкаНаОбъект.ДатаОкончания);
	ФИОПредставителя = ?(Не ЗначениеЗаполнено(ДанныеПредставителяОрганизации.Фамилия), "",
		ДанныеПредставителяОрганизации.Фамилия
		+ ?(Не ЗначениеЗаполнено(ДанныеПредставителяОрганизации.Имя), "", " " + ДанныеПредставителяОрганизации.Имя)
		+ ?(Не ЗначениеЗаполнено(ДанныеПредставителяОрганизации.Отчество), "", " " + ДанныеПредставителяОрганизации.Отчество));
	
	СтрЗаголовокТаблица = "Мы, нижеподписавшиеся, " + ?(Не ЗначениеЗаполнено(ДанныеПредставителяОрганизации.Должность),
		"________________", ДанныеПредставителяОрганизации.Должность) + " " + НазваниеОрганизации
		+ " " + ?(ФИОПредставителя <> "", ФИОПредставителя, "_______________________") + ", с одной стороны, "
		+ "и " + ?(Не ЗначениеЗаполнено(СсылкаНаОбъект.ПредставительКонтрагента.Должность), "________________",
		СсылкаНаОбъект.ПредставительКонтрагента.Должность) + " " + НаименованиеКонтрагента + " "
		+ ?(Не ПодключениеКБазе.ЗначениеЗаполнено(СсылкаНаОбъект.ПредставительКонтрагента), "_______________________",
		ПодключениеКБазе.String(СсылкаНаОбъект.ПредставительКонтрагента)) + ", с другой стороны, "
		+ "составили настоящий акт сверки в том, что состояние взаимных расчетов по данным учета следующее:";
	Структура.Вставить("СтрЗаголовокТаблица", СтрЗаголовокТаблица);
	Структура.Вставить("ВалютаДокумента", ПодключениеКБазе.String(СсылкаНаОбъект.ВалютаДокумента));
	
	// Начальные остатки
	Структура.Вставить("СуммаНачальныйОстатокДт", ?(СсылкаНаОбъект.ОстатокНаНачало > 0, СсылкаНаОбъект.ОстатокНаНачало, 0));
	Структура.Вставить("СуммаНачальныйОстатокКт", ?(СсылкаНаОбъект.ОстатокНаНачало < 0, -СсылкаНаОбъект.ОстатокНаНачало, 0));
	Если СсылкаНаОбъект.ВыводитьСРегламентом Тогда
		Структура.Вставить("СуммаНачальныйОстатокДтРегл", ?(СсылкаНаОбъект.ОстатокНаНачалоРегл > 0, СсылкаНаОбъект.ОстатокНаНачалоРегл, 0));
		Структура.Вставить("СуммаНачальныйОстатокКтРегл", ?(СсылкаНаОбъект.ОстатокНаНачалоРегл < 0, -СсылкаНаОбъект.ОстатокНаНачалоРегл, 0));
	КонецЕсли;
	
	// Обороты
	ОборотыДт = 0;
	ОборотыКт = 0;
	ОборотыДтКонтр = 0;
	ОборотыКтКонтр = 0;
	ОборотыДтРегл = 0;
	ОборотыКтРегл = 0;
	ОборотыДтКонтрРегл = 0;
	ОборотыКтКонтрРегл = 0;
	
	Если СсылкаНаОбъект.ПоДаннымОрганизации.Количество() > 0 Или СсылкаНаОбъект.ПоДаннымКонтрагента.Количество() > 0 Тогда
		Запрос = ПодключениеКБазе.NewObject("Запрос");
		Запрос.УстановитьПараметр("ТекущийДокумент", СсылкаНаОбъект);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ДанныеСДокумента.Договор, ОстаткиПоДоговорам.Договор) КАК Договор,
		|	ДанныеСДокумента.Дата КАК Дата,
		|	ДанныеСДокумента.Документ,
		|	ДанныеСДокумента.Представление КАК Представление,
		|	ДанныеСДокумента.ДатаК КАК ДатаК,
		|	ДанныеСДокумента.ПредставлениеК КАК ПредставлениеК,
		|	ЕСТЬNULL(ДанныеСДокумента.Дебет, 0) КАК СуммаДогДт,
		|	ЕСТЬNULL(ДанныеСДокумента.Кредит, 0) КАК СуммаДогКт,
		|	ЕСТЬNULL(ДанныеСДокумента.ДебетК, 0) КАК СуммаДогДтКонтр,
		|	ЕСТЬNULL(ДанныеСДокумента.КредитК, 0) КАК СуммаДогКтКонтр,
		|	ЕСТЬNULL(ДанныеСДокумента.ДебетРегл, 0) КАК СуммаДогДтРегл,
		|	ЕСТЬNULL(ДанныеСДокумента.КредитРегл, 0) КАК СуммаДогКтРегл,
		|	ЕСТЬNULL(ДанныеСДокумента.ДебетКРегл, 0) КАК СуммаДогДтКонтрРегл,
		|	ЕСТЬNULL(ДанныеСДокумента.КредитКРегл, 0) КАК СуммаДогКтКонтрРегл,
		|	ЕСТЬNULL(ОстаткиПоДоговорам.Остаток, 0) КАК Остаток,
		|	ЕСТЬNULL(ОстаткиПоДоговорам.ОстатокРегл, 0) КАК ОстатокРегл
		|ИЗ
		|	(ВЫБРАТЬ
		|		АктСверкиВзаиморасчетовОстаткиПоДоговорам.Договор КАК Договор,
		|		АктСверкиВзаиморасчетовОстаткиПоДоговорам.Остаток КАК Остаток,
		|		АктСверкиВзаиморасчетовОстаткиПоДоговорам.ОстатокРегл КАК ОстатокРегл
		|	ИЗ
		|		Документ.АктСверкиВзаиморасчетов.ОстаткиПоДоговорам КАК АктСверкиВзаиморасчетовОстаткиПоДоговорам
		|	ГДЕ
		|		АктСверкиВзаиморасчетовОстаткиПоДоговорам.Ссылка = &ТекущийДокумент) КАК ОстаткиПоДоговорам
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПоДаннымОрганизации.Договор КАК Договор,
		|			ПоДаннымОрганизации.Дата КАК Дата,
		|			NULL КАК ДатаК,
		|			ПоДаннымОрганизации.Документ КАК Документ,
		|			ПоДаннымОрганизации.Представление КАК Представление,
		|			NULL КАК ПредставлениеК,
		|			ПоДаннымОрганизации.Дебет КАК Дебет,
		|			ПоДаннымОрганизации.Кредит КАК Кредит,
		|			0 КАК ДебетК,
		|			0 КАК КредитК,
		|			ПоДаннымОрганизации.ДебетРегл КАК ДебетРегл,
		|			ПоДаннымОрганизации.КредитРегл КАК КредитРегл,
		|			0 КАК ДебетКРегл,
		|			0 КАК КредитКРегл
		|		ИЗ
		|			Документ.АктСверкиВзаиморасчетов.ПоДаннымОрганизации КАК ПоДаннымОрганизации
		|		ГДЕ
		|			ПоДаннымОрганизации.Ссылка = &ТекущийДокумент
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			ПоДаннымКонтрагента.Договор,
		|			NULL,
		|			ПоДаннымКонтрагента.Дата,
		|			ПоДаннымКонтрагента.Документ,
		|			NULL,
		|			ПоДаннымКонтрагента.Представление,
		|			0,
		|			0,
		|			ПоДаннымКонтрагента.Дебет,
		|			ПоДаннымКонтрагента.Кредит,
		|			0,
		|			0,
		|			ПоДаннымКонтрагента.ДебетРегл,
		|			ПоДаннымКонтрагента.КредитРегл
		|		ИЗ
		|			Документ.АктСверкиВзаиморасчетов.ПоДаннымКонтрагента КАК ПоДаннымКонтрагента
		|		ГДЕ
		|			ПоДаннымКонтрагента.Ссылка = &ТекущийДокумент) КАК ДанныеСДокумента
		|		ПО ОстаткиПоДоговорам.Договор = ДанныеСДокумента.Договор
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	ДатаК,
		|	Представление" + ?(СсылкаНаОбъект.ВыводитьПолныеНазванияДокументов, "", " УБЫВ") + ",
		|	ПредставлениеК" + ?(СсылкаНаОбъект.ВыводитьПолныеНазванияДокументов, "", " УБЫВ") + "
		|ИТОГИ
		|	СУММА(СуммаДогДт),
		|	СУММА(СуммаДогКт),
		|	СУММА(СуммаДогДтКонтр),
		|	СУММА(СуммаДогКтКонтр),
		|	СУММА(СуммаДогДтРегл),
		|	СУММА(СуммаДогКтРегл),
		|	СУММА(СуммаДогДтКонтрРегл),
		|	СУММА(СуммаДогКтКонтрРегл),
		|	МАКСИМУМ(Остаток),
		|	МАКСИМУМ(ОстатокРегл)
		|ПО
		|	ОБЩИЕ" + ?(СсылкаНаОбъект.РазбитьПоДоговорам, ", Договор", "");
		
		Результат = Запрос.Выполнить();
		ОбходПоОбщимИтогам = Результат.Выбрать(ПодключениеКБазе.ОбходРезультатаЗапроса.ПоГруппировкам, "Общие");
		ОбходПоОбщимИтогам.Следующий();
		
		ОборотыДт = ОбходПоОбщимИтогам.СуммаДогДт;
		ОборотыКт = ОбходПоОбщимИтогам.СуммаДогКт;
		ОборотыДтКонтр = ОбходПоОбщимИтогам.СуммаДогДтКонтр;
		ОборотыКтКонтр = ОбходПоОбщимИтогам.СуммаДогКтКонтр;
		ОборотыДтРегл = ОбходПоОбщимИтогам.СуммаДогДтРегл;
		ОборотыКтРегл = ОбходПоОбщимИтогам.СуммаДогКтРегл;
		ОборотыДтКонтрРегл = ОбходПоОбщимИтогам.СуммаДогДтКонтрРегл;
		ОборотыКтКонтрРегл = ОбходПоОбщимИтогам.СуммаДогКтКонтрРегл;
		
		ОбходПоДокументам = Результат.Выбрать();
		СписокДокументов = Новый Массив;
		СписокДокументовК = Новый Массив;
		
		Пока ОбходПоДокументам.Следующий() Цикл
			Если ОбходПоДокументам.Дата <> NULL Тогда
				СписокДокументов.Добавить(Новый Структура("ДатаДокумента,РегистраторПредставление,Регистратор,СуммаОборотДт,СуммаОборотКт,СуммаОборотДтРегл,СуммаОборотКтРегл",
					ОбходПоДокументам.Дата, ОбходПоДокументам.Представление, ПодключениеКБазе.String(ОбходПоДокументам.Документ),
					ОбходПоДокументам.СуммаДогДт, ОбходПоДокументам.СуммаДогКт, ОбходПоДокументам.СуммаДогДтРегл, ОбходПоДокументам.СуммаДогКтРегл));
			КонецЕсли;
			Если ОбходПоДокументам.ДатаК <> NULL Тогда
				СписокДокументовК.Добавить(Новый Структура("ДатаДокументаКонтр,РегистраторПредставлениеКонтр,СуммаОборотДтКонтр,СуммаОборотКтКонтр,СуммаОборотДтКонтрРегл,СуммаОборотКтКонтрРегл",
					ОбходПоДокументам.ДатаК, ОбходПоДокументам.ПредставлениеК, ОбходПоДокументам.СуммаДогДтКонтр, ОбходПоДокументам.СуммаДогКтКонтр,
					ОбходПоДокументам.СуммаДогДтКонтрРегл, ОбходПоДокументам.СуммаДогКтКонтрРегл));
			КонецЕсли;
		КонецЦикла;
		
		// Выравнивание списков документов
		МаксИндекс = Макс(СписокДокументов.Количество(), СписокДокументовК.Количество()) - 1;
		МинИндекс = Мин(СписокДокументов.Количество(), СписокДокументовК.Количество()) - 1;
		Если СписокДокументов.Количество() < СписокДокументовК.Количество() Тогда
			Для Инд = МинИндекс По МаксИндекс - 1 Цикл
				СписокДокументов.Добавить(Новый Структура("ДатаДокумента,РегистраторПредставление,Регистратор,СуммаОборотДт,СуммаОборотКт,СуммаОборотДтРегл,СуммаОборотКтРегл",
					"", "", "", "", "", "", ""));
			КонецЦикла;
		ИначеЕсли СписокДокументов.Количество() > СписокДокументовК.Количество() Тогда
			Для Инд = МинИндекс По МаксИндекс - 1 Цикл
				СписокДокументовК.Добавить(Новый Структура("ДатаДокументаКонтр,РегистраторПредставлениеКонтр,СуммаОборотДтКонтр,СуммаОборотКтКонтр,СуммаОборотДтКонтрРегл,СуммаОборотКтКонтрРегл",
					"", "", "", "", "", ""));
			КонецЦикла;
		КонецЕсли;
		
		Структура.Вставить("СписокДокументов", СписокДокументов);
		Структура.Вставить("СписокДокументовК", СписокДокументовК);
		Структура.Вставить("ОборотыДт", ОборотыДт);
		Структура.Вставить("ОборотыКт", ОборотыКт);
		Структура.Вставить("СуммаОборотДтРегл", ОборотыДтРегл);
		Структура.Вставить("СуммаОборотКтРегл", ОборотыКтРегл);
		Структура.Вставить("СверкаСогласована", СсылкаНаОбъект.СверкаСогласована);
		Структура.Вставить("СуммаОборотДтКонтр", ОборотыДтКонтр);
		Структура.Вставить("СуммаОборотКтКонтр", ОборотыКтКонтр);
		Структура.Вставить("СуммаОборотДтКонтрРегл", ОборотыДтКонтрРегл);
		Структура.Вставить("СуммаОборотКтКонтрРегл", ОборотыКтКонтрРегл);
	КонецЕсли;
	
	// Конечные остатки
	ОстатокНаКонец = СсылкаНаОбъект.ОстатокНаНачало + ОборотыДт - ОборотыКт;
	ОстатокНаКонецРегл = СсылкаНаОбъект.ОстатокНаНачалоРегл + ОборотыДтРегл - ОборотыКтРегл;
	Структура.Вставить("СуммаКонечныйОстатокДт", ?(ОстатокНаКонец > 0, ОстатокНаКонец, 0));
	Структура.Вставить("СуммаКонечныйОстатокКт", ?(ОстатокНаКонец < 0, -ОстатокНаКонец, 0));
	Структура.Вставить("СуммаКонечныйОстатокДтРегл", ?(ОстатокНаКонецРегл > 0, ОстатокНаКонецРегл, 0));
	Структура.Вставить("СуммаКонечныйОстатокКтРегл", ?(ОстатокНаКонецРегл < 0, -ОстатокНаКонецРегл, 0));
	
	ОстатокНаКонецК = СсылкаНаОбъект.ОстатокНаНачало - ОборотыДтКонтр + ОборотыКтКонтр;
	ОстатокНаКонецКРегл = СсылкаНаОбъект.ОстатокНаНачалоРегл - ОборотыДтКонтрРегл + ОборотыКтКонтрРегл;
	Структура.Вставить("СуммаКонечныйОстатокКтКонтр", ?(ОстатокНаКонецК > 0, ОстатокНаКонецК, 0));
	Структура.Вставить("СуммаКонечныйОстатокДтКонтр", ?(ОстатокНаКонецК < 0, -ОстатокНаКонецК, 0));
	Структура.Вставить("СуммаКонечныйОстатокКтКонтрРегл", ?(ОстатокНаКонецКРегл > 0, ОстатокНаКонецКРегл, 0));
	Структура.Вставить("СуммаКонечныйОстатокДтКонтрРегл", ?(ОстатокНаКонецКРегл < 0, -ОстатокНаКонецКРегл, 0));
	Структура.Вставить("ДатаОкончания", СсылкаНаОбъект.ДатаОкончания);
	
	// Результаты сверки
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект.ДатаОкончания) Тогда
		РезультатыСверки = "<не указана дата сверки>";
	ИначеЕсли Не ПодключениеКБазе.ЗначениеЗаполнено(СсылкаНаОбъект.Контрагент) Тогда
		РезультатыСверки = "<не указан контрагент>";
	Иначе
		РезультатыСверки = "на " + Формат(СсылкаНаОбъект.ДатаОкончания, "ДФ=dd.MM.yyyy") + " задолженность ";
		Если ОстатокНаКонец > 0 Тогда
			РезультатыСверки = РезультатыСверки + "в пользу " + СокрЛП(НазваниеОрганизации) + " "
				+ Формат(ОстатокНаКонец, "ЧЦ=21; ЧДЦ=2") + " " + Структура.ВалютаДокумента
				+ " (" + ПолучитьЧислоПрописью(СсылкаНаОбъект.ВалютаДокумента, ОстатокНаКонец, ,
					СсылкаНаОбъект.ВалютаДокумента.ПараметрыПрописиНаРусском) + ")";
		ИначеЕсли ОстатокНаКонец < 0 Тогда
			РезультатыСверки = РезультатыСверки + "в пользу " + СокрЛП(НаименованиеКонтрагента) + " "
				+ Формат(-ОстатокНаКонец, "ЧЦ=21; ЧДЦ=2") + " " + Структура.ВалютаДокумента
				+ " (" + ПолучитьЧислоПрописью(СсылкаНаОбъект.ВалютаДокумента, -ОстатокНаКонец, ,
					СсылкаНаОбъект.ВалютаДокумента.ПараметрыПрописиНаРусском) + ")";
		Иначе
			РезультатыСверки = РезультатыСверки + "отсутствует.";
		КонецЕсли;
	КонецЕсли;
	Структура.Вставить("РезультатыСверки", РезультатыСверки);
	
	Если СсылкаНаОбъект.СверкаСогласована Тогда
		Структура.Вставить("ПоДаннымКонтрагента", "По данным " + СокрЛП(НаименованиеКонтрагента));
		РезультатыСверкиК = "на " + Формат(СсылкаНаОбъект.ДатаОкончания, "ДФ=dd.MM.yyyy") + " задолженность ";
		Если ОстатокНаКонецК > 0 Тогда
			РезультатыСверкиК = РезультатыСверкиК + "в пользу " + СокрЛП(НазваниеОрганизации) + " "
				+ Формат(ОстатокНаКонецК, "ЧЦ=21; ЧДЦ=2") + " " + Структура.ВалютаДокумента
				+ " (" + ПолучитьЧислоПрописью(СсылкаНаОбъект.ВалютаДокумента, ОстатокНаКонецК, ,
					СсылкаНаОбъект.ВалютаДокумента.ПараметрыПрописиНаРусском) + ")";
		ИначеЕсли ОстатокНаКонецК < 0 Тогда
			РезультатыСверкиК = РезультатыСверкиК + "в пользу " + СокрЛП(НаименованиеКонтрагента) + " "
				+ Формат(-ОстатокНаКонецК, "ЧЦ=21; ЧДЦ=2") + " " + Структура.ВалютаДокумента
				+ " (" + ПолучитьЧислоПрописью(СсылкаНаОбъект.ВалютаДокумента, -ОстатокНаКонецК, ,
					СсылкаНаОбъект.ВалютаДокумента.ПараметрыПрописиНаРусском) + ")";
		Иначе
			РезультатыСверкиК = РезультатыСверкиК + "отсутствует.";
		КонецЕсли;
		Структура.Вставить("РезультатыСверкиК", РезультатыСверкиК);
		
		Если СсылкаНаОбъект.Расхождение <> 0 Тогда
			ИтогСверки = "В результате сверки выявлено расхождение информации о состоянии расчетов в размере "
				+ Формат(?(СсылкаНаОбъект.Расхождение > 0, 1, -1) * СсылкаНаОбъект.Расхождение, "ЧЦ=21; ЧДЦ=2")
				+ " " + Структура.ВалютаДокумента
				+ " (" + ПолучитьЧислоПрописью(СсылкаНаОбъект.ВалютаДокумента,
					?(СсылкаНаОбъект.Расхождение > 0, 1, -1) * СсылкаНаОбъект.Расхождение, ,
					СсылкаНаОбъект.ВалютаДокумента.ПараметрыПрописиНаРусском) + ")";
			ИтогСверки = Символы.ПС + ИтогСверки + Символы.ПС + " ";
			Структура.Вставить("ИтогСверки", ИтогСверки);
			Структура.Вставить("Расхождение", СсылкаНаОбъект.Расхождение);
		КонецЕсли;
	КонецЕсли;
	
	Структура.Вставить("Должность", ?(Не ЗначениеЗаполнено(ДанныеПредставителяОрганизации.Должность),
		"________________", ДанныеПредставителяОрганизации.Должность));
	Структура.Вставить("ДолжностьК", ?(Не ПодключениеКБазе.ЗначениеЗаполнено(СсылкаНаОбъект.ПредставительКонтрагента.Должность),
		"________________", СсылкаНаОбъект.ПредставительКонтрагента.Должность));
	Структура.Вставить("ФИОПредставителя", "(" + ?(Не ЗначениеЗаполнено(ДанныеПредставителяОрганизации),
		"_______________________", ДанныеПредставителяОрганизации.Представление) + ")");
	Структура.Вставить("ФИОПредставителяК", "(" + ?(Не ПодключениеКБазе.ЗначениеЗаполнено(СсылкаНаОбъект.ПредставительКонтрагента),
		"_______________________", ПодключениеКБазе.ПроцедурыУправленияПерсоналом.ФамилияИнициалыФизЛица(
		СсылкаНаОбъект.ПредставительКонтрагента.Фамилия + " " + СсылкаНаОбъект.ПредставительКонтрагента.Имя + " "
		+ СсылкаНаОбъект.ПредставительКонтрагента.Отчество)) + ")");
	
	Возврат Структура;
КонецФункции

Функция ПечатьАктаСверки(СтруктураДанных)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктСверкиВзаиморасчетов_АктСверки";
	
	// Предполагаем, что макет находится в обработке, для HTTP-сервиса нужно указать путь
	Обработка = Обработки.АктСверкиВзаиморасчетов.Создать();
	Макет = Обработка.ПолучитьМакет("АктСверки");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьНачОстатки = Макет.ПолучитьОбласть("НачОстатки" + СтруктураДанных.Приставка);
	ОбластьОбороты = Макет.ПолучитьОбласть("Обороты" + СтруктураДанных.Приставка);
	ОбластьОборотыИтог = Макет.ПолучитьОбласть("ОборотыИтог" + СтруктураДанных.Приставка);
	ОбластьКонОстатки = Макет.ПолучитьОбласть("КонОстатки" + СтруктураДанных.Приставка);
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	// Заполнение заголовка
	ОбластьЗаголовок.Параметры.НазваниеОрганизации = СтруктураДанных.НазваниеОрганизации;
	ОбластьЗаголовок.Параметры.НаименованиеКонтрагента = СтруктураДанных.НаименованиеКонтрагента;
	ОбластьЗаголовок.Параметры.ТекстЗаголовка = СтруктураДанных.ТекстЗаголовка;
	ОбластьЗаголовок.Параметры.СтрЗаголовокТаблица = СтруктураДанных.СтрЗаголовокТаблица;
	ОбластьЗаголовок.Параметры.ВалютаДокумента = СтруктураДанных.ВалютаДокумента;
	
	ТабДок.Очистить();
	ТабДок.Вывести(ОбластьЗаголовок);
	ТабДок.Вывести(ОбластьШапкаТаблицы);
	
	// Начальные остатки
	ОбластьНачОстатки.Параметры.СуммаНачальныйОстатокДт = СтруктураДанных.СуммаНачальныйОстатокДт;
	ОбластьНачОстатки.Параметры.СуммаНачальныйОстатокКт = СтруктураДанных.СуммаНачальныйОстатокКт;
	Если СтруктураДанных.ВыводитьСРегламентом Тогда
		ОбластьНачОстатки.Параметры.СуммаНачальныйОстатокДтРегл = СтруктураДанных.СуммаНачальныйОстатокДтРегл;
		ОбластьНачОстатки.Параметры.СуммаНачальныйОстатокКтРегл = СтруктураДанных.СуммаНачальныйОстатокКтРегл;
	КонецЕсли;
	ТабДок.Вывести(ОбластьНачОстатки);
	
	// Обороты
	МаксИндекс = Макс(СтруктураДанных.СписокДокументов.Количество(), СтруктураДанных.СписокДокументовК.Количество()) - 1;
	Для Инд = 0 По МаксИндекс Цикл
		ОбластьОбороты.Параметры.Заполнить(СтруктураДанных.СписокДокументов[Инд]);
		ОбластьОбороты.Параметры.Заполнить(СтруктураДанных.СписокДокументовК[Инд]);
		ТабДок.Вывести(ОбластьОбороты);
	КонецЦикла;
	
	// Итоги оборотов
	ОбластьОборотыИтог.Параметры.СуммаОборотДт = СтруктураДанных.ОборотыДт;
	ОбластьОборотыИтог.Параметры.СуммаОборотКт = СтруктураДанных.ОборотыКт;
	Если СтруктураДанных.ВыводитьСРегламентом Тогда
		ОбластьОборотыИтог.Параметры.СуммаОборотДтРегл = СтруктураДанных.СуммаОборотДтРегл;
		ОбластьОборотыИтог.Параметры.СуммаОборотКтРегл = СтруктураДанных.СуммаОборотКтРегл;
	КонецЕсли;
	Если СтруктураДанных.СверкаСогласована Тогда
		ОбластьОборотыИтог.Параметры.СуммаОборотДтКонтр = СтруктураДанных.СуммаОборотДтКонтр;
		ОбластьОборотыИтог.Параметры.СуммаОборотКтКонтр = СтруктураДанных.СуммаОборотКтКонтр;
		Если СтруктураДанных.ВыводитьСРегламентом Тогда
			ОбластьОборотыИтог.Параметры.СуммаОборотДтКонтрРегл = СтруктураДанных.СуммаОборотДтКонтрРегл;
			ОбластьОборотыИтог.Параметры.СуммаОборотКтКонтрРегл = СтруктураДанных.СуммаОборотКтКонтрРегл;
		КонецЕсли;
	КонецЕсли;
	ТабДок.Вывести(ОбластьОборотыИтог);
	
	// Конечные остатки
	ОбластьКонОстатки.Параметры.СуммаКонечныйОстатокДт = СтруктураДанных.СуммаКонечныйОстатокДт;
	ОбластьКонОстатки.Параметры.СуммаКонечныйОстатокКт = СтруктураДанных.СуммаКонечныйОстатокКт;
	Если СтруктураДанных.ВыводитьСРегламентом Тогда
		ОбластьКонОстатки.Параметры.СуммаКонечныйОстатокДтРегл = СтруктураДанных.СуммаКонечныйОстатокДтРегл;
		ОбластьКонОстатки.Параметры.СуммаКонечныйОстатокКтРегл = СтруктураДанных.СуммаКонечныйОстатокКтРегл;
	КонецЕсли;
	ТабДок.Вывести(ОбластьКонОстатки);
	
	// Подвал
	ОбластьПодвал.Параметры.РезультатыСверки = СтруктураДанных.РезультатыСверки;
	ОбластьПодвал.Параметры.НазваниеОрганизации = СокрЛП(СтруктураДанных.НазваниеОрганизации);
	ОбластьПодвал.Параметры.НаименованиеКонтрагента = СокрЛП(СтруктураДанных.НаименованиеКонтрагента);
	ОбластьПодвал.Параметры.Должность = СтруктураДанных.Должность;
	ОбластьПодвал.Параметры.ДолжностьК = СтруктураДанных.ДолжностьК;
	ОбластьПодвал.Параметры.ФИОПредставителя = СтруктураДанных.ФИОПредставителя;
	ОбластьПодвал.Параметры.ФИОПредставителяК = СтруктураДанных.ФИОПредставителяК;
	ТабДок.Вывести(ОбластьПодвал);
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Возврат ТабДок;
КонецФункции

Функция ПолучитьЧислоПрописью(ВалютаДокумента = Неопределено, Знач Сумма, Знач ФорматСтрока = "", Знач ПарамПредмета, КодЯзыка = Неопределено)
	ПараметрЯзыка = "Л=ru_RU; ";
	Если Не ВалютаДокумента = Неопределено Тогда
		ПарамПредмета = ВалютаДокумента.ПараметрыПрописиНаРусском;
	КонецЕсли;
	ФорматСтрока = ПараметрЯзыка + ФорматСтрока;
	ПолученноеЧисло = ЧислоПрописью(Сумма, ФорматСтрока, ПарамПредмета);
	Возврат ПолученноеЧисло;
КонецФункции