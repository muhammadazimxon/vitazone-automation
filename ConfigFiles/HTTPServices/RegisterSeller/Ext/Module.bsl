Функция RegisterSeller(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
    Данные = ПрочитатьJSON(ЧтениеJSON);

    // Проверка уникальности телефона
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Продавцы.Ссылка
        |ИЗ
        |    Справочник.Продавцы КАК Продавцы
        |ГДЕ
        |    Продавцы.НомерТелефона = &Номер";
    Запрос.УстановитьПараметр("Номер", Данные.Phone);
    Результат = Запрос.Выполнить();

    Если НЕ Результат.Пустой() Тогда
        Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Номер уже зарегистрирован""}");
        Возврат Ответ;
    КонецЕсли;

    // Поиск контрагента по ИНН
    Аптека = Справочники.Контрагенты.ПустаяСсылка();
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    Контрагенты.Ссылка КАК Ссылка
        |ИЗ
        |    Справочник.Контрагенты КАК Контрагенты
        |ГДЕ
        |    Контрагенты.ИНН = &ИНН";
    Запрос.УстановитьПараметр("ИНН", Данные.inn);
    Результат = Запрос.Выполнить();

    Если НЕ Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        Аптека = Выборка.Ссылка;
    КонецЕсли;

    // Создание элемента
    Продавец = Справочники.Продавцы.СоздатьЭлемент();
    Продавец.НомерТелефона = Данные.Phone;
    Продавец.Имя = Данные.Name;
    Продавец.Фамилия = Данные.Surname;
    Продавец.ИНН = Данные.inn;
    Продавец.Аптека = Аптека; // Заполнение реквизита Аптека, если найдена
    Продавец.Пароль = Данные.Password;
    Продавец.TelegramID = Данные.TelegramID;
    Продавец.Наименование = ""; // Очистка Наименования
    Продавец.Наименование = Данные.Surname + " " + Данные.Name; // Формирование Наименования
    Продавец.Записать();

    Ответ.УстановитьТелоИзСтроки("{""success"": true}");
    Возврат Ответ;
КонецФункции

Функция CheckPhoneGET(Запрос)
    Телефон = СтрЗаменить(Запрос.ПолучитьПараметр("phone"), " ", "");

    Запрос1С = Новый Запрос;
    Запрос1С.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    Продавцы.Ссылка
        |ИЗ
        |    Справочник.Продавцы КАК Продавцы
        |ГДЕ
        |    Продавцы.НомерТелефона = &Телефон";
    Запрос1С.УстановитьПараметр("Телефон", Телефон);
    Результат = Запрос1С.Выполнить();

    Ответ = Новый HTTPСервисОтвет(200);
    Если НЕ Результат.Пустой() Тогда
        Ответ.УстановитьТелоИзСтроки("{""exists"": true}");
    Иначе
        Ответ.УстановитьТелоИзСтроки("{""exists"": false}");
    КонецЕсли;

    Возврат Ответ;
КонецФункции