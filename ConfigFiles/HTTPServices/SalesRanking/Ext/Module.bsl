Функция GetRankingGET(Запрос)

    // Получаем параметры из URL
    Попытка
        Год = Число(Запрос.ПараметрыURL["Year"]);
        Месяц = Число(Запрос.ПараметрыURL["Month"]);
    Исключение
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка в параметрах: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;

    // Проверяем корректность параметров
    Если Год < 2000 Или Год > 2100 Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Некорректный год");
        Возврат Ответ;
    КонецЕсли;

    Если Месяц < 1 Или Месяц > 12 Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Некорректный месяц");
        Возврат Ответ;
    КонецЕсли;

    // Формируем рейтинг
    Попытка
        Рейтинг = СформироватьРейтинг(Год, Месяц);
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка при формировании рейтинга: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;

    // Преобразуем рейтинг в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина);
    ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
    ЗаписатьJSON(ЗаписьJSON, Рейтинг);

    // Формируем ответ
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
    Возврат Ответ;

КонецФункции

Функция СформироватьРейтинг(Год, Месяц)

    // Определяем границы месяца
    НачалоПериода = НачалоМесяца(Дата(Год, Месяц, 1));
    КонецПериода = КонецМесяца(НачалоПериода);

    // Запрос для получения продаж по менеджерам
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    Остатки.МП КАК Менеджер,
    |    Остатки.МП.Родитель КАК ГруппаМенеджера,
    |    СУММА(Остатки.Сумма) КАК СуммаПродаж // Заменили СуммаРасход на Сумма
    |ИЗ
    |    РегистрНакопления.Остатки КАК Остатки
    |ГДЕ
    |    Остатки.Период МЕЖДУ &НачалоПериода И &КонецПериода
    |    И Остатки.МП.Родитель <> ЗНАЧЕНИЕ(Справочник.Менеджер.ПустаяСсылка)
    |    И Остатки.МП.Родитель.ЭтоГруппа = ИСТИНА
    |СГРУППИРОВАТЬ ПО
    |    Остатки.МП,
    |    Остатки.МП.Родитель
    |ИТОГИ
    |    СУММА(СуммаПродаж)
    |ПО
    |    ГруппаМенеджера";

    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

    // Проверяем, пустой ли результат
    РезультатЗапроса = Запрос.Выполнить();
    Если РезультатЗапроса.Пустой() Тогда
        Возврат Новый Массив;
    КонецЕсли;

    // Формируем рейтинг
    ТаблицаРейтинга = Новый ТаблицаЗначений;
    ТаблицаРейтинга.Колонки.Добавить("ГруппаМенеджера", Новый ОписаниеТипов("СправочникСсылка.Менеджер"));
    ТаблицаРейтинга.Колонки.Добавить("СуммаПродаж", Новый ОписаниеТипов("Число"));

    ВыборкаГруппы = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
    Пока ВыборкаГруппы.Следующий() Цикл
        НоваяСтрока = ТаблицаРейтинга.Добавить();
        НоваяСтрока.ГруппаМенеджера = ВыборкаГруппы.ГруппаМенеджера;
        НоваяСтрока.СуммаПродаж = ВыборкаГруппы.СуммаПродаж;
    КонецЦикла;

    // Сортируем по убыванию суммы продаж
    ТаблицаРейтинга.Сортировать("СуммаПродаж УБЫВ");

    // Формируем итоговый рейтинг с местами
    Рейтинг = Новый Массив;
    Для Индекс = 0 По ТаблицаРейтинга.Количество() - 1 Цикл
        СтрокаРейтинга = ТаблицаРейтинга[Индекс];
        Место = Индекс + 1;

        // Выделяем топ-3 смайликами
        Если Место = 1 Тогда
            МестоСтрокой = "";
        ИначеЕсли Место = 2 Тогда
            МестоСтрокой = "";
        ИначеЕсли Место = 3 Тогда
            МестоСтрокой = "";
        Иначе
            МестоСтрокой = Формат(Место, "ЧГ=0");
        КонецЕсли;

        // Формируем структуру для JSON
        ДанныеРейтинга = Новый Структура;
        ДанныеРейтинга.Вставить("Rank", МестоСтрокой);
        ДанныеРейтинга.Вставить("GroupName", Строка(СтрокаРейтинга.ГруппаМенеджера));
        ДанныеРейтинга.Вставить("TotalSales", СтрокаРейтинга.СуммаПродаж);

        Рейтинг.Добавить(ДанныеРейтинга);
    КонецЦикла;

    Возврат Рейтинг;

КонецФункции