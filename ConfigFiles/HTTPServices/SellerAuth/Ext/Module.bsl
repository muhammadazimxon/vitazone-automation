    КонецЕсли;

    Попытка
        Продавец = Справочники.Продавцы.НайтиПоРеквизиту("НомерТелефона", НомерТелефона);
        Если Продавец.Пустая() Тогда
            ЗаписьЖурналаРегистрации("API.getCards", УровеньЖурналаРегистрации.Ошибка, , , "Пользователь не найден: " + НомерТелефона);
