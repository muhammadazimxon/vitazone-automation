            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Пользователь не найден""}");
            Возврат Ответ;
        КонецЕсли;

        ЗаписьЖурналаРегистрации("API.getCards", 
            УровеньЖурналаРегистрации.Информация, 
            , , 
            "Найден продавец: " + Продавец.Наименование + " (" + НомерТелефона + ")");

        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    ПластКарты.Ссылка КАК Ссылка,
            |    ПластКарты.НомерКарты КАК НомерКарты,
            |    ПластКарты.СрокДействия КАК СрокДействия,
            |    ПластКарты.Наименование КАК Наименование
            |ИЗ
            |    Справочник.ПластКарты КАК ПластКарты
            |ГДЕ
            |    ПластКарты.Владелец = &Владелец";
        Запрос.УстановитьПараметр("Владелец", Продавец);

        Результат = Запрос.Выполнить();
        Карты = Новый Массив;

        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            ДанныеКарты = Новый Структура;
            ДанныеКарты.Вставить("cardId", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
            ДанныеКарты.Вставить("cardNumber", Выборка.НомерКарты);
