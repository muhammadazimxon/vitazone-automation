Функция requestPayoutPOST(Запрос)
    Попытка
        // Логируем тело запроса
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("API.requestPayout", 
            УровеньЖурналаРегистрации.Информация, 
            , , 
            "Получен POST-запрос. Тело: " + ТелоЗапроса);

        // Парсим JSON
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);

        // Извлекаем данные
        НомерТелефона = Данные.PhoneNumber;
        Сумма = Данные.Amount;
        СпособВыплаты = Данные.Method;
        КартаИД = Данные.CardId;

        ЗаписьЖурналаРегистрации("API.requestPayout", 
            УровеньЖурналаРегистрации.Информация, 
            , , 
            "Обработка Amount: Значение = " + Сумма + ", Тип = " + ТипЗнч(Сумма));

        // Проверка параметров
        Если НомерТелефона = Неопределено ИЛИ ПустаяСтрока(НомерТелефона) Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Номер телефона не указан""}");
            Возврат Ответ;
        КонецЕсли;

        Если ТипЗнч(Сумма) <> Тип("Число") Тогда
            ЗаписьЖурналаРегистрации("API.requestPayout", 
                УровеньЖурналаРегистрации.Ошибка, 
                , , 
                "Некорректный тип суммы: " + ТипЗнч(Сумма));
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Некорректный формат суммы""}");
            Возврат Ответ;
        КонецЕсли;

        Если Сумма <= 0 Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Сумма должна быть больше 0""}");
            Возврат Ответ;
        КонецЕсли;

        Если СпособВыплаты = Неопределено ИЛИ ПустаяСтрока(СпособВыплаты) Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Способ выплаты не указан""}");
            Возврат Ответ;
        КонецЕсли;

        // Поиск продавца
        Продавец = Справочники.Продавцы.НайтиПоРеквизиту("НомерТелефона", НомерТелефона);
        Если Продавец.Пустая() Тогда
            ЗаписьЖурналаРегистрации("API.requestPayout", 
                УровеньЖурналаРегистрации.Ошибка, 
                , , 
                "Пользователь не найден: " + НомерТелефона);
            Ответ = Новый HTTPСервисОтвет(404);
            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Пользователь не найден""}");
            Возврат Ответ;
        КонецЕсли;

        // Проверка карты
        Карта = Справочники.ПластКарты.ПустаяСсылка();
        Если КартаИД <> Неопределено И НЕ ПустаяСтрока(КартаИД) Тогда
            Попытка
                УникальныйИдентификатор = Новый УникальныйИдентификатор(КартаИД);
                Карта = Справочники.ПластКарты.ПолучитьСсылку(УникальныйИдентификатор);
                Если Карта.ПолучитьОбъект() = Неопределено ИЛИ Карта.Владелец <> Продавец Тогда
                    Ответ = Новый HTTPСервисОтвет(400);
                    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
                    Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Карта не найдена или не принадлежит пользователю""}");
                    Возврат Ответ;
                КонецЕсли;
            Исключение
                ЗаписьЖурналаРегистрации("API.requestPayout", 
                    УровеньЖурналаРегистрации.Ошибка, 
                    , , 
                    "Ошибка обработки CardId: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
                Ответ = Новый HTTPСервисОтвет(400);
                Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
                Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Некорректный идентификатор карты""}");
                Возврат Ответ;
            КонецПопытки;
        КонецЕсли;

        // Проверка доступного остатка
        ЗапросОстаток = Новый Запрос;
        ЗапросОстаток.Текст = 
            "ВЫБРАТЬ
            |    ЕСТЬNULL(СУММА(НачисленныеБонусыОстатки.БонусОстаток), 0) КАК Остаток
            |ИЗ
            |    РегистрНакопления.НачисленныеБонусы.Остатки(, Продавец = &Продавец) КАК НачисленныеБонусыОстатки";
        ЗапросОстаток.УстановитьПараметр("Продавец", Продавец);
        Попытка
            РезультатОстаток = ЗапросОстаток.Выполнить();
            Если НЕ РезультатОстаток.Пустой() Тогда
                Выборка = РезультатОстаток.Выбрать();
                Выборка.Следующий();
                Остаток = Выборка.Остаток;
                ЗаписьЖурналаРегистрации("API.requestPayout", 
                    УровеньЖурналаРегистрации.Информация, 
                    , , 
                    "Остаток бонусов: " + Остаток + ", Тип: " + ТипЗнч(Остаток));
                Если Остаток < Сумма Тогда
                    Ответ = Новый HTTPСервисОтвет(400);
                    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
                    Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Недостаточно средств""}");
                    Возврат Ответ;
                КонецЕсли;
            Иначе
                ЗаписьЖурналаРегистрации("API.requestPayout", 
                    УровеньЖурналаРегистрации.Информация, 
                    , , 
                    "Остаток не найден для продавца: " + НомерТелефона);
                Ответ = Новый HTTPСервисОтвет(400);
                Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
                Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Остаток не найден""}");
                Возврат Ответ;
            КонецЕсли;
        Исключение
            ОписаниеОшибкиТекст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            ЗаписьЖурналаРегистрации("API.requestPayout", 
                УровеньЖурналаРегистрации.Ошибка, 
                , , 
                "Ошибка при проверке остатка: " + ОписаниеОшибкиТекст);
            Ответ = Новый HTTPСервисОтвет(500);
            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Ошибка проверки остатка: " + СтрЗаменить(ОписаниеОшибкиТекст, """", "\""") + """}");
            Возврат Ответ;
        КонецПопытки;

        // Проверка ограничения 24 часов
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    МАКСИМУМ(ЗапросыНаВыплаты.ДатаЗапроса) КАК ПоследнийЗапрос
            |ИЗ
            |    РегистрСведений.ЗапросыНаВыплаты КАК ЗапросыНаВыплаты
            |ГДЕ
            |    ЗапросыНаВыплаты.Пользователь = &Пользователь
            |    И ЗапросыНаВыплаты.ДатаЗапроса ЕСТЬ НЕ NULL";
        Запрос.УстановитьПараметр("Пользователь", Продавец);
        Попытка
            Результат = Запрос.Выполнить();
            Если НЕ Результат.Пустой() Тогда
                Выборка = Результат.Выбрать();
                Выборка.Следующий();
                Если Выборка.ПоследнийЗапрос <> Null И ТипЗнч(Выборка.ПоследнийЗапрос) = Тип("Дата") Тогда
                    Попытка
                        РазницаВСекундах = (ТекущаяДата() - Выборка.ПоследнийЗапрос);
                        ЗаписьЖурналаРегистрации("API.requestPayout", 
                            УровеньЖурналаРегистрации.Информация, 
                            , , 
                            "Разница с последним запросом: " + РазницаВСекундах + " секунд");
                        Если РазницаВСекундах < 24 * 3600 Тогда
                            Ответ = Новый HTTPСервисОтвет(429);
                            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
                            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Новый запрос возможен через 24 часа после последнего""}");
                            Возврат Ответ;
                        КонецЕсли;
                    Исключение
                        ОписаниеОшибкиТекст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
                        ЗаписьЖурналаРегистрации("API.requestPayout", 
                            УровеньЖурналаРегистрации.Ошибка, 
                            , , 
                            "Ошибка при вычислении разницы дат: " + ОписаниеОшибкиТекст);
                        Ответ = Новый HTTPСервисОтвет(500);
                        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
                        Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Ошибка проверки времени последнего запроса""}");
                        Возврат Ответ;
                    КонецПопытки;
                Иначе
                    ЗаписьЖурналаРегистрации("API.requestPayout", 
                        УровеньЖурналаРегистрации.Информация, 
                        , , 
                        "Нет валидной даты последнего запроса для продавца: " + НомерТелефона);
                КонецЕсли;
            Иначе
                ЗаписьЖурналаРегистрации("API.requestPayout", 
                    УровеньЖурналаРегистрации.Информация, 
                    , , 
                    "Записей о предыдущих запросах не найдено для продавца: " + НомерТелефона);
            КонецЕсли;
        Исключение
            ОписаниеОшибкиТекст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            ЗаписьЖурналаРегистрации("API.requestPayout", 
                УровеньЖурналаРегистрации.Ошибка, 
                , , 
                "Ошибка выполнения запроса к ЗапросыНаВыплаты: " + ОписаниеОшибкиТекст);
            Ответ = Новый HTTPСервисОтвет(500);
            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Ошибка проверки времени последнего запроса""}");
            Возврат Ответ;
        КонецПопытки;

        // Запись в регистр сведений
        Попытка
            Запись = РегистрыСведений.ЗапросыНаВыплаты.СоздатьМенеджерЗаписи();
            Запись.Период = ТекущаяДата();
            Запись.Пользователь = Продавец;
            Запись.Сумма = Сумма;
            Запись.СпособВыплаты = СпособВыплаты;
            Запись.Карта = Карта;
            Запись.Статус = "Ожидание";
            Запись.ДатаЗапроса = ТекущаяДата();
            Запись.Записать();

            ЗаписьЖурналаРегистрации("API.requestPayout", 
                УровеньЖурналаРегистрации.Информация, 
                , , 
                "Запрос на выплату записан: Пользователь = " + НомерТелефона + ", Сумма = " + Сумма + ", Способ = " + СпособВыплаты);
        Исключение
            ОписаниеОшибкиТекст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            ЗаписьЖурналаРегистрации("API.requestPayout", 
                УровеньЖурналаРегистрации.Ошибка, 
                , , 
                "Ошибка записи в ЗапросыНаВыплаты: " + ОписаниеОшибкиТекст);
            Ответ = Новый HTTPСервисОтвет(500);
            Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Ошибка записи запроса на выплату""}");
            Возврат Ответ;
        КонецПопытки;

        // Успешный ответ
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки("{""success"": true}");

    Исключение
        ОписаниеОшибкиТекст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписьЖурналаРегистрации("API.requestPayout", 
            УровеньЖурналаРегистрации.Ошибка, 
            , , 
            "Критическая ошибка: " + ОписаниеОшибкиТекст + ", Тело: " + ТелоЗапроса);
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Внутренняя ошибка сервера: " + СтрЗаменить(ОписаниеОшибкиТекст, """", "\""") + """}");
    КонецПопытки;

    Возврат Ответ;
КонецФункции