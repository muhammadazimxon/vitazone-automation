Функция LoginPOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        // Читаем тело запроса
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        
        // Проверяем, что тело запроса не пустое
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("success, error", Ложь, "Пустое тело запроса")));
            ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Ошибка,,, "Пустое тело запроса");
            Возврат Ответ;
        КонецЕсли;
        
        // Логируем тело запроса для отладки
        ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Информация,,, "Тело запроса: " + ТелоЗапроса);
        
        // Парсим JSON
        Данные = ПрочитатьJSONИзСтроки(ТелоЗапроса);
        
        // Проверяем, что Данные - это структура
        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("success, error", Ложь, "Невалидный формат JSON")));
            ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Ошибка,,, "Невалидный формат JSON: " + ТелоЗапроса);
            Возврат Ответ;
        КонецЕсли;
        
        // Проверяем наличие полей
        Если НЕ Данные.Свойство("phone") ИЛИ НЕ Данные.Свойство("password") Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("success, error", Ложь, "Отсутствуют обязательные параметры phone или password")));
            ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Ошибка,,, "Отсутствуют поля phone или password");
            Возврат Ответ;
        КонецЕсли;
        
        Телефон = Данные.phone;
        Пароль = Данные.password;
        
        // Нормализуем номер телефона (удаляем всё, кроме цифр)
        Телефон = СтрЗаменить(Телефон, " ", "");
        Телефон = СтрЗаменить(Телефон, "+", "");
        
        // Логируем входные данные для отладки
        ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Информация,,, "Телефон: " + Телефон + ", Пароль: " + Пароль);
        
        // Проверяем наличие продавца в справочнике
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    Продавцы.Ссылка,
            |    Продавцы.Имя,
            |    Продавцы.Фамилия,
            |    Продавцы.ИНН,
            |    Продавцы.НомерТелефона,
            |    Продавцы.Пароль
            |ИЗ
            |    Справочник.Продавцы КАК Продавцы
            |ГДЕ
            |    Продавцы.НомерТелефона = &Телефон
            |    И Продавцы.Пароль = &Пароль";
        
        Запрос.УстановитьПараметр("Телефон", Телефон);
        Запрос.УстановитьПараметр("Пароль", Пароль);
        
        Результат = Запрос.Выполнить();
        
        Если Результат.Пустой() Тогда
            // Логируем, что запись не найдена
            ЗапросПроверка = Новый Запрос;
            ЗапросПроверка.Текст = 
                "ВЫБРАТЬ
                |    Продавцы.НомерТелефона,
                |    Продавцы.Пароль
                |ИЗ
                |    Справочник.Продавцы КАК Продавцы
                |ГДЕ
                |    Продавцы.НомерТелефона = &Телефон";
            ЗапросПроверка.УстановитьПараметр("Телефон", Телефон);
            РезультатПроверка = ЗапросПроверка.Выполнить();
            
            Если РезультатПроверка.Пустой() Тогда
                ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Информация,,, "Пользователь с телефоном " + Телефон + " не найден");
            Иначе
                ВыборкаПроверка = РезультатПроверка.Выбрать();
                ВыборкаПроверка.Следующий();
                ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Информация,,, "Пользователь найден, но пароль не совпадает. Пароль в базе: " + ВыборкаПроверка.Пароль);
            КонецЕсли;
            
            Ответ = Новый HTTPСервисОтвет(401);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("success, error", Ложь, "Неверный телефон или пароль")));
            Возврат Ответ;
        КонецЕсли;
        
        // Формируем ответ
        Выборка = Результат.Выбрать();
Выборка.Следующий();

ОтветДанные = Новый Структура;
ОтветДанные.Вставить("success", Истина);
ОтветДанные.Вставить("phone", Телефон);
ОтветДанные.Вставить("name", Выборка.Имя);
ОтветДанные.Вставить("surname", Выборка.Фамилия);
//ОтветДанные.Вставить("inn", Выборка.ИНН);

        
        JSONОтвет = СформироватьJSON(ОтветДанные);
        ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Информация,,, "Сформированный JSON: " + JSONОтвет);
        Ответ.УстановитьТелоИзСтроки(JSONОтвет);
        
    Исключение
        Ошибка = ОписаниеОшибки();
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("success, error", Ложь, Ошибка)));
        ЗаписьЖурналаРегистрации("SellerAuth.LoginPOST", УровеньЖурналаРегистрации.Ошибка,,, Ошибка);
    КонецПопытки;
    
    Возврат Ответ;
КонецФункции

Функция ProfileGET(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        // Логируем все параметры запроса
        ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
        Для Каждого Параметр Из ПараметрыЗапроса Цикл
            ЗаписьЖурналаРегистрации("SellerAuth.ProfileGET", УровеньЖурналаРегистрации.Информация,,, 
                "Параметр запроса: " + Параметр.Ключ + " = " + Параметр.Значение);
        КонецЦикла;
        
        Телефон = Запрос.ПараметрыЗапроса.Получить("phone");
        Если Телефон = Неопределено Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("success, error", Ложь, "Отсутствует параметр phone")));
            ЗаписьЖурналаРегистрации("SellerAuth.ProfileGET", УровеньЖурналаРегистрации.Ошибка,,, "Параметр phone отсутствует");
            Возврат Ответ;
        КонецЕсли;
        
        // Нормализуем номер телефона (удаляем всё, кроме цифр)
        Телефон = СтрЗаменить(Телефон, " ", "");
        Телефон = СтрЗаменить(Телефон, "+", "");
        
        // Проверяем наличие продавца по номеру телефона
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    Продавцы.Имя,
            |    Продавцы.Фамилия,
            |    Продавцы.НомерТелефона,
            |    Продавцы.Аптека.Наименование КАК Аптека
            |ИЗ
            |    Справочник.Продавцы КАК Продавцы
            |ГДЕ
            |    Продавцы.НомерТелефона = &Телефон";
        
        Запрос.УстановитьПараметр("Телефон", Телефон);
        
        Результат = Запрос.Выполнить();
        
        Если Результат.Пустой() Тогда
            Ответ = Новый HTTPСервисОтвет(401);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("success, error", Ложь, "Пользователь с таким телефоном не найден")));
            Возврат Ответ;
        КонецЕсли;
        
        // Формируем ответ
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        
        ОтветДанные = Новый Структура;
        ОтветДанные.Вставить("success", Истина);
        ОтветДанные.Вставить("name", Выборка.Имя);
        ОтветДанные.Вставить("surname", Выборка.Фамилия);
        ОтветДанные.Вставить("phone", Выборка.НомерТелефона);
        ОтветДанные.Вставить("pharmacy", ?(ЗначениеЗаполнено(Выборка.Аптека), Выборка.Аптека, ""));
        
        Ответ.УстановитьТелоИзСтроки(СформироватьJSON(ОтветДанные));
        
    Исключение
        Ошибка = ОписаниеОшибки();
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("success, error", Ложь, Ошибка)));
        ЗаписьЖурналаРегистрации("SellerAuth.ProfileGET", УровеньЖурналаРегистрации.Ошибка,,, Ошибка);
    КонецПопытки;
    
    Возврат Ответ;
КонецФункции

Функция СформироватьJSON(Данные)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Результат = ЗаписьJSON.Закрыть();
    // Убедимся, что результат в UTF-8
    Возврат Результат;
КонецФункции

Функция ПрочитатьJSONИзСтроки(Строка)
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Строка);
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Данные;
    Исключение
        ЗаписьЖурналаРегистрации("SellerAuth.ПрочитатьJSON", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
        ВызватьИсключение "Ошибка разбора JSON: " + ОписаниеОшибки();
    КонецПопытки;
КонецФункции


// Модуль HTTP-сервиса SellerAuth

Функция bonusesGET(Запрос)
    
    // Получение параметров из URL
    НомерТелефона = Запрос.ПараметрыURL["phone"];
    ПериодСтрокой = Запрос.ПараметрыURL["period"];
    
    // Ответ в формате JSON
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        // Найти продавца по номеру телефона
        Продавец = НайтиПродавцаПоНомеруТелефона(НомерТелефона);
        Если Продавец.Пустая() Тогда
            Ответ.КодСостояния = 404;
            Ответ.УстановитьТелоИзСтроки("{""error"": ""Продавец не найден""}");
            Возврат Ответ;
        КонецЕсли;
        
        // Определить границы периода
        ДатаНачала = Неопределено;
        ДатаОкончания = ТекущаяДатаСеанса();
        
        Если ПериодСтрокой = "month" Тогда
            ДатаНачала = НачалоМесяца(ДобавитьМесяц(ДатаОкончания, -1));
        ИначеЕсли ПериодСтрокой = "quarter" Тогда
            ДатаНачала = НачалоКвартала(ДобавитьМесяц(ДатаОкончания, -3));
        ИначеЕсли ПериодСтрокой = "year" Тогда
            ДатаНачала = НачалоГода(ДобавитьМесяц(ДатаОкончания, -12));
        Иначе
            Ответ.КодСостояния = 400;
            Ответ.УстановитьТелоИзСтроки("{""error"": ""Неверный период""}");
            Возврат Ответ;
        КонецЕсли;
        
        // Получить данные из регистра накопления
        ДанныеБонусов = ПолучитьДанныеБонусов(Продавец, ДатаНачала, ДатаОкончания);
        
        // Формирование JSON-ответа
        СтруктураОтвета = Новый Структура;
        СтруктураОтвета.Вставить("totalAccrued", ДанныеБонусов.ВсегоНачислено);
        СтруктураОтвета.Вставить("totalPaid", ДанныеБонусов.ВсегоОплачено);
        СтруктураОтвета.Вставить("availableBalance", ДанныеБонусов.ДоступныйОстаток);
        
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
        
    Исключение
        Ответ.КодСостояния = 500;
        Ответ.УстановитьТелоИзСтроки("{""error"": """ + ОписаниеОшибки() + """}");
    КонецПопытки;
    
    Возврат Ответ;
    
КонецФункции

// Найти продавца по номеру телефона
Функция НайтиПродавцаПоНомеруТелефона(НомерТелефона)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Продавцы.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Продавцы КАК Продавцы
        |ГДЕ
        |	Продавцы.НомерТелефона = &НомерТелефона";
    
    Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);
    Результат = Запрос.Выполнить();
    
    Если Результат.Пустой() Тогда
        Возврат Справочники.Продавцы.ПустаяСсылка();
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Ссылка;
    
КонецФункции

// Получить данные из регистра накопления НачисленныеБонусы
Функция ПолучитьДанныеБонусов(Продавец, ДатаНачала, ДатаОкончания)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ЕСТЬNULL(СУММА(ВЫБОР
        |				КОГДА НачисленныеБонусы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
        |					ТОГДА НачисленныеБонусы.Бонус
        |				ИНАЧЕ 0
        |			КОНЕЦ), 0) КАК ВсегоНачислено,
        |	ЕСТЬNULL(СУММА(ВЫБОР
        |				КОГДА НачисленныеБонусы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
        |					ТОГДА НачисленныеБонусы.Бонус
        |				ИНАЧЕ 0
        |			КОНЕЦ), 0) КАК ВсегоОплачено
        |ИЗ
        |	РегистрНакопления.НачисленныеБонусы КАК НачисленныеБонусы
        |ГДЕ
        |	НачисленныеБонусы.Продавец = &Продавец
        |	И НачисленныеБонусы.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	0,
        |	0
        |ИЗ
        |	РегистрНакопления.НачисленныеБонусы.Остатки(, Продавец = &Продавец) КАК НачисленныеБонусыОстатки
        |ГДЕ
        |	НачисленныеБонусыОстатки.БонусОстаток ЕСТЬ НЕ NULL";
    
    Запрос.УстановитьПараметр("Продавец", Продавец);
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Данные = Новый Структура;
    Данные.Вставить("ВсегоНачислено", 0);
    Данные.Вставить("ВсегоОплачено", 0);
    Данные.Вставить("ДоступныйОстаток", 0);
    
    // Суммы за период
    Если Выборка.Следующий() Тогда
        Данные.ВсегоНачислено = Выборка.ВсегоНачислено;
        Данные.ВсегоОплачено = Выборка.ВсегоОплачено;
    КонецЕсли;
    
    // Остаток на текущий момент
    ЗапросОстатки = Новый Запрос;
    ЗапросОстатки.Текст = 
        "ВЫБРАТЬ
        |	ЕСТЬNULL(НачисленныеБонусыОстатки.БонусОстаток, 0) КАК Остаток
        |ИЗ
        |	РегистрНакопления.НачисленныеБонусы.Остатки(, Продавец = &Продавец) КАК НачисленныеБонусыОстатки";
    
    ЗапросОстатки.УстановитьПараметр("Продавец", Продавец);
    РезультатОстатки = ЗапросОстатки.Выполнить();
    
    Если НЕ РезультатОстатки.Пустой() Тогда
        ВыборкаОстатки = РезультатОстатки.Выбрать();
        ВыборкаОстатки.Следующий();
        Данные.ДоступныйОстаток = ВыборкаОстатки.Остаток;
    КонецЕсли;
    
    Возврат Данные;
    
КонецФункции



Функция addCardPOST(Запрос)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
    Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
    
    НомерТелефона = Данные.PhoneNumber;
    НомерКарты = Данные.CardNumber;
    СрокДействия = Данные.ExpiryDate;
    Наименование = Данные.CardName;
    
    Продавец = Справочники.Продавцы.НайтиПоРеквизиту("НомерТелефона", НомерТелефона);
    Если Продавец.Пустая() Тогда
        Ответ = Новый HTTPСервисОтвет(404);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки("{""success"": false, ""error"": ""Пользователь не найден""}");
        Возврат Ответ;
    КонецЕсли;
    
    ЗапросПроверка = Новый Запрос;
    ЗапросПроверка.Текст = 
        "ВЫБРАТЬ
        |	ПластКарты.Ссылка
        |ИЗ
        |	Справочник.ПластКарты КАК ПластКарты
        |ГДЕ
        |	ПластКарты.Владелец = &Владелец
        |	И ПластКарты.НомерКарты = &НомерКарты";
    ЗапросПроверка.УстановитьПараметр("Владелец", Продавец);
    ЗапросПроверка.УстановитьПараметр("НомерКарты", НомерКарты);
    
    Если НЕ ЗапросПроверка.Выполнить().Пустой() Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
