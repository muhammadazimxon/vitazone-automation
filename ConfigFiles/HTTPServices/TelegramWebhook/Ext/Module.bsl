Функция Index(Запрос)
    Попытка
        // Получаем тело запроса от Telegram
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 1: Получено тело запроса: " + ТелоЗапроса);
        
        // Проверяем, что тело запроса не пустое
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Ошибка,,, "Шаг 2: Тело запроса пустое");
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: тело запроса пустое");
            Возврат Ответ;
        КонецЕсли;
        
        // Парсим JSON
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 3: JSON успешно распарсен");
        
        // Проверяем наличие message и chat.id
        Если НЕ Данные.Свойство("message") Или НЕ Данные.message.Свойство("chat") Или НЕ Данные.message.chat.Свойство("id") Тогда
            ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Ошибка,,, "Шаг 4: Некорректный формат данных от Telegram");
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: некорректный формат данных от Telegram");
            Возврат Ответ;
        КонецЕсли;
        
        // Извлекаем Telegram ID
        TelegramID = Формат(Данные.message.chat.id, "ЧГ=0");
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 5: TelegramID извлечён: " + TelegramID);
        
        // Проверяем текст сообщения
        ТекстСообщенияПользователя = Данные.message.text;
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 6: Текст сообщения: " + ТекстСообщенияПользователя);
        
        // Проверяем, является ли это командой /start
        ЭтоКомандаStart = Ложь;
        Если СтрНачинаетсяС(ТекстСообщенияПользователя, "/start") Тогда
            ЭтоКомандаStart = Истина;
            ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 6.1: Текст начинается с /start");
        ИначеЕсли Данные.message.Свойство("entities") Тогда
            ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 6.2: Проверка entities");
            Для Каждого Entity Из Данные.message.entities Цикл
                Если Entity.Свойство("type") И Entity.type = "bot_command" Тогда
                    Если СтрНачинаетсяС(ТекстСообщенияПользователя, "/start") Тогда
                        ЭтоКомандаStart = Истина;
                        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 6.3: Найдена команда /start в entities");
                        Прервать;
                    КонецЕсли;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        
        // Если это команда /start, создаём пользователя
        Если ЭтоКомандаStart Тогда
            ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 7: Обработка команды /start");
            
            // Проверяем, есть ли пользователь в справочнике
            Пользователь = НайтиПользователяПоTelegramID(TelegramID);
            
            Если Пользователь = Неопределено Тогда
                // Создаём нового пользователя без имени
                userID = СоздатьПользователяБезИмени(TelegramID);
                ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 8: Создан новый пользователь: TelegramID = " + TelegramID + ", userID = " + userID);
            Иначе
                userID = Пользователь.userID;
                ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 8: Пользователь уже существует: TelegramID = " + TelegramID + ", userID = " + userID);
                
                Если ПустаяСтрока(Пользователь.Наименование) Тогда
                    // Пользователь уже создан, но имя не заполнено
                    ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 9: Ожидается ввод имени");
                    Ответ = Новый HTTPСервисОтвет(200);
                    Возврат Ответ;
                КонецЕсли;
                
                // Если имя уже есть, сохраняем Deep Link в справочнике
                ПользовательОбъект = Пользователь.ПолучитьОбъект();
                ПользовательОбъект.DeepLink = "daantec://auth?userId=" + userID;
                ПользовательОбъект.Записать();
                ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 9: Deep Link сохранён: " + ПользовательОбъект.DeepLink);
                
                Ответ = Новый HTTPСервисОтвет(200);
                Возврат Ответ;
            КонецЕсли;
            
            Ответ = Новый HTTPСервисОтвет(200);
            Возврат Ответ;
        КонецЕсли;
        
        // Если это текстовое сообщение, считаем, что пользователь отправил имя и фамилию
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 7: Обработка текстового сообщения (имя и фамилия)");
        
        Пользователь = НайтиПользователяПоTelegramID(TelegramID);
        Если Пользователь = Неопределено Тогда
            ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Ошибка,,, "Шаг 8: Пользователь не найден: TelegramID = " + TelegramID);
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: пользователь не найден");
            Возврат Ответ;
        КонецЕсли;
        
        // Сохраняем имя и фамилию
        ПользовательОбъект = Пользователь.ПолучитьОбъект();
        ПользовательОбъект.Наименование = ТекстСообщенияПользователя;
        ПользовательОбъект.ДатаИВремя = ТекущаяДата();
        ПользовательОбъект.DeepLink = "daantec://auth?userId=" + Пользователь.userID; // Сохраняем Deep Link
        ПользовательОбъект.Записать();
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "Шаг 9: Имя и Deep Link сохранены: Наименование = " + ПользовательОбъект.Наименование + ", Deep Link = " + ПользовательОбъект.DeepLink);
        
        Ответ = Новый HTTPСервисОтвет(200);
        Возврат Ответ;
        
    Исключение
        ОписаниеОшибкиТекст = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Ошибка,,, "Шаг 10: Ошибка обработки запроса: " + ОписаниеОшибкиТекст);
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка: " + ОписаниеОшибкиТекст);
        Возврат Ответ;
    КонецПопытки;
КонецФункции

Функция НайтиПользователяПоTelegramID(TelegramID)
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    Пользователи.Ссылка КАК Ссылка,
            |    Пользователи.userID КАК userID,
            |    Пользователи.Наименование КАК Наименование,
            |    Пользователи.DeepLink КАК DeepLink
            |ИЗ
            |    Справочник.Пользователи КАК Пользователи
            |ГДЕ
            |    Пользователи.TelegramID = &TelegramID";
        
        Запрос.УстановитьПараметр("TelegramID", TelegramID);
        Результат = Запрос.Выполнить();
        
        Если Результат.Пустой() Тогда
            ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "НайтиПользователяПоTelegramID: Пользователь не найден: TelegramID = " + TelegramID);
            Возврат Неопределено;
        КонецЕсли;
        
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "НайтиПользователяПоTelegramID: Пользователь найден: TelegramID = " + TelegramID);
        Возврат Выборка;
    Исключение
        ОписаниеОшибкиТекст = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка в НайтиПользователяПоTelegramID: " + ОписаниеОшибкиТекст);
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция СоздатьПользователяБезИмени(TelegramID)
    Попытка
        НовыйПользователь = Справочники.Пользователи.СоздатьЭлемент();
        НовыйПользователь.TelegramID = TelegramID;
        НовыйПользователь.userID = Строка(Новый УникальныйИдентификатор());
        НовыйПользователь.ДатаИВремя = ТекущаяДата();
        НовыйПользователь.Записать();
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Информация,,, "СоздатьПользователяБезИмени: Пользователь успешно создан: TelegramID = " + TelegramID);
        Возврат НовыйПользователь.userID;
    Исключение
        ОписаниеОшибкиТекст = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("TelegramWebhook", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка в СоздатьПользователяБезИмени: " + ОписаниеОшибкиТекст);
        Возврат "";
    КонецПопытки;
КонецФункции