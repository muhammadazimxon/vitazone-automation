Функция CheckDebtGET(Запрос)
// Получаем параметр ИНН из URL
ИННСтрока = Запрос.ПараметрыURL["INN"];
Если Не ЗначениеЗаполнено(ИННСтрока) Тогда
Ответ = Новый HTTPСервисОтвет(400);
Ответ.УстановитьТелоИзСтроки(СформироватьJSONОшибка("ИНН не указан"));
Ответ.Заголовки.Вставить("Content-Type", "application/json");
Возврат Ответ;
КонецЕсли;
// Преобразуем ИНН в число (поскольку в базе Контрагенты.ИНН - число)
Попытка
ИННЧисло = Число(ИННСтрока);
Исключение
Ответ = Новый HTTPСервисОтвет(400);
Ответ.УстановитьТелоИзСтроки(СформироватьJSONОшибка("Некорректный формат ИНН"));
Ответ.Заголовки.Вставить("Content-Type", "application/json");
Возврат Ответ;
КонецПопытки;
// Текущая дата для расчета просрочки
ТекущаяДата = ТекущаяДата();
// Запрос с учетом фильтра по Счет = Основной счет и добавлением ДатаСоставления, СрокДействия
Запрос = Новый Запрос;
Запрос.Текст =
"ВЫБРАТЬ
|	Договоры.Ссылка КАК ДокНомер,
|	Договоры.ДатаСоставления КАК ДатаСоставления,
|	Договоры.СрокДействия КАК СрокДействия,
|	ВЫБОР
|		КОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) < 0
|			ТОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0)
|		ИНАЧЕ 0
|	КОНЕЦ КАК СуммаЗадолженности,
|	ВЫБОР
|		КОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) < 0
|				И Договоры.СрокДействия <> ДАТАВРЕМЯ(1, 1, 1)
|				И РАЗНОСТЬДАТ(Договоры.СрокДействия, &ТекущаяДата, ДЕНЬ) >= 30
|				И РАЗНОСТЬДАТ(Договоры.СрокДействия, &ТекущаяДата, ДЕНЬ) <= 3650
|			ТОГДА РАЗНОСТЬДАТ(Договоры.СрокДействия, &ТекущаяДата, ДЕНЬ)
|		КОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) < 0
|				И Договоры.СрокДействия <> ДАТАВРЕМЯ(1, 1, 1)
|			ТОГДА 0
|		ИНАЧЕ 0
|	КОНЕЦ КАК КоличествоДнейПросрочки
|ИЗ
|	Справочник.Договор КАК Договоры
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Дебиторка.Остатки(&ТекущаяДата, Счет = ЗНАЧЕНИЕ(Справочник.Организация.ОсновнойСчет)) КАК ДебиторкаОстатки
|		ПО Договоры.Ссылка = ДебиторкаОстатки.ДокНомер
|			И Договоры.Владелец = ДебиторкаОстатки.Контрагенты
|			И (ДебиторкаОстатки.Статья = ЗНАЧЕНИЕ(Справочник.Статьи.Продажа))
|ГДЕ
|	НЕ Договоры.ПометкаУдаления
|	И Договоры.Владелец.ИНН = &ИННЧисло
|	И ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) < 0
|	И Договоры.СрокДействия <> ДАТАВРЕМЯ(1, 1, 1)
|	И Договоры.СрокДействия ЕСТЬ НЕ NULL
|	И Договоры.ДатаСоставления <> ДАТАВРЕМЯ(1, 1, 1)
|	И Договоры.ДатаСоставления ЕСТЬ НЕ NULL";
Запрос.УстановитьПараметр("ИННЧисло", ИННЧисло);
Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
Результат = Запрос.Выполнить();
// Формируем массив для JSON с проблемными договорами
МассивПросрочек = Новый Массив;
Если НЕ Результат.Пустой() Тогда
Выборка = Результат.Выбрать();
Пока Выборка.Следующий() Цикл
СтруктураПросрочки = Новый Структура;
СтруктураПросрочки.Вставить("ДокНомер", Строка(Выборка.ДокНомер));
СтруктураПросрочки.Вставить("Сумма", Выборка.СуммаЗадолженности);
СтруктураПросрочки.Вставить("ДниПросрочки", Выборка.КоличествоДнейПросрочки);
СтруктураПросрочки.Вставить("ДатаСоставления", Формат(Выборка.ДатаСоставления, "ДФ=dd.MM.yyyy"));
СтруктураПросрочки.Вставить("СрокДействия", Формат(Выборка.СрокДействия, "ДФ=dd.MM.yyyy"));
МассивПросрочек.Добавить(СтруктураПросрочки);
КонецЦикла;
КонецЕсли;
// Формируем JSON-ответ
ЗаписьJSON = Новый ЗаписьJSON;
ЗаписьJSON.УстановитьСтроку();
ЗаписатьJSON(ЗаписьJSON, МассивПросрочек);
СтрокаJSON = ЗаписьJSON.Закрыть();
// Возвращаем JSON с кодом 200
Ответ = Новый HTTPСервисОтвет(200);
Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
Ответ.Заголовки.Вставить("Content-Type", "application/json");
Возврат Ответ;
КонецФункции
// Формирует JSON для ошибок
Функция СформироватьJSONОшибка(ТекстОшибки)
СтруктураОшибки = Новый Структура("Ошибка", ТекстОшибки);
ЗаписьJSON = Новый ЗаписьJSON;
ЗаписьJSON.УстановитьСтроку();
ЗаписатьJSON(ЗаписьJSON, СтруктураОшибки);
Возврат ЗаписьJSON.Закрыть();
КонецФункции