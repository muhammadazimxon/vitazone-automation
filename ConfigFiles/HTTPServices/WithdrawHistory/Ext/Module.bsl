Function History(Запрос) Export
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    // Логируем полный URL
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Полный URL: " + Запрос.БазовыйURL + Запрос.ОтносительныйURL
    );
    
    // Логируем параметры URL
    ПараметрыURLСтрокой = "";
    Для Каждого Параметр Из Запрос.ПараметрыURL Цикл
        ПараметрыURLСтрокой = ПараметрыURLСтрокой + Параметр.Ключ + "=" + Параметр.Значение + "; ";
    КонецЦикла;
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Параметры URL: " + ?(ПустаяСтрока(ПараметрыURLСтрокой), "Отсутствуют", ПараметрыURLСтрокой)
    );
    
    // Извлекаем phoneNumber из ПараметрыURL
    НомерТелефона = Запрос.ПараметрыURL.Получить("phoneNumber");
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Извлечённый phoneNumber (ПараметрыURL): " + ?(НомерТелефона = Неопределено, "Не определено", НомерТелефона)
    );
    
    // Проверяем, удалось ли извлечь номер телефона
    Если НомерТелефона = Неопределено Или ПустаяСтрока(НомерТелефона) Тогда
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.Withdraw.History",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Ошибка: Номер телефона не указан"
        );
        Ответ.КодСостояния = 400;
        Ответ.УстановитьТелоИзСтроки(
            СериализоватьJSON(Новый Структура("success, error", Ложь, "Номер телефона не указан"))
        );
        Возврат Ответ;
    КонецЕсли;
    
    // Логируем перед поиском пользователя
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Поиск пользователя по номеру телефона: " + НомерТелефона
    );
    
    Пользователь = НайтиПользователяПоНомеруТелефона(НомерТелефона);
    Если Пользователь.Пустая() Тогда
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.Withdraw.History",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Пользователь не найден для номера: " + НомерТелефона
        );
        Ответ.КодСостояния = 200;
        Ответ.УстановитьТелоИзСтроки(
            СериализоватьJSON(Новый Структура("success, error", Ложь, "Пользователь не найден"))
        );
        Возврат Ответ;
    КонецЕсли;
    
    // Логируем успешный поиск пользователя
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Пользователь найден: " + Пользователь
    );
    
    Запросы = ПолучитьЗапросыНаВыплаты(Пользователь);
    
    // Логируем количество найденных запросов
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Найдено запросов на выплаты: " + Запросы.Количество()
    );
    
    Результат = Новый Структура;
    Результат.Вставить("success", Истина);
    Результат.Вставить("transactions", Запросы);
    
    Ответ.УстановитьТелоИзСтроки(СериализоватьJSON(Результат));
    Возврат Ответ;
КонецФункции

Function НайтиПользователяПоНомеруТелефона(НомерТелефона)
    // Нормализация номера телефона
    НомерТелефона = СтрЗаменить(НомерТелефона, " ", "");
    НомерТелефона = СтрЗаменить(НомерТелефона, "-", "");
    НомерТелефона = СтрЗаменить(НомерТелефона, "+", "");
    
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Нормализованный номер телефона: " + НомерТелефона
    );
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Продавцы.Ссылка КАК Ссылка,
        |    Продавцы.НомерТелефона КАК НомерТелефона
        |ИЗ
        |    Справочник.Продавцы КАК Продавцы
        |ГДЕ
        |    Продавцы.НомерТелефона = &НомерТелефона
        |    ИЛИ Продавцы.НомерТелефона = &НомерТелефонаСPlus";
    Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);
    Запрос.УстановитьПараметр("НомерТелефонаСPlus", "+" + НомерТелефона);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Если Выборка.Следующий() Тогда
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.Withdraw.History",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Пользователь найден: " + Выборка.Ссылка + ", Номер в базе: " + Выборка.НомерТелефона
        );
        Возврат Выборка.Ссылка;
    Иначе
        ЗаписьЖурналаРегистрации(
            "HTTPСервис.Withdraw.History",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            "Пользователь не найден для номера: " + НомерТелефона
        );
        Возврат Справочники.Продавцы.ПустаяСсылка();
    КонецЕсли;
КонецФункции

Function ПолучитьЗапросыНаВыплаты(Пользователь)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ЗапросыНаВыплаты.Сумма КАК amount,
        |    ЗапросыНаВыплаты.СпособВыплаты КАК paymentMethod,
        |    ЗапросыНаВыплаты.Статус КАК status,
        |    ЗапросыНаВыплаты.ДатаЗапроса КАК requestDate,
        |    ЗапросыНаВыплаты.Комментарий КАК comment
        |ИЗ
        |    РегистрСведений.ЗапросыНаВыплаты КАК ЗапросыНаВыплаты
        |ГДЕ
        |    ЗапросыНаВыплаты.Пользователь = &Пользователь
        |УПОРЯДОЧИТЬ ПО
        |    ЗапросыНаВыплаты.ДатаЗапроса УБЫВ";
    Запрос.УстановитьПараметр("Пользователь", Пользователь);
    
    Результат = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        Запись = Новый Структура;
        Запись.Вставить("amount", Формат(Выборка.amount, "ЧГ=0"));
        Запись.Вставить("paymentMethod", ?(Выборка.paymentMethod = Null, "", Выборка.paymentMethod));
        Запись.Вставить("status", ?(Выборка.status = Null, "", Строка(Выборка.status)));
        Запись.Вставить("requestDate", ?(Выборка.requestDate = Null, "", Формат(Выборка.requestDate, "ДФ='yyyy-MM-dd HH:mm:ss'")));
        Запись.Вставить("comment", ?(Выборка.comment = Null, "", Выборка.comment));
        Результат.Добавить(Запись);
    КонецЦикла;
    
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Сформировано записей: " + Результат.Количество()
    );
    
    Возврат Результат;
КонецФункции

Function СериализоватьJSON(Данные)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, , , , , , , Ложь));
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Результат = ЗаписьJSON.Закрыть();
    
    ЗаписьЖурналаРегистрации(
        "HTTPСервис.Withdraw.History",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "JSON ответ: " + Результат
    );
    
    Возврат Результат;
КонецФункции