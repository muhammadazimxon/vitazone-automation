Функция sendsmsPOST(Запрос)
    // Получаем данные из тела запроса
    Тело = Запрос.ПолучитьТелоКакСтроку();
    
    // Логируем тело для отладки
    ЗаписьЖурналаРегистрации("Auth.sendsmsPOST", УровеньЖурналаРегистрации.Информация,,, 
        "Тело запроса: " + Тело);
    
    // Проверяем, что тело не пустое
    Если ПустаяСтрока(Тело) Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("{""success"":false, ""message"":""Тело запроса пустое""}");
        Возврат Ответ;
    КонецЕсли;
    
    // Пробуем разобрать JSON
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Тело);
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
    Исключение
        ЗаписьЖурналаРегистрации("Auth.sendsmsPOST", УровеньЖурналаРегистрации.Ошибка,,, 
            "Ошибка разбора JSON: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("{""success"":false, ""message"":""Неверный формат JSON""}");
        Возврат Ответ;
    КонецПопытки;
    
    // Проверяем наличие поля phone
    Если НЕ Данные.Свойство("phone") Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("{""success"":false, ""message"":""Отсутствует поле phone""}");
        Возврат Ответ;
    КонецЕсли;
    
    Телефон = Данные.phone;
    
    // Проверка: есть ли уже такой продавец
    ЗапросПроверки = Новый Запрос("
        |ВЫБРАТЬ ПЕРВЫЕ 1
        |    Наименование
        |ИЗ
        |    Справочник.Продавцы
        |ГДЕ
        |    НомерТелефона = &Телефон");
    ЗапросПроверки.УстановитьПараметр("Телефон", Число(Телефон));
    Попытка
        Результат = ЗапросПроверки.Выполнить().Выбрать();
    Исключение
        ЗаписьЖурналаРегистрации("Auth.sendsmsPOST", УровеньЖурналаРегистрации.Ошибка,,, 
            "Ошибка запроса: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("{""success"":false, ""message"":""Ошибка запроса: " + ОписаниеОшибки() + """}");
        Возврат Ответ;
    КонецПопытки;
    ЕстьПользователь = Результат.Следующий();
    
    // Генерируем 4-значный код
    ГСЧ = Новый ГенераторСлучайныхЧисел;
    Код = Формат(Цел(1000 + ГСЧ.СлучайноеЧисло(0, 8999)), "ЧЦ=4; ЧВН=");
    
    // Сохраняем код в регистре сведений
    МенеджерЗаписи = РегистрыСведений.КодыАвторизации.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.Телефон = Число(Телефон);
    МенеджерЗаписи.Код = Код;
    МенеджерЗаписи.ДатаСоздания = ТекущаяДата();
    МенеджерЗаписи.Записать();
    
    // Готовим структуру для отправки SMS через Infobip
    Попытка
        HTTP = Новый HTTPСоединение("m3kqv2.api.infobip.com", 443,,, Неопределено, Новый ЗащищенноеСоединениеOpenSSL(), 30);
    Исключение
        ЗаписьЖурналаРегистрации("Auth.sendsmsPOST", УровеньЖурналаРегистрации.Ошибка,,, 
            "Ошибка создания HTTP-соединения: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("{""success"":false, ""message"":""Ошибка соединения с Infobip: " + ОписаниеОшибки() + """}");
        Возврат Ответ;
    КонецПопытки;
    
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "App 15e11439665ec478ea371068ad3f0ed6-13995cc7-57ce-40e0-bb33-9ccc096dcb8a");
    Заголовки.Вставить("Content-Type", "application/json");
    
    ДанныеОтправки = Новый Структура;
    ДанныеОтправки.Вставить("messages", Новый Массив);
    
    Сообщение = Новый Структура;
    Сообщение.Вставить("destinations", Новый Массив);
    Сообщение.destinations.Добавить(Новый Структура("to", Телефон));
    Сообщение.Вставить("from", "MyApp");
    Сообщение.Вставить("text", "Ваш код подтверждения: " + Код);
    
    ДанныеОтправки.messages.Добавить(Сообщение);
    
    // Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеОтправки);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    // Отправляем SMS через Infobip
    Попытка
    HTTP = Новый HTTPСоединение(
        "m3kqv2.api.infobip.com", // Сервер
        443,                     // Порт
        ,                        // Пользователь (не указан)
        ,                        // Пароль (не указан)
        Неопределено,            // Прокси
        Новый ЗащищенноеСоединениеOpenSSL(), // Защищенное соединение
        30                       // Таймаут
    );
Исключение
    ЗаписьЖурналаРегистрации("Auth.sendsmsPOST", УровеньЖурналаРегистрации.Ошибка,,, 
        "Ошибка создания HTTP-соединения: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    Ответ = Новый HTTPСервисОтвет(500);
    Ответ.УстановитьТелоИзСтроки("{""success"":false, ""message"":""Ошибка соединения с Infobip: " + ОписаниеОшибки() + """}");
    Возврат Ответ;
КонецПопытки;
    
    // Формируем ответ
    ОтветJSON = Новый Структура;
    ОтветJSON.Вставить("success", Истина);
    ОтветJSON.Вставить("isRegistered", ЕстьПользователь);
    
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, ОтветJSON);
    СтрокаJSON = Запись.Закрыть();
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
    Возврат Ответ;
КонецФункции

Функция verifyPOST(Запрос)
    // Получаем данные из тела запроса
    Тело = Запрос.ПолучитьТелоКакСтроку();
    Данные = ПрочитатьJSON(Тело);
    Телефон = Число(Данные.phone);
    Код = ?(Данные.Свойство("code"), Данные.code, "");
    Пароль = Данные.password;

// Проверка: есть ли пользователь
ЗапросПроверки = Новый Запрос("
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |    Наименование,
    |    Пароль
    |ИЗ
    |    Справочник.Продавцы
    |ГДЕ
    |    НомерТелефона = &Телефон");
ЗапросПроверки.УстановитьПараметр("Телефон", Телефон);
Результат = ЗапросПроверки.Выполнить().Выбрать();

Если Результат.Следующий() Тогда
    // Пользователь существует, проверяем пароль
    Если Результат.Пароль = Пароль Тогда
        ОтветJSON = Новый Структура("success", Истина);
    Иначе
        ОтветJSON = Новый Структура("success, message", Ложь, "Неверный пароль");
    КонецЕсли;
Иначе
    // Новый пользователь, проверяем код
    ЗапросКода = Новый Запрос("
        |ВЫБРАТЬ
        |    Код
        |ИЗ
        |    РегистрСведений.КодыАвторизации
        |ГДЕ
        |    Телефон = &Телефон
        |    И ДатаСоздания > &ДатаОграничения");
    ЗапросКода.УстановитьПараметр("Телефон", Телефон);
    ЗапросКода.УстановитьПараметр("ДатаОграничения", ТекущаяДата() - 600); // Код действителен 10 минут
    РезультатКода = ЗапросКода.Выполнить().Выбрать();
    
    Если РезультатКода.Следующий() И РезультатКода.Код = Код Тогда
        // Код верный, регистрируем нового пользователя
        НовыйПользователь = Справочники.Продавцы.СоздатьЭлемент();
        НовыйПользователь.НомерТелефона = Телефон;
        НовыйПользователь.Наименование = "Продавец_" + Формат(Телефон, "ЧГ=");
        НовыйПользователь.Пароль = Пароль;
        НовыйПользователь.Записать();
        
        // Удаляем использованный код
        МенеджерЗаписи = РегистрыСведений.КодыАвторизации.СоздатьМенеджерЗаписи();
        МенеджерЗаписи.Телефон = Телефон;
        МенеджерЗаписи.Удалить();
        
        ОтветJSON = Новый Структура("success", Истина);
    Иначе
        ОтветJSON = Новый Структура("success, message", Ложь, "Неверный или просроченный код");
    КонецЕсли;
КонецЕсли;

// Формируем ответ
Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку();
ЗаписатьJSON(Запись, ОтветJSON);
СтрокаJSON = Запись.Закрыть();

Ответ = Новый HTTPСервисОтвет(200);
Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
Возврат Ответ;

КонецФункции


Функция TelegramPOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        // Чтение тела запроса
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        
        // Парсинг JSON
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
        TelegramID = Данные.TelegramID;
        Username = Данные.Username;
        FirstName = Данные.FirstName;
        
        Если НЕ ЗначениеЗаполнено(TelegramID) Тогда
            СтруктураОтвета = Новый Структура("Успех, Сообщение", Ложь, "TelegramID не указан");
            ЗаписьJSON = Новый ЗаписьJSON;
            ЗаписьJSON.УстановитьСтроку();
            ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
            Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
            Возврат Ответ;
        КонецЕсли;
        
        // Поиск продавца по TelegramID
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    Продавцы.Ссылка
            |ИЗ
            |    Справочник.Продавцы КАК Продавцы
            |ГДЕ
            |    Продавцы.TelegramID = &TelegramID";
        Запрос.УстановитьПараметр("TelegramID", TelegramID);
        
        Результат = Запрос.Выполнить();
        Если Результат.Пустой() Тогда
            СтруктураОтвета = Новый Структура("Успех, Сообщение", Ложь, "Пользователь не найден");
            ЗаписьJSON = Новый ЗаписьJSON;
            ЗаписьJSON.УстановитьСтроку();
            ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
            Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
            Возврат Ответ;
        КонецЕсли;
        
        // Успешная авторизация
        СтруктураОтвета = Новый Структура("Успех, Сообщение", Истина, "Авторизация успешна");
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
        
    Исключение
        СтруктураОтвета = Новый Структура("Успех, Сообщение", Ложь, "Ошибка обработки: " + ОписаниеОшибки());
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
    КонецПопытки;
    
    Возврат Ответ;
КонецФункции
