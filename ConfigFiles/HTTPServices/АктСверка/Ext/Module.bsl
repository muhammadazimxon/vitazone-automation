Функция SverkiGET(Запрос)
    // 1. Получаем параметры
    НачалоГод = Число(Запрос.ПараметрыURL["StartYear"]);
    НачалоМесяц = Число(Запрос.ПараметрыURL["StartMonth"]);
    НачалоДень = Число(Запрос.ПараметрыURL["StartDate"]);
    КонецГод = Число(Запрос.ПараметрыURL["EndYear"]);
    КонецМесяц = Число(Запрос.ПараметрыURL["EndMonth"]);
    КонецДень = Число(Запрос.ПараметрыURL["EndDate"]);
    ИНН = Число(СокрЛП(Запрос.ПараметрыURL["inn"]));

    НачалоПериода = Дата(НачалоГод, НачалоМесяц, НачалоДень, 0, 0, 0);
    ДатаСверки = Дата(КонецГод, КонецМесяц, КонецДень, 23, 59, 59);
    НашаОрганизация = "DAANTEC";

    // 2. Ищем контрагента
    Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);
    Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
        Ответ = Новый HTTPСервисОтвет(404);
        Ответ.УстановитьТелоИзСтроки("Контрагент с ИНН не найден");
        Возврат Ответ;
    КонецЕсли;

    // 3. Запрашиваем движения по регистру
    // 3.1. Сальдо на начало периода (до НачалоПериода)
    ЗапросСальдо = Новый Запрос;
    ЗапросСальдо.Текст =
        "ВЫБРАТЬ
        |   СУММА(ВЫБОР
        |           КОГДА БухгалтерияПР.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
        |               ТОГДА БухгалтерияПР.Операция
        |           ИНАЧЕ -БухгалтерияПР.Операция
        |       КОНЕЦ) КАК Сальдо
        |ИЗ
        |   РегистрНакопления.БухгалтерияПР КАК БухгалтерияПР
        |ГДЕ
        |   БухгалтерияПР.Период < &НачалоПериода
        |   И БухгалтерияПР.Контрагент = &Контрагент";
    ЗапросСальдо.УстановитьПараметр("НачалоПериода", НачалоПериода);
    ЗапросСальдо.УстановитьПараметр("Контрагент", Контрагент);

    СальдоНаНачало = 0;
    Попытка
        Результат = ЗапросСальдо.Выполнить();
        Если НЕ Результат.Пустой() Тогда
            Выборка = Результат.Выбрать();
            Выборка.Следующий();
            СальдоНаНачало = ?(Выборка.Сальдо = NULL, 0, Выборка.Сальдо);
        КонецЕсли;
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка при расчете сальдо на начало: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;

    // 3.2. Движения за период
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   БухгалтерияПР.Период КАК Период,
        |   БухгалтерияПР.Документ КАК Документ,
        |   БухгалтерияПР.Операция КАК Сумма,
        |   БухгалтерияПР.ВидДвижения КАК ВидДвижения
        |ИЗ
        |   РегистрНакопления.БухгалтерияПР КАК БухгалтерияПР
        |ГДЕ
        |   БухгалтерияПР.Период МЕЖДУ &НачалоПериода И &Дата
        |   И БухгалтерияПР.Контрагент = &Контрагент
        |УПОРЯДОЧИТЬ ПО
        |   БухгалтерияПР.Период";
    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("Дата", ДатаСверки);
    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    Попытка
        Данные = Запрос.Выполнить().Выгрузить();
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка при выполнении запроса: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;

    // 4. Формируем строку периода
    Месяцы = Новый Массив;
    Месяцы.Добавить("ЯНВАРЬ"); Месяцы.Добавить("ФЕВРАЛЬ"); Месяцы.Добавить("МАРТ");
    Месяцы.Добавить("АПРЕЛЬ"); Месяцы.Добавить("МАЙ"); Месяцы.Добавить("ИЮНЬ");
    Месяцы.Добавить("ИЮЛЬ"); Месяцы.Добавить("АВГУСТ"); Месяцы.Добавить("СЕНТЯБРЬ");
    Месяцы.Добавить("ОКТЯБРЬ"); Месяцы.Добавить("НОЯБРЬ"); Месяцы.Добавить("ДЕКАБРЬ");

    НачалоПериодаСтрокой = Месяцы[Месяц(НачалоПериода) - 1] + " " + Год(НачалоПериода) + " г.";
    КонецПериодаСтрокой = Месяцы[Месяц(ДатаСверки) - 1] + " " + Год(ДатаСверки) + " г.";
    ПериодСтрокой = НачалоПериодаСтрокой + " - " + КонецПериодаСтрокой;

    // Точные даты для дополнительного параметра
    ПериодДаты = Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаСверки, "ДФ=dd.MM.yyyy");

    // 5. Работа с макетом
    Макет = ПолучитьОбщийМакет("МакетАктСверки");
    ТабДок = Новый ТабличныйДокумент;

    Обл = Макет.ПолучитьОбласть("Заголовок");
   // Обл.Параметры.Период = ПериодСтрокой; // "НОЯБРЬ 2024 г. - АПРЕЛЬ 2025 г."
    Обл.Параметры.ПериодДаты = ПериодДаты; // "01.11.2024 - 30.04.2025"
    Обл.Параметры.НашаОрганизация = НашаОрганизация;
    Обл.Параметры.Контрагент = Контрагент.Наименование;
    ТабДок.Вывести(Обл);

    // Сальдо на начало
    Обл = Макет.ПолучитьОбласть("СальдоНаНачало");
    Обл.Параметры.СальдоНаНачало = Формат(?(СальдоНаНачало < 0, -СальдоНаНачало, СальдоНаНачало), "ЧДЦ=2");
    Обл.Параметры.Сторона = ?(СальдоНаНачало > 0, Контрагент.Наименование, НашаОрганизация);
    ТабДок.Вывести(Обл);

    Обл = Макет.ПолучитьОбласть("ШапкаТаблицы");
    Обл.Параметры.НашаОрганизация = НашаОрганизация;
    Обл.Параметры.Контрагент = Контрагент.Наименование;
    ТабДок.Вывести(Обл);

    ИтогДебет = 0;
    ИтогКредит = 0;

    Для Каждого Стр Из Данные Цикл
        Обл = Макет.ПолучитьОбласть("Строка");

        Обл.Параметры.Дата1 = Формат(Стр.Период, "ДФ=dd.MM.yyyy");
        Обл.Параметры.Документ1 = Стр.Документ;
        Обл.Параметры.Дата2 = Обл.Параметры.Дата1;
        Обл.Параметры.Документ2 = Стр.Документ;

        Если Стр.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
            Обл.Параметры.Дебет1 = Формат(Стр.Сумма, "ЧДЦ=2");
            Обл.Параметры.Кредит1 = "";
            Обл.Параметры.Дебет2 = "";
            Обл.Параметры.Кредит2 = Формат(Стр.Сумма, "ЧДЦ=2");
            ИтогДебет = ИтогДебет + Стр.Сумма;
        ИначеЕсли Стр.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
            Обл.Параметры.Дебет1 = "";
            Обл.Параметры.Кредит1 = Формат(Стр.Сумма, "ЧДЦ=2");
            Обл.Параметры.Дебет2 = Формат(Стр.Сумма, "ЧДЦ=2");
            Обл.Параметры.Кредит2 = "";
            ИтогКредит = ИтогКредит + Стр.Сумма;
        КонецЕсли;

        ТабДок.Вывести(Обл);
    КонецЦикла;

    // 6. Итог
    Обл = Макет.ПолучитьОбласть("Итог");
    Обл.Параметры.Дебет1 = Формат(ИтогДебет, "ЧДЦ=2");
    Обл.Параметры.Кредит1 = Формат(ИтогКредит, "ЧДЦ=2");
    Обл.Параметры.Дебет2 = Формат(ИтогКредит, "ЧДЦ=2");
    Обл.Параметры.Кредит2 = Формат(ИтогДебет, "ЧДЦ=2");
    ТабДок.Вывести(Обл);

    // 7. Сальдо
    Сальдо = СальдоНаНачало + (ИтогДебет - ИтогКредит); // Учитываем начальный остаток
    Обл = Макет.ПолучитьОбласть("Сальдо");
    Обл.Параметры.Дата = Формат(ДатаСверки, "ДФ=dd.MM.yyyy");
    Обл.Параметры.Сторона = ?(Сальдо > 0, Контрагент.Наименование, НашаОрганизация);
    Обл.Параметры.Сумма = Формат(?(Сальдо < 0, -Сальдо, Сальдо), "ЧДЦ=2");
    ТабДок.Вывести(Обл);

    // 8. Подписи
    Обл = Макет.ПолучитьОбласть("Подписи");
    Обл.Параметры.НашаОрганизация = НашаОрганизация;
    Обл.Параметры.Контрагент = Контрагент.Наименование;
    ТабДок.Вывести(Обл);

    // 9. Формируем имя файла
    ИмяФайла = "ActSverki_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + ".pdf";

    // 10. Укажите папку, доступную из браузера (через веб-сервер!)
    Папка = "C:\inetpub\wwwroot\files\";

    Попытка
        СоздатьКаталог(Папка); // если вдруг нет
        ТабДок.Записать(Папка + ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка при записи PDF: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;

    // 11. Готовим ссылку для скачивания
    Ссылка = "https://90.156.196.234:55556/files/" + ИмяФайла;

    // 12. Перенаправляем браузер
    Ответ = Новый HTTPСервисОтвет(302);
    Ответ.Заголовки.Вставить("Location", Ссылка); // браузер скачает напрямую

    Возврат Ответ;
КонецФункции