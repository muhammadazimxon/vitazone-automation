Функция reportPOST(Запрос)
	
	// Читаем тело запроса
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоЗапроса) Тогда
		Возврат Новый HTTPСервисОтвет(400, "Ошибка: тело запроса пустое");
	КонецЕсли;
	
	// Парсим JSON
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат СоздатьОтветСОшибкой(400, "Ошибка: неверный формат JSON - " + ОписаниеОшибки());
	КонецПопытки;
	
	// Получаем дату из запроса
	Если НЕ Данные.Свойство("Дата") Тогда
		Возврат СоздатьОтветСОшибкой(400, "Ошибка: в запросе отсутствует поле 'Дата'");
	КонецЕсли;
	
	Попытка
		ДатаКонца = ПрочитатьДатуJSON(Данные.Дата, ФорматДатыJSON.ISO); // Ожидаем "YYYY-MM-DD"
		ДатаКонцаМесяца = КонецМесяца(ДатаКонца);
	Исключение
		Возврат СоздатьОтветСОшибкой(400, "Ошибка: неверный формат даты - " + ОписаниеОшибки());
	КонецПопытки;
	
	// Подготовка периодов
	ДатаНачалаГода = НачалоГода(ДатаКонца);
	ДатаКонцаПредМесяца = КонецМесяца(ДобавитьМесяц(ДатаКонца, -1));
	ДатаНачалаМесяца = НачалоМесяца(ДатаКонца);
	
	// Запрос к регистру "Финансы" для оборотов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФинансыОбороты.Период КАК Период,
	|	ФинансыОбороты.ФинИст КАК ФинИст,
	|	ФинансыОбороты.Статья КАК Статья,
	|	СУММА(ФинансыОбороты.СуммаОборот) КАК СуммаОборот,
	|	СУММА(ФинансыОбороты.СуммаПриход) КАК СуммаПриход,
	|	СУММА(ФинансыОбороты.СуммаРасход) КАК СуммаРасход,
	|	СУММА(ФинансыОбороты.ВалютаПриход) КАК ВалютаПриход,
	|	СУММА(ФинансыОбороты.ВалютаРасход) КАК ВалютаРасход
	|ПОМЕСТИТЬ ВТ_Обороты
	|ИЗ
	|	РегистрНакопления.Финансы.Обороты(&ДатаНачалаГода, &ДатаКонцаМесяца, Месяц, ) КАК ФинансыОбороты
	|ГДЕ
	|	(ФинансыОбороты.ФинИст = &ДебиторкаДантек)
	|	ИЛИ (ФинансыОбороты.ФинИст = &Фойдадан И ФинансыОбороты.Статья <> &ПереносОстатков)
	|СГРУППИРОВАТЬ ПО
	|	ФинансыОбороты.Период,
	|	ФинансыОбороты.ФинИст,
	|	ФинансыОбороты.Статья
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Обороты.Период КАК Период,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Обороты.ФинИст = &ДебиторкаДантек И ВТ_Обороты.Статья = &Продажа
	|				ТОГДА ВТ_Обороты.СуммаРасход
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОбъемПродажи,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Обороты.ФинИст = &Фойдадан И ВТ_Обороты.Статья <> &ПереносОстатков
	|				ТОГДА ВТ_Обороты.ВалютаПриход - ВТ_Обороты.ВалютаРасход
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОбъемПрибыли,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Обороты.ФинИст = &ДебиторкаДантек
	|				ТОГДА ВТ_Обороты.СуммаПриход
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОбъемПоступлений
	|ИЗ
	|	ВТ_Обороты КАК ВТ_Обороты
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Обороты.Период";
	
	Запрос.УстановитьПараметр("ДатаНачалаГода", ДатаНачалаГода);
	Запрос.УстановитьПараметр("ДатаКонцаМесяца", ДатаКонцаМесяца);
	Запрос.УстановитьПараметр("ДебиторкаДантек", Справочники.ФинИст.НайтиПоНаименованию("Дебиторка дантек"));
	Запрос.УстановитьПараметр("Фойдадан", Справочники.ФинИст.НайтиПоНаименованию("Фойдадан"));
	Запрос.УстановитьПараметр("Продажа", Справочники.Статьи.НайтиПоНаименованию("Продажа"));
	Запрос.УстановитьПараметр("ПереносОстатков", Справочники.Статьи.НайтиПоНаименованию("ПереносОстатков"));
	
	// Выполняем запрос для оборотов
	Попытка
		РезультатОбороты = Запрос.Выполнить();
	Исключение
		Возврат СоздатьОтветСОшибкой(500, "Ошибка выполнения запроса оборотов: " + ОписаниеОшибки());
	КонецПопытки;
	
	// Запрос остатков на конец каждого периода (только для "Предыдущий месяц" и "Выбранный месяц")
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ФинансыОстатки.СуммаОстаток) КАК ОбъемЗадолженности
	|ИЗ
	|	РегистрНакопления.Финансы.Остатки(&Дата, ФинИст = &ДебиторкаДантек) КАК ФинансыОстатки";
	
	ЗапросОстатки.УстановитьПараметр("ДебиторкаДантек", Справочники.ФинИст.НайтиПоНаименованию("Дебиторка дантек"));
	
	// Остатки на конец каждого периода
	Остатки = Новый Структура;
	ЗапросОстатки.УстановитьПараметр("Дата", ДатаКонца);
	Результат = ЗапросОстатки.Выполнить();
	Выборка = Результат.Выбрать();
	Остатки.Вставить("ВыбранныйМесяц", ?(Выборка.Следующий(), Выборка.ОбъемЗадолженности, 0));
	
	ЗапросОстатки.УстановитьПараметр("Дата", ДатаКонцаПредМесяца);
	Результат = ЗапросОстатки.Выполнить();
	Выборка = Результат.Выбрать();
	Остатки.Вставить("ПредыдущийМесяц", ?(Выборка.Следующий(), Выборка.ОбъемЗадолженности, 0));
	
	// Собираем данные
	ДанныеПоПериодам = Новый Структура;
	ДанныеПоПериодам.Вставить("СНачалаГода", Новый Структура("ОбъемПродажи, ОбъемПрибыли, ОбъемПоступлений", 0, 0, 0));
	ДанныеПоПериодам.Вставить("ПредыдущийМесяц", Новый Структура("ОбъемПродажи, ОбъемПрибыли, ОбъемПоступлений, ОбъемЗадолженности", 0, 0, 0, Остатки.ПредыдущийМесяц));
	ДанныеПоПериодам.Вставить("ВыбранныйМесяц", Новый Структура("ОбъемПродажи, ОбъемПрибыли, ОбъемПоступлений, ОбъемЗадолженности", 0, 0, 0, Остатки.ВыбранныйМесяц));
	
	// Обороты
	ВыборкаОбороты = РезультатОбороты.Выбрать();
	Пока ВыборкаОбороты.Следующий() Цикл
		Период = ВыборкаОбороты.Период;
		
		// С начала года (включая выбранный месяц)
		Если Период >= ДатаНачалаГода И Период <= ДатаКонцаМесяца Тогда
			ДанныеПоПериодам.СНачалаГода.ОбъемПродажи = ДанныеПоПериодам.СНачалаГода.ОбъемПродажи + ВыборкаОбороты.ОбъемПродажи;
			ДанныеПоПериодам.СНачалаГода.ОбъемПрибыли = ДанныеПоПериодам.СНачалаГода.ОбъемПрибыли + ВыборкаОбороты.ОбъемПрибыли;
			ДанныеПоПериодам.СНачалаГода.ОбъемПоступлений = ДанныеПоПериодам.СНачалаГода.ОбъемПоступлений + ВыборкаОбороты.ОбъемПоступлений;
		КонецЕсли;
		
		// Предыдущий месяц
		Если НачалоМесяца(Период) = НачалоМесяца(ДатаКонцаПредМесяца) Тогда
			ДанныеПоПериодам.ПредыдущийМесяц.ОбъемПродажи = ДанныеПоПериодам.ПредыдущийМесяц.ОбъемПродажи + ВыборкаОбороты.ОбъемПродажи;
			ДанныеПоПериодам.ПредыдущийМесяц.ОбъемПрибыли = ДанныеПоПериодам.ПредыдущийМесяц.ОбъемПрибыли + ВыборкаОбороты.ОбъемПрибыли;
			ДанныеПоПериодам.ПредыдущийМесяц.ОбъемПоступлений = ДанныеПоПериодам.ПредыдущийМесяц.ОбъемПоступлений + ВыборкаОбороты.ОбъемПоступлений;
		КонецЕсли;
		
		// Выбранный месяц
		Если НачалоМесяца(Период) = НачалоМесяца(ДатаКонца) Тогда
			ДанныеПоПериодам.ВыбранныйМесяц.ОбъемПродажи = ДанныеПоПериодам.ВыбранныйМесяц.ОбъемПродажи + ВыборкаОбороты.ОбъемПродажи;
			ДанныеПоПериодам.ВыбранныйМесяц.ОбъемПрибыли = ДанныеПоПериодам.ВыбранныйМесяц.ОбъемПрибыли + ВыборкаОбороты.ОбъемПрибыли;
			ДанныеПоПериодам.ВыбранныйМесяц.ОбъемПоступлений = ДанныеПоПериодам.ВыбранныйМесяц.ОбъемПоступлений + ВыборкаОбороты.ОбъемПоступлений;
		КонецЕсли;
	КонецЦикла;
	
	// Получение данных о просрочке (только для "Предыдущий месяц" и "Выбранный месяц")
	ПросрочкаПредМесяц = ПолучитьПросрочку(ДатаКонцаПредМесяца);
	ПросрочкаВыбранныйМесяц = ПолучитьПросрочку(ДатаКонца); // Используем дату, указанную пользователем
	
	// Добавляем просрочку и долю в данные (только для "Предыдущий месяц" и "Выбранный месяц")
	ДанныеПоПериодам.ПредыдущийМесяц.Вставить("ОбъемПросрочки", ПросрочкаПредМесяц);
	ДанныеПоПериодам.ПредыдущийМесяц.Вставить("ДоляПросрочки", ?(ДанныеПоПериодам.ПредыдущийМесяц.ОбъемЗадолженности <> 0, Окр(ПросрочкаПредМесяц / ДанныеПоПериодам.ПредыдущийМесяц.ОбъемЗадолженности * 100, 2), 0));
	ДанныеПоПериодам.ВыбранныйМесяц.Вставить("ОбъемПросрочки", ПросрочкаВыбранныйМесяц);
	ДанныеПоПериодам.ВыбранныйМесяц.Вставить("ДоляПросрочки", ?(ДанныеПоПериодам.ВыбранныйМесяц.ОбъемЗадолженности <> 0, Окр(ПросрочкаВыбранныйМесяц / ДанныеПоПериодам.ВыбранныйМесяц.ОбъемЗадолженности * 100, 2), 0));
	
	// Временная отладка: выводим сырые значения ОбъемПрибыли
	Сообщить("Отладка: Сырые значения ОбъемПрибыли:");
	Сообщить("СНачалаГода: " + ДанныеПоПериодам.СНачалаГода.ОбъемПрибыли);
	Сообщить("ПредыдущийМесяц: " + ДанныеПоПериодам.ПредыдущийМесяц.ОбъемПрибыли);
	Сообщить("ВыбранныйМесяц: " + ДанныеПоПериодам.ВыбранныйМесяц.ОбъемПрибыли);
	
	// Формируем итоговый ответ
	Ответ = Новый Структура("Анализ", ДанныеПоПериодам);
	
	// Формируем JSON-ответ
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Ответ);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// Возвращаем успешный ответ
	HTTPОтвет = Новый HTTPСервисОтвет(200);
	HTTPОтвет.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	HTTPОтвет.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Возврат HTTPОтвет;
	
КонецФункции

// Вспомогательная функция для получения общей суммы просрочки
Функция ПолучитьПросрочку(Дата)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|		КОГДА НЕ ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия ЕСТЬ NULL
	|			И &КонецПериода > ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия
	|			И ДебиторкаОстаткиИОбороты.ДокНомер.Наименование <> ""Переплата""
	|			И ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток < 0
	|		ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК ПросроченнаяСумма
	|ИЗ
	|	РегистрНакопления.Дебиторка.ОстаткиИОбороты(&НачалоПериода, &КонецПериода) КАК ДебиторкаОстаткиИОбороты
	|ГДЕ
	|	ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток <> 0
	|	И ДебиторкаОстаткиИОбороты.Счет = &ОсновнойСчет";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(Дата));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Дата));
	Запрос.УстановитьПараметр("ОсновнойСчет", Справочники.Организация.ОсновнойСчет);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат 0;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат ?(Выборка.ПросроченнаяСумма = Null, 0, Выборка.ПросроченнаяСумма); // Оставляем отрицательной
	КонецЕсли;
КонецФункции

// Вспомогательная функция для создания ответа с ошибкой
Функция СоздатьОтветСОшибкой(КодСостояния, ТекстОшибки)
	Ответ = Новый Структура("Ошибка", ТекстОшибки);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Ответ);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	HTTPОтвет = Новый HTTPСервисОтвет(КодСостояния);
	HTTPОтвет.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	HTTPОтвет.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Возврат HTTPОтвет;
КонецФункции