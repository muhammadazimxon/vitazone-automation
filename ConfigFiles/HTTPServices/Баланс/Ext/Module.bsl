  Функция active(Запрос) Экспорт
    Попытка
        // Получаем тело запроса
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Тело запроса пустое.");
            Возврат Ответ;
        КонецЕсли;
        
        // Разбираем JSON
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
        
        // Проверяем наличие даты и МиниОтчет
        Если НЕ ДанныеJSON.Свойство("Дата") Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Не указана дата.");
            Возврат Ответ;
        КонецЕсли;
        Если НЕ ДанныеJSON.Свойство("МиниОтчет") Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Не указан МиниОтчет.");
            Возврат Ответ;
        КонецЕсли;
        
        // Преобразуем строку даты в формат "ГГГГММДД"
        ДатаСтрока = СтрЗаменить(ДанныеJSON.Дата, "-", ""); // "2025-03-12" → "20250312"
        Если СтрДлина(ДатаСтрока) <> 8 Или Не ТолькоЦифрыВСтроке(ДатаСтрока) Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Некорректный формат даты. Ожидается YYYY-MM-DD.");
            Возврат Ответ;
        КонецЕсли;
        ДатаОстатков =Дата(ДатаСтрока)+86400; // Остатки на конец дня
        
        МиниОтчет = Справочники.МиниОтчетГруппировка.НайтиПоНаименованию(ДанныеJSON.МиниОтчет);
        Если МиниОтчет.Пустая() Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: МиниОтчет '" + ДанныеJSON.МиниОтчет + "' не найден.");
            Возврат Ответ;
        КонецЕсли;
        
        // Запрос к регистру "Финансы" для активов (КатегорияБаланса = 1)
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    ФинансыОстатки.ФинИст КАК ФинИст,
            |    ФинансыОстатки.СуммаОстаток КАК Сумма,
            |    ФинансыОстатки.ВалютаОстаток КАК Xorij,
            |    ФинансыОстатки.ФинИст.Валюта.Наименование КАК Валюта
            |ИЗ
            |    РегистрНакопления.Финансы.Остатки(&ДатаОстатков, 
            |        ФинИст.КатегорияБаланса = 1
            |        И ФинИст.МиниОтчет = &МиниОтчет) КАК ФинансыОстатки";
        Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
        Запрос.УстановитьПараметр("МиниОтчет", МиниОтчет);
        
        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();
        
        // Формируем ответ с отладкой
        МассивОстатков = Новый Массив;
        Пока Выборка.Следующий() Цикл
            ДанныеОстатка = Новый Структура;
            ДанныеОстатка.Вставить("ФинИст", Строка(Выборка.ФинИст));
            Если Выборка.Валюта = "UZS" Тогда
                ДанныеОстатка.Вставить("Сумма", Выборка.Сумма);
                ДанныеОстатка.Вставить("Валюта", "UZS");
            Иначе // "USD"
                ДанныеОстатка.Вставить("Сумма", Выборка.Xorij);
                ДанныеОстатка.Вставить("Валюта", "USD");
            КонецЕсли;
            // Добавляем отладочную информацию
            ДанныеОстатка.Вставить("СуммаОстаток", Выборка.Сумма);
            ДанныеОстатка.Вставить("ВалютаОстаток", Выборка.Xorij);
            МассивОстатков.Добавить(ДанныеОстатка);
        КонецЦикла;
        
        СтруктураОтвета = Новый Структура;
        СтруктураОтвета.Вставить("Актив", МассивОстатков);
        
        // Сериализация в JSON
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Вставить("Content-Type", "application/json");
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
        Возврат Ответ;
        
    Исключение
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Новый Структура("Ошибка", ОписаниеОшибки()));
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.Заголовки.Вставить("Content-Type", "application/json");
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
        Возврат Ответ;
    КонецПопытки;
КонецФункции




