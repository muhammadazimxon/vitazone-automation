Функция ТолькоЦифрыВСтроке(Строка) Экспорт
    Для Позиция = 1 По СтрДлина(Строка) Цикл
        Символ = Сред(Строка, Позиция, 1);
        Если КодСимвола(Символ) < 48 Или КодСимвола(Символ) > 57 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции                                                                                                  




Функция minireports(Запрос) Экспорт
    Попытка
        // Формируем список всех МиниОтчетов из справочника
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    МиниОтчетГруппировка.Наименование КАК Наименование
            |ИЗ
            |    Справочник.МиниОтчетГруппировка КАК МиниОтчетГруппировка
            |ГДЕ
            |    НЕ МиниОтчетГруппировка.ПометкаУдаления";
        
        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();
        
        МассивМиниОтчетов = Новый Массив;
        Пока Выборка.Следующий() Цикл
            МассивМиниОтчетов.Добавить(Выборка.Наименование);
        КонецЦикла;
        
        СтруктураОтвета = Новый Структура;
        СтруктураОтвета.Вставить("МиниОтчеты", МассивМиниОтчетов);
        
        // Сериализация в JSON
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Вставить("Content-Type", "application/json");
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
        Возврат Ответ;
        
    Исключение
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Новый Структура("Ошибка", ОписаниеОшибки()));
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.Заголовки.Вставить("Content-Type", "application/json");
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
        Возврат Ответ;
    КонецПопытки;
КонецФункции