Функция ZakazNomenclatureGET(Запрос)
    Сообщить("Запрос номенклатуры получен в " + ТекущаяДата());
    Сообщить("URL запроса: " + Запрос.БазовыйURL + Запрос.ОтносительныйURL);
    Попытка
        ЗапросSQL = Новый Запрос;
        ЗапросSQL.Текст = 
            "ВЫБРАТЬ
            |    Номенклатура.Ссылка КАК Ссылка,
            |    Номенклатура.Наименование КАК Наименование
            |ИЗ
            |    Справочник.Номенклатура КАК Номенклатура
            |ГДЕ
            |    НЕ Номенклатура.ПометкаУдаления
            |    И Номенклатура.Приложение = ЛОЖЬ";
        
        Результат = ЗапросSQL.Выполнить();
        Сообщить("Запрос выполнен, записей: " + Строка(Результат.Выгрузить().Количество()));
        СписокНоменклатуры = Новый Массив;
        
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            Структура = Новый Структура;
            Структура.Insert("ref", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
            Структура.Insert("name", Выборка.Наименование);
            СписокНоменклатуры.Добавить(Структура);
        КонецЦикла;
        
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СписокНоменклатуры);
        
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
        Возврат Ответ;
    Исключение
        Сообщить("Ошибка в ZakazNomenclatureGET: " + ОписаниеОшибки());
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка сервера: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
КонецФункции


Функция ZakazOrderPOST(Запрос)
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
        Данные = ПрочитатьJSON(ЧтениеJSON);
        
        Док = Документы.ЗаказыОтМП.СоздатьДокумент();
        Док.Дата = ТекущаяДата();
        Док.IDTelegram = Данные.telegram_id;
        Док.НомерЗаказа = Данные.order_number;
        Док.СтатусЗаказа = Справочники.Статусы.НайтиПоНаименованию("Заказ отправлен");
        
        // Проверяем и устанавливаем ИНН, если он есть
        Если Данные.Свойство("inn") И ЗначениеЗаполнено(Данные.inn) Тогда
            Док.ИННКонтрагента = Данные.inn;
            Контрагент = КонтрагентОламиз(Данные.inn);
            Если НЕ Контрагент.Пустая() Тогда
                Док.Контрагенты = Контрагент;
                Сообщить("Контрагент установлен: " + Контрагент.Наименование);
            Иначе
                Сообщить("Контрагент с ИНН " + Данные.inn + " не найден. Поле 'Контрагенты' оставлено пустым.");
            КонецЕсли;
        Иначе
            Сообщить("ИНН не указан в запросе. Поле 'Контрагенты' оставлено пустым.");
        КонецЕсли;
        
        Док.НаименованиеКонтрагента = Данные.name;
        Док.УсловиеПредоплаты = Данные.prepayment;
        Док.Комментарий = Данные.comment;
		
        // Обработка массива позиций
        Для Каждого Элемент Из Данные.items Цикл
            НоваяСтрока = Док.ТабДок.Добавить();
            НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(
                Новый УникальныйИдентификатор(Элемент.nomenclature_ref));
            НоваяСтрока.Количество = Элемент.quantity;
            НоваяСтрока.ЦенаЗаЕдиницу = Элемент.price;
            НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.ЦенаЗаЕдиницу;
        КонецЦикла;
        
        Док.Записать(РежимЗаписиДокумента.Проведение);
        Сообщить("Документ записан: " + Док.Ссылка);
        
        // Обновление регистра накопления с игнорированием ошибки
        Движение = РегистрыНакопления.ЗаказыМП.СоздатьНаборЗаписей();
        Движение.Отбор.Регистратор.Установить(Док.Ссылка);
        Для Каждого СтрокаТаб Из Док.ТабДок Цикл
            НоваяЗапись = Движение.Добавить();
			НоваяЗапись.Период = ТекущаяДата();
            НоваяЗапись.НомерЗаказа = Док.НомерЗаказа;
            НоваяЗапись.IDTelegram = Док.IDTelegram;
            НоваяЗапись.Номенклатура = СтрокаТаб.Номенклатура;
            НоваяЗапись.СтатусЗаказа = Док.СтатусЗаказа;
            НоваяЗапись.Комментарии = Док.Комментарий;
            НоваяЗапись.Сумма = СтрокаТаб.Сумма;
            // Период не устанавливаем, полагаемся на автоматическое заполнение 1С
        КонецЦикла;
        
        Попытка
            Движение.Записать();
            Сообщить("Записей в регистре: " + Движение.Количество());
        Исключение
            Сообщить("Ошибка записи в регистр ЗаказыМП: " + ОписаниеОшибки() + ". Игнорируем ошибку.");
        КонецПопытки;
        
        // Формируем ответ с номером заказа
        Ответ = Новый HTTPСервисОтвет(200);
        СтруктураОтвета = Новый Структура("order_number", Док.НомерЗаказа);
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
        Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
        Возврат Ответ;
    Исключение
        Сообщить("Ошибка в ZakazOrderPOST: " + ОписаниеОшибки());
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка сервера: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
КонецФункции




Функция ZakazStatusGET(Запрос)
    Попытка
        НомерЗаказа = Запрос.ПараметрыЗапроса.Получить("order_number");
        IDTelegram = Запрос.ПараметрыЗапроса.Получить("telegram_id");
        
        Если НомерЗаказа = Неопределено Или IDTelegram = Неопределено Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Отсутствуют обязательные параметры");
            Возврат Ответ;
        КонецЕсли;
        
        ЗапросSQL = Новый Запрос;
        ЗапросSQL.Текст = 
            "ВЫБРАТЬ
            |    ЗаказыМП.СтатусЗаказа.Наименование КАК Статус,
            |    ЗаказыМП.Комментарии КАК Комментарии
            |ИЗ
            |    РегистрНакопления.ЗаказыМП КАК ЗаказыМП
            |ГДЕ
            |    ЗаказыМП.НомерЗаказа = &НомерЗаказа
            |    И ЗаказыМП.IDTelegram = &IDTelegram";
        ЗапросSQL.УстановитьПараметр("НомерЗаказа", НомерЗаказа);
        ЗапросSQL.УстановитьПараметр("IDTelegram", IDTelegram);
        
        Результат = ЗапросSQL.Выполнить();
        Если Результат.Пустой() Тогда
            Ответ = Новый HTTPСервисОтвет(404);
            Ответ.УстановитьТелоИзСтроки("Заказ не найден или не принадлежит вам.");
            Возврат Ответ;
        Иначе
            Выборка = Результат.Выбрать();
            Выборка.Следующий();
            СтруктураОтвета = Новый Структура("status, comments", Выборка.Статус, Выборка.Комментарии);
            ЗаписьJSON = Новый ЗаписьJSON;
            ЗаписьJSON.УстановитьСтроку();
            ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
            Ответ = Новый HTTPСервисОтвет(200);
            Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
            Возврат Ответ;
        КонецЕсли;
    Исключение
        Сообщить("Ошибка в ZakazStatusGET: " + ОписаниеОшибки());
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка сервера: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
КонецФункции

Функция КонтрагентОламиз(ИНН) Экспорт
    Попытка
        ИННЧисло = Число(ИНН);
    Исключение
        Сообщить("Ошибка: ИНН " + ИНН + " не является числом.");
        Возврат Справочники.Контрагенты.ПустаяСсылка();
    КонецПопытки;
    
    КонтрагентСсылка = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИННЧисло);
    
    Если КонтрагентСсылка.Пустая() Тогда
        Сообщить("Контрагент с ИНН " + Формат(ИННЧисло, "ЧГ=0") + " не найден в справочнике.");
        Возврат Справочники.Контрагенты.ПустаяСсылка();
    Иначе
        Сообщить("Контрагент найден: " + КонтрагентСсылка.Наименование);
        Возврат КонтрагентСсылка;
    КонецЕсли;
КонецФункции
	


// Обработчик метода POST /prices
Функция pricesPOST(Запрос)
	
	// Читаем тело запроса
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	Сообщить("Получен запрос: " + ТелоЗапроса);
	
	// Парсим JSON
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Сообщить("Ошибка парсинга JSON: " + ОписаниеОшибки());
		Возврат ОтветСОшибкой("Некорректный JSON: " + ОписаниеОшибки(), 400);
	КонецПопытки;
	
	// Проверяем наличие обязательных полей
	Если НЕ Данные.Свойство("items") ИЛИ НЕ Данные.Свойство("prepayment") Тогда
		Сообщить("Ошибка: Отсутствуют обязательные поля items или prepayment");
		Возврат ОтветСОшибкой("Отсутствуют обязательные поля items или prepayment", 400);
	КонецЕсли;
	
	// Проверяем предоплату
	Попытка
		Предоплата = Число(Данные.prepayment);
	Исключение
		Сообщить("Ошибка: prepayment не является числом: " + Данные.prepayment);
		Возврат ОтветСОшибкой("prepayment должен быть числом", 400);
	КонецПопытки;
	
	Если Предоплата < 0 Или Предоплата > 100 Тогда
		Сообщить("Ошибка: Предоплата вне диапазона 0-100: " + Формат(Предоплата, "ЧГ=0"));
		Возврат ОтветСОшибкой("prepayment должен быть в диапазоне от 0 до 100", 400);
	КонецЕсли;
	
	// Проверяем, что items — массив
	Если ТипЗнч(Данные.items) <> Тип("Массив") Тогда
		Сообщить("Ошибка: items должен быть массивом");
		Возврат ОтветСОшибкой("items должен быть массивом", 400);
	КонецЕсли;
	
	// Обрабатываем каждую позицию
	МассивПозиций = Новый Массив;
	Для Каждого Позиция Из Данные.items Цикл
		Если НЕ Позиция.Свойство("nomenclature_ref") ИЛИ НЕ Позиция.Свойство("quantity") Тогда
			Сообщить("Ошибка: В позиции отсутствует nomenclature_ref или quantity");
			Возврат ОтветСОшибкой("В позиции отсутствует nomenclature_ref или quantity", 400);
		КонецЕсли;
		
		// Получаем ссылку на номенклатуру
		Попытка
			НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Позиция.nomenclature_ref));
			Если НоменклатураСсылка.Пустая() Или НоменклатураСсылка.ПолучитьОбъект() = Неопределено Тогда
				Сообщить("Ошибка: Номенклатура с ref " + Позиция.nomenclature_ref + " не найдена");
				Возврат ОтветСОшибкой("Номенклатура с ref " + Позиция.nomenclature_ref + " не найдена", 404);
			КонецЕсли;
		Исключение
			Сообщить("Ошибка при получении номенклатуры: " + ОписаниеОшибки());
			Возврат ОтветСОшибкой("Ошибка при получении номенклатуры: " + ОписаниеОшибки(), 400);
		КонецПопытки;
		
		// Получаем количество
		Попытка
			Количество = Число(Позиция.quantity);
		Исключение
			Сообщить("Ошибка: quantity не является числом: " + Позиция.quantity);
			Возврат ОтветСОшибкой("quantity должен быть числом", 400);
		КонецПопытки;
		
		// Добавляем позицию в массив
		СтруктураПозиции = Новый Структура;
		СтруктураПозиции.Вставить("Номенклатура", НоменклатураСсылка);
		СтруктураПозиции.Вставить("Количество", Количество);
		МассивПозиций.Добавить(СтруктураПозиции);
	КонецЦикла;
	
	// Определяем предварительное условие оплаты
	УсловиеОплаты = ОпределитьУсловиеОплаты(Предоплата, МассивПозиций);
	
	// Получаем цены для каждой позиции
	МассивОтвета = Новый Массив;
	Для Каждого Позиция Из МассивПозиций Цикл
		Цена = ПолучитьЦенуИзПрайсов(Позиция.Номенклатура, УсловиеОплаты);
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("nomenclature_ref", Строка(Позиция.Номенклатура.УникальныйИдентификатор()));
		СтруктураОтвета.Вставить("price", Цена);
		МассивОтвета.Добавить(СтруктураОтвета);
	КонецЦикла;
	
	// Формируем ответ
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("items", МассивОтвета);
	СтруктураОтвета.Вставить("condition", УсловиеОплаты);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
	
	Сообщить("Ответ отправлен: " + Ответ.ПолучитьТелоКакСтроку());
	
	Возврат Ответ;
	
КонецФункции

// Определяет условие оплаты на основе предоплаты и общей стоимости заказа
Функция ОпределитьУсловиеОплаты(Предоплата, МассивПозиций)
	
	Сообщить("Определяем условие оплаты для предоплаты: " + Формат(Предоплата, "ЧГ=0"));
	
	// Определяем предварительное условие
	ПредварительноеУсловие = "";
	ОкончательноеУсловие = "ЭлликФоиз"; // По умолчанию
	
	Если Предоплата = 100 Тогда
		Сообщить("Предоплата 100%, выбираем ЮзФоиз");
		ОкончательноеУсловие = "ЮзФоиз";
		Возврат ОкончательноеУсловие;
	ИначеЕсли Предоплата >= 50 Тогда
		ПредварительноеУсловие = "ЭлликБешФоиз";
		Сообщить("Предоплата >= 50%, предварительно выбираем: ЭлликБешФоиз");
	Иначе
		Сообщить("Предоплата < 50%, выбираем: ЭлликФоиз");
		ОкончательноеУсловие = "ЭлликФоиз";
		Возврат ОкончательноеУсловие;
	КонецЕсли;
	
	// Рассчитываем общую стоимость по предварительному условию
	ОбщаяСтоимость = 0;
	Для Каждого Позиция Из МассивПозиций Цикл
		Цена = ПолучитьЦенуИзПрайсов(Позиция.Номенклатура, ПредварительноеУсловие);
		СтоимостьПозиции = Цена * Позиция.Количество;
		ОбщаяСтоимость = ОбщаяСтоимость + СтоимостьПозиции;
		Сообщить("Позиция: " + Позиция.Номенклатура.Наименование + ", Цена (ЭлликБешФоиз): " + Цена + ", Стоимость: " + СтоимостьПозиции);
	КонецЦикла;
	
	Сообщить("Общая стоимость по ЭлликБешФоиз: " + Формат(ОбщаяСтоимость, "ЧГ=0"));
	
	// Проверяем условие на 4,9 млн
	Если ОбщаяСтоимость >= 4900000 Тогда
		Сообщить("Общая стоимость >= 4,9 млн, оставляем ЭлликБешФоиз");
		ОкончательноеУсловие = "ЭлликБешФоиз";
	Иначе
		Сообщить("Общая стоимость < 4,9 млн, переходим на ЭлликФоиз");
		ОкончательноеУсловие = "ЭлликФоиз";
	КонецЕсли;
	
	Сообщить("Окончательное условие: " + ОкончательноеУсловие);
	
	Возврат ОкончательноеУсловие;
	
КонецФункции

// Получает цену из регистра сведений "Прайсы" с условием как строкой
Функция ПолучитьЦенуИзПрайсов(Номенклатура, УсловиеОплатыСтрокой)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Прайсы.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.Прайсы КАК Прайсы
	|ГДЕ
	|	Прайсы.Номенклатура = &Номенклатура
	|	И Прайсы.УсловиеОплаты = &УсловиеОплаты";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("УсловиеОплаты", УсловиеОплатыСтрокой);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Сообщить("Цена найдена: " + Формат(Выборка.Цена, "ЧГ=0") + " для условия " + УсловиеОплатыСтрокой);
		Возврат Выборка.Цена;
	КонецЕсли;
	
	Сообщить("Цена не найдена в Прайсы для номенклатуры " + Номенклатура.Наименование + " и условия " + УсловиеОплатыСтрокой);
	Возврат 0;
	
КонецФункции

// Формирует HTTP-ответ с ошибкой
Функция ОтветСОшибкой(ТекстОшибки, КодСостояния)
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтруктураОтвета = Новый Структура("error", ТекстОшибки);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
	
	Сообщить("Ошибка отправлена: " + ТекстОшибки);
	
	Возврат Ответ;
	
КонецФункции