Функция hisorderPOST(Запрос)
    
    // Логируем начало обработки
    ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, "Начало обработки запроса");
    
    // Читаем тело запроса
    ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
    ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, "Тело запроса: " + ТелоЗапроса);
    
    Если ПустаяСтрока(ТелоЗапроса) Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка: Тело запроса пустое");
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка: Тело запроса пустое");
        Возврат Ответ;
    КонецЕсли;
    
    // Парсим JSON
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        // Явно указываем, что ожидаем Соответствие
        ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON, Истина); // Истина — читать в Соответствие
        ЧтениеJSON.Закрыть();
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, "JSON успешно распарсен");
    Исключение
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка: Некорректный JSON");
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка парсинга JSON: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
    
    // Проверяем, что ДанныеЗапроса — это Соответствие
    Если ТипЗнч(ДанныеЗапроса) <> Тип("Соответствие") Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка: Неверный формат данных в JSON (ожидается объект)");
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Ошибка,,, 
            "Ошибка: ДанныеЗапроса не является соответствием, тип: " + ТипЗнч(ДанныеЗапроса));
        Возврат Ответ;
    КонецЕсли;
    
    // Логируем содержимое ДанныеЗапроса для отладки
    ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, 
        "Содержимое ДанныеЗапроса: " + ЗначениеВСтрокуВнутр(ДанныеЗапроса));
    
    // Проверяем обязательные параметры
    TelegramID = ДанныеЗапроса.Получить("telegram_id");
    НачалоПериода = ДанныеЗапроса.Получить("start_date");
    КонецПериода = ДанныеЗапроса.Получить("end_date");
    Статус = ДанныеЗапроса.Получить("status");
    
    ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, 
        "Параметры запроса: TelegramID=" + TelegramID + ", НачалоПериода=" + НачалоПериода + ", КонецПериода=" + КонецПериода + ", Статус=" + Статус);
    
    Если TelegramID = Неопределено Или ПустаяСтрока(TelegramID) Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка: Не указан telegram_id");
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка: Не указан telegram_id");
        Возврат Ответ;
    КонецЕсли;
    
    Если НачалоПериода = Неопределено Или ПустаяСтрока(НачалоПериода) Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка: Не указан start_date");
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка: Не указан start_date");
        Возврат Ответ;
    КонецЕсли;
    
    Если КонецПериода = Неопределено Или ПустаяСтрока(КонецПериода) Тогда
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка: Не указан end_date");
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка: Не указан end_date");
        Возврат Ответ;
    КонецЕсли;
    
    // Парсим даты
    Попытка
        ДатаНачала = Дата(Лев(НачалоПериода, 4), Сред(НачалоПериода, 6, 2), Сред(НачалоПериода, 9, 2));
        ДатаОкончания = Дата(Лев(КонецПериода, 4), Сред(КонецПериода, 6, 2), Сред(КонецПериода, 9, 2), 23, 59, 59);
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, 
            "Даты успешно распарсены: ДатаНачала=" + ДатаНачала + ", ДатаОкончания=" + ДатаОкончания);
    Исключение
        Ответ = Новый HTTPСервисОтвет(400);
        Ответ.УстановитьТелоИзСтроки("Ошибка: Некорректный формат дат (ожидается YYYY-MM-DD)");
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка парсинга дат: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
    
    // Формируем запрос к документу ЗаказыОтМП
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ЗаказыОтМП.Ссылка КАК Ссылка,
        |	ЗаказыОтМП.Дата КАК Дата,
        |	ЗаказыОтМП.НомерЗаказа КАК НомерЗаказа,
        |	ЗаказыОтМП.СтатусЗаказа КАК СтатусЗаказа,
        |	ЗаказыОтМП.Контрагенты КАК Контрагент,
        |	ЗаказыОтМП.Контрагенты.ИНН КАК ИНН,
        |	ЗаказыОтМП.УсловиеПредоплаты КАК УсловиеПредоплаты,
        |	ЗаказыОтМП.Комментарий КАК Комментарий,
        |	ЗаказыОтМП.Табдок.(
        |		Номенклатура.Наименование КАК Наименование,
        |		Количество КАК Количество,
        |		ЦенаЗаЕдиницу КАК Цена
        |	) КАК Товары
        |ИЗ
        |	Документ.ЗаказыОтМП КАК ЗаказыОтМП
        |ГДЕ
        |	ЗаказыОтМП.Проведен
        |	И ЗаказыОтМП.IDTelegram = &TelegramID
        |	И ЗаказыОтМП.Дата МЕЖДУ &НачалоПериода И &КонецПериода
        |	" + ?(ЗначениеЗаполнено(Статус), "И ЗаказыОтМП.СтатусЗаказа.Наименование = &Статус", "");
    
    Запрос.УстановитьПараметр("TelegramID", TelegramID);
    Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
    Запрос.УстановитьПараметр("КонецПериода", ДатаОкончания);
    Если ЗначениеЗаполнено(Статус) Тогда
        Запрос.УстановитьПараметр("Статус", Статус);
    КонецЕсли;
    
    Попытка
        РезультатЗапроса = Запрос.Выполнить();
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, "Запрос к базе выполнен успешно");
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка выполнения запроса к базе: " + ОписаниеОшибки());
        ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка выполнения запроса к базе: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
    
    // Формируем ответ
    МассивЗаказов = Новый Массив;
    
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл
        СтруктураЗаказа = Новый Структура;
        СтруктураЗаказа.Вставить("order_number", Выборка.НомерЗаказа);
        СтруктураЗаказа.Вставить("status", ?(ЗначениеЗаполнено(Выборка.СтатусЗаказа), Выборка.СтатусЗаказа.Наименование, "Неизвестно"));
        СтруктураЗаказа.Вставить("comments", ?(ЗначениеЗаполнено(Выборка.Комментарий), Выборка.Комментарий, "Нет комментариев"));
        СтруктураЗаказа.Вставить("inn", ?(ЗначениеЗаполнено(Выборка.ИНН), Выборка.ИНН, "Неизвестно"));
        СтруктураЗаказа.Вставить("name", ?(ЗначениеЗаполнено(Выборка.Контрагент), Выборка.Контрагент.Наименование, "Неизвестно"));
        СтруктураЗаказа.Вставить("prepayment", Выборка.УсловиеПредоплаты);
        
        // Обрабатываем товары
        МассивТоваров = Новый Массив;
        ВыборкаТовары = Выборка.Товары.Выбрать();
        Пока ВыборкаТовары.Следующий() Цикл
            СтруктураТовара = Новый Структура;
            СтруктураТовара.Вставить("name", ВыборкаТовары.Наименование);
            СтруктураТовара.Вставить("quantity", ВыборкаТовары.Количество);
            СтруктураТовара.Вставить("price", ВыборкаТовары.Цена);
            МассивТоваров.Добавить(СтруктураТовара);
        КонецЦикла;
        
        СтруктураЗаказа.Вставить("items", МассивТоваров);
        
        // Вычисляем общую сумму
        ОбщаяСумма = 0;
        Для Каждого Товар Из МассивТоваров Цикл
            ОбщаяСумма = ОбщаяСумма + Товар.quantity * Товар.price;
        КонецЦикла;
        СтруктураЗаказа.Вставить("total_sum", ОбщаяСумма);
        
        МассивЗаказов.Добавить(СтруктураЗаказа);
    КонецЦикла;
    
    ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, "Формирование ответа завершено, заказов: " + МассивЗаказов.Количество());
    
    // Формируем JSON-ответ
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, МассивЗаказов);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
    
    ЗаписьЖурналаРегистрации("HTTPСервис.history.hisorder", УровеньЖурналаРегистрации.Информация,,, "Запрос успешно обработан");
    
    Возврат Ответ;
    
КонецФункции

Функция StatusesGET(Запрос)
	ЗаписьЖурналаРегистрации("HTTPСервис.statuses", УровеньЖурналаРегистрации.Информация,,, "Начало обработки запроса");
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Статусы.Наименование КАК Наименование
        |ИЗ
        |	Справочник.Статусы КАК Статусы
        |ГДЕ
        |	НЕ Статусы.ПометкаУдаления";
    
    Попытка
        РезультатЗапроса = Запрос.Выполнить();
        ЗаписьЖурналаРегистрации("HTTPСервис.statuses", УровеньЖурналаРегистрации.Информация,,, "Запрос к базе выполнен успешно");
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки("Ошибка выполнения запроса к базе: " + ОписаниеОшибки());
        ЗаписьЖурналаРегистрации("HTTPСервис.statuses", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка выполнения запроса к базе: " + ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
    
    МассивСтатусов = Новый Массив;
    
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл
        СтруктураСтатуса = Новый Структура;
        СтруктураСтатуса.Вставить("name", Выборка.Наименование);
        МассивСтатусов.Добавить(СтруктураСтатуса);
    КонецЦикла;
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, МассивСтатусов);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
    
    ЗаписьЖурналаРегистрации("HTTPСервис.statuses", УровеньЖурналаРегистрации.Информация,,, "Запрос успешно обработан");
    
    Возврат Ответ;
КонецФункции
