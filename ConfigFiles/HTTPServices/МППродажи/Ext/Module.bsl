Функция SalesReportPOST(Запрос)
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
        УровеньЖурналаРегистрации.Информация,,, "Начало выполнения SalesReportPOST");
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
            УровеньЖурналаРегистрации.Информация,,, 
            "Тело запроса: " + ?(ПустаяСтрока(ТелоЗапроса), "Пустое", ТелоЗапроса));
        
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Тело запроса пустое"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецЕсли;
        
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        Попытка
            ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
        Исключение
            ЧтениеJSON.Закрыть();
            Описание = "Ошибка парсинга JSON: " + ОписаниеОшибки();
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, Описание);
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Некорректный JSON"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецПопытки;
        ЧтениеJSON.Закрыть();
        
        Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура") И ТипЗнч(ДанныеЗапроса) <> Тип("Соответствие") Тогда
            Описание = "Некорректный тип JSON: ожидается Структура или Соответствие, получено: " + ТипЗнч(ДанныеЗапроса);
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, Описание);
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Некорректный формат JSON: ожидается объект"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецЕсли;
        
        TelegramID = Неопределено;
        Если ТипЗнч(ДанныеЗапроса) = Тип("Структура") Тогда
            ДанныеЗапроса.Свойство("telegram_id", TelegramID);
        Иначе
            TelegramID = ДанныеЗапроса.Получить("telegram_id");
        КонецЕсли;
        
        Если НЕ ЗначениеЗаполнено(TelegramID) Тогда
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, "Параметр telegram_id отсутствует");
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Параметр telegram_id не указан"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецЕсли;
        
        TelegramID = Строка(TelegramID);
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
            УровеньЖурналаРегистрации.Информация,,, "TelegramID: " + TelegramID);
        
        // Проверяем статусы пользователя
        ЭтоМенеджер = Ложь;
        ЭтоКуратор = Ложь;
        МенеджерСсылка = Неопределено;
        МенеджерНаименование = "";
        
        // Проверка на менеджера
        ЗапросМенеджер = Новый Запрос;
        ЗапросМенеджер.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка КАК МП,
        |	Менеджер.Наименование КАК Наименование
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDM = &TelegramID
        |	И НЕ Менеджер.ПометкаУдаления";
        ЗапросМенеджер.УстановитьПараметр("TelegramID", TelegramID);
        РезультатМенеджер = ЗапросМенеджер.Выполнить();
        Если НЕ РезультатМенеджер.Пустой() Тогда
            ЭтоМенеджер = Истина;
            Выборка = РезультатМенеджер.Выбрать();
            Если Выборка.Следующий() Тогда
                МенеджерСсылка = Выборка.МП;
                МенеджерНаименование = Выборка.Наименование;
            КонецЕсли;
        КонецЕсли;
        
        // Проверка на куратора
        ЗапросКуратор = Новый Запрос;
        ЗапросКуратор.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDK = &TelegramID
        |	И НЕ Менеджер.ПометкаУдаления";
        ЗапросКуратор.УстановитьПараметр("TelegramID", TelegramID);
        РезультатКуратор = ЗапросКуратор.Выполнить();
        ЭтоКуратор = НЕ РезультатКуратор.Пустой();
        
        // Если пользователь не менеджер и не куратор, возвращаем ошибку
        Если НЕ ЭтоМенеджер И НЕ ЭтоКуратор Тогда
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, "Пользователь не является куратором или менеджером");
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("У вас нет прав доступа"));
            Ответ.КодСостояния = 403;
            Возврат Ответ;
        КонецЕсли;
        
        // Формируем список менеджеров
        ПодчиненныеМП = Новый ТаблицаЗначений;
        ПодчиненныеМП.Колонки.Добавить("МП");
        ПодчиненныеМП.Колонки.Добавить("Наименование");
        
        Если ЭтоКуратор Тогда
            // Добавляем всех подчиненных менеджеров
            ЗапросКуратор.Текст = 
            "ВЫБРАТЬ
            |	Менеджер.Ссылка КАК МП,
            |	Менеджер.Наименование КАК Наименование
            |ИЗ
            |	Справочник.Менеджер КАК Менеджер
            |ГДЕ
            |	Менеджер.TelegramIDK = &TelegramID
            |	И НЕ Менеджер.ПометкаУдаления";
            ПодчиненныеМП = ЗапросКуратор.Выполнить().Выгрузить();
        КонецЕсли;
        
        Если ЭтоМенеджер Тогда
            // Добавляем самого пользователя как менеджера, если он еще не в списке
            Найдено = ПодчиненныеМП.Найти(МенеджерСсылка, "МП");
            Если Найдено = Неопределено Тогда
                НоваяСтрока = ПодчиненныеМП.Добавить();
                НоваяСтрока.МП = МенеджерСсылка;
                НоваяСтрока.Наименование = МенеджерНаименование;
            КонецЕсли;
        КонецЕсли;
        
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
            УровеньЖурналаРегистрации.Информация,,, 
            "Найдено подчиненных МП: " + Формат(ПодчиненныеМП.Количество(), "ЧГ=0"));
        
        Если ПодчиненныеМП.Количество() = 0 Тогда
            СтруктураОтвета = Новый Структура("managers", Новый Массив);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(СтруктураОтвета));
            Возврат Ответ;
        КонецЕсли;
        
        Год = Неопределено;
        Месяц = Неопределено;
        Если ТипЗнч(ДанныеЗапроса) = Тип("Структура") Тогда
            ДанныеЗапроса.Свойство("year", Год);
            ДанныеЗапроса.Свойство("month", Месяц);
        Иначе
            Год = ДанныеЗапроса.Получить("year");
            Месяц = ДанныеЗапроса.Получить("month");
        КонецЕсли;
        
        Если НЕ ЗначениеЗаполнено(Год) ИЛИ НЕ ЗначениеЗаполнено(Месяц) Тогда
            Менеджеры = Новый Массив;
            Для Каждого МП Из ПодчиненныеМП Цикл
                ДанныеМП = Новый Структура("name", МП.Наименование);
                Менеджеры.Добавить(ДанныеМП);
            КонецЦикла;
            СтруктураОтвета = Новый Структура("managers", Менеджеры);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(СтруктураОтвета));
            Возврат Ответ;
        КонецЕсли;
        
        Попытка
            Год = Число(Год);
            Месяц = Число(Месяц);
        Исключение
            Описание = "Параметры year и month должны быть числами: " + ОписаниеОшибки();
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, Описание);
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON(Описание));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецПопытки;
        
        Попытка
            ДанныеПродаж = ПолучитьДанныеПродаж(ПодчиненныеМП, Год, Месяц);
        Исключение
            Описание = "Ошибка получения данных продаж: " + ОписаниеОшибки();
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, Описание);
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON(Описание));
            Ответ.КодСостояния = 500;
            Возврат Ответ;
        КонецПопытки;
        
        Ответ.УстановитьТелоИзСтроки(СформироватьJSON(ДанныеПродаж));
        
    Исключение
        Инфо = ИнформацияОбОшибке();
        Описание = "Общая ошибка: " + Инфо.Описание + ", строка: " + Формат(Инфо.НомерСтроки, "ЧГ=0");
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
            УровеньЖурналаРегистрации.Ошибка,,, Описание);
        Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON(Описание));
        Ответ.КодСостояния = 500;
    КонецПопытки;
    
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.SalesReportPOST", 
        УровеньЖурналаРегистрации.Информация,,, "Завершение выполнения SalesReportPOST");
    
    Возврат Ответ;
КонецФункции

Функция ПолучитьПодчиненныхМП(TelegramID)
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьПодчиненныхМП", 
        УровеньЖурналаРегистрации.Информация,,, "Начало выполнения, TelegramID: " + TelegramID);
    
    Попытка
        ПодчиненныеМП = Новый ТаблицаЗначений;
        ПодчиненныеМП.Колонки.Добавить("МП");
        ПодчиненныеМП.Колонки.Добавить("Наименование");
        
        // Проверка на менеджера
        ЗапросМенеджер = Новый Запрос;
        ЗапросМенеджер.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка КАК МП,
        |	Менеджер.Наименование КАК Наименование
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDM = &TelegramID
        |	И НЕ Менеджер.ПометкаУдаления";
        ЗапросМенеджер.УстановитьПараметр("TelegramID", Строка(TelegramID));
        РезультатМенеджер = ЗапросМенеджер.Выполнить();
        
        Если НЕ РезультатМенеджер.Пустой() Тогда
            Выборка = РезультатМенеджер.Выбрать();
            Если Выборка.Следующий() Тогда
                НоваяСтрока = ПодчиненныеМП.Добавить();
                НоваяСтрока.МП = Выборка.МП;
                НоваяСтрока.Наименование = Выборка.Наименование;
            КонецЕсли;
        КонецЕсли;
        
        // Проверка на куратора
        ЗапросКуратор = Новый Запрос;
        ЗапросКуратор.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка КАК МП,
        |	Менеджер.Наименование КАК Наименование
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDK = &TelegramID
        |	И НЕ Менеджер.ПометкаУдаления";
        ЗапросКуратор.УстановитьПараметр("TelegramID", Строка(TelegramID));
        РезультатКуратор = ЗапросКуратор.Выполнить();
        
        Если НЕ РезультатКуратор.Пустой() Тогда
            Выборка = РезультатКуратор.Выбрать();
            Пока Выборка.Следующий() Цикл
                Если ПодчиненныеМП.Найти(Выборка.МП, "МП") = Неопределено Тогда
                    НоваяСтрока = ПодчиненныеМП.Добавить();
                    НоваяСтрока.МП = Выборка.МП;
                    НоваяСтрока.Наименование = Выборка.Наименование;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьПодчиненныхМП", 
            УровеньЖурналаРегистрации.Информация,,, 
            "Найдено МП: " + Формат(ПодчиненныеМП.Количество(), "ЧГ=0"));
        
        Возврат ПодчиненныеМП;
        
    Исключение
        Описание = "Ошибка в ПолучитьПодчиненныхМП: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьПодчиненныхМП", 
            УровеньЖурналаРегистрации.Ошибка,,, Описание);
        ВызватьИсключение Описание;
    КонецПопытки;
КонецФункции

Функция ПолучитьДанныеПродаж(ПодчиненныеМП, Год, Месяц)
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьДанныеПродаж", 
        УровеньЖурналаРегистрации.Информация,,, 
        "Начало выполнения, Год: " + Год + ", Месяц: " + Месяц);
    
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |	Остатки.МП КАК МП,
        |	Остатки.МП.Наименование КАК НаименованиеМП,
        |	Остатки.Номенклатура.Наименование КАК Номенклатура,
        |	СУММА(Остатки.Колво) КАК Колво,
        |	СУММА(Остатки.Сумма) КАК Сотилган
        |ИЗ
        |	РегистрНакопления.Остатки КАК Остатки
        |ГДЕ
        |	Остатки.МП В(&СписокМП)
        |	И ГОД(Остатки.Период) = &Год
        |	И МЕСЯЦ(Остатки.Период) = &Месяц
        |
        |СГРУППИРОВАТЬ ПО
        |	Остатки.МП,
        |	Остатки.МП.Наименование,
        |	Остатки.Номенклатура.Наименование
        |
        |УПОРЯДОЧИТЬ ПО
        |	НаименованиеМП,
        |	Номенклатура";
        
        Запрос.УстановитьПараметр("СписокМП", ПодчиненныеМП.ВыгрузитьКолонку("МП"));
        Запрос.УстановитьПараметр("Год", Число(Год));
        Запрос.УстановитьПараметр("Месяц", Число(Месяц));
        
        Результат = Запрос.Выполнить().Выгрузить();
        
        Менеджеры = Новый Массив;
        ТекущийМП = Неопределено;
        ДанныеМП = Неопределено;
        
        Для Каждого Строка Из Результат Цикл
            Если ТекущийМП <> Строка.МП Тогда
                Если ДанныеМП <> Неопределено Тогда
                    Менеджеры.Добавить(ДанныеМП);
                КонецЕсли;
                
                ДанныеМП = Новый Структура;
                ДанныеМП.Вставить("name", Строка.НаименованиеМП);
                ДанныеМП.Вставить("total_sotilgan", 0);
                ДанныеМП.Вставить("items", Новый Массив);
                
                ТекущийМП = Строка.МП;
            КонецЕсли;
            
            ЭлементНоменклатуры = Новый Структура;
            ЭлементНоменклатуры.Вставить("nomenclature", Строка.Номенклатура);
            ЭлементНоменклатуры.Вставить("quantity", Строка.Колво);
            ЭлементНоменклатуры.Вставить("sotilgan", Строка.Сотилган);
            
            ДанныеМП.items.Добавить(ЭлементНоменклатуры);
            ДанныеМП.total_sotilgan = ДанныеМП.total_sotilgan + Строка.Сотилган;
        КонецЦикла;
        
        Если ДанныеМП <> Неопределено Тогда
            Менеджеры.Добавить(ДанныеМП);
        КонецЕсли;
        
        СтруктураОтвета = Новый Структура("managers", Менеджеры);
        
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьДанныеПродаж", 
            УровеньЖурналаРегистрации.Информация,,, "Завершение выполнения");
        
        Возврат СтруктураОтвета;
        
    Исключение
        Описание = "Ошибка в ПолучитьДанныеПродаж: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьДанныеПродаж", 
            УровеньЖурналаРегистрации.Ошибка,,, Описание);
        ВызватьИсключение Описание;
    КонецПопытки;
КонецФункции

Функция СформироватьJSON(Данные)
    
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.СформироватьJSON", 
        УровеньЖурналаРегистрации.Информация,,, "Начало выполнения");
    
    Попытка
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Данные);
        Результат = ЗаписьJSON.Закрыть();
        
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.СформироватьJSON", 
            УровеньЖурналаРегистрации.Информация,,, "Успешная сериализация");
        
        Возврат Результат;
    Исключение
        Описание = "Ошибка сериализации JSON: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.СформироватьJSON", 
            УровеньЖурналаРегистрации.Ошибка,,, Описание);
        ВызватьИсключение Описание;
    КонецПопытки;
    
КонецФункции

Функция СформироватьОшибкуJSON(ТекстОшибки)
    
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.СформироватьОшибкуJSON", 
        УровеньЖурналаРегистрации.Информация,,, "Начало выполнения, текст ошибки: " + ТекстОшибки);
    
    Попытка
        СтруктураОшибки = Новый Структура("error", ТекстОшибки);
        Результат = СформироватьJSON(СтруктураОшибки);
        
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.СформироватьОшибкуJSON", 
            УровеньЖурналаРегистрации.Информация,,, "Успешное формирование ошибки");
        
        Возврат Результат;
    Исключение
        Описание = "Ошибка формирования ошибки JSON: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.СформироватьОшибкуJSON", 
            УровеньЖурналаРегистрации.Ошибка,,, Описание);
        ВызватьИсключение Описание;
    КонецПопытки;
    
КонецФункции





Функция DailySalesPOST(Запрос)
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
        УровеньЖурналаРегистрации.Информация,,, "Начало выполнения DailySalesPOST");
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
            УровеньЖурналаРегистрации.Информация,,, 
            "Тело запроса: " + ?(ПустаяСтрока(ТелоЗапроса), "Пустое", ТелоЗапроса));
        
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Тело запроса пустое"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецЕсли;
        
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        Попытка
            ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
        Исключение
            ЧтениеJSON.Закрыть();
            Описание = "Ошибка парсинга JSON: " + ОписаниеОшибки();
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, Описание);
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Некорректный JSON"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецПопытки;
        ЧтениеJSON.Закрыть();
        
        TelegramID = Неопределено;
        ДатаСтрокой = Неопределено;
        Если ТипЗнч(ДанныеЗапроса) = Тип("Структура") Тогда
            ДанныеЗапроса.Свойство("telegram_id", TelegramID);
            ДанныеЗапроса.Свойство("date", ДатаСтрокой);
        Иначе
            TelegramID = ДанныеЗапроса.Получить("telegram_id");
            ДатаСтрокой = ДанныеЗапроса.Получить("date");
        КонецЕсли;
        
        Если НЕ ЗначениеЗаполнено(TelegramID) ИЛИ НЕ ЗначениеЗаполнено(ДатаСтрокой) Тогда
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Отсутствуют обязательные параметры: telegram_id, date"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецЕсли;
        
        TelegramID = Строка(TelegramID);
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
            УровеньЖурналаРегистрации.Информация,,, "TelegramID: " + TelegramID + ", Дата: " + ДатаСтрокой);
        
        Попытка
            ДатаЧасти = СтрРазделить(ДатаСтрокой, "-");
            Если ДатаЧасти.Количество() <> 3 Тогда
                ВызватьИсключение "Дата должна быть в формате YYYY-MM-DD";
            КонецЕсли;
            Год = Число(ДатаЧасти[0]);
            Месяц = Число(ДатаЧасти[1]);
            День = Число(ДатаЧасти[2]);
            Дата = Дата(Год, Месяц, День);
            
            Если Год < 1900 ИЛИ Месяц < 1 ИЛИ Месяц > 12 ИЛИ День < 1 ИЛИ День > 31 Тогда
                ВызватьИсключение "Недопустимые значения года, месяца или дня";
            КонецЕсли;
        Исключение
            Описание = "Ошибка парсинга даты: " + ДатаСтрокой + ", деталь: " + ОписаниеОшибки();
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, Описание);
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Некорректный формат даты. Ожидается YYYY-MM-DD"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецПопытки;
        
        // Проверяем статусы пользователя
        ЭтоМенеджер = Ложь;
        ЭтоКуратор = Ложь;
        МенеджерСсылка = Неопределено;
        МенеджерНаименование = "";
        
        // Проверка на менеджера
        ЗапросМенеджер = Новый Запрос;
        ЗапросМенеджер.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка КАК МП,
        |	Менеджер.Наименование КАК Наименование
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDM = &TelegramID
        |	И НЕ Менеджер.ПометкаУдаления";
        ЗапросМенеджер.УстановитьПараметр("TelegramID", TelegramID);
        РезультатМенеджер = ЗапросМенеджер.Выполнить();
        Если НЕ РезультатМенеджер.Пустой() Тогда
            ЭтоМенеджер = Истина;
            Выборка = РезультатМенеджер.Выбрать();
            Если Выборка.Следующий() Тогда
                МенеджерСсылка = Выборка.МП;
                МенеджерНаименование = Выборка.Наименование;
            КонецЕсли;
        КонецЕсли;
        
        // Проверка на куратора
        ЗапросКуратор = Новый Запрос;
        ЗапросКуратор.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDK = &TelegramID
        |	И НЕ Менеджер.ПометкаУдаления";
        ЗапросКуратор.УстановитьПараметр("TelegramID", TelegramID);
        РезультатКуратор = ЗапросКуратор.Выполнить();
        ЭтоКуратор = НЕ РезультатКуратор.Пустой();
        
        // Если пользователь не менеджер и не куратор, возвращаем ошибку
        Если НЕ ЭтоМенеджер И НЕ ЭтоКуратор Тогда
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, "Пользователь не является куратором или менеджером");
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("У вас нет прав доступа"));
            Ответ.КодСостояния = 403;
            Возврат Ответ;
        КонецЕсли;
        
        // Формируем список менеджеров
        ПодчиненныеМП = Новый ТаблицаЗначений;
        ПодчиненныеМП.Колонки.Добавить("МП");
        ПодчиненныеМП.Колонки.Добавить("Наименование");
        
        Если ЭтоКуратор Тогда
            ЗапросКуратор.Текст = 
            "ВЫБРАТЬ
            |	Менеджер.Ссылка КАК МП,
            |	Менеджер.Наименование КАК Наименование
            |ИЗ
            |	Справочник.Менеджер КАК Менеджер
            |ГДЕ
            |	Менеджер.TelegramIDK = &TelegramID
            |	И НЕ Менеджер.ПометкаУдаления";
            ПодчиненныеМП = ЗапросКуратор.Выполнить().Выгрузить();
        КонецЕсли;
        
        Если ЭтоМенеджер Тогда
            Найдено = ПодчиненныеМП.Найти(МенеджерСсылка, "МП");
            Если Найдено = Неопределено Тогда
                НоваяСтрока = ПодчиненныеМП.Добавить();
                НоваяСтрока.МП = МенеджерСсылка;
                НоваяСтрока.Наименование = МенеджерНаименование;
            КонецЕсли;
        КонецЕсли;
        
        Если ПодчиненныеМП.Количество() = 0 Тогда
            СтруктураОтвета = Новый Структура("managers", Новый Массив);
            Ответ.УстановитьТелоИзСтроки(СформироватьJSON(СтруктураОтвета));
            Возврат Ответ;
        КонецЕсли;
        
        Попытка
            ДанныеПродаж = ПолучитьДанныеПродажНаДату(ПодчиненныеМП, Дата);
        Исключение
            Описание = "Ошибка получения данных продаж: " + ОписаниеОшибки();
            ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
                УровеньЖурналаРегистрации.Ошибка,,, Описание);
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON(Описание));
            Ответ.КодСостояния = 500;
            Возврат Ответ;
        КонецПопытки;
        
        Ответ.УстановитьТелоИзСтроки(СформироватьJSON(ДанныеПродаж));
        
    Исключение
        Инфо = ИнформацияОбОшибке();
        Описание = "Общая ошибка: " + Инфо.Описание + ", строка: " + Формат(Инфо.НомерСтроки, "ЧГ=0");
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
            УровеньЖурналаРегистрации.Ошибка,,, Описание);
        Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON(Описание));
        Ответ.КодСостояния = 500;
    КонецПопытки;
    
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.DailySalesPOST", 
        УровеньЖурналаРегистрации.Информация,,, "Завершение выполнения DailySalesPOST");
    
    Возврат Ответ;
КонецФункции

Функция ПолучитьДанныеПродажНаДату(ПодчиненныеМП, Дата)
    ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьДанныеПродажНаДату", 
        УровеньЖурналаРегистрации.Информация,,, 
        "Начало выполнения, Дата: " + Формат(Дата, "ДФ=yyyy-MM-dd"));
    
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |	Остатки.МП КАК МП,
        |	Остатки.МП.Наименование КАК НаименованиеМП,
        |	Остатки.Номенклатура.Наименование КАК Номенклатура,
        |	СУММА(Остатки.Колво) КАК Колво,
        |	СУММА(Остатки.Сумма) КАК Сотилган
        |ИЗ
        |	РегистрНакопления.Остатки КАК Остатки
        |ГДЕ
        |	Остатки.МП В(&СписокМП)
        |	И Остатки.Период >= &НачалоДня
        |	И Остатки.Период < &КонецДня
        |
        |СГРУППИРОВАТЬ ПО
        |	Остатки.МП,
        |	Остатки.МП.Наименование,
        |	Остатки.Номенклатура.Наименование
        |
        |УПОРЯДОЧИТЬ ПО
        |	НаименованиеМП,
        |	Номенклатура";
        
        Запрос.УстановитьПараметр("СписокМП", ПодчиненныеМП.ВыгрузитьКолонку("МП"));
        Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Дата));
        Запрос.УстановитьПараметр("КонецДня", КонецДня(Дата));
        
        Результат = Запрос.Выполнить().Выгрузить();
        
        Менеджеры = Новый Массив;
        ТекущийМП = Неопределено;
        ДанныеМП = Неопределено;
        
        Для Каждого Строка Из Результат Цикл
            Если ТекущийМП <> Строка.МП Тогда
                Если ДанныеМП <> Неопределено Тогда
                    Менеджеры.Добавить(ДанныеМП);
                КонецЕсли;
                
                ДанныеМП = Новый Структура;
                ДанныеМП.Вставить("name", Строка.НаименованиеМП);
                ДанныеМП.Вставить("total_sotilgan", 0);
                ДанныеМП.Вставить("items", Новый Массив);
                
                ТекущийМП = Строка.МП;
            КонецЕсли;
            
            ЭлементНоменклатуры = Новый Структура;
            ЭлементНоменклатуры.Вставить("nomenclature", Строка.Номенклатура);
            ЭлементНоменклатуры.Вставить("quantity", Строка.Колво);
            ЭлементНоменклатуры.Вставить("sotilgan", Строка.Сотилган);
            
            ДанныеМП.items.Добавить(ЭлементНоменклатуры);
            ДанныеМП.total_sotilgan = ДанныеМП.total_sotilgan + Строка.Сотилган;
        КонецЦикла;
        
        Если ДанныеМП <> Неопределено Тогда
            Менеджеры.Добавить(ДанныеМП);
        КонецЕсли;
        
        СтруктураОтвета = Новый Структура("managers", Менеджеры);
        
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьДанныеПродажНаДату", 
            УровеньЖурналаРегистрации.Информация,,, "Завершение выполнения");
        
        Возврат СтруктураОтвета;
        
    Исключение
        Описание = "Ошибка в ПолучитьДанныеПродажНаДату: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("HTTP.МППродажи.ПолучитьДанныеПродажНаДату", 
            УровеньЖурналаРегистрации.Ошибка,,, Описание);
        ВызватьИсключение Описание;
    КонецПопытки;
КонецФункции