

Функция mpzadoljennostiPOST(Запрос)
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Начало обработки POST-запроса mpzadoljennosti");
    
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
        ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON, Истина);
        ЧтениеJSON.Закрыть();
    Исключение
        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписьЖурналаРегистрации("МППросрочки.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
            "Ошибка чтения JSON: " + ТекстОшибки);
        Возврат ОтветОшибка("Ошибка обработки запроса.", 400);
    КонецПопытки;
    
    TelegramID = СокрЛП(ДанныеЗапроса["telegram_id"]);
    Если НЕ ЗначениеЗаполнено(TelegramID) Тогда
        ЗаписьЖурналаРегистрации("МППросрочки.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
            "Не указан Telegram ID.");
        Возврат ОтветОшибка("Не указан Telegram ID.", 400);
    КонецЕсли;
    
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Обработка запроса для TelegramID: " + TelegramID);
    
    // Проверяем статусы пользователя
    ЭтоМенеджер = Ложь;
    ЭтоКуратор = Ложь;
    МенеджерСсылка = Неопределено;
    МенеджерНаименование = "";
    
    // Проверка на менеджера
    ЗапросМенеджер = Новый Запрос;
    ЗапросМенеджер.Текст = 
    "ВЫБРАТЬ
    |	Менеджер.Ссылка КАК Ссылка,
    |	Менеджер.Наименование КАК Наименование
    |ИЗ
    |	Справочник.Менеджер КАК Менеджер
    |ГДЕ
    |	Менеджер.TelegramIDM = &TelegramID";
    ЗапросМенеджер.УстановитьПараметр("TelegramID", TelegramID);
    РезультатМенеджер = ЗапросМенеджер.Выполнить();
    Если НЕ РезультатМенеджер.Пустой() Тогда
        ЭтоМенеджер = Истина;
        Выборка = РезультатМенеджер.Выбрать();
        Если Выборка.Следующий() Тогда
            МенеджерСсылка = Выборка.Ссылка;
            МенеджерНаименование = Выборка.Наименование;
        КонецЕсли;
    КонецЕсли;
    
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Менеджер: " + ?(ЭтоМенеджер, "Найден, Ссылка: " + Строка(МенеджерСсылка) + ", Наименование: " + МенеджерНаименование, "Не найден"));
    
    // Проверка на куратора
    ЗапросКуратор = Новый Запрос;
    ЗапросКуратор.Текст = 
    "ВЫБРАТЬ
    |	Менеджер.Ссылка
    |ИЗ
    |	Справочник.Менеджер КАК Менеджер
    |ГДЕ
    |	Менеджер.TelegramIDK = &TelegramID";
    ЗапросКуратор.УстановитьПараметр("TelegramID", TelegramID);
    РезультатКуратор = ЗапросКуратор.Выполнить();
    ЭтоКуратор = НЕ РезультатКуратор.Пустой();
    
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Куратор: " + ?(ЭтоКуратор, "Найден", "Не найден"));
    
    // Если пользователь не менеджер и не куратор, возвращаем ошибку
    Если НЕ ЭтоМенеджер И НЕ ЭтоКуратор Тогда
        ЗаписьЖурналаРегистрации("МППросрочки.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
            "Пользователь не является куратором или менеджером, TelegramID: " + TelegramID);
        Возврат ОтветОшибка("У вас нет прав доступа.", 403);
    КонецЕсли;
    
    // Формируем список менеджеров
    Менеджеры = Новый Массив;
    
    Если ЭтоКуратор Тогда
        ЗапросКуратор.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка,
        |	Менеджер.Наименование
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDK = &TelegramID";
        Выборка = ЗапросКуратор.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Менеджеры.Добавить(Выборка.Ссылка);
            ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
                "Добавлен подчиненный менеджер: " + Выборка.Наименование + ", Ссылка: " + Строка(Выборка.Ссылка));
        КонецЦикла;
    КонецЕсли;
    
    Если ЭтоМенеджер Тогда
        Если Менеджеры.Найти(МенеджерСсылка) = Неопределено Тогда
            Менеджеры.Добавить(МенеджерСсылка);
            ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
                "Добавлен текущий менеджер: " + МенеджерНаименование + ", Ссылка: " + Строка(МенеджерСсылка));
        КонецЕсли;
    КонецЕсли;
    
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Найдено менеджеров: " + Формат(Менеджеры.Количество(), "ЧГ=0") + ", TelegramID: " + TelegramID);
    
    // Проверка соответствия МенеджерСсылка в Дебиторка
    Если ЭтоМенеджер Тогда
        ЗапросПроверка = Новый Запрос;
        ЗапросПроверка.Текст = 
        "ВЫБРАТЬ
        |	ДебиторкаОстатки.ДокНомер.МП КАК Менеджер,
        |	ДебиторкаОстатки.ДокНомер.МП.Наименование КАК Наименование
        |ИЗ
        |	РегистрНакопления.Дебиторка.Остатки(, ДокНомер.МП.Наименование = &Наименование) КАК ДебиторкаОстатки
        |ГДЕ
        |	ДебиторкаОстатки.ДокНомер.МП = &МенеджерСсылка";
        ЗапросПроверка.УстановитьПараметр("МенеджерСсылка", МенеджерСсылка);
        ЗапросПроверка.УстановитьПараметр("Наименование", МенеджерНаименование);
        РезультатПроверка = ЗапросПроверка.Выполнить();
        Если НЕ РезультатПроверка.Пустой() Тогда
            Выборка = РезультатПроверка.Выбрать();
            Если Выборка.Следующий() Тогда
                ЗаписьЖурналаРегистрации("МППросрочки.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
                    "Несоответствие МенеджерСсылка: TelegramIDM = " + TelegramID + ", Наименование = " + МенеджерНаименование + 
                    ", Ссылка из справочника = " + Строка(МенеджерСсылка) + ", Ссылка в Дебиторка = " + Строка(Выборка.Менеджер));
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    
    // Формируем ответ
    ДанныеОтвета = Новый Структура;
    ДанныеОтвета.Вставить("Менеджеры", Новый Массив);
    ДанныеОтвета.Вставить("ОбщаяСумма", 0);
    ДанныеОтвета.Вставить("ОбщаяПросроченнаяСумма", 0);
    ДанныеОтвета.Вставить("ДатаОстатков", Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy"));
    
    // Если пользователь — менеджер, добавляем его в ответ
    Если ЭтоМенеджер Тогда
        ДанныеМенеджера = Новый Структура;
        ДанныеМенеджера.Вставить("Менеджер", МенеджерНаименование);
        ДанныеМенеджера.Вставить("Контрагенты", Новый Массив);
        ДанныеМенеджера.Вставить("СуммаЗадолженности", 0);
        ДанныеМенеджера.Вставить("СуммаПросрочено", 0);
        ДанныеОтвета.Менеджеры.Добавить(ДанныеМенеджера);
    КонецЕсли;
    
    // Получаем данные о задолженностях
    Если Менеджеры.Количество() > 0 Тогда
        ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
            "Получение данных о задолженностях для " + Формат(Менеджеры.Количество(), "ЧГ=0") + " менеджеров");
        Попытка
            РезультатДанные = ПолучитьДанныеЗадолженностей(Менеджеры, МенеджерНаименование, ЭтоМенеджер);
            ДанныеОтвета.Менеджеры = РезультатДанные.Менеджеры;
            ДанныеОтвета.ОбщаяСумма = РезультатДанные.ОбщаяСумма;
            ДанныеОтвета.ОбщаяПросроченнаяСумма = РезультатДанные.ОбщаяПросроченнаяСумма;
            ДанныеОтвета.ДатаОстатков = РезультатДанные.ДатаОстатков;
        Исключение
            ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
            ЗаписьЖурналаРегистрации("МППросрочки.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
                "Ошибка получения данных о задолженностях: " + ТекстОшибки);
            Возврат ОтветОшибка("Ошибка получения данных о задолженностях.", 500);
        КонецПопытки;
    КонецЕсли;
    
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Формирование ответа, менеджеров в ответе: " + Формат(ДанныеОтвета.Менеджеры.Количество(), "ЧГ=0"));
    Ответ = Новый HTTPСервисОтвет(200);
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Возврат Ответ;
КонецФункции

Функция НайтиМенеджераПоTelegramID(TelegramID)
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , "Начало поиска менеджера по Telegram ID: " + TelegramID);
    TelegramID = СокрЛП(TelegramID);
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDK = &TelegramID";
    Запрос.УстановитьПараметр("TelegramID", TelegramID);
    Попытка
        Результат = Запрос.Выполнить();
    Исключение
        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписьЖурналаРегистрации("МППросрочки.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка поиска менеджера: " + ТекстОшибки);
        Возврат Справочники.Менеджер.ПустаяСсылка();
    КонецПопытки;
    Если Результат.Пустой() Тогда
        ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , "Менеджер не найден для Telegram ID: " + TelegramID);
        Возврат Справочники.Менеджер.ПустаяСсылка();
    КонецЕсли;
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , "Менеджер найден: " + Строка(Выборка.Ссылка));
    Возврат Выборка.Ссылка;
КонецФункции

Функция ПолучитьДанныеЗадолженностей(Менеджеры, МенеджерНаименование, ЭтоМенеджер)
    ТекущаяДата = ТекущаяДата();
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Начало получения данных о задолженностях, менеджеров: " + Формат(Менеджеры.Количество(), "ЧГ=0"));
    
    ДанныеОтвета = Новый Структура;
    ДанныеОтвета.Вставить("Менеджеры", Новый Массив);
    ДанныеОтвета.Вставить("ОбщаяСумма", 0);
    ДанныеОтвета.Вставить("ОбщаяПросроченнаяСумма", 0);
    ДанныеОтвета.Вставить("ДатаОстатков", Формат(ТекущаяДата, "ДФ=dd.MM.yyyy"));
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	ДебиторкаОстатки.ДокНомер КАК ДокНомер,
    |	ДебиторкаОстатки.ДокНомер.МП КАК Менеджер,
    |	ДебиторкаОстатки.ДокНомер.МП.Наименование КАК МенеджерНаименование,
    |	ДебиторкаОстатки.ДокНомер.Владелец КАК Контрагент,
    |	ДебиторкаОстатки.ДокНомер.Владелец.ИНН КАК ИНН,
    |	ДебиторкаОстатки.ДокНомер.ДатаСоставления КАК ДатаСоставления,
    |	ДебиторкаОстатки.ДокНомер.СрокДействия КАК СрокДействия,
    |	ДебиторкаОстатки.ДокНомер.Наименование КАК ДоговорНаименование,
    |	СУММА(ДебиторкаОстатки.ЗадолженностьСумОстаток) КАК ЗадолженностьСум
    |ИЗ
    |	РегистрНакопления.Дебиторка.Остатки(
    |			,
    |			ДокНомер.МП В (&Менеджеры)) КАК ДебиторкаОстатки
    |СГРУППИРОВАТЬ ПО
    |	ДебиторкаОстатки.ДокНомер,
    |	ДебиторкаОстатки.ДокНомер.МП,
    |	ДебиторкаОстатки.ДокНомер.МП.Наименование,
    |	ДебиторкаОстатки.ДокНомер.Владелец,
    |	ДебиторкаОстатки.ДокНомер.Владелец.ИНН,
    |	ДебиторкаОстатки.ДокНомер.ДатаСоставления,
    |	ДебиторкаОстатки.ДокНомер.СрокДействия,
    |	ДебиторкаОстатки.ДокНомер.Наименование
    |УПОРЯДОЧИТЬ ПО
    |	МенеджерНаименование,
    |	Контрагент,
    |	ДокНомер";
    Запрос.УстановитьПараметр("Менеджеры", Менеджеры);
    
    Попытка
        РезультатЗапроса = Запрос.Выполнить();
        ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
            "Запрос выполнен, строк в результате: " + Формат(РезультатЗапроса.Выбрать().Количество(), "ЧГ=0"));
    Исключение
        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписьЖурналаРегистрации("МППросрочки.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
            "Ошибка выполнения запроса задолженностей: " + ТекстОшибки);
        ВызватьИсключение "Ошибка выполнения запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    
    ТекущийМенеджер = Неопределено;
    ДанныеМенеджера = Неопределено;
    Выборка = РезультатЗапроса.Выбрать();
    
    Пока Выборка.Следующий() Цикл
        Если ТекущийМенеджер <> Выборка.Менеджер Тогда
            Если ДанныеМенеджера <> Неопределено Тогда
                ДанныеОтвета.Менеджеры.Добавить(ДанныеМенеджера);
            КонецЕсли;
            ТекущийМенеджер = Выборка.Менеджер;
            ДанныеМенеджера = Новый Структура;
            ДанныеМенеджера.Вставить("Менеджер", ?(ЗначениеЗаполнено(Выборка.МенеджерНаименование), Выборка.МенеджерНаименование, ""));
            ДанныеМенеджера.Вставить("Контрагенты", Новый Массив);
            ДанныеМенеджера.Вставить("СуммаЗадолженности", 0);
            ДанныеМенеджера.Вставить("СуммаПросрочено", 0);
        КонецЕсли;
        
        ДанныеКонтрагента = Новый Структура;
        ДанныеКонтрагента.Вставить("Контрагент", ?(ЗначениеЗаполнено(Выборка.Контрагент), Строка(Выборка.Контрагент), ""));
        ДанныеКонтрагента.Вставить("ИНН", ?(ЗначениеЗаполнено(Выборка.ИНН), Формат(Выборка.ИНН, "ЧГ=0"), ""));
        ДанныеКонтрагента.Вставить("Договор", ?(ЗначениеЗаполнено(Выборка.ДоговорНаименование), Выборка.ДоговорНаименование, ""));
        ДанныеКонтрагента.Вставить("ДатаСоставления", ?(ЗначениеЗаполнено(Выборка.ДатаСоставления), Формат(Выборка.ДатаСоставления, "ДФ=yyyy-MM-ddTHH:mm:ss"), "0001-01-01T00:00:00"));
        ДанныеКонтрагента.Вставить("СрокДействия", ?(ЗначениеЗаполнено(Выборка.СрокДействия), Формат(Выборка.СрокДействия, "ДФ=yyyy-MM-ddTHH:mm:ss"), "0001-01-01T00:00:00"));
        ДанныеКонтрагента.Вставить("СуммаЗадолженности", ?(ЗначениеЗаполнено(Выборка.ЗадолженностьСум), Выборка.ЗадолженностьСум, 0));
        
        ДнейПросрочки = 0;
        Если ЗначениеЗаполнено(Выборка.СрокДействия) И Выборка.СрокДействия < ТекущаяДата Тогда
            ДнейПросрочки = (ТекущаяДата - Выборка.СрокДействия) / (24 * 60 * 60);
            ДанныеКонтрагента.Вставить("ПросроченоДней", Окр(ДнейПросрочки));
        Иначе
            ДанныеКонтрагента.Вставить("ПросроченоДней", 0);
        КонецЕсли;
        
        ДанныеМенеджера.Контрагенты.Добавить(ДанныеКонтрагента);
        ДанныеМенеджера.СуммаЗадолженности = ДанныеМенеджера.СуммаЗадолженности + ДанныеКонтрагента.СуммаЗадолженности;
        Если ДнейПросрочки > 0 Тогда
            ДанныеМенеджера.СуммаПросрочено = ДанныеМенеджера.СуммаПросрочено + ДанныеКонтрагента.СуммаЗадолженности;
        КонецЕсли;
        
        ДанныеОтвета.ОбщаяСумма = ДанныеОтвета.ОбщаяСумма + ДанныеКонтрагента.СуммаЗадолженности;
        Если ДнейПросрочки > 0 Тогда
            ДанныеОтвета.ОбщаяПросроченнаяСумма = ДанныеОтвета.ОбщаяПросроченнаяСумма + ДанныеКонтрагента.СуммаЗадолженности;
        КонецЕсли;
    КонецЦикла;
    
    Если ДанныеМенеджера <> Неопределено Тогда
        ДанныеОтвета.Менеджеры.Добавить(ДанныеМенеджера);
    КонецЕсли;
    
    // Гарантируем наличие текущего менеджера в ответе
    Если ЭтоМенеджер Тогда
        Найдено = Ложь;
        Для Каждого Данные Из ДанныеОтвета.Менеджеры Цикл
            Если Данные.Менеджер = МенеджерНаименование Тогда
                Найдено = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если НЕ Найдено Тогда
            ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
                "Данные для менеджера " + МенеджерНаименование + " не найдены в регистре, добавляем пустую структуру");
            ДанныеМенеджера = Новый Структура;
            ДанныеМенеджера.Вставить("Менеджер", МенеджерНаименование);
            ДанныеМенеджера.Вставить("Контрагенты", Новый Массив);
            ДанныеМенеджера.Вставить("СуммаЗадолженности", 0);
            ДанныеМенеджера.Вставить("СуммаПросрочено", 0);
            ДанныеОтвета.Менеджеры.Добавить(ДанныеМенеджера);
        КонецЕсли;
    КонецЕсли;
    
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Данные задолженностей сформированы, менеджеров в ответе: " + Формат(ДанныеОтвета.Менеджеры.Количество(), "ЧГ=0"));
    Возврат ДанныеОтвета;
КонецФункции




Функция ОтветОшибка(ТекстОшибки, КодСостояния)
    ЗаписьЖурналаРегистрации("МППросрочки.Диагностика", УровеньЖурналаРегистрации.Информация, , , 
        "Формирование ответа с ошибкой: " + ТекстОшибки);
    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    ДанныеОшибки = Новый Структура("error", ТекстОшибки);
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеОшибки);
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Возврат Ответ;
КонецФункции

