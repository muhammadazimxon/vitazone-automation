Функция ostatka(Запрос) Экспорт
	Попытка
		ДатаОстатков = Неопределено;
		
		// Разбираем параметры запроса
		Если Запрос.HTTPМетод = "POST" Тогда
			ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
			Сообщить("Тело запроса: " + ТелоЗапроса); // Лог для отладки
			
			Если ПустаяСтрока(ТелоЗапроса) Тогда
				Ответ = Новый HTTPСервисОтвет(400);
				Ответ.УстановитьТелоИзСтроки("Ошибка: Тело запроса пустое.");
				Возврат Ответ;
			КонецЕсли;
			
			Данные = Новый ЧтениеJSON;
			Данные.УстановитьСтроку(ТелоЗапроса);
			ДеревоJSON = ПрочитатьJSON(Данные);

			Если ДеревоJSON.Свойство("ДатаОстатков") Тогда
				Попытка
					// Преобразуем "YYYY-MM-DD" в "YYYYMMDD"
					ДатаСтрокой = СтрЗаменить(ДеревоJSON.ДатаОстатков, "-", "");
					ДатаОстатков = Дата(ДатаСтрокой)+86400; // Ожидаем "20250312"
				Исключение
					Ответ = Новый HTTPСервисОтвет(400);
					Ответ.УстановитьТелоИзСтроки("Ошибка: Неверный формат даты. Ожидается YYYY-MM-DD.");
					Возврат Ответ;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если ДатаОстатков = Неопределено Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			Ответ.УстановитьТелоИзСтроки("Ошибка: Не указана дата остатков.");
			Возврат Ответ;
		КонецЕсли;

		// Запрос к регистру
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ 
			|    Склады.Номенклатура.Наименование КАК Номенклатура, 
			|    Склады.КолВоОстаток КАК КонечныйОстаток
			|ИЗ 
			|    РегистрНакопления.Склады.Остатки(&Дата) КАК Склады";
		Запрос.УстановитьПараметр("Дата", ДатаОстатков);

		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();

		// Формируем JSON
		МассивОстатков = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ДанныеОстатка = Новый Структура("Номенклатура, КонечныйОстаток", 
				Выборка.Номенклатура, 
				Выборка.КонечныйОстаток);
			МассивОстатков.Добавить(ДанныеОстатка);
		КонецЦикла;

		// Сериализация в JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивОстатков);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		// Установка тела ответа
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
		Возврат Ответ;
		
	Исключение
		// Сериализация ошибки в JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Новый Структура("Ошибка", ОписаниеОшибки()));
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-Type", "application/json");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
		Возврат Ответ;
	КонецПопытки;
КонецФункции