Функция CheckCuratorPOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    Попытка
        Тело = Запрос.ПолучитьТелоКакСтроку();
        ЗаписьЖурналаРегистрации("HTTP.CheckCuratorPOST", УровеньЖурналаРегистрации.Информация,,,
            "Тело запроса: " + ?(ПустаяСтрока(Тело), "Пустое", Тело));
        
        Если ПустаяСтрока(Тело) Тогда
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Тело запроса пустое"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецЕсли;
        
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Тело);
        Попытка
            Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
        Исключение
            ЧтениеJSON.Закрыть();
            ЗаписьЖурналаРегистрации("HTTP.CheckCuratorPOST", УровеньЖурналаРегистрации.Ошибка,,,
                "Ошибка парсинга JSON: " + ОписаниеОшибки());
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Ошибка парсинга JSON"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецПопытки;
        ЧтениеJSON.Закрыть();
        
        Если ТипЗнч(Данные) <> Тип("Соответствие") И ТипЗнч(Данные) <> Тип("Структура") Тогда
            ЗаписьЖурналаРегистрации("HTTP.CheckCuratorPOST", УровеньЖурналаРегистрации.Ошибка,,,
                "Некорректный тип JSON: ожидается Соответствие или Структура, получено: " + ТипЗнч(Данные));
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Некорректный формат JSON: ожидается объект"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецЕсли;
        
        TelegramID = Неопределено;
        Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
            TelegramID = Данные.Получить("telegram_id");
        ИначеЕсли ТипЗнч(Данные) = Тип("Структура") Тогда
            Если Данные.Свойство("telegram_id", TelegramID) Тогда
                // TelegramID уже заполнен
            КонецЕсли;
        КонецЕсли;
        
        Если НЕ ЗначениеЗаполнено(TelegramID) Тогда
            ЗаписьЖурналаРегистрации("HTTP.CheckCuratorPOST", УровеньЖурналаРегистрации.Ошибка,,,
                "Параметр telegram_id отсутствует в JSON");
            Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON("Параметр telegram_id не указан"));
            Ответ.КодСостояния = 400;
            Возврат Ответ;
        КонецЕсли;
        
        // Проверяем, является ли пользователь куратором
        ЗапросКуратор = Новый Запрос;
        ЗапросКуратор.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDK = &TelegramID
        |	И НЕ Менеджер.ПометкаУдаления";
        ЗапросКуратор.УстановитьПараметр("TelegramID", TelegramID);
        РезультатКуратор = ЗапросКуратор.Выполнить();
        ЭтоКуратор = НЕ РезультатКуратор.Пустой();
        
        // Проверяем, является ли пользователь менеджером
        ЗапросМенеджер = Новый Запрос;
        ЗапросМенеджер.Текст = 
        "ВЫБРАТЬ
        |	Менеджер.Ссылка,
        |	Менеджер.Наименование КАК Наименование
        |ИЗ
        |	Справочник.Менеджер КАК Менеджер
        |ГДЕ
        |	Менеджер.TelegramIDM = &TelegramID
        |	И НЕ Менеджер.ПометкаУдаления";
        ЗапросМенеджер.УстановитьПараметр("TelegramID", TelegramID);
        РезультатМенеджер = ЗапросМенеджер.Выполнить();
        ЭтоМенеджер = НЕ РезультатМенеджер.Пустой();
        ИмяМенеджера = "";
        Если ЭтоМенеджер Тогда
            Выборка = РезультатМенеджер.Выбрать();
            Если Выборка.Следующий() Тогда
                ИмяМенеджера = Выборка.Наименование;
            КонецЕсли;
        КонецЕсли;
        
        // Формируем ответ
        СтруктураОтвета = Новый Структура;
        СтруктураОтвета.Вставить("is_curator", ЭтоКуратор);
        СтруктураОтвета.Вставить("is_manager", ЭтоМенеджер);
        СтруктураОтвета.Вставить("manager_name", ИмяМенеджера);
        
        Ответ.УстановитьТелоИзСтроки(СформироватьJSON(СтруктураОтвета));
        
    Исключение
        ИнфоОбОшибке = ИнформацияОбОшибке();
        Описание = "Ошибка: " + ИнфоОбОшибке.Описание + ", строка: " + ИнфоОбОшибке.НомерСтроки;
        ЗаписьЖурналаРегистрации("HTTP.CheckCuratorPOST", УровеньЖурналаРегистрации.Ошибка,,, Описание);
        Ответ.УстановитьТелоИзСтроки(СформироватьОшибкуJSON(Описание));
        Ответ.КодСостояния = 500;
    КонецПопытки;
    
    Возврат Ответ;
КонецФункции
// Вспомогательная функция для заполнения структуры из JSON
Процедура ЗаполнитьСтруктуруИзJSON(ЧтениеJSON, Структура)
    Пока ЧтениеJSON.Прочитать() Цикл
        Если ЧтениеJSON.ТипТекущегоЗначения() = ТипЗначенияJSON.ИмяСвойства Тогда
            ИмяСвойства = ЧтениеJSON.ТекущееЗначение();
            ЧтениеJSON.Прочитать();
            Если ЧтениеJSON.ТипТекущегоЗначения() = ТипЗначенияJSON.Строка Тогда
                Структура.Вставить(ИмяСвойства, ЧтениеJSON.ТекущееЗначение());
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// Вспомогательная функция для сериализации в JSON
Функция СформироватьJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

// Формирование JSON с ошибкой
Функция СформироватьОшибкуJSON(ТекстОшибки)
	СтруктураОшибки = Новый Структура("error", ТекстОшибки);
	Возврат СформироватьJSON(СтруктураОшибки);
КонецФункции

