Функция prosrochkaDetailsPOST(Запрос)
	
	// Читаем тело запроса
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоЗапроса) Тогда
		Возврат Новый HTTPСервисОтвет(400, "Ошибка: тело запроса пустое");
	КонецЕсли;
	
	// Парсим JSON
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат СоздатьОтветСОшибкой(400, "Ошибка: неверный формат JSON - " + ОписаниеОшибки());
	КонецПопытки;
	
	// Получаем дату из запроса
	Если НЕ Данные.Свойство("Дата") Тогда
		Возврат СоздатьОтветСОшибкой(400, "Ошибка: в запросе отсутствует поле 'Дата'");
	КонецЕсли;
	
	Попытка
		ДатаПользователя = ПрочитатьДатуJSON(Данные.Дата, ФорматДатыJSON.ISO); // Поддержка "YYYY-MM-DD"
	Исключение
		Возврат СоздатьОтветСОшибкой(400, "Ошибка: неверный формат даты - " + ОписаниеОшибки());
	КонецПопытки;
	
	// Формируем запрос к регистру накопления
	Запрос1С = Новый Запрос;
	Запрос1С.Текст = 
	"ВЫБРАТЬ
	|	ДебиторкаОстатки.ДокНомер.МП.Регион КАК Регион,
	|	ДебиторкаОстатки.ДокНомер.МП.Куратор КАК Куратор,
	|	СУММА(ДебиторкаОстатки.ЗадолженностьСумОстаток) КАК ПросроченнаяСумма
	|ИЗ
	|	РегистрНакопления.Дебиторка.Остатки(
	|			&ДатаПользователя,
	|			ДокНомер.СрокДействия < &ДатаПользователя
	|			И Счет = &ОсновнойСчет) КАК ДебиторкаОстатки
	|ГДЕ
	|	ДебиторкаОстатки.ЗадолженностьСумОстаток < 0
	|СГРУППИРОВАТЬ ПО
	|	ДебиторкаОстатки.ДокНомер.МП.Регион,
	|	ДебиторкаОстатки.ДокНомер.МП.Куратор
	|ИТОГИ
	|	СУММА(ПросроченнаяСумма)
	|ПО
	|	Регион";
	
	Запрос1С.УстановитьПараметр("ДатаПользователя", КонецДня(ДатаПользователя));
	Запрос1С.УстановитьПараметр("ОсновнойСчет", Справочники.Организация.ОсновнойСчет);
	
	// Выполняем запрос
	Попытка
		Результат = Запрос1С.Выполнить();
	Исключение
		Возврат СоздатьОтветСОшибкой(500, "Ошибка выполнения запроса: " + ОписаниеОшибки());
	КонецПопытки;
	
	// Формируем результат
	Если Результат.Пустой() Тогда
		Ответ = Новый Структура("Результат", Новый Массив);
	Иначе
		ВыборкаРегион = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		МассивРезультатов = Новый Массив;
		
		Пока ВыборкаРегион.Следующий() Цикл
			РегионДанные = Новый Структура;
			РегионДанные.Вставить("Регион", Строка(ВыборкаРегион.Регион));
			РегионДанные.Вставить("ПросроченнаяСуммаРегиона", ВыборкаРегион.ПросроченнаяСумма);
			
			// Детализация по кураторам
			МассивКураторов = Новый Массив;
			ВыборкаКуратор = ВыборкаРегион.Выбрать();
			Пока ВыборкаКуратор.Следующий() Цикл
				КураторДанные = Новый Структура;
				КураторДанные.Вставить("Куратор", ?(ЗначениеЗаполнено(ВыборкаКуратор.Куратор), Строка(ВыборкаКуратор.Куратор), "Без куратора"));
				КураторДанные.Вставить("ПросроченнаяСумма", ВыборкаКуратор.ПросроченнаяСумма);
				МассивКураторов.Добавить(КураторДанные);
			КонецЦикла;
			
			РегионДанные.Вставить("Кураторы", МассивКураторов);
			МассивРезультатов.Добавить(РегионДанные);
		КонецЦикла;
		
		Ответ = Новый Структура("Результат", МассивРезультатов);
	КонецЕсли;
	
	// Формируем JSON-ответ
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Ответ);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// Возвращаем успешный ответ
	HTTPОтвет = Новый HTTPСервисОтвет(200);
	HTTPОтвет.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	HTTPОтвет.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Возврат HTTPОтвет;
	
КонецФункции

// Вспомогательная функция для создания ответа с ошибкой
Функция СоздатьОтветСОшибкой(КодСостояния, ТекстОшибки)
	Ответ = Новый Структура("Ошибка", ТекстОшибки);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Ответ);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	HTTPОтвет = Новый HTTPСервисОтвет(КодСостояния);
	HTTPОтвет.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	HTTPОтвет.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Возврат HTTPОтвет;
КонецФункции