Функция RasxodXarajatlarPOST(Запрос)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
    ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
    ДатаОкончания = ДанныеЗапроса.Дата;
    
    ДатаОкончания = ПрочитатьДатуJSON(ДатаОкончания, ФорматДатыJSON.ISO);
    
    НачалоГода = НачалоГода(ДатаОкончания);
    НачалоПредМесяца = НачалоМесяца(ДобавитьМесяц(ДатаОкончания, -1));
    КонецПредМесяца = КонецМесяца(ДобавитьМесяц(ДатаОкончания, -1));
    НачалоТекМесяца = НачалоМесяца(ДатаОкончания);
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ФинансыОбороты.Статья КАК Статья,
        |	СУММА(ФинансыОбороты.ВалютаРасход-ФинансыОбороты.ВалютаПриход) КАК Валюта
        |ИЗ
        |	РегистрНакопления.Финансы.Обороты(&НачалоПериода, &КонецПериода, , 
        |		ФинИст = &ФинИст 
        |		И Статья <> &ПереносОстатков 
        |		И Статья <> &СтатьяПродажа
		|		И Статья <> &СтатьяРезерв) КАК ФинансыОбороты
        |СГРУППИРОВАТЬ ПО
        |	ФинансыОбороты.Статья";
    
    // Устанавливаем параметры
    Запрос.УстановитьПараметр("ФинИст", Справочники.ФинИст.Фойдадан);
    Запрос.УстановитьПараметр("ПереносОстатков", Справочники.Статьи.НайтиПоНаименованию("ПереносОстатков"));
    Запрос.УстановитьПараметр("СтатьяПродажа", Справочники.Статьи.НайтиПоНаименованию("Продажа")); // Исключаем "Продажа"
	Запрос.УстановитьПараметр("СтатьяРезерв", Справочники.Статьи.НайтиПоНаименованию("Резерв")); // Исключаем "Резерв"
    
    // Структура ответа
    ОтветСтруктура = Новый Структура;
    
    // С начала года
    Запрос.УстановитьПараметр("НачалоПериода", НачалоГода);
    Запрос.УстановитьПараметр("КонецПериода", ДатаОкончания);
    Результат = Запрос.Выполнить().Выгрузить();
    МассивСНачалаГода = Новый Массив;
    Для Каждого Строка Из Результат Цикл
        Элемент = Новый Структура("Статья, Валюта", Строка.Статья.Наименование, Строка.Валюта);
        МассивСНачалаГода.Добавить(Элемент);
    КонецЦикла;
    ОтветСтруктура.Вставить("СНачалаГода", МассивСНачалаГода);
    
    // Предыдущий месяц
    Запрос.УстановитьПараметр("НачалоПериода", НачалоПредМесяца);
    Запрос.УстановитьПараметр("КонецПериода", КонецПредМесяца);
    Результат = Запрос.Выполнить().Выгрузить();
    МассивПредМесяц = Новый Массив;
    Для Каждого Строка Из Результат Цикл
        Элемент = Новый Структура("Статья, Валюта", Строка.Статья.Наименование, Строка.Валюта);
        МассивПредМесяц.Добавить(Элемент);
    КонецЦикла;
    ОтветСтруктура.Вставить("ПредыдущийМесяц", МассивПредМесяц);
    
    // Текущий месяц
    Запрос.УстановитьПараметр("НачалоПериода", НачалоТекМесяца);
    Запрос.УстановитьПараметр("КонецПериода", ДатаОкончания);
    Результат = Запрос.Выполнить().Выгрузить();
    МассивТекМесяц = Новый Массив;
    Для Каждого Строка Из Результат Цикл
        Элемент = Новый Структура("Статья, Валюта", Строка.Статья.Наименование, Строка.Валюта);
        МассивТекМесяц.Добавить(Элемент);
    КонецЦикла;
    ОтветСтруктура.Вставить("ТекущийМесяц", МассивТекМесяц);
    
    // Формируем JSON-ответ
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ОтветСтруктура);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
    
    Возврат Ответ;
КонецФункции