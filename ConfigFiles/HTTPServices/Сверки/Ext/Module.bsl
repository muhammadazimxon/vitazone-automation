Функция debt(Запрос) Экспорт
    Попытка
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        Сообщить("Тело запроса: " + ТелоЗапроса);
        
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Тело запроса пустое.");
            Возврат Ответ;
        КонецЕсли;
        
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
        
        Если НЕ ДанныеJSON.Свойство("ИНН") Тогда
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: Не указан ИНН контрагента.");
            Возврат Ответ;
        КонецЕсли;
        
        ИННСтрока = ДанныеJSON.ИНН;
        Сообщить("Получен ИНН из запроса: " + ИННСтрока);
        
        Попытка
            ИНН = Число(ИННСтрока);
            Сообщить("ИНН преобразован в число: " + Формат(ИНН, "ЧГ=0"));
        Исключение
            Ответ = Новый HTTPСервисОтвет(400);
            Ответ.УстановитьТелоИзСтроки("Ошибка: ИНН должен быть числом из 9 цифр.");
            Возврат Ответ;
        КонецПопытки;
        
        Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("инн", ИНН);
        Если Контрагент.Пустая() Тогда
            ЗапросКонтрагент = Новый Запрос;
            ЗапросКонтрагент.Текст = 
                "ВЫБРАТЬ
                |    Контрагенты.Ссылка КАК Ссылка,
                |    Контрагенты.инн КАК инн
                |ИЗ
                |    Справочник.Контрагенты КАК Контрагенты
                |ГДЕ
                |    Контрагенты.инн = &ИНН";
            ЗапросКонтрагент.УстановитьПараметр("ИНН", ИНН);
            Результат = ЗапросКонтрагент.Выполнить();
            
            Если Результат.Пустой() Тогда
                Сообщить("Контрагент с ИНН " + Формат(ИНН, "ЧГ=0") + " не найден в справочнике.");
                Ответ = Новый HTTPСервисОтвет(404);
                Ответ.УстановитьТелоИзСтроки("Ошибка: Контрагент с ИНН " + ИННСтрока + " не найден.");
                Возврат Ответ;
            Иначе
                Выборка = Результат.Выбрать();
                Выборка.Следующий();
                Контрагент = Выборка.Ссылка;
                Сообщить("Контрагент найден через запрос: " + Контрагент.Наименование);
            КонецЕсли;
        Иначе
            Сообщить("Контрагент найден через НайтиПоРеквизиту: " + Контрагент.Наименование);
        КонецЕсли;
        
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    ДебиторкаОстатки.ДокНомер КАК ДокНомер,
            |    ДебиторкаОстатки.ДокНомер.СрокДействия КАК СрокДействия,
            |    ДебиторкаОстатки.ЗадолженностьСумОстаток КАК ЗадолженностьСум
            |ИЗ
            |    РегистрНакопления.Дебиторка.Остатки(, 
            |        Контрагенты = &Контрагент 
            |        И Счет = &ОсновнойСчет) КАК ДебиторкаОстатки
            |ИТОГИ
            |    СУММА(ЗадолженностьСумОстаток)
            |ПО
            |    ОБЩИЕ";
        Запрос.УстановитьПараметр("Контрагент", Контрагент);
        Запрос.УстановитьПараметр("ОсновнойСчет", Справочники.Организация.ОсновнойСчет);
        
        Результат = Запрос.Выполнить();
        ВыборкаОбщие = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
        
        СтруктураОтвета = Новый Структура;
        СтруктураОтвета.Вставить("НаименованиеКонтрагента", Контрагент.Наименование);
        
        Если ВыборкаОбщие.Следующий() Тогда
            СтруктураОтвета.Вставить("ОбщаяСумма", ВыборкаОбщие.ЗадолженностьСум);
            МассивДоговоров = Новый Массив;
            ОбщаяПросроченнаяСумма = 0;
            ВыборкаДетали = ВыборкаОбщие.Выбрать();
            ТекущаяДата = ТекущаяДата();
            Пока ВыборкаДетали.Следующий() Цикл
                ДанныеДоговора = Новый Структура;
                ДанныеДоговора.Вставить("ДокНомер", Строка(ВыборкаДетали.ДокНомер));
                ДанныеДоговора.Вставить("ЗадолженностьСум", ВыборкаДетали.ЗадолженностьСум);
                Если ЗначениеЗаполнено(ВыборкаДетали.СрокДействия) Тогда
                    ДнейПросрочки = (ТекущаяДата - ВыборкаДетали.СрокДействия) / (60*60*24);
                    ДнейПросрочки = ?(ДнейПросрочки > 0, Цел(ДнейПросрочки), 0);
                    ДанныеДоговора.Вставить("ДнейПросрочки", ДнейПросрочки);
                    Если ДнейПросрочки > 0 Тогда
                        ОбщаяПросроченнаяСумма = ОбщаяПросроченнаяСумма + ВыборкаДетали.ЗадолженностьСум;
                    КонецЕсли;
                Иначе
                    ДанныеДоговора.Вставить("ДнейПросрочки", 0);
                КонецЕсли;
                МассивДоговоров.Добавить(ДанныеДоговора);
            КонецЦикла;
            СтруктураОтвета.Вставить("Договоры", МассивДоговоров);
            СтруктураОтвета.Вставить("ОбщаяПросроченнаяСумма", ОбщаяПросроченнаяСумма);
        Иначе
            СтруктураОтвета.Вставить("ОбщаяСумма", 0);
            СтруктураОтвета.Вставить("ОбщаяПросроченнаяСумма", 0);
            СтруктураОтвета.Вставить("Договоры", Новый Массив);
        КонецЕсли;
        
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Вставить("Content-Type", "application/json");
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
        Возврат Ответ;
        
    Исключение
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Новый Структура("Ошибка", ОписаниеОшибки()));
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.Заголовки.Вставить("Content-Type", "application/json");
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
        Возврат Ответ;
    КонецПопытки;
КонецФункции