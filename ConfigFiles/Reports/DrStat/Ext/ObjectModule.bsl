Функция ПолучитьТокенАутентификации()
    URL = "http://84.54.116.154:8080/authenticate";
    
    ДанныеАутентификации = Новый Структура;
    ДанныеАутентификации.Вставить("username", "998977716381");
    ДанныеАутентификации.Вставить("password", "000000");
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеАутентификации);
    ТелоЗапроса = ЗаписьJSON.Закрыть();
    
    HTTPСоединение = Новый HTTPСоединение("84.54.116.154", 8080);
    
    HTTPЗапрос = Новый HTTPЗапрос("/authenticate");
    HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
    HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
    
    Попытка
        Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
    Исключение
        Сообщить("Ошибка при выполнении запроса аутентификации: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    
    Если Ответ.КодСостояния = 200 Тогда
        ТекстJSON = Ответ.ПолучитьТелоКакСтроку();
        Сообщить("Ответ сервера (аутентификация): " + ТекстJSON);
        
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТекстJSON);
        Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
        ЧтениеJSON.Закрыть();
        
        Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("token") Тогда
            Возврат Данные.token;
        Иначе
            Сообщить("Токен не найден в ответе сервера.");
            Возврат Неопределено;
        КонецЕсли;
    Иначе
        Сообщить("Ошибка аутентификации. Код: " + Ответ.КодСостояния);
        Возврат Неопределено;
    КонецЕсли;
КонецФункции


Процедура ПолучитьДанныеИзAPI(ДатаНачала, ДатаОкончания, Результат)
    Токен = ПолучитьТокенАутентификации();
    Если Токен = Undefined Тогда
        Сообщить("Не удалось получить токен аутентификации.");
        Результат = Новый Массив;
        Возврат;
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
        Сообщить("Ошибка: Не указаны даты начала или окончания периода.");
        Результат = Новый Массив;
        Возврат;
    КонецЕсли;
    
    // Форматирование дат в строгий формат yyyy-MM-ddTHH:mm:ss
    FromDate = Формат(Год(ДатаНачала), "ЧГ=0") + "-" +
               Прав("0" + Формат(Месяц(ДатаНачала), "ЧГ=0"), 2) + "-" +
               Прав("0" + Формат(День(ДатаНачала), "ЧГ=0"), 2) + "T" +
               Прав("00" + Формат(Час(ДатаНачала), "ЧГ=0"), 2) + ":" +
               Прав("00" + Формат(Минута(ДатаНачала), "ЧГ=0"), 2) + ":" +
               Прав("00" + Формат(Секунда(ДатаНачала), "ЧГ=0"), 2);

    ToDate = Формат(Год(ДатаОкончания), "ЧГ=0") + "-" +
             Прав("0" + Формат(Месяц(ДатаОкончания), "ЧГ=0"), 2) + "-" +
             Прав("0" + Формат(День(ДатаОкончания), "ЧГ=0"), 2) + "T" +
             Прав("00" + Формат(Час(ДатаОкончания), "ЧГ=0"), 2) + ":" +
             Прав("00" + Формат(Минута(ДатаОкончания), "ЧГ=0"), 2) + ":" +
             Прав("00" + Формат(Секунда(ДатаОкончания), "ЧГ=0"), 2);
    
    HTTPСоединение = Новый HTTPСоединение("84.54.116.154", 8080);
    Результат = Новый Массив;
    НомерСтраницы = 0;
    РазмерСтраницы = 100;
    
    Пока Истина Цикл
        ПараметрыЗапроса = Новый Структура;
        ПараметрыЗапроса.Вставить("fromDate", FromDate);
        ПараметрыЗапроса.Вставить("toDate", ToDate);
        ПараметрыЗапроса.Вставить("page", НомерСтраницы);
        ПараметрыЗапроса.Вставить("size", РазмерСтраницы);
        
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, ПараметрыЗапроса);
        ТелоЗапроса = ЗаписьJSON.Закрыть();
        
        Сообщить("Отправляемые параметры (страница " + НомерСтраницы + "): " + ТелоЗапроса);
        
        HTTPЗапрос = Новый HTTPЗапрос("/api/v1/response");
        HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
        HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
        HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
        
        Попытка
            Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
        Исключение
            Сообщить("Ошибка при выполнении запроса данных: " + ОписаниеОшибки());
            Результат = Новый Массив;
            Возврат;
        КонецПопытки;
        
        Если Ответ.КодСостояния = 200 Тогда
            ТекстJSON = Ответ.ПолучитьТелоКакСтроку();
            Сообщить("Данные API (страница " + НомерСтраницы + "): " + ТекстJSON);
            
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(ТекстJSON);
            Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
            ЧтениеJSON.Закрыть();
            
            Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("data") Тогда
                Для Каждого Элемент Из Данные.data Цикл
                    Результат.Добавить(Элемент);
                КонецЦикла;
                
                Если Данные.Свойство("total") Тогда
                    ВсегоЗаписей = Данные.total;
                    Если Результат.Количество() >= ВсегоЗаписей Тогда
                        Прервать;
                    КонецЕсли;
                ИначеЕсли Данные.data.Количество() < РазмерСтраницы Тогда
                    Прервать;
                КонецЕсли;
            Иначе
                Сообщить("Поле 'data' не найдено в ответе API на странице " + НомерСтраницы);
                Прервать;
            КонецЕсли;
        Иначе
            Сообщить("Ошибка запроса данных. Код: " + Ответ.КодСостояния);
            Сообщить("Ответ сервера (данные): " + Ответ.ПолучитьТелоКакСтроку());
            Прервать;
        КонецЕсли;
        
        НомерСтраницы = НомерСтраницы + 1;
    КонецЦикла;
    
    Сообщить("Всего получено записей: " + Результат.Количество());
КонецПроцедуры




Функция ЗаполнитьДанныеAPI(КомпоновщикНастроек, ДанныеРасшифровки)
    ПараметрДатаНачала = Неопределено;
    ПараметрДатаОкончания = Неопределено;
    
    Для Каждого Элемент Из КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
        Если ТипЗнч(Элемент) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
            Если Строка(Элемент.Параметр) = "ДатаНачала" Тогда
                ПараметрДатаНачала = Элемент;
            ИначеЕсли Строка(Элемент.Параметр) = "ДатаОкончания" Тогда
                ПараметрДатаОкончания = Элемент;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
    Если ПараметрДатаНачала = Неопределено Или ПараметрДатаОкончания = Undefined Тогда
        Сообщить("Ошибка: Параметры 'ДатаНачала' или 'ДатаОкончания' не найдены в пользовательских настройках.");
        Возврат Новый ТаблицаЗначений;
    КонецЕсли;
    
    ДатаНачала = ПараметрДатаНачала.Значение;
    ДатаОкончания = ПараметрДатаОкончания.Значение;
    
    Сообщить("ДатаНачала из пользовательских настроек: " + ДатаНачала);
    Сообщить("ДатаОкончания из пользовательских настроек: " + ДатаОкончания);
    
    Данные = Новый Массив;
    ПолучитьДанныеИзAPI(ДатаНачала, ДатаОкончания, Данные);
    
    ТаблицаДанных = Новый ТаблицаЗначений;
    ТаблицаДанных.Колонки.Добавить("userId", Новый ОписаниеТипов("Число"));
    ТаблицаДанных.Колонки.Добавить("userName", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("userSurname", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("userPhoneNumber", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("userRole", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("region", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("managerId", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
    ТаблицаДанных.Колонки.Добавить("managerName", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("managerSurname", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("managerPhoneNumber", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("eventId", Новый ОписаниеТипов("Число"));
    ТаблицаДанных.Колонки.Добавить("eventTime", Новый ОписаниеТипов("Дата"));
    ТаблицаДанных.Колонки.Добавить("eventStatus", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("medicineId", Новый ОписаниеТипов("Число"));
    ТаблицаДанных.Колонки.Добавить("medicineName", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("medicineBall", Новый ОписаниеТипов("Число"));
    ТаблицаДанных.Колонки.Добавить("qrId", Новый ОписаниеТипов("Число"));
    ТаблицаДанных.Колонки.Добавить("qrUid", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("medPlaceId", Новый ОписаниеТипов("Число"));
    ТаблицаДанных.Колонки.Добавить("medPlaceAddress", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("medPlaceRegion", Новый ОписаниеТипов("Строка"));
    
    Для Каждого Элемент Из Данные Цикл
        НоваяСтрока = ТаблицаДанных.Добавить();
        
        // Преобразуем eventTime из строки в дату
        Если Элемент.Свойство("eventTime") И ЗначениеЗаполнено(Элемент.eventTime) Тогда
            Попытка
                // Удаляем миллисекунды, если они есть
                ВремяСтрокой = Элемент.eventTime;
                ПозицияТочки = Найти(ВремяСтрокой, ".");
                Если ПозицияТочки > 0 Тогда
                    ВремяСтрокой = Лев(ВремяСтрокой, ПозицияТочки - 1);
                КонецЕсли;
                
                // Парсим строку вида "2025-04-10T14:27:01"
                Год = Число(Лев(ВремяСтрокой, 4));
                Месяц = Число(Сред(ВремяСтрокой, 6, 2));
                День = Число(Сред(ВремяСтрокой, 9, 2));
                Час = Число(Сред(ВремяСтрокой, 12, 2));
                Минута = Число(Сред(ВремяСтрокой, 15, 2));
                Секунда = Число(Сред(ВремяСтрокой, 18, 2));
                
                НоваяСтрока.eventTime = Дата(Год, Месяц, День, Час, Минута, Секунда);
            Исключение
                Сообщить("Ошибка преобразования eventTime для записи: " + Элемент.eventTime + ". " + ОписаниеОшибки());
                НоваяСтрока.eventTime = Дата(1, 1, 1); // Или другое значение по умолчанию
            КонецПопытки;
        КонецЕсли;
        
        // Заполняем остальные поля
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент,, "eventTime");
    КонецЦикла;
    
    Если ТаблицаДанных.Количество() = 0 Тогда
        Сообщить("За указанный период данные отсутствуют.");
    КонецЕсли;
    
    Возврат ТаблицаДанных;
КонецФункции

#КонецОбласти

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    
    СхемаКомпоновки = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
    Настройки = КомпоновщикНастроек.ПолучитьНастройки();
    
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, Настройки, ДанныеРасшифровки);
    
    ТаблицаДанных = ЗаполнитьДанныеAPI(КомпоновщикНастроек, ДанныеРасшифровки);
    
    ВнешниеНаборы = Новый Структура;
    ВнешниеНаборы.Вставить("ДанныеAPI", ТаблицаДанных);
    
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы, ДанныеРасшифровки);
    
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    
    Если ТаблицаДанных.Количество() = 0 Тогда
        ДокументРезультат.Вывести(ДокументРезультат);
        ДокументРезультат.Область(1,1).Текст = "За указанный период данные отсутствуют.";
    Иначе
        ПроцессорВывода.Вывести(ПроцессорКомпоновки);
    КонецЕсли;
КонецПроцедуры