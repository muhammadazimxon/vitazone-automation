	<calculatedField>
		<dataPath>ОжидаемаяЗП</dataPath>
		<expression>ВЫБОР
    КОГДА ЕСТЬNULL(Порог, 0) &gt; 0 И СуммаПродаж &gt;= Порог ТОГДА СуммаПродаж * ЕСТЬNULL(ВышеПорога, 10) / 100
    КОГДА СуммаПродаж &gt;= &amp;БазовыйПорог ТОГДА СуммаПродаж * ЕСТЬNULL(Выше, 9) / 100
    ИНАЧЕ СуммаПродаж * ЕСТЬNULL(Ниже, 8) / 100
КОНЕЦ + ЕСТЬNULL(Кураторские, 0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ожидаемая ЗП</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>32</v8:Digits>
				<v8:FractionDigits>2</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>Процент</dataPath>
		<expression>ВЫБОР
    КОГДА ЕСТЬNULL(Порог, 0) &gt; 0 И СуммаПродаж &gt;= Порог ТОГДА ЕСТЬNULL(ВышеПорога, 10)
    КОГДА СуммаПродаж &gt;= &amp;БазовыйПорог ТОГДА ЕСТЬNULL(Выше, 9)
    ИНАЧЕ ЕСТЬNULL(Ниже, 8)
КОНЕЦ</expression>
