		<query>ВЫБРАТЬ
    Договоры.Владелец КАК Контрагенты,
    Договоры.Регион КАК Регион,
    Договоры.МП КАК МП,
    ЕСТЬNULL(ДебиторкаОстатки.Статья, ЗНАЧЕНИЕ(Справочник.Статьи.Продажа)) КАК Статья,
    Договоры.Ссылка КАК ДокНомер,
    1 КАК КолвоДок,
    Договоры.ДатаСоставления КАК ДатаСоставления,
    Договоры.СрокДействия КАК СрокДоговора,
    ВЫБОР
        КОГДА ВЫБОР
                КОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) &lt; 0
                    ТОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0)
                ИНАЧЕ 0
            КОНЕЦ = 0
            ТОГДА "Основной счет"
        ИНАЧЕ ЕСТЬNULL(ДебиторкаОстатки.Счет.Наименование, ЗНАЧЕНИЕ(Справочник.Организация.ОсновнойСчет))
    КОНЕЦ КАК Счет,
    ВЫБОР
        КОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) &lt; 0
            ТОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0)
        ИНАЧЕ 0
    КОНЕЦ КАК СуммаВсейЗадолженности,
    ВЫБОР
        КОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) &lt; 0
                И РАЗНОСТЬДАТ(ЕСТЬNULL(Договоры.СрокДействия, ДАТАВРЕМЯ(1, 1, 1)), &amp;ДатаОкончания, ДЕНЬ) &gt; 0
            ТОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0)
        ИНАЧЕ 0
    КОНЕЦ КАК СуммаПросроченнойЗадолженности,
    ВЫБОР
        КОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) &gt; 0
            ТОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0)
        ИНАЧЕ 0
    КОНЕЦ КАК СуммаПереплаты,
    ВЫБОР
        КОГДА Договоры.Наименование В ("Переплата", "Суд харажати")
            ТОГДА 0
        КОГДА ВЫБОР
                КОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0) &lt; 0
                    ТОГДА ЕСТЬNULL(ДебиторкаОстатки.ЗадолженностьСумОстаток, 0)
                ИНАЧЕ 0
            КОНЕЦ = 0
            ТОГДА 0
        КОГДА ЕСТЬNULL(Договоры.СрокДействия, ДАТАВРЕМЯ(1, 1, 1)) &lt; &amp;ДатаОкончания
            ТОГДА РАЗНОСТЬДАТ(ЕСТЬNULL(Договоры.СрокДействия, ДАТАВРЕМЯ(1, 1, 1)), &amp;ДатаОкончания, ДЕНЬ)
        ИНАЧЕ 0
    КОНЕЦ КАК КоличествоДнейПросрочки,
    ЕСТЬNULL(ОстаткиОстаткиИОбороты.СуммаРасход, 0) КАК РеализацияБезНДС,
    ЕСТЬNULL(ОстаткиОстаткиИОбороты.СебестоимостьРасход, 0) КАК Себестоимость,
    ЕСТЬNULL(ОстаткиОстаткиИОбороты.СуммаРасход - ОстаткиОстаткиИОбороты.СебестоимостьРасход, 0) КАК Прибыль
ИЗ
    Справочник.Договор КАК Договоры
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Дебиторка.Остатки(&amp;ДатаОкончания, ) КАК ДебиторкаОстатки
        ПО Договоры.Ссылка = ДебиторкаОстатки.ДокНомер
            И Договоры.Владелец = ДебиторкаОстатки.Контрагенты
            И (ДебиторкаОстатки.Статья = ЗНАЧЕНИЕ(Справочник.Статьи.Продажа))
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Остатки.ОстаткиИОбороты(&amp;ДатаНачала, &amp;ДатаОкончания, , , ) КАК ОстаткиОстаткиИОбороты
        ПО Договоры.Владелец = ОстаткиОстаткиИОбороты.Контрагенты
            И Договоры.Ссылка = ОстаткиОстаткиИОбороты.ДокНомер
ГДЕ
    НЕ Договоры.ПометкаУдаления

</query>
