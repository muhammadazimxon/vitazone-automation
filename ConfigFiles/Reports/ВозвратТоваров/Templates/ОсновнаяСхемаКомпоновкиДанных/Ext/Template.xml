			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	ПродажаТабдок.Номенклатура КАК Номенклатура,
	ПродажаТабдок.КолВо * -1 КАК КолВо,
	ПродажаТабдок.Цена КАК Цена,
	ПродажаТабдок.Сумма * -1 КАК Сумма,
	ПродажаТабдок.НДС * -1 КАК НДС,
	ПродажаТабдок.Бонус * -1 КАК Бонус,
	ПродажаТабдок.Себестоим * -1 КАК Себестоим,
	ПродажаТабдок.ОбщаяСумма * -1 КАК ОбщаяСумма,
	ПродажаТабдок.Ссылка.Дата КАК Дата,
	ПродажаТабдок.НомерДокС КАК НомерДок,
	ПродажаТабдок.НомерДокС.МП КАК МП,
	ПродажаТабдок.НомерДокС.Владелец КАК Контрагенты,
	ПродажаТабдок.НомерДокС.МП.Регион КАК Регион
ИЗ
	Документ.Продажа.Табдок КАК ПродажаТабдок
ГДЕ
	ПродажаТабдок.КолВо &lt; 0
	И ПродажаТабдок.Ссылка.Дата МЕЖДУ &amp;Дата1 И &amp;Дата2
	И ПродажаТабдок.Ссылка.Проведен = ИСТИНА</query>
