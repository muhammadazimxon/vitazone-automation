		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    ЕСТЬNULL(ПланыПродажРС.Аптека, ОстаткиОстаткиИОбороты.Контрагенты) КАК Контрагенты,
    ЕСТЬNULL(ПланыПродажРС.МП, ОстаткиОстаткиИОбороты.МП) КАК МП,
    ЕСТЬNULL(ПланыПродажРС.Куратор, ОстаткиОстаткиИОбороты.Куратор) КАК Куратор,
    ЕСТЬNULL(ПланыПродажРС.Номенклатура, ОстаткиОстаткиИОбороты.Номенклатура) КАК Номенклатура,
    ПланыПродажРС.Количество КАК Количество,
    ПланыПродажРС.Сумма КАК Сумма,
    ОстаткиОстаткиИОбороты.КолвоРасход КАК ФактКоличество,
    ОстаткиОстаткиИОбороты.СуммаРасход КАК ФактСумма
ИЗ
    РегистрСведений.ПланыПродажРС КАК ПланыПродажРС
    ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Остатки.ОстаткиИОбороты КАК ОстаткиОстаткиИОбороты
    ПО ПланыПродажРС.Аптека = ОстаткиОстаткиИОбороты.Контрагенты
    И ПланыПродажРС.МП = ОстаткиОстаткиИОбороты.МП
    И ПланыПродажРС.Куратор = ОстаткиОстаткиИОбороты.Куратор
    И ПланыПродажРС.Номенклатура = ОстаткиОстаткиИОбороты.Номенклатура
ГДЕ
    ПланыПродажРС.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
