			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	ПланПродажТабдок1.Номенклатура КАК Номенклатура,
	ПланПродажТабдок1.МП КАК МП,
	ПланПродажТабдок1.Колво КАК ПланКолво,
	ПланПродажТабдок1.Сумма КАК ПланСумма,
	ПланПродажТабдок1.МП.Куратор.ФФМ КАК ФФМ,
	ПланПродажТабдок1.МП.Куратор.ГруппыРМ КАК ГруппыРМ,
	ПланПродажТабдок1.МП.Куратор КАК Куратор
ИЗ
	Документ.ПланПродаж.Табдок1 КАК ПланПродажТабдок1
ГДЕ
	ПланПродажТабдок1.Ссылка.ДатаПериодники МЕЖДУ &amp;НачалаПериода И &amp;ОкончанияПериода
