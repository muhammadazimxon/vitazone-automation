		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    КОНЕЦПЕРИОДА(ДебиторкаОстаткиИОбороты.Период, ДЕНЬ) КАК Кунлар,
    СУММА((ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток * -1)/1000) КАК Карздорлик
     //   ВЫБОР
    //    КОГДА ДебиторкаОстаткиИОбороты.ДокНомер.СрокДействия &lt;= КОНЕЦПЕРИОДА(ДебиторкаОстаткиИОбороты.Период, ДЕНЬ)
     //   ТОГДА ДебиторкаОстаткиИОбороты.ЗадолженностьСумКонечныйОстаток * -1
      //  ИНАЧЕ 0
  //  КОНЕЦ КАК Карздорлик
ИЗ
    РегистрНакопления.Дебиторка.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, День, , ) КАК ДебиторкаОстаткиИОбороты
ГДЕ
    //ДЕНЬ(ДебиторкаОстаткиИОбороты.Период) &lt;= &amp;КоличествоДней
    //И 
    ДебиторкаОстаткиИОбороты.Счет.Наименование = "Основной счет"
СГРУППИРОВАТЬ ПО
    КОНЕЦПЕРИОДА(ДебиторкаОстаткиИОбороты.Период, ДЕНЬ)</query>
