		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    Контрагенты,
    Дата,
    МАКСИМУМ(ДатаСоставления)   КАК ДатаСоставления,
    МАКСИМУМ(СрокДействия)      КАК СрокДействия, 
   МАКСИМУМ(УсловиеПредоплаты)      КАК УсловиеПредоплаты, 
    МАКСИМУМ(ДокНомер)          КАК ДокНомер,
    СУММА(Продажа)              КАК Продажа,
    СУММА(Дебиторка)            КАК Дебиторка,
    СУММА(Приход)               КАК Приход
ИЗ
    (
        // ───── Все строки из ПТабдок2 ─────
        ВЫБРАТЬ
            Фин3ПТабдок2.Контрагенты                            КАК Контрагенты,
            Фин3ПТабдок2.Ссылка.Дата                            КАК Дата,
            Фин3ПТабдок2.ДокНомер.ДатаСоставления               КАК ДатаСоставления,
            Фин3ПТабдок2.ДокНомер.СрокДействия                  КАК СрокДействия,
           Фин3ПТабдок2.ДокНомер.УсловиеПредоплаты                  КАК УсловиеПредоплаты,
 
            Фин3ПТабдок2.ДокНомер                               КАК ДокНомер,
            ВЫБОР
                КОГДА Фин3ПТабдок2.ДокНомер.ДатаСоставления = Фин3ПТабдок2.Ссылка.Дата
                   ИЛИ Фин3ПТабдок2.ДокНомер.Наименование = "Переплата"
                ТОГДА ЕСТЬNULL(Фин3ПТабдок2.СуммаПогашения, 0)
                ИНАЧЕ 0
            КОНЕЦ                                               КАК Продажа,
            ВЫБОР
                КОГДА Фин3ПТабдок2.ДокНомер.ДатаСоставления &lt; Фин3ПТабдок2.Ссылка.Дата
                ТОГДА ЕСТЬNULL(Фин3ПТабдок2.СуммаПогашения, 0)
                ИНАЧЕ 0
            КОНЕЦ                                               КАК Дебиторка,
            0                                                   КАК Приход
        ИЗ
            Документ.Фин3.ПТабдок2 КАК Фин3ПТабдок2
        ГДЕ
            Фин3ПТабдок2.Ссылка.Проведен
            И Фин3ПТабдок2.Ссылка.Дата МЕЖДУ &amp;Дата И &amp;Дата2

        ОБЪЕДИНИТЬ ВСЕ

        // ───── Все строки из ПТабдок3 ─────
        ВЫБРАТЬ
            Фин3ПТабдок3.Контрагенты                            КАК Контрагенты,
            Фин3ПТабдок3.Ссылка.Дата                            КАК Дата,
            ДАТАВРЕМЯ(1,1,1)                                    КАК ДатаСоставления,
            ДАТАВРЕМЯ(1,1,1)                                 	КАК СрокДействия,
            НЕОПРЕДЕЛЕНО                                        КАК УсловиеПредоплаты,
            НЕОПРЕДЕЛЕНО                                        КАК ДокНомер,
            0                                                   КАК Продажа,
            0                                                   КАК Дебиторка,
            ЕСТЬNULL(Фин3ПТабдок3.Приход, 0)                    КАК Приход
        ИЗ
            Документ.Фин3.ПТабдок3 КАК Фин3ПТабдок3
        ГДЕ
            Фин3ПТабдок3.Ссылка.Проведен
            И Фин3ПТабдок3.Ссылка.Дата МЕЖДУ &amp;Дата И &amp;Дата2
    ) КАК Вложенный
СГРУППИРОВАТЬ ПО
    Контрагенты,
    Дата</query>
