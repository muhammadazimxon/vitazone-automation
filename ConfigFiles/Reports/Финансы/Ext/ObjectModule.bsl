&НаСервере
Процедура ОбработкаИзмененияПараметров(Параметры, ИмяПараметра)
    Если ИмяПараметра = "Период" Тогда
        КонецПериода = Параметры.Период.Конец;
        Если ЗначениеЗаполнено(КонецПериода) Тогда
            Запрос = Новый Запрос;
            Запрос.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1
                | КурсВалют.Курс
               |  ИЗ РегистрСведений.КурсВалют КАК КурсВалют
               |  ГДЕ КурсВалют.Валюта = &Валюта
               |  И КурсВалют.Период <= &Дата
               |  УПОРЯДОЧИТЬ ПО КурсВалют.Период УБЫВ";
            
            Запрос.УстановитьПараметр("Валюта", Справочники.Валюта.USD);
            Запрос.УстановитьПараметр("Дата", КонецПериода);
            
            Результат = Запрос.Выполнить();
            Выборка = Результат.Выбрать();
            
            Если Выборка.Следующий() Тогда
                Параметры.Курс = Выборка.Курс;
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры
