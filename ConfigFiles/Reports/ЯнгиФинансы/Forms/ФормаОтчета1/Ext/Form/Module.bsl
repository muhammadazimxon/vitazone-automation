&НаКлиенте
Процедура Команда1(Команда)
    Параметры = Новый Структура("Период, Курс");
    Параметры.Вставить("Период", ТекущаяДата()); // Примерная дата
    Параметры.Вставить("Курс", 0);

    // Асинхронный вызов серверной процедуры
    КурсОламизОКНаСервере(Параметры, Ложь);
    
    Сообщить("Курс валюты: " + Параметры.Курс);
КонецПроцедуры
&НаСервере
Процедура КурсОламизОКНаСервере(Параметры, Отказ) Экспорт
    Если Параметры.Свойство("Период") И Параметры.Свойство("Курс") Тогда
        ПериодКонец = Параметры.Период.Конец;
        
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    КурсВалют.Курс
        | ИЗ
        |    РегистрСведений.КурсВалют КАК КурсВалют
        | ГДЕ
        |    КурсВалют.Валюта = &Валюта
        |    И КурсВалют.Период <= &Дата
        | УПОРЯДОЧИТЬ ПО КурсВалют.Период УБЫВ";
        
        Запрос.УстановитьПараметр("Валюта", "USD");
        Запрос.УстановитьПараметр("Дата", ПериодКонец);
        
        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();
        
        Если Выборка.Следующий() Тогда
            Параметры.Курс = Выборка.Курс;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры
